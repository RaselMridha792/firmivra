# Firmivra local environment. Copy to .env (git-ignored): cp .env.example .env
# Values here are local defaults for synthetic data only. Never put real keys or passwords in this file.

# ---------- Runtime ----------
# development | test | production
NODE_ENV=development
# local = sign in through POST /api/v1/dev/token; cognito = AWS Cognito. The API refuses "local" outside development.
AUTH_MODE=local
# Signs local dev tokens when AUTH_MODE=local. Local only.
LOCAL_AUTH_SECRET=firmivra-local-dev-only-auth-secret
# fatal | error | warn | info | debug | trace
LOG_LEVEL=debug

# ---------- Database (docker compose: postgres) ----------
# Owner role. Migrations and seed only.
DATABASE_URL=postgresql://firmivra:firmivra@localhost:5432/firmivra
# App role used by the API. Cannot bypass row-level security.
DATABASE_URL_APP=postgresql://firmivra_app:firmivra_app@localhost:5432/firmivra

# ---------- AWS ----------
# Region for every AWS client.
AWS_REGION=us-east-1

# ---------- Files: S3 (docker compose: s3mock) ----------
# s3mock endpoint. Leave empty in AWS so the SDK uses real S3.
S3_ENDPOINT=http://localhost:9090
# s3mock only supports path-style URLs.
S3_FORCE_PATH_STYLE=true
# Documents bucket, created by docker compose.
S3_DOCUMENTS_BUCKET=firmivra-docs-local
# Any value works for s3mock. Unset in AWS, where the task role is used.
S3_ACCESS_KEY_ID=local
# Any value works for s3mock. Unset in AWS, where the task role is used.
S3_SECRET_ACCESS_KEY=local

# ---------- Encryption: KMS ----------
# local = encrypt with LOCAL_KMS_KEY; kms = AWS KMS (one key per business).
KMS_MODE=local
# 32 bytes, base64. Local only. Make your own with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
LOCAL_KMS_KEY=ZmlybWl2cmEtbG9jYWwtZGV2LW9ubHkta2V5LTAwMDE=

# ---------- Email (docker compose: Mailpit, inbox at http://localhost:8025) ----------
# smtp = send to SMTP_HOST (Mailpit); ses = Amazon SES.
EMAIL_MODE=smtp
# Mailpit SMTP host.
SMTP_HOST=localhost
# Mailpit SMTP port.
SMTP_PORT=1025
# Sender for platform emails.
EMAIL_FROM="Firmivra <no-reply@dev.firmivra.com>"

# ---------- SMS ----------
# log = write the message to the API log; sns = Amazon SNS.
SMS_MODE=log

# ---------- Cognito (only when AUTH_MODE=cognito; values come from the CDK outputs) ----------
# Region of the user pools.
COGNITO_REGION=us-east-1
# Staff pool (app.firmivra.com).
COGNITO_STAFF_USER_POOL_ID=
# Staff pool app client used by the API.
COGNITO_STAFF_CLIENT_ID=
# Staff pool app client secret. Never commit it.
COGNITO_STAFF_CLIENT_SECRET=
# Clients pool (portal.firmivra.com).
COGNITO_CLIENTS_USER_POOL_ID=
# Clients pool app client used by the API.
COGNITO_CLIENTS_CLIENT_ID=
# Clients pool app client secret. Never commit it.
COGNITO_CLIENTS_CLIENT_SECRET=
# Super Admin pool (admin.firmivra.com).
COGNITO_ADMINS_USER_POOL_ID=
# Super Admin pool app client used by the API.
COGNITO_ADMINS_CLIENT_ID=
# Super Admin pool app client secret. Never commit it.
COGNITO_ADMINS_CLIENT_SECRET=

# ---------- Stripe (test mode; leave empty unless you work on payments) ----------
# Test secret key (sk_test_...). Never commit it.
STRIPE_SECRET_KEY=
# Test publishable key (pk_test_...).
STRIPE_PUBLISHABLE_KEY=
# Webhook signing secret (whsec_...), from `stripe listen` locally. Never commit it.
STRIPE_WEBHOOK_SECRET=

# ---------- URLs ----------
# Firm workspace.
APP_BASE_URL=http://app.localhost:3000
# Client portal (firm slug goes after it, e.g. /lvp).
PORTAL_BASE_URL=http://portal.localhost:3000
# Super Admin console.
ADMIN_BASE_URL=http://admin.localhost:3000
# API, as the servers call it.
API_BASE_URL=http://localhost:4000
# Port the API listens on.
API_PORT=4000
# API base the browser uses (Next.js puts NEXT_PUBLIC_* into the page).
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api/v1
