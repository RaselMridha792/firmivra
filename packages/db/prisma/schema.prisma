  HISTORICAL
  PROJECTED
  ADJUSTMENT
}

/// Why a plan snapshot was kept: when it was finalized, generated as a document or sent.
enum PlanVersionEvent {
  FINALIZED
  GENERATED
  SENT
}

/// An opportunity's review state. NEW is identified and not reviewed; ADDED_TO_PLAN, IMPLEMENTED
/// and CLOSED need a review; NOT_APPLICABLE and DISMISSED need a reason and can be reopened.
enum OpportunityStatus {
  NEW
  UNDER_REVIEW
  ADDED_TO_PLAN
  ASSIGNED
  DISCUSSION_SCHEDULED
  NEEDS_DOCUMENTS
  NOT_APPLICABLE
  DISMISSED
  IMPLEMENTED
  CLOSED
}

enum OpportunitySource {
  SYSTEM
  STAFF
  IMPORTED
  MANUAL
}

enum OpportunityEventKind {
  SCREENED
  STATUS
  ASSIGNED
  DISCUSSION
  DOCUMENTS
  PLAN
  NOTE
}

/// How a template or recurring series picks the assignee of a new task.
enum TaskAssignmentRule {
  UNASSIGNED
  SPECIFIC_USER
  /// The client's current team (the client's assigned member) when the task is created.
  CLIENT_TEAM
}

enum RecurrenceUnit {
  DAY
  WEEK
  MONTH
  QUARTER
  YEAR
}

enum RecurrenceEnd {
  NEVER
  AFTER_COUNT
  ON_DATE
}

/// Move a date that falls on a weekend or holiday.
enum HolidayRule {
  NONE
  NEXT_BUSINESS_DAY
  PREVIOUS_BUSINESS_DAY
}

/// Also the status of a recurring compliance deadline (ComplianceRecurrence).
enum TaskSeriesStatus {
  ACTIVE
  PAUSED
  /// Stopped: no more tasks are made, the tasks made so far stay.
  ENDED
  ARCHIVED
}

enum TaskOccurrenceState {
  SCHEDULED
  GENERATED
  SKIPPED
  FAILED
}

/// Bookkeeping: REPORT, RECONCILIATION. Tax Planning: ESTIMATE, PROJECTION.
enum ReportKind {
  REPORT
  RECONCILIATION
  ESTIMATE
  PROJECTION
}

enum ReportStatus {
  DRAFT
  PUBLISHED
}

enum DocumentDirection {
  /// Uploaded by the client or a portal member.
  CLIENT_TO_FIRM
  /// Shared by the firm with the client.
  FIRM_TO_CLIENT
  /// Firm only: never shown to the client.
  INTERNAL
}

/// Malware scan of an upload. Only CLEAN files can be downloaded.
enum ScanStatus {
  PENDING
  CLEAN
  INFECTED
  FAILED
}

enum DocumentRequestStatus {
  REQUESTED
  SUBMITTED
  ACCEPTED
  /// The firm marked the upload missing; the client is asked again.
  REJECTED
  /// The client said "I don't have this" (reason in statusNote).
  NOT_AVAILABLE
  CANCELLED
}

enum IntakeFormStatus {
  DRAFT
  PUBLISHED
  RETIRED
}

/// docs/PROJECT-DRAFT-v2.md, Intake forms.
enum IntakeStatus {
  /// R37: send setup saved but not sent (no sent_at, never shown to the recipient).
  DRAFT
  SENT
  IN_PROGRESS
  SUBMITTED
  NEEDS_CORRECTION
  UNDER_REVIEW
  COMPLETED
  EXPIRED
  ARCHIVED
}

/// A Begin Online visitor's request, before it is a client.
enum LeadStatus {
  /// Saved for later; resumable with the emailed link.
  DRAFT
  SUBMITTED
  IN_REVIEW
  /// Staff matched or created the client and opened the engagement.
  CONVERTED
  DECLINED
  /// The draft ran out (Lead.draftExpiresAt) before it was sent.
  EXPIRED
  /// R37 (Leads module): the pipeline staff work after the lead came in (SUBMITTED is "New
  /// Lead", DECLINED is "Not Qualified"; IN_REVIEW stays for old rows).
  CONTACTED
  IN_FOLLOW_UP
  APPOINTMENT_SCHEDULED
  QUALIFIED
  /// Lost, or no response.
  LOST
}

/// Groups notifications for preferences. ACCOUNT (security) notices ignore preferences.
enum NotificationCategory {
  ACCOUNT
  DOCUMENTS
  INTAKE
  SERVICES
  MESSAGES
  APPOINTMENTS
  BILLING
}

enum DeliveryChannel {
  EMAIL
  SMS
}

enum DeliveryStatus {
  QUEUED
  SENT
  /// Retried by the sender (back to QUEUED) until it gives up.
  FAILED
  /// Not sent: the preference is off, or there is no address or number.
  SKIPPED
}

enum AppointmentStatus {
  SCHEDULED
  CANCELLED
  COMPLETED
  NO_SHOW
}

enum LocationKind {
  IN_PERSON
  PHONE
  VIDEO
}

enum MessageDirection {
  FIRM_TO_CLIENT
  CLIENT_TO_FIRM
}

/// DRAFT -> SCHEDULED (Upcoming) or OPEN (Pending, Due Soon) -> PAID; CANCELED. PAID and CANCELED are
/// final, except that voiding an offline payment reopens (PAID -> OPEN) a PAID invoice it no longer covers.
enum InvoiceStatus {
  DRAFT
  SCHEDULED
  OPEN
  PAID
  CANCELED
}

/// A refund is PENDING until Stripe's refund event confirms it (SUCCEEDED) or it fails.
enum PaymentRefundStatus {
  PENDING
  SUCCEEDED
  FAILED
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

/// A firm's Stripe Connect onboarding: PENDING until Stripe has the details, RESTRICTED when
/// Stripe needs more, COMPLETE when charges and payouts work.
enum StripeOnboardingStatus {
  PENDING
  RESTRICTED
  COMPLETE
}

enum PaymentProcessor {
  STRIPE
}

/// How an offline payment arrived. Card and bank payments through Stripe are Payment rows, never these.
enum OfflinePaymentMethod {
  CHECK
  CASH
  /// R36: money the firm received outside Stripe by bank transfer, card terminal or another way
  /// and records by hand (Record Payment's methods). Stripe stays the only processor.
  ACH
  CARD
  OTHER
}

/// Content editor records shown in the portal (Business Documents, Resources & Services).
enum ContentKind {
  RESOURCE
  TIP
  EXTERNAL_LINK
}

enum LegalDocumentKind {
  TERMS
  PRIVACY
}

/// Which intakes a firm agreement covers.
enum AgreementScope {
  /// The firm-wide agreement: every Begin Online form and every portal intake. One per firm.
  ALL_INTAKES
  /// An extra agreement for one service's intakes.
  SERVICE
}

/// How a signature was captured. Intake signing is TYPED; DRAWN and UPLOADED are Firm Sign's.
enum SignatureMethod {
  TYPED
  DRAWN
  UPLOADED
}

/// A firm on Firmivra (the tenant).
model Business {
  id           String         @id @default(uuid(7)) @db.Uuid
  name         String
  legalName    String?        @map("legal_name")
  slug         String         @unique
  status       BusinessStatus @default(PENDING_SETUP)
  termsUrl     String?        @map("terms_url")
  privacyUrl   String?        @map("privacy_url")
  /// The firm's own KMS key (per-business key, the fourth wall). Set at approval; platform only.
  kmsKeyId     String?        @map("kms_key_id")
  /// What kind of business, from the application. Platform only.
  businessType String?        @map("business_type")
  /// The industry pack that sets starter modules and wording. Platform only.
  pack         IndustryPack   @default(TAX_ACCOUNTING)
  /// When the firm first became ACTIVE (setup Finish). Set by the database, never changed.
  activatedAt  DateTime?      @map("activated_at") @db.Timestamptz(3)
  createdAt    DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  memberships          Membership[]
  clientAccounts       ClientAccount[]
  supportAccessGrants  SupportAccessGrant[]
  auditLogs            AuditLog[]
  /// R0 stage B4: security alerts about this firm.
  securityAlerts       SecurityAlert[]
  firmApplication      FirmApplication?
  settings             BusinessSettings?
  legalDocuments       FirmLegalDocument[]
  taxStatuses          TaxStatus[]
  invites              Invite[]
  clients              Client[]
  services             Service[]
  documentCategories   DocumentCategory[]
  notifications        Notification[]
  notificationPrefs    NotificationPreference[]
  appointmentTypes     AppointmentType[]
  contentItems         ContentItem[]
  calculators          CalculatorDefinition[]
  stripeAccount        StripeAccount?
  platformOwnerInvites PlatformOwnerInvite[]
  esignSettings        EsignSettings?
  invoiceTaxRates      InvoiceTaxRate[]
  invoiceTemplates     InvoiceTemplate[]
  paymentSettings      PaymentSettings?
  depositAccounts      DepositAccount[]
  serviceCategories    ServiceCategory[]
  servicePackages      ServicePackage[]
  promotions           Promotion[]
  messageSettings      MessageSettings?
  outboundMessages     OutboundMessage[]
  portalVisibility     PortalModuleVisibility[]
  brandProfile         BusinessBrandProfile?
  brandVersions        BusinessBrandVersion[]
  departments          Department[]

  // R38 work modules.
  taskTypes                TaskType[]
  complianceSettings       ComplianceSettings[]
  automationSettings       AutomationSettings[]
  bookkeepingSettings      BookkeepingSettings[]
  intakeSettings           IntakeSettings?
  intakeTemplates          IntakeTemplate[]
  documentFolders          DocumentFolder[]
  firmOffices              FirmOffice[]
  appointmentSettings      AppointmentSettings?
  tags                     Tag[]
  documentRequestTemplates DocumentRequestTemplate[]
  documentSettings         DocumentSettings?

  /// R0 stage A: null until a subscription is set (no backfill for existing firms).
  platformFirmSubscription  PlatformFirmSubscription?
  /// R0 stage B3: what Firmivra bills this firm (Super Admin Billing).
  platformBillingProfile    PlatformFirmBillingProfile?
  platformInvoices          PlatformInvoice[]
  platformRecurringInvoices PlatformRecurringInvoice[]
  platformEstimates         PlatformEstimate[]
  platformCreditNotes       PlatformCreditNote[]
  /// R0 stage B5: Firmivra sales records that converted into this firm.
  salesOpportunities        SalesOpportunity[]
  /// R0 stage B1: Super Admin notifications about this firm (nullable link, platform data).
  platformNotifications     PlatformNotification[]
  /// R0 stage B2: the firm's tickets with Firmivra support (Super Admin Support module).
  supportTickets            SupportTicket[]
  /// R0 stage B6: Firmivra's conversations with this firm's people, and its message and broadcast recipients.
  commConversations         CommConversation[]
  commRecipients            CommMessageRecipient[]           @relation("CommMessageRecipientBusiness")
  commBroadcastRecipients   CommBroadcastRecipient[]         @relation("CommBroadcastRecipientBusiness")
  /// R0 stage B7: this firm's feature overrides, legal holds and the defaults it was provisioned with.
  platformFeatureOverrides  PlatformFeatureOverride[]
  platformLegalHolds        PlatformLegalHold[]              @relation("PlatformLegalHoldBusiness")
  platformDefaultsApplied   PlatformDefaultSetApplication?   @relation("PlatformDefaultSetApplied")
  /// R0 stage B8: this firm's allow or deny rules in Firmivra's integration catalog.
  platformCatalogRules      PlatformIntegrationCatalogFirm[] @relation("PlatformCatalogFirmRule")

  @@map("businesses")
}

/// A person who signs in. One row per Cognito user: staff have one user across firms,
/// clients have one user per firm (docs/AUTH-DESIGN.md), so email is not unique.
model User {
  id         String       @id @default(uuid(7)) @db.Uuid
  cognitoSub String       @unique @map("cognito_sub")
  pool       IdentityPool
  email      String
  name       String
  phone      String?
  createdAt  DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  memberships   Membership[]
  clientAccount ClientAccount?
  platformAdmin PlatformAdmin?

  @@index([email])
  @@map("users")
}

/// Staff and client logins created per day (UTC), for the Super Admin dashboard (R4). Kept by a
/// trigger on users; admin scope reads it, nobody writes it.
model PlatformUserSignups {
  day   DateTime     @db.Date
  pool  IdentityPool
  users Int          @default(0)

  @@id([day, pool])
  @@map("platform_user_signups")
}

/// The owner activation links the platform sent (invites with `sent_by_platform`), without the
/// token: what Super Admin reads for ownerInvite and OWNER_INVITED (R4). Kept by triggers on
/// invites; admin scope reads it, nobody writes it. Admin scope can't read `invites`, so never
/// include `invite` from here (it would come back null).
model PlatformOwnerInvite {
  inviteId     String    @id @map("invite_id") @db.Uuid
  businessId   String    @map("business_id") @db.Uuid
  membershipId String?   @map("membership_id") @db.Uuid
  sentAt       DateTime  @map("sent_at") @db.Timestamptz(3)
  expiresAt    DateTime  @map("expires_at") @db.Timestamptz(3)
  acceptedAt   DateTime? @map("accepted_at") @db.Timestamptz(3)
  revokedAt    DateTime? @map("revoked_at") @db.Timestamptz(3)

  invite   Invite   @relation(fields: [inviteId], references: [id], onDelete: Cascade)
  business Business @relation(fields: [businessId], references: [id])

  @@index([businessId, sentAt])
  @@map("platform_owner_invites")
}

/// A staff user's role in one business.
model Membership {
  id         String           @id @default(uuid(7)) @db.Uuid
  businessId String           @map("business_id") @db.Uuid
  userId     String           @map("user_id") @db.Uuid
  role       MembershipRole
  status     MembershipStatus @default(INVITED)
  /// Set by the database the first time the membership is ACTIVE; never changes. Until then
  /// the firm sees only the invite's name and email, never the person's user row.
  joinedAt   DateTime?        @map("joined_at") @db.Timestamptz(3)
  /// The member's own video meeting link (Zoom, Meet, Teams) for their VIDEO appointments:
  /// https only, no spaces or control characters, at most 500 characters (database CHECK).
  meetingUrl String?          @map("meeting_url")
  /// Firm Sign's Staff Title merge field: the member's own job title, up to 100 characters.
  jobTitle   String?          @map("job_title")
  createdAt  DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  business               Business               @relation(fields: [businessId], references: [id])
  user                   User                   @relation(fields: [userId], references: [id])
  invites                Invite[]
  assignedClients        Client[]
  assignedEngagements    Engagement[]
  assignedTasks          Task[]
  workingHours           WorkingHours[]
  blockedTimes           BlockedTime[]
  appointments           Appointment[]
  invoicesCreated        Invoice[]
