enum BookkeepingPeriodStatus {
  NOT_STARTED
  IN_PROGRESS
  READY_FOR_REVIEW
  APPROVED
  CLOSED
}

enum ReconciliationStatus {
  IN_PROGRESS
  READY_FOR_REVIEW
  APPROVED
  REOPENED
}

enum FiguresSource {
  MANUAL
  IMPORTED
}

enum BookkeepingReportType {
  PROFIT_LOSS
  BALANCE_SHEET
  CASH_FLOW
  GENERAL_LEDGER
  TRIAL_BALANCE
  TRANSACTION_DETAIL
  UNCATEGORIZED
  RECONCILIATION
  QUARTERLY_REVIEW
  YEAR_TO_DATE_SUMMARY
  BOOKKEEPING_STATUS
  MISSING_DOCUMENTS
  /// A report the firm names itself (customName).
  CUSTOM
}

/// The work and review of one report: not started, being prepared, in review, approved, delivered
/// to the client (which freezes it).
enum ReportReviewStatus {
  NOT_STARTED
  IN_PROGRESS
  IN_REVIEW
  APPROVED
  DELIVERED
}

enum AccountingBasis {
  CASH
  ACCRUAL
}

enum TaxPlanType {
  COMPREHENSIVE
  FOCUSED
}

/// Where a planning plan stands (the Recent Planning Clients status). Needs Review in the
