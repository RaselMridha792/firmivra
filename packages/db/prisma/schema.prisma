/// A client's portal login at one firm. The API finds the Cognito user by (businessId, email).
/// clientId links it to the firm's Client record; one client can have several logins
/// (primary, spouse, authorized). Nullable until every sign-up path creates the Client too.
model ClientAccount {
  id               String              @id @default(uuid(7)) @db.Uuid
  businessId       String              @map("business_id") @db.Uuid
  userId           String              @unique @map("user_id") @db.Uuid
  clientId         String?             @map("client_id") @db.Uuid
  portalRole       ClientPortalRole    @default(PRIMARY) @map("portal_role")
  email            String
  accountType      ClientAccountType   @default(INDIVIDUAL) @map("account_type")
  status           ClientAccountStatus @default(PENDING_APPROVAL)
  emailVerifiedAt  DateTime?           @map("email_verified_at") @db.Timestamptz(3)
  phoneVerifiedAt  DateTime?           @map("phone_verified_at") @db.Timestamptz(3)
  approvedAt       DateTime?           @map("approved_at") @db.Timestamptz(3)
  approvedByUserId String?             @map("approved_by_user_id") @db.Uuid
  declinedAt       DateTime?           @map("declined_at") @db.Timestamptz(3)
  declinedByUserId String?             @map("declined_by_user_id") @db.Uuid
  declineReason    String?             @map("decline_reason")
  createdAt        DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)

  business                 Business               @relation(fields: [businessId], references: [id])
  user                     User                   @relation(fields: [userId], references: [id])
  client                   Client?                @relation(fields: [businessId, clientId], references: [businessId, id], onDelete: Restrict)
  invites                  Invite[]
  privateNotes             ClientPrivateNote[]
  legalAcceptances         LegalAcceptance[]
  intakeSignatures         IntakeSignature[]
  verificationCodes        VerificationCode[]
  esignRecipients          EsignRecipient[]
  authorizedPaymentMethods ClientPaymentMethod[]
  portalActivity           ClientPortalActivity[]

  documentShares DocumentShare[]

  @@unique([businessId, email])
  // Target of client-owned rows (private notes).
  @@unique([businessId, userId])
  @@unique([businessId, id])
  @@index([businessId, status])
  @@index([businessId, clientId])
  @@map("client_accounts")
}

/// A Firmivra team member with platform rights (Super Admin).
model PlatformAdmin {
  userId    String       @id @map("user_id") @db.Uuid
  role      PlatformRole @default(SUPER_ADMIN)
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)

  user                   User                     @relation(fields: [userId], references: [id])
  /// R0 stage A: the org-chart row for this admin, if one exists yet (CREATING_TEAM 20261016_r0).
  member                 PlatformMember?
  /// R0 stage B5: sales records and follow-ups assigned to this team member.
  salesDealsAssigned     SalesOpportunity[]       @relation("SalesOpportunityAssignee")
  salesFollowUps         SalesFollowUp[]          @relation("SalesFollowUpAssignee")
  /// R0 stage B1: this admin's notification center and export jobs.
  notifications          PlatformNotification[]
  exportJobs             PlatformExportJob[]
  /// R0 stage B6: conversations assigned to this team member, mentions and read state.
  commConversations      CommConversation[]       @relation("CommConversationAssignee")
  commMentions           CommMessageMention[]     @relation("CommMessageMentioned")
  commReads              CommConversationRead[]   @relation("CommConversationReader")
  /// R0 stage B2: support tickets assigned to this team member.
  supportTicketsAssigned SupportTicket[]          @relation("SupportTicketAssignee")
  /// R0 stage B4
  securityAlertsAssigned SecurityAlert[]          @relation("SecurityAlertAssignee")
  investigationNotes     AuditInvestigationNote[] @relation("AuditInvestigationNoteAuthor")

