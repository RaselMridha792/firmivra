}

/// The cumulative feature checklist for a plan (every feature included at that tier).
model PlatformPlanFeature {
  id         String   @id @default(uuid(7)) @db.Uuid
  planId     String   @map("plan_id") @db.Uuid
  featureKey String   @map("feature_key")
  label      String
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  plan PlatformPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, featureKey])
  @@map("platform_plan_features")
}

enum PlatformSubscriptionStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  SUSPENDED
  /// Still active through the paid-through date; renewal disabled.
  NON_RENEWING
  EXPIRED
  CANCELLED
}

/// One per firm. No row for most firms yet in stage A (no backfill): a missing row means no
