// ==================== R0 stage A: platform team hierarchy and plans (Oct 16) ====================
// Firmivra's own internal org chart (Octavia's hierarchy/permissions and team developer
// instructions) and the firm-facing plan ladder (pricing doc). platform_admins is untouched:
// app_is_admin() keeps meaning exactly what it means today. A non-CEO member's admin row has
// role TEAM_MEMBER, which app_is_admin() already excludes; letting TEAM_MEMBER sign in to the
// admin console is a later PR (API and guards).

enum PlatformRoleLevel {
  CEO
  CHIEF_OFFICER
  VP_DIRECTOR
  MANAGER
  LEAD_SUPERVISOR
  INDIVIDUAL_CONTRIBUTOR
}

/// Where a permission or a member's authority applies (hierarchy doc, "Permission Scope Options").
enum PlatformScopeType {
  COMPANY
  DEPARTMENT
  DIVISION
  TEAM
  DIRECT_REPORTS
  OWN_RECORDS
  CUSTOM
}

enum PlatformPermissionState {
  ALLOW
  DENY
  INHERIT
}

enum PlatformMemberStatus {
  PENDING_INVITATION
  PENDING_APPROVAL
  /// HR added a VP/Director hire; the department Chief Officer must finalize the role.
  PENDING_DEPARTMENT_HEAD_APPROVAL
  ACTIVE
  SUSPENDED
  INACTIVE
  DEACTIVATED
}

/// Data-driven and extensible (Team instructions): the 13 departments from the hierarchy doc.
model PlatformDepartment {
  id          String   @id @default(uuid(7)) @db.Uuid
  code        String   @unique
  name        String
  description String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  roleDefinitions PlatformRoleDefinition[]
  members         PlatformMember[]

  @@map("platform_departments")
}

/// A role template: title, authority level, home department, default reporting line and scope.
/// Roles may exist without a current occupant (hierarchy doc).
model PlatformRoleDefinition {
  id                     String            @id @default(uuid(7)) @db.Uuid
  code                   String            @unique
  title                  String
  level                  PlatformRoleLevel
  departmentId           String            @map("department_id") @db.Uuid
  defaultReportsToRoleId String?           @map("default_reports_to_role_id") @db.Uuid
  defaultScopeType       PlatformScopeType @map("default_scope_type")
  description            String?
  createdAt              DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt              DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  department           PlatformDepartment       @relation(fields: [departmentId], references: [id])
  defaultReportsToRole PlatformRoleDefinition?  @relation("PlatformRoleDefaultReportsTo", fields: [defaultReportsToRoleId], references: [id])
  rolesReportingHere   PlatformRoleDefinition[] @relation("PlatformRoleDefaultReportsTo")
  permissions          PlatformRolePermission[]
  members              PlatformMember[]         @relation("PlatformMemberRole")
  intendedForMembers   PlatformMember[]         @relation("PlatformMemberIntendedRole")

  @@index([departmentId])
  @@map("platform_role_definitions")
}

/// The role's default permission template (doc: "permission_state: allow / deny / inherited").
model PlatformRolePermission {
  roleDefinitionId String                  @map("role_definition_id") @db.Uuid
  permissionKey    String                  @map("permission_key")
  state            PlatformPermissionState
  createdAt        DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)

  roleDefinition PlatformRoleDefinition @relation(fields: [roleDefinitionId], references: [id], onDelete: Cascade)

  @@id([roleDefinitionId, permissionKey])
  @@map("platform_role_permissions")
}

/// The org chart: one row per person occupying a role, 1:1 extending platform_admins. A
/// platform_admins row may exist with no member row yet; a member row never exists without one
/// (app_log_... trigger below also ties role level to platform_admins.role).
model PlatformMember {
  userId                   String               @id @map("user_id") @db.Uuid
  roleDefinitionId         String               @map("role_definition_id") @db.Uuid
  departmentId             String               @map("department_id") @db.Uuid
  reportsToUserId          String?              @map("reports_to_user_id") @db.Uuid
  scopeType                PlatformScopeType    @map("scope_type")
  /// No foreign key (stage A): department, team or user ids depending on scopeType.
  scopeIds                 String[]             @default([]) @map("scope_ids") @db.Uuid
  status                   PlatformMemberStatus @default(ACTIVE)
  /// Set only while status is PENDING_DEPARTMENT_HEAD_APPROVAL.
  intendedRoleDefinitionId String?              @map("intended_role_definition_id") @db.Uuid
  /// Loose references, like audit_logs.actor_user_id: no FK to users (R0 convention).
  invitedByUserId          String?              @map("invited_by_user_id") @db.Uuid
  approvedByUserId         String?              @map("approved_by_user_id") @db.Uuid
  createdAt                DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)

  admin                  PlatformAdmin                      @relation(fields: [userId], references: [userId], onDelete: Cascade)
  roleDefinition         PlatformRoleDefinition             @relation("PlatformMemberRole", fields: [roleDefinitionId], references: [id])
  intendedRoleDefinition PlatformRoleDefinition?            @relation("PlatformMemberIntendedRole", fields: [intendedRoleDefinitionId], references: [id])
  department             PlatformDepartment                 @relation(fields: [departmentId], references: [id])
  reportsTo              PlatformMember?                    @relation("PlatformMemberReportsTo", fields: [reportsToUserId], references: [userId])
  reports                PlatformMember[]                   @relation("PlatformMemberReportsTo")
  permissionOverrides    PlatformMemberPermissionOverride[]

  @@index([departmentId])
  @@index([roleDefinitionId])
  @@index([reportsToUserId])
  @@index([status])
  @@map("platform_members")
}

/// A member's individual exception to their role's permission template (hierarchy doc, "Custom
/// Overrides"): still enforced never to exceed the grantor's own authority (API layer).
model PlatformMemberPermissionOverride {
  id               String                  @id @default(uuid(7)) @db.Uuid
  platformMemberId String                  @map("platform_member_id") @db.Uuid
  permissionKey    String                  @map("permission_key")
  state            PlatformPermissionState
  reason           String?
  grantedByUserId  String?                 @map("granted_by_user_id") @db.Uuid
  createdAt        DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)

  platformMember PlatformMember @relation(fields: [platformMemberId], references: [userId], onDelete: Cascade)

  @@unique([platformMemberId, permissionKey])
  @@map("platform_member_permission_overrides")
}

enum PlatformBillingCycle {
  MONTHLY
  ANNUAL
}

/// The firm-facing plan ladder (pricing doc), reference data. Not tenant data: seeded, not
/// business-scoped.
model PlatformPlan {
  id                           String               @id @default(uuid(7)) @db.Uuid
  code                         String               @unique
  name                         String
  basePriceCents               Int                  @map("base_price_cents")
  billingCycle                 PlatformBillingCycle @default(MONTHLY) @map("billing_cycle")
