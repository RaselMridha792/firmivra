enum BookkeepingPeriodStatus {
  NOT_STARTED
  IN_PROGRESS
  READY_FOR_REVIEW
  APPROVED
  CLOSED
}

enum ReconciliationStatus {
  IN_PROGRESS
  READY_FOR_REVIEW
  APPROVED
  REOPENED
}

enum FiguresSource {
  MANUAL
  IMPORTED
}

enum BookkeepingReportType {
  PROFIT_LOSS
  BALANCE_SHEET
  CASH_FLOW
  GENERAL_LEDGER
  TRIAL_BALANCE
  TRANSACTION_DETAIL
  UNCATEGORIZED
  RECONCILIATION
  QUARTERLY_REVIEW
  YEAR_TO_DATE_SUMMARY
  BOOKKEEPING_STATUS
  MISSING_DOCUMENTS
  /// A report the firm names itself (customName).
  CUSTOM
}

/// The work and review of one report: not started, being prepared, in review, approved, delivered
/// to the client (which freezes it).
enum ReportReviewStatus {
  NOT_STARTED
  IN_PROGRESS
  IN_REVIEW
  APPROVED
  DELIVERED
}

enum AccountingBasis {
  CASH
  ACCRUAL
}

enum TaxPlanType {
  COMPREHENSIVE
  FOCUSED
}

/// Where a planning plan stands (the Recent Planning Clients status). Needs Review in the
/// screens is READY_FOR_REVIEW.
enum TaxPlanStatus {
  DRAFT
  SCHEDULED
  IN_PROGRESS
  AWAITING_CLIENT
  READY_FOR_REVIEW
  IMPLEMENTED
  CLOSED
}

enum PlanningGoal {
  REDUCE_TAXABLE_INCOME
  INCREASE_RETIREMENT_SAVINGS
  PURCHASE_HOME
  START_BUSINESS
  BUY_EQUIPMENT_VEHICLE
  MINIMIZE_SELF_EMPLOYMENT_TAX
  PLAN_EDUCATION_EXPENSES
  BUILD_LONG_TERM_WEALTH
  PREPARE_LIFE_CHANGES
  OTHER
}

enum TaxFilingStatus {
  SINGLE
  MARRIED_FILING_JOINTLY
  MARRIED_FILING_SEPARATELY
  HEAD_OF_HOUSEHOLD
  QUALIFYING_SURVIVING_SPOUSE
}

enum StrategyCategory {
  RETIREMENT
  DEDUCTIONS
  BUSINESS
  CREDITS
  ENTITY
  TIMING
  INVESTMENT
  ESTATE_OTHER
}

/// A strategy in a plan: proposed, accepted by the client, being carried out, done, or declined.
