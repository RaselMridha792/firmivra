/// Append-only. business_id is null for platform events. The app role cannot update or delete rows.
model AuditLog {
  id                String          @id @default(uuid(7)) @db.Uuid
  businessId        String?         @map("business_id") @db.Uuid
  actorUserId       String?         @map("actor_user_id") @db.Uuid
  action            String
  entityType        String          @map("entity_type")
  entityId          String?         @map("entity_id")
  metadata          Json?
  ip                String?
  userAgent         String?         @map("user_agent")
  requestId         String?         @map("request_id")
  createdAt         DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  /// R0 stage B4 (Audit & Security): the normalized event fields. All optional, so every existing
  /// writer keeps working; a row with a category also carries its severity, outcome and actor type.
  category          AuditCategory?
  severity          AuditSeverity?
  outcome           AuditOutcome?
  actorType         AuditActorType? @map("actor_type")
  /// Snapshots at the time of the action (names and roles change later).
  actorName         String?         @map("actor_name")
  actorRole         String?         @map("actor_role")
  sessionId         String?         @map("session_id")
  /// How the actor signed in, e.g. "password", "password_totp", "api_key". Never a credential.
  authMethod        String?         @map("auth_method")
  /// The target's display label at the time, e.g. a firm's or a user's name.
  targetLabel       String?         @map("target_label")
  /// The user acted on, when not the actor. No foreign key: the history outlives the login.
  subjectUserId     String?         @map("subject_user_id") @db.Uuid
  /// The firm a platform row is about (a firm's own row may only name itself). No foreign key:
  /// the history outlives the firm.
  subjectBusinessId String?         @map("subject_business_id") @db.Uuid
  /// A bulk operation's parent event, or the event a response action answers.
  parentEventId     String?         @map("parent_event_id") @db.Uuid
  riskScore         Int?            @map("risk_score") @db.SmallInt
  ruleId            String?         @map("rule_id")
  /// What detected it, e.g. "rules_engine", "sign_in".
  detectionSource   String?         @map("detection_source")
  /// A bulk operation's item count.
  itemCount         Int?            @map("item_count")

  // Restrict: a business delete must never turn its audit rows into platform rows.
  business           Business?                @relation(fields: [businessId], references: [id], onDelete: Restrict)
  /// R0 stage B4
  parentEvent        AuditLog?                @relation("AuditLogParent", fields: [parentEventId], references: [id], onDelete: SetNull)
  childEvents        AuditLog[]               @relation("AuditLogParent")
  securityAlerts     SecurityAlert[]
  investigationNotes AuditInvestigationNote[]

  @@index([businessId, createdAt])
  // R37: a record's history (an intake's, a document's, a return's) and a settings page's changes.
  @@index([businessId, entityType, entityId, createdAt])
  // R0 stage B4: the cross-firm dashboard, related events and an alert chain.
  @@index([createdAt])
  @@index([category, createdAt])
  @@index([severity, createdAt])
  @@index([actorUserId, createdAt])
  @@index([subjectBusinessId, createdAt])
  @@index([sessionId])
  @@index([parentEventId])
  @@map("audit_logs")
}

// ---------- R0 stage B4: Super Admin Audit & Security ----------
// One trail: audit_logs gains the normalized event fields above (all optional, so every existing
// writer keeps working). Alerts, investigation notes and the security policy are platform data:
// only the Super Admin team and the platform's jobs reach them. Contract note:
// docs/work/R0-stage-b4-audit.md.

enum AuditCategory {
  AUTHENTICATION
  AUTHORIZATION
  DATA
  INTEGRATION
  SECURITY
  SYSTEM
}

/// Info: routine success. Low: minor signal. Medium: suspicious or privileged. High: probable risk
/// or a major privilege change. Critical: confirmed or immediate threat.
enum AuditSeverity {
  INFO
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum AuditOutcome {
  SUCCESS
  FAILURE
  DENIED
}

/// Who acted: a firm's staff member, a firm's client, a Super Admin team member, an integration or
/// API key, the platform itself (jobs, rules), or someone not signed in (a failed sign-in).
enum AuditActorType {
  STAFF
  CLIENT
  PLATFORM
  SERVICE
  SYSTEM
  ANONYMOUS
}

enum SecurityAlertStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
  DISMISSED
}

/// A rule matched an audit event. Raised once per `eventKey` (a second raise finds the first).
/// The content is fixed; only the status (OPEN -> ACKNOWLEDGED -> RESOLVED or DISMISSED, or
/// straight to a final state), the assignee and the closing note change. The database stamps who
/// acknowledged and who closed it, and when.
model SecurityAlert {
  id                   String              @id @default(uuid(7)) @db.Uuid
  /// The event that raised it.
  auditLogId           String              @map("audit_log_id") @db.Uuid
  /// The firm it is about, if any: the event's firm or the firm a platform event is about. The
  /// alert is deleted with that firm's data.
  businessId           String?             @map("business_id") @db.Uuid
  /// The rule that raised it, e.g. "login.failed_burst".
  ruleId               String              @map("rule_id")
  severity             AuditSeverity
  title                String
  /// Why it was raised and why this severity. Safe text only: never secrets or document contents.
  summary              String?
  riskScore            Int?                @map("risk_score") @db.SmallInt
  eventKey             String              @unique @map("event_key")
  status               SecurityAlertStatus @default(OPEN)
  assignedToUserId     String?             @map("assigned_to_user_id") @db.Uuid
  acknowledgedAt       DateTime?           @map("acknowledged_at") @db.Timestamptz(3)
  acknowledgedByUserId String?             @map("acknowledged_by_user_id") @db.Uuid
  /// Set when the alert is resolved or dismissed.
  closedAt             DateTime?           @map("closed_at") @db.Timestamptz(3)
  closedByUserId       String?             @map("closed_by_user_id") @db.Uuid
  resolutionNote       String?             @map("resolution_note")
  createdAt            DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)

  auditLog AuditLog       @relation(fields: [auditLogId], references: [id], onDelete: Cascade)
  business Business?      @relation(fields: [businessId], references: [id], onDelete: Restrict)
  assignee PlatformAdmin? @relation("SecurityAlertAssignee", fields: [assignedToUserId], references: [userId], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([severity, createdAt])
  @@index([auditLogId])
  @@index([businessId, createdAt])
  @@index([assignedToUserId, status])
  @@map("security_alerts")
}

/// A team member's investigation note on an audit event. Additive: a note's text never changes.
/// An edit is a new note that supersedes the earlier one (by the same author, at most once); a
/// delete retracts the note (the text stays for the record). The API writes an audit row for each.
model AuditInvestigationNote {
  id               String    @id @default(uuid(7)) @db.Uuid
  auditLogId       String    @map("audit_log_id") @db.Uuid
  authorUserId     String    @map("author_user_id") @db.Uuid
  body             String
  supersedesNoteId String?   @unique @map("supersedes_note_id") @db.Uuid
  retractedAt      DateTime? @map("retracted_at") @db.Timestamptz(3)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  auditLog     AuditLog                @relation(fields: [auditLogId], references: [id], onDelete: Cascade)
  author       PlatformAdmin           @relation("AuditInvestigationNoteAuthor", fields: [authorUserId], references: [userId], onDelete: Restrict)
  supersedes   AuditInvestigationNote? @relation("AuditInvestigationNoteEdit", fields: [auditLogId, supersedesNoteId], references: [auditLogId, id], onDelete: Cascade)
  supersededBy AuditInvestigationNote? @relation("AuditInvestigationNoteEdit")

  @@unique([auditLogId, id])
  @@unique([auditLogId, supersedesNoteId])
  @@index([auditLogId, createdAt])
  @@map("audit_investigation_notes")
}

/// One row (id 1): the platform's security policy (Security Settings & Policies). Each section is
/// a JSON object whose shape the contract note fixes; the database checks the safety floors. Every
/// save adds 1 to `version` (the database does it): the API saves with `where: { id: 1, version }`,
/// so two admins never silently overwrite each other. The migration inserts the defaults.
model PlatformSecurityPolicy {
  id              Int      @id @default(1)
  version         Int      @default(1)
  mfa             Json     @default("{}")
  password        Json     @default("{}")
  session         Json     @default("{}")
  loginProtection Json     @default("{}") @map("login_protection")
  adminAccess     Json     @default("{}") @map("admin_access")
  apiIntegrations Json     @default("{}") @map("api_integrations")
  auditRetention  Json     @default("{}") @map("audit_retention")
  exportControls  Json     @default("{}") @map("export_controls")
  alertRouting    Json     @default("{}") @map("alert_routing")
  updatedByUserId String?  @map("updated_by_user_id") @db.Uuid
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("platform_security_policy")
}

/// A firm's application to join Firmivra. Platform data: only Super Admin sees it.
/// Full field list comes from Tumit's FIR-S0-T1; the complete form is kept in `data` until then.
model FirmApplication {
  id               String                @id @default(uuid(7)) @db.Uuid
  status           FirmApplicationStatus @default(PENDING_REVIEW)
  legalName        String                @map("legal_name")
  dbaName          String?               @map("dba_name")
  contactName      String                @map("contact_name")
  contactEmail     String                @map("contact_email")
  contactPhone     String?               @map("contact_phone")
  data             Json
  internalNotes    String?               @map("internal_notes")
  decisionReason   String?               @map("decision_reason")
  reviewedByUserId String?               @map("reviewed_by_user_id") @db.Uuid
  reviewedAt       DateTime?             @map("reviewed_at") @db.Timestamptz(3)
  businessId       String?               @unique @map("business_id") @db.Uuid
  /// The EIN's last 4 digits, the only part ever shown. The full EIN is never stored.
  einLast4         String?               @map("ein_last4")
  /// HMAC-SHA256 of the EIN with a server-side secret (32 bytes), for the duplicate check.
  einHash          Bytes?                @map("ein_hash")
  createdAt        DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)

  business           Business?                      @relation(fields: [businessId], references: [id])
  statusHistory      FirmApplicationStatusHistory[]
  /// R0 stage B5
  salesOpportunities SalesOpportunity[]

  @@index([status, createdAt])
  @@index([einHash])
  @@map("firm_applications")
}

/// One per firm: contact details, branding, modules and setup wizard progress.
model BusinessSettings {
  businessId          String    @id @map("business_id") @db.Uuid
  contactEmail        String?   @map("contact_email")
  contactPhone        String?   @map("contact_phone")
  website             String?
  addressLine1        String?   @map("address_line1")
  addressLine2        String?   @map("address_line2")
  city                String?
  state               String?
  postalCode          String?   @map("postal_code")
  country             String    @default("US")
  timezone            String    @default("America/New_York")
  /// S3 key under the firm's prefix.
  logoKey             String?   @map("logo_key")
  /// S3 key of the logo for light backgrounds (footer, portal, emails); `logo_key` is for dark ones.
  logoLightKey        String?   @map("logo_light_key")
  /// Sidebar bottom: the slogan (gold script) and the motto (small capitals), plain text, 80 characters at most.
  sidebarSlogan       String?   @map("sidebar_slogan")
  sidebarMotto        String?   @map("sidebar_motto")
  /// `#rrggbb`, themes the firm's client portal.
  brandColor          String?   @map("brand_color")
  /// Optional second colour (`#rrggbb`) for the portal; the API uses a default when empty.
  accentColor         String?   @map("accent_color")
  /// Module keys switched on for this firm (docs/SYSTEM-DESIGN.md, Modules & packs).
  enabledModules      String[]  @default([]) @map("enabled_modules")
  clientSignUpEnabled Boolean   @default(true) @map("client_sign_up_enabled")
  /// Setup wizard, client portal step: the portal's name (null: the firm's name), header and welcome text.
  portalName          String?   @map("portal_name")
  portalHeader        String?   @map("portal_header")
  welcomeMessage      String?   @map("welcome_message")
  /// Setup wizard steps done so far, e.g. { "profile": true }.
  setupProgress       Json      @default("{}") @map("setup_progress")
  setupCompletedAt    DateTime? @map("setup_completed_at") @db.Timestamptz(3)
  /// Setup Step 2, "Business Details". The DBA or display name is `businesses.name`.
  /// A code from the application's entity types (R4's ENTITY_TYPES; the API checks the list).
  entityType          String?   @map("entity_type")
  /// The firm's EIN, encrypted with the firm's KMS key (never plain), and its last 4 digits.
  einEnc              Bytes?    @map("ein_enc")
  einLast4            String?   @map("ein_last4")
  /// People at the firm, 1 to 10,000, as in the application.
  teamSize            Int?      @map("team_size")
  /// Codes from the application's services (R4's FIRM_SERVICES; the API checks the list), at most 20.
  services            String[]  @default([])
  description         String?
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  // R36 (Settings, r36_money_portal_rest): the Company Profile and Branding screens' fields. The primary
  // and accent colours, the logos, the slogan and motto, the portal text and the time zone are above.
  /// S3 keys under the firm's prefix (`tenant/<business_id>/`, CHECK).
  faviconKey          String?         @map("favicon_key")
  loginBackgroundKey  String?         @map("login_background_key")
  /// `#rrggbb` (CHECK); contrast is the API's rule.
  secondaryColor      String?         @map("secondary_color")
  backgroundColor     String?         @map("background_color")
  theme               BrandTheme      @default(LIGHT)
  sidebarStyle        SidebarStyle    @default(SOLID) @map("sidebar_style")
  sidebarPosition     SidebarPosition @default(LEFT) @map("sidebar_position")
  showLogoText        Boolean         @default(true) @map("show_logo_text")
  roundedCorners      Boolean         @default(true) @map("rounded_corners")
  /// Plain text, up to 200 characters; never styled like a password or MFA prompt.
  loginMessage        String?         @map("login_message")
  supportEmail        String?         @map("support_email")
  /// What the firm does ("Accounting & Tax Services"), up to 80 characters.
  industry            String?
  locale              String          @default("en-US")
  currency            String          @default("usd")
  dateFormat          DateFormat      @default(MDY) @map("date_format")
  /// Counts up on every publish, so two admins never overwrite each other silently.
  brandingVersion     Int             @default(1) @map("branding_version")
  brandingPublishedAt DateTime?       @map("branding_published_at") @db.Timestamptz(3)

  business Business @relation(fields: [businessId], references: [id])

  @@map("business_settings")
}

/// A published version of a firm's Terms or Privacy policy. Insert-only: clients accept one exact
/// version, so a change is a new version. The current one is the highest version.
model FirmLegalDocument {
  id                String            @id @default(uuid(7)) @db.Uuid
  businessId        String            @map("business_id") @db.Uuid
  kind              LegalDocumentKind
  version           Int
  /// Markdown.
  body              String
  publishedByUserId String            @map("published_by_user_id") @db.Uuid
  publishedAt       DateTime          @default(now()) @map("published_at") @db.Timestamptz(3)

  business          Business          @relation(fields: [businessId], references: [id])
  termsSignatures   IntakeSignature[] @relation("IntakeSignatureTerms")
  privacySignatures IntakeSignature[] @relation("IntakeSignaturePrivacy")
  acceptances       LegalAcceptance[]

  @@unique([businessId, kind, version])
  // Target of same-firm foreign keys (legal acceptances).
  @@unique([businessId, id])
  @@map("firm_legal_documents")
}

/// A firm-defined tax status ("Documents received", "Filed"). Archived, not deleted, once used.
model TaxStatus {
  id         String    @id @default(uuid(7)) @db.Uuid
  businessId String    @map("business_id") @db.Uuid
  name       String
  sortOrder  Int       @default(0) @map("sort_order")
  archivedAt DateTime? @map("archived_at") @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  business          Business                 @relation(fields: [businessId], references: [id])
  clientTaxStatuses ClientTaxStatus[]
  history           ClientTaxStatusHistory[]

  @@unique([businessId, name])
  @@unique([businessId, id])
  @@map("tax_statuses")
}

/// One-time activation link (7 days) for an INVITED membership (staff, or a new firm's owner) or
/// client account. Only the SHA-256 of the token is stored. Resend = revoke this one, add a new one.
/// The signed-out accept step finds it with db.forInvite(tokenHash), then works in business scope.
model Invite {
  id              String    @id @default(uuid(7)) @db.Uuid
  businessId      String    @map("business_id") @db.Uuid
  membershipId    String?   @map("membership_id") @db.Uuid
  clientAccountId String?   @map("client_account_id") @db.Uuid
  tokenHash       String    @unique @map("token_hash")
  /// The name and email the inviter typed (staff invites). The firm shows these until the
  /// person joins, never the person's user row.
  name            String?
  email           String?
  expiresAt       DateTime  @map("expires_at") @db.Timestamptz(3)
  /// Null when the platform invites a new firm's owner on approval.
  invitedByUserId String?   @map("invited_by_user_id") @db.Uuid
  acceptedAt      DateTime? @map("accepted_at") @db.Timestamptz(3)
  revokedAt       DateTime? @map("revoked_at") @db.Timestamptz(3)
  /// Set by the database: true for an invite inserted in platform scope with no inviting member
  /// (the owner's activation link from Firmivra). Never set or changed by a request.
  sentByPlatform  Boolean   @default(false) @map("sent_by_platform")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  business      Business             @relation(fields: [businessId], references: [id])
  platformCopy  PlatformOwnerInvite?
  // Same-firm foreign keys: FK checks skip RLS, so (business_id, id) stops a link to another firm's row.
  membership    Membership?          @relation(fields: [businessId, membershipId], references: [businessId, id], onDelete: Restrict)
  clientAccount ClientAccount?       @relation(fields: [businessId, clientAccountId], references: [businessId, id], onDelete: Restrict)

  @@index([businessId, membershipId])
  @@index([businessId, clientAccountId])
  @@map("invites")
}

/// A firm's client: a person or a business. Exists with or without a portal login (the firm can
/// add a client first and invite them later). Archived, never deleted: records are kept 7 years.
model Client {
  id             String            @id @default(uuid(7)) @db.Uuid
  businessId     String            @map("business_id") @db.Uuid
  accountType    ClientAccountType @default(INDIVIDUAL) @map("account_type")
  /// Name shown in lists and search: the person's full name or the business name.
  displayName    String            @map("display_name")
  email          String?
  phone          String?
  /// Staff member responsible for the client; must be a member of the same firm.
  assignedUserId String?           @map("assigned_user_id") @db.Uuid
  archivedAt     DateTime?         @map("archived_at") @db.Timestamptz(3)

  // R37 (Clients module): list filters, the 360 header and the dates the list sorts by.
  /// Shown as "CL-" + number: given by the database, per firm, from 10001, in order; never changes.
  clientNumber    Int             @default(0) @map("client_number")
  /// What the firm says about the relationship; separate from archiving (Inactive stays listed).
  status          ClientStatus    @default(NEW)
  priority        ClientPriority?
  /// Where the client came from: a code from the shared list the API checks (up to 50 characters).
  source          String?
  /// The campaign or detail, e.g. "Facebook Ad / Back Taxes" (up to 200).
  sourceDetail    String?         @map("source_detail")
  /// Client since: editable (clients brought over from before Firmivra); empty means the
  /// creation date. Not in the future.
  clientSince     DateTime?       @map("client_since") @db.Date
  /// The newest thing that happened for the client; set by the API, and the database only lets
  /// it move forward.
  lastActivityAt  DateTime?       @map("last_activity_at") @db.Timestamptz(3)
  /// Who made the last change; the status history row's author.
  updatedByUserId String?         @map("updated_by_user_id") @db.Uuid
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  business                       Business                        @relation(fields: [businessId], references: [id])
  assignedMember                 Membership?                     @relation(fields: [businessId, assignedUserId], references: [businessId, userId], onDelete: Restrict)
  profile                        ClientProfile?
  accounts                       ClientAccount[]
  taxStatuses                    ClientTaxStatus[]
  taxStatusHistory               ClientTaxStatusHistory[]
  engagements                    Engagement[]
  tasks                          Task[]
  notes                          Note[]
  appointments                   Appointment[]
  messageThreads                 MessageThread[]
  invoices                       Invoice[]
  taxReturns                     TaxReturn[]
  esignRequests                  EsignRequest[]
  esignBulkItems                 EsignBulkItem[]
  recurringInvoices              RecurringInvoice[]
  paymentMethods                 ClientPaymentMethod[]
  promotionRedemptions           PromotionRedemption[]
  outboundRecipients             OutboundMessageRecipient[]
  portalVisibility               PortalModuleVisibility[]
  portalLock                     ClientPortalLock?
  portalActivity                 ClientPortalActivity[]
  portalRecent                   PortalRecentClient[]
  taskSeries                     TaskSeries[]
  complianceDeadlines            ComplianceDeadline[]
  complianceApplicabilityRecords ComplianceApplicabilityRecord[]
  automationRuns                 AutomationRun[]
  taxPlans                       TaxPlan[]
  taxSavingsScenarios            TaxSavingsScenario[]
  taxOpportunities               TaxOpportunity[]

  // R39
  segmentMembers  CommunicationSegmentMember[]
  commConsents    CommunicationConsent[]
  commAudience    CommunicationAudienceEntry[]
  commRecipients  CommunicationRecipient[]
  payrollClients  PayrollClient[]
  advisoryRecords AdvisoryClient[]
  updatedBy       Membership?                  @relation("ClientUpdatedBy", fields: [businessId, updatedByUserId], references: [businessId, userId], onDelete: Restrict)
  tags            ClientTag[]
  statusHistory   ClientStatusHistory[]

  @@unique([businessId, id])
  @@unique([businessId, email])
  @@unique([businessId, clientNumber])
  @@index([businessId, displayName])
  @@index([businessId, assignedUserId])
  @@index([businessId, status])
  @@index([businessId, lastActivityAt(sort: Desc)])
  @@index([businessId, source])
  @@index([businessId, priority])
  @@map("clients")
}

/// A client's personal or business details, edited by the firm and by the client in the portal.
/// `*Enc` columns hold ciphertext made with the firm's KMS key, never plain values: the API
/// encrypts and decrypts. Fields not typed here yet (I01 list) go in customFields.
model ClientProfile {
  clientId               String         @id @map("client_id") @db.Uuid
  businessId             String         @map("business_id") @db.Uuid
  firstName              String?        @map("first_name")
  middleName             String?        @map("middle_name")
  lastName               String?        @map("last_name")
  preferredName          String?        @map("preferred_name")
  /// BUSINESS clients: legal name and entity type (LLC, S corp...).
  businessName           String?        @map("business_name")
  entityType             String?        @map("entity_type")
  dobEnc                 Bytes?         @map("dob_enc")
  ssnEnc                 Bytes?         @map("ssn_enc")
  /// Last 4 digits only, for display and matching.
  ssnLast4               String?        @map("ssn_last4")
  /// BUSINESS clients: the EIN, encrypted with the firm's key (field-encryption helper), never plain.
  einEnc                 Bytes?         @map("ein_enc")
  /// Last 4 digits only, for display.
  einLast4               String?        @map("ein_last4")
  addressLine1           String?        @map("address_line1")
  addressLine2           String?        @map("address_line2")
  city                   String?
  state                  String?
  postalCode             String?        @map("postal_code")
  country                String         @default("US")
  customFields           Json           @default("{}") @map("custom_fields")
  /// My Profile "Additional information" (the client may edit these; R10).
  preferredContactMethod ContactMethod? @map("preferred_contact_method")
  /// "How did you hear about us?"
  referralSource         String?        @map("referral_source")
  /// Anything else the client wants the firm to know. Not the client's private notes.
  additionalInfo         String?        @map("additional_info")
  // R37 (Clients module): the profile's county. Email and SMS consent live in communication_consents (R39).
  /// The client's county (the list's optional "City or County" filter).
  county                 String?
  createdAt              DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt              DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  client Client @relation(fields: [businessId, clientId], references: [businessId, id], onDelete: Restrict)

  @@unique([businessId, clientId])
  @@index([businessId, state])
  @@index([businessId, entityType])
  @@map("client_profiles")
}

/// A client's current tax status for one tax year. A trigger copies every change to
/// ClientTaxStatusHistory. The tax status must be one of the firm's own and not archived.
model ClientTaxStatus {
  id              String   @id @default(uuid(7)) @db.Uuid
  businessId      String   @map("business_id") @db.Uuid
  clientId        String   @map("client_id") @db.Uuid
  taxYear         Int      @map("tax_year")
  taxStatusId     String   @map("tax_status_id") @db.Uuid
  /// Shown to the client in the portal. Internal remarks do not belong here.
  clientNote      String?  @map("client_note")
  updatedByUserId String?  @map("updated_by_user_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  client    Client    @relation(fields: [businessId, clientId], references: [businessId, id], onDelete: Restrict)
  taxStatus TaxStatus @relation(fields: [businessId, taxStatusId], references: [businessId, id], onDelete: Restrict)

  @@unique([businessId, clientId, taxYear])
  @@index([businessId, taxStatusId])
  @@map("client_tax_statuses")
}

/// Append-only: one row per change of a client's tax status, written by the trigger on
/// client_tax_statuses. Read it for the history view; do not insert into it directly.
model ClientTaxStatusHistory {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  businessId      String   @map("business_id") @db.Uuid
  clientId        String   @map("client_id") @db.Uuid
  taxYear         Int      @map("tax_year")
  taxStatusId     String   @map("tax_status_id") @db.Uuid
  clientNote      String?  @map("client_note")
  changedByUserId String?  @map("changed_by_user_id") @db.Uuid
  /// The time of the change itself (not of its transaction's start).
  changedAt       DateTime @default(dbgenerated("clock_timestamp()")) @map("changed_at") @db.Timestamptz(3)
  /// The order the rows were written in: the newest is the year's current state.
  seq             BigInt   @default(autoincrement())

  client    Client    @relation(fields: [businessId, clientId], references: [businessId, id], onDelete: Restrict)
  taxStatus TaxStatus @relation(fields: [businessId, taxStatusId], references: [businessId, id], onDelete: Restrict)

  @@index([businessId, clientId, taxYear, seq])
  @@map("client_tax_status_history")
}

/// A service the firm offers (its catalog). Archived, not deleted, once engagements use it.
model Service {
  id              String          @id @default(uuid(7)) @db.Uuid
  businessId      String          @map("business_id") @db.Uuid
  kind            ServiceKind
  name            String
  description     String?
  /// Default for new engagements; anything but ONE_TIME is a recurring service.
  billingInterval BillingInterval @default(ONE_TIME) @map("billing_interval")
  /// Package names offered, e.g. Starter, Growth, Premium for Bookkeeping.
  packages        String[]        @default([])
  /// The firm's workflow steps for this service, in order. An engagement's stage is one of them.
  stages          String[]        @default([])
  sortOrder       Int             @default(0) @map("sort_order")
  /// Offered on the firm's Begin Online pages. At most one live (not archived) Begin Online
  /// service per kind in a firm, never OTHER (SQL only: Prisma ignores partial unique indexes).
  beginOnline     Boolean         @default(false) @map("begin_online")
  archivedAt      DateTime?       @map("archived_at") @db.Timestamptz(3)
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  // R36 (Services and Pricing, r36_service_catalog): the catalog screens' fields. `description` is
  // the short description; a service made before R36 is ACTIVE with a custom quote.
  categoryId             String?             @map("category_id") @db.Uuid
  status                 ServiceStatus       @default(ACTIVE)
  pricingType            ServicePricingType  @default(CUSTOM_QUOTE) @map("pricing_type")
  basePriceCents         Int?                @map("base_price_cents")
  /// RECURRING needs one other than ONE_TIME; `billing_interval` stays the engagement default.
  billingFrequency       BillingFrequency?   @map("billing_frequency")
  taxable                Boolean             @default(false)
  requiresClientApproval Boolean             @default(false) @map("requires_client_approval")
  /// Client-facing, sanitized by the API, up to 1000 characters.
  fullDescription        String?             @map("full_description")
  /// A design-system icon name, never a URL.
  iconKey                String?             @map("icon_key")
  /// Staff only, up to 500 characters; never on a client page or an invoice.
  internalNotes          String?             @map("internal_notes")
  /// Shown to clients (portal and website) when ACTIVE; staff permission is separate.
  clientVisible          Boolean             @default(false) @map("client_visible")
  /// ADDITIVE: the line items add up to the price; INFORMATIONAL: they only describe what the base price covers.
  lineItemMode           ServiceLineItemMode @default(INFORMATIONAL) @map("line_item_mode")
  updatedByUserId        String?             @map("updated_by_user_id") @db.Uuid

  business         Business               @relation(fields: [businessId], references: [id])
  engagements      Engagement[]
  intakeForms      IntakeForm[]
  agreements       FirmAgreement[]
  leads            Lead[]
  invoiceLines     InvoiceLine[]
  recurringLines   RecurringInvoiceLine[]
  category         ServiceCategory?       @relation(fields: [businessId, categoryId], references: [businessId, id], onDelete: Restrict)
  updatedBy        Membership?            @relation("ServiceUpdatedBy", fields: [businessId, updatedByUserId], references: [businessId, userId], onDelete: Restrict)
  inclusions       ServiceInclusion[]
  lineItems        ServiceLineItem[]
  addOns           ServiceAddOn[]
  linkedAddOns     ServiceAddOn[]         @relation("ServiceAddOnLinked")
  packageItems     ServicePackageItem[]
  promotionTargets PromotionTarget[]
  tasks            Task[]
  taskTemplates    TaskTemplate[]
  taskSeries       TaskSeries[]

  // R39
  advisoryServices AdvisoryWorkstream[]
  leadServices     LeadService[]
  intakeTemplates  IntakeTemplate[]
  appointments     Appointment[]
  appointmentTypes AppointmentType[]

  @@unique([businessId, name])
  @@unique([businessId, id])
  @@index([businessId, status])
  @@index([businessId, categoryId])
  @@map("services")
}

/// One service for one period for one client, e.g. "2025 Personal Tax". Never deleted.
/// status is the lifecycle; stage is the firm's workflow step. A trigger keeps the lifecycle
/// rules and writes EngagementStatusHistory. Recurring = billingInterval other than ONE_TIME.
model Engagement {
  id                  String           @id @default(uuid(7)) @db.Uuid
  businessId          String           @map("business_id") @db.Uuid
  clientId            String           @map("client_id") @db.Uuid
  serviceId           String           @map("service_id") @db.Uuid
  title               String
  taxYear             Int?             @map("tax_year")
  periodStart         DateTime?        @map("period_start") @db.Date
  periodEnd           DateTime?        @map("period_end") @db.Date
  package             String?
  status              EngagementStatus @default(ACTIVE)
  /// One of the service's stages.
  stage               String?
  billingInterval     BillingInterval  @default(ONE_TIME) @map("billing_interval")
  nextBillingOn       DateTime?        @map("next_billing_on") @db.Date
  assignedUserId      String?          @map("assigned_user_id") @db.Uuid
  completedAt         DateTime?        @map("completed_at") @db.Timestamptz(3)
  /// Recurring services: the client's request, at least 14 days before nextBillingOn.
  cancelRequestedAt   DateTime?        @map("cancel_requested_at") @db.Timestamptz(3)
  /// The client's own words when asking to cancel (portal); only with cancelRequestedAt.
  cancelRequestReason String?          @map("cancel_request_reason")
  /// The client keeps document access for 60 days after this and can reactivate within 90.
  cancelledAt         DateTime?        @map("cancelled_at") @db.Timestamptz(3)
  cancellationReason  String?          @map("cancellation_reason")
  updatedByUserId     String?          @map("updated_by_user_id") @db.Uuid
  createdAt           DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  client                 Client                    @relation(fields: [businessId, clientId], references: [businessId, id], onDelete: Restrict)
  service                Service                   @relation(fields: [businessId, serviceId], references: [businessId, id], onDelete: Restrict)
  assignedMember         Membership?               @relation(fields: [businessId, assignedUserId], references: [businessId, userId], onDelete: Restrict)
  statusHistory          EngagementStatusHistory[]
  tasks                  Task[]
  notes                  Note[]
  reports                EngagementReport[]
  documents              Document[]
  documentRequests       DocumentRequest[]
  documentRequestPackets DocumentRequestPacket[]
  intakes                Intake[]
  leads                  Lead[]
  appointments           Appointment[]
  messageThreads         MessageThread[]
  invoices               Invoice[]
  taxReturns             TaxReturn[]
  esignRequests          EsignRequest[]
  esignBulkItems         EsignBulkItem[]
  recurringInvoices      RecurringInvoice[]
  taskSeries             TaskSeries[]
  complianceDeadlines    ComplianceDeadline[]
  bookkeepingProfile     BookkeepingProfile?
  bookkeepingActivities  BookkeepingActivity[]
  bookkeepingConnections BookkeepingConnection[]
  bookkeepingAccounts    BookkeepingAccount[]
  bookkeepingPeriods     BookkeepingPeriod[]
  bookkeepingReports     BookkeepingReport[]
  taxPlans               TaxPlan[]

  // R39
  payrollClient  PayrollClient?
  advisoryClient AdvisoryClient?

  @@unique([businessId, id])
  // Lets tasks and notes require that their engagement belongs to their client.
  @@unique([businessId, clientId, id])
  @@index([businessId, status, assignedUserId])
  @@index([businessId, serviceId])
  @@map("engagements")
}

/// Append-only: one row per change of an engagement's status or stage, written by the trigger
/// on engagements (the status tracker). Do not insert into it directly.
model EngagementStatusHistory {
  id              String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  businessId      String           @map("business_id") @db.Uuid
  engagementId    String           @map("engagement_id") @db.Uuid
  status          EngagementStatus
  stage           String?
  changedByUserId String?          @map("changed_by_user_id") @db.Uuid
  changedAt       DateTime         @default(now()) @map("changed_at") @db.Timestamptz(3)

  engagement Engagement @relation(fields: [businessId, engagementId], references: [businessId, id], onDelete: Restrict)

  @@index([businessId, engagementId, changedAt])
  @@map("engagement_status_history")
}

/// Firm-side to-do for a client, optionally within one of that client's engagements (client
/// record Tasks tab, service workspaces). Never shown to the client.
model Task {
  id              String     @id @default(uuid(7)) @db.Uuid
  businessId      String     @map("business_id") @db.Uuid
  clientId        String     @map("client_id") @db.Uuid
  engagementId    String?    @map("engagement_id") @db.Uuid
  title           String
  details         String?
  kind            TaskKind   @default(GENERAL)
  status          TaskStatus @default(OPEN)
  dueOn           DateTime?  @map("due_on") @db.Date
  assignedUserId  String?    @map("assigned_user_id") @db.Uuid
  completedAt     DateTime?  @map("completed_at") @db.Timestamptz(3)
  createdByUserId String?    @map("created_by_user_id") @db.Uuid
  createdAt       DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  // R38 (Tasks module): the columns below belong to the Tasks screens (see the R38 section).
  priority          TaskPriority @default(MEDIUM)
  progress          TaskProgress @default(PENDING)
  typeId            String?      @map("type_id") @db.Uuid
  /// The firm's service this work belongs to (Services & Pricing), optional.
  serviceId         String?      @map("service_id") @db.Uuid
  startOn           DateTime?    @map("start_on") @db.Date
  /// Time of day the task is due, in the firm's timezone; only with dueOn, never with allDay.
  dueTime           DateTime?    @map("due_time") @db.Time(0)
  allDay            Boolean      @default(true) @map("all_day")
  /// The client's portal shows the task (approved fields only) while this is true.
  clientVisible     Boolean      @default(false) @map("client_visible")
  /// Staff only, never shown to the client.
  internalNotes     String?      @map("internal_notes")
  /// Why the task is BLOCKED; its prerequisite (dependsOnTaskId) is the other reason.
  blockedReason     String?      @map("blocked_reason")
  /// The one task that must be completed first. The database refuses a cycle.
  dependsOnTaskId   String?      @map("depends_on_task_id") @db.Uuid
  completedByUserId String?      @map("completed_by_user_id") @db.Uuid
  archivedAt        DateTime?    @map("archived_at") @db.Timestamptz(3)
  /// The compliance deadline this task works on (the deadline stays the source of truth).
  deadlineId        String?      @map("deadline_id") @db.Uuid
  /// The template the task was made from; with deadlineId at most one task per pair (SQL only).
  templateId        String?      @map("template_id") @db.Uuid

  client             Client              @relation(fields: [businessId, clientId], references: [businessId, id], onDelete: Restrict)
  engagement         Engagement?         @relation(fields: [businessId, clientId, engagementId], references: [businessId, clientId, id], onDelete: Restrict)
  assignedMember     Membership?         @relation(fields: [businessId, assignedUserId], references: [businessId, userId], onDelete: Restrict)
  type               TaskType?           @relation(fields: [businessId, typeId], references: [businessId, id], onDelete: Restrict)
  service            Service?            @relation(fields: [businessId, serviceId], references: [businessId, id], onDelete: Restrict)
  dependsOn          Task?               @relation("TaskDependency", fields: [businessId, dependsOnTaskId], references: [businessId, id], onDelete: Restrict)
  dependents         Task[]              @relation("TaskDependency")
  assignees          TaskAssignee[]
  taskChecklistItems TaskChecklistItem[]
  taskReminders      TaskReminder[]
  taskAttachments    TaskAttachment[]
  taskOccurrence     TaskOccurrence?
  deadline           ComplianceDeadline? @relation(fields: [businessId, deadlineId], references: [businessId, id], onDelete: Restrict)
  template           TaskTemplate?       @relation(fields: [businessId, templateId], references: [businessId, id], onDelete: Restrict)

  @@unique([businessId, id])
  @@index([businessId, clientId])
  @@index([businessId, engagementId])
  @@index([businessId, assignedUserId, status])
  @@index([businessId, status, dueOn])
  @@index([businessId, dependsOnTaskId])
  @@index([businessId, deadlineId])
  @@map("tasks")
}

/// Internal note about a client, optionally within one of that client's engagements (client
/// record Internal notes tab, service workspaces). Never shown to the client.
model Note {
  id           String   @id @default(uuid(7)) @db.Uuid
  businessId   String   @map("business_id") @db.Uuid
  clientId     String   @map("client_id") @db.Uuid
  engagementId String?  @map("engagement_id") @db.Uuid
  body         String
  authorUserId String   @map("author_user_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  client     Client      @relation(fields: [businessId, clientId], references: [businessId, id], onDelete: Restrict)
  engagement Engagement? @relation(fields: [businessId, clientId, engagementId], references: [businessId, clientId, id], onDelete: Restrict)

  @@index([businessId, clientId, createdAt])
  @@index([businessId, engagementId])
  @@map("notes")
}

/// A service workspace report: bookkeeping report or reconciliation, tax planning estimate or
/// projection. Figures go in `data`; documentId is the attached file, from the same engagement.
/// The client sees it while PUBLISHED. It can be unpublished, but a report that was ever
/// published (firstPublishedAt set) is never deleted.
model EngagementReport {
  id               String       @id @default(uuid(7)) @db.Uuid
  businessId       String       @map("business_id") @db.Uuid
  engagementId     String       @map("engagement_id") @db.Uuid
  documentId       String?      @map("document_id") @db.Uuid
  kind             ReportKind
  title            String
  /// e.g. "March 2026", "Q1 2026", "2026 plan".
  periodLabel      String?      @map("period_label")
  status           ReportStatus @default(DRAFT)
  data             Json         @default("{}")
  publishedAt      DateTime?    @map("published_at") @db.Timestamptz(3)
  /// Set by the database when the report is first published; never changed or cleared.
  firstPublishedAt DateTime?    @map("first_published_at") @db.Timestamptz(3)
  createdByUserId  String?      @map("created_by_user_id") @db.Uuid
  createdAt        DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  engagement        Engagement         @relation(fields: [businessId, engagementId], references: [businessId, id], onDelete: Restrict)
  document          Document?          @relation(fields: [businessId, engagementId, documentId], references: [businessId, engagementId, id], onDelete: Restrict)
  bookkeepingReport BookkeepingReport?

  @@index([businessId, engagementId, status])
  @@map("engagement_reports")
}

/// A firm-defined document category (W-2 and 1099, ID, Payroll...). retentionYears sets how long
/// its documents are kept; null keeps them for good (formation papers). Archived, not deleted,
/// once used.
model DocumentCategory {
  id             String    @id @default(uuid(7)) @db.Uuid
  businessId     String    @map("business_id") @db.Uuid
  name           String
  retentionYears Int?      @default(7) @map("retention_years")
  sortOrder      Int       @default(0) @map("sort_order")
  archivedAt     DateTime? @map("archived_at") @db.Timestamptz(3)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  business             Business                      @relation(fields: [businessId], references: [id])
  documents            Document[]
  requests             DocumentRequest[]
  requestTemplateItems DocumentRequestTemplateItem[]

  @@unique([businessId, name])
  @@unique([businessId, id])
  @@map("document_categories")
}

/// A file in the firm's vault, always within one engagement. The file is in S3 under the firm's
/// prefix (`tenant/<business_id>/...`, under a UUID name) and its key never changes; it starts in
/// quarantine (PENDING) and only a CLEAN file can be downloaded. INTERNAL documents are never
/// shown to the client. Database rules: a client file (an upload or a carried-over Begin Online
/// file) goes only into an ACTIVE engagement; the scan result is set once; retentionUntil only
/// moves later; a document is deleted only without a legal hold, and either after
/// retentionUntil or, for a client upload, while its engagement is ACTIVE (and its intake open).
model Document {
  id               String            @id @default(uuid(7)) @db.Uuid
  businessId       String            @map("business_id") @db.Uuid
  clientId         String            @map("client_id") @db.Uuid
  engagementId     String            @map("engagement_id") @db.Uuid
  categoryId       String?           @map("category_id") @db.Uuid
  /// The request this upload answers, from the same engagement.
  requestId        String?           @map("request_id") @db.Uuid
  /// Set when the document was carried over from a Begin Online upload at lead conversion: it
  /// then shares that upload's S3 key, file and scan result (checked by the database).
  leadUploadId     String?           @map("lead_upload_id") @db.Uuid
  /// A client file in an intake's upload slot (intakeSlot is the field's key). Both are set on
  /// insert, for an intake of the same engagement that is open for changes (or, carried over,
  /// for the intake of the upload's lead and its slot). The file leaves the intake (both cleared,
  /// or deleted before retentionUntil) only while the intake is open: a submit detaches hidden
  /// slots' files before it changes the status. Nothing else changes them.
  intakeId         String?           @map("intake_id") @db.Uuid
  intakeSlot       String?           @map("intake_slot")
  direction        DocumentDirection
  /// The uploader's file name, for display only.
  fileName         String            @map("file_name")
  contentType      String            @map("content_type")
  sizeBytes        Int               @map("size_bytes")
  /// SHA-256 of the file, hex.
  sha256           String
  s3Key            String            @unique @map("s3_key")
  scanStatus       ScanStatus        @default(PENDING) @map("scan_status")
  scannedAt        DateTime?         @map("scanned_at") @db.Timestamptz(3)
  taxYear          Int?              @map("tax_year")
  /// Set at upload from the category's retention; it can only move later. Null keeps the
  /// document for good and never becomes a date.
  retentionUntil   DateTime?         @map("retention_until") @db.Date
  legalHold        Boolean           @default(false) @map("legal_hold")
  uploadedByUserId String?           @map("uploaded_by_user_id") @db.Uuid
  /// Firm Sign's filed copy (the final PDF or the certificate) of this completed request: the one
  /// kind of document that starts CLEAN (the scan exception), set on insert only.
  esignRequestId   String?           @map("esign_request_id") @db.Uuid
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  esignRequest                EsignRequest?                @relation("EsignFiledDocuments", fields: [businessId, esignRequestId], references: [businessId, id], onDelete: Restrict)
  esignFinalOf                EsignRequest?                @relation("EsignFinalDocument")
  esignCertificateOf          EsignRequest?                @relation("EsignCertificateDocument")
  engagement                  Engagement                   @relation(fields: [businessId, clientId, engagementId], references: [businessId, clientId, id], onDelete: Restrict)
  category                    DocumentCategory?            @relation(fields: [businessId, categoryId], references: [businessId, id], onDelete: Restrict)
  request                     DocumentRequest?             @relation(fields: [businessId, engagementId, requestId], references: [businessId, engagementId, id], onDelete: Restrict)
  leadUpload                  LeadUpload?                  @relation(fields: [businessId, leadUploadId], references: [businessId, id], onDelete: Restrict)
  intake                      Intake?                      @relation(fields: [businessId, intakeId], references: [businessId, id], onDelete: Restrict)
  reports                     EngagementReport[]
  messageAttachments          MessageAttachment[]
  invoiceAttachments          InvoiceAttachment[]
  taxReturns                  TaxReturn[]
  taskAttachments             TaskAttachment[]
  complianceDeadlineDocuments ComplianceDeadlineDocument[]
  bookkeepingReconciliations  BookkeepingReconciliation[]
  taxPlanDocuments            TaxPlanDocument[]
  // R37 (Documents module): folder, details, review, validity, versions, archive and trash.
  /// Organisation only, never access. A FIRM folder takes no client-visible document.
  folderId                    String?                      @map("folder_id") @db.Uuid
  /// One line, up to 500 characters.
  description                 String?
  /// Up to 20, each 1 to 40 characters, none twice (ignoring case).
  tags                        String[]                     @default([])
  /// Null: no review needed. VERIFIED and COMPLETED carry who and when (CHECK).
  reviewStatus                DocumentReviewStatus?        @map("review_status")
  reviewerUserId              String?                      @map("reviewer_user_id") @db.Uuid
  reviewedAt                  DateTime?                    @map("reviewed_at") @db.Timestamptz(3)
  reviewedByUserId            String?                      @map("reviewed_by_user_id") @db.Uuid
  /// When the document itself stops being valid (a license, an ID). Not retention: nothing is
  /// deleted by it.
  expiresOn                   DateTime?                    @map("expires_on") @db.Date
  /// The upload's "Notify client" choice, kept for the moment the scan result arrives.
  notifyClient                Boolean                      @default(false) @map("notify_client")
  // R37: versions. A replacement of this document has the same client, engagement and
  // direction and is numbered after it (a chain); set on insert only. The old one is marked
  // superseded by the database once the replacement is CLEAN.
  replacesId                  String?                      @map("replaces_id") @db.Uuid
  versionNo                   Int                          @default(1) @map("version_no")
  supersededAt                DateTime?                    @map("superseded_at") @db.Timestamptz(3)
  archivedAt                  DateTime?                    @map("archived_at") @db.Timestamptz(3)
  /// Reversible; the purge stays under the retention and legal-hold delete rules.
  trashedAt                   DateTime?                    @map("trashed_at") @db.Timestamptz(3)
  folder                      DocumentFolder?              @relation(fields: [businessId, folderId], references: [businessId, id], onDelete: Restrict)
  reviewer                    Membership?                  @relation("DocumentReviewer", fields: [businessId, reviewerUserId], references: [businessId, userId], onDelete: Restrict)
  reviewedBy                  Membership?                  @relation("DocumentReviewedBy", fields: [businessId, reviewedByUserId], references: [businessId, userId], onDelete: Restrict)
  documentShares              DocumentShare[]
  taxReturnApprovals          TaxReturnApproval[]
  taxReturnAuthorizations     TaxReturnAuthorization[]
  taxReturnDocuments          TaxReturnDocument[]

  // Target of message attachments.
  @@unique([businessId, id])
  // One document per carried-over lead upload.
  @@unique([businessId, leadUploadId])
  // Lets reports require that their document belongs to the same engagement.
  @@unique([businessId, engagementId, id])
  @@unique([businessId, replacesId])
  // R37: the firm-wide library, its filters and the duplicate warning.
  @@index([businessId, clientId, createdAt])
  @@index([businessId, requestId])
  @@index([businessId, intakeId])
  @@index([businessId, esignRequestId])
  @@index([businessId, createdAt])
  @@index([businessId, folderId])
  @@index([businessId, reviewStatus])
  @@index([businessId, reviewerUserId])
  @@index([businessId, categoryId])
  @@index([businessId, clientId, sha256])
  @@index([businessId, expiresOn])
  @@map("documents")
}

/// The firm asks the client for a document within an engagement ("W-2 from your employer", with
/// a due date). The client uploads (SUBMITTED) or says "I don't have this" (NOT_AVAILABLE, with
/// a reason); the firm accepts it or marks it missing (REJECTED). Cancelled, never deleted.
model DocumentRequest {
  id                String                @id @default(uuid(7)) @db.Uuid
  businessId        String                @map("business_id") @db.Uuid
  clientId          String                @map("client_id") @db.Uuid
  engagementId      String                @map("engagement_id") @db.Uuid
  categoryId        String?               @map("category_id") @db.Uuid
  title             String
  /// Shown to the client.
  instructions      String?
  dueOn             DateTime?             @map("due_on") @db.Date
  status            DocumentRequestStatus @default(REQUESTED)
  /// Shown to the client and the firm: the client's reason for NOT_AVAILABLE, or the firm's for REJECTED.
  statusNote        String?               @map("status_note")
  requestedByUserId String?               @map("requested_by_user_id") @db.Uuid
  resolvedAt        DateTime?             @map("resolved_at") @db.Timestamptz(3)
  createdAt         DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)

  // R37: a row is one checklist item. Items of a request (packet) are edited while it is a DRAFT.
  /// The request this item belongs to; null for a single request made on its own.
  packetId  String? @map("packet_id") @db.Uuid
  /// Optional items do not count toward "x of y required received".
  required  Boolean @default(true)
  sortOrder Int     @default(0) @map("sort_order")

  engagement Engagement             @relation(fields: [businessId, clientId, engagementId], references: [businessId, clientId, id], onDelete: Restrict)
  category   DocumentCategory?      @relation(fields: [businessId, categoryId], references: [businessId, id], onDelete: Restrict)
  packet     DocumentRequestPacket? @relation(fields: [businessId, engagementId, packetId], references: [businessId, engagementId, id], onDelete: Restrict)
  documents  Document[]

  // Lets documents require that the request they answer belongs to the same engagement.
  @@unique([businessId, engagementId, id])
  @@index([businessId, clientId, status])
  @@index([businessId, packetId, sortOrder])
  @@map("document_requests")
}

/// A versioned intake form for one of the firm's services (the form engine's definition:
/// steps, conditional and repeating fields, quarterly grids, upload slots, agreement). Once
/// PUBLISHED a version never changes; it can only be RETIRED. Only drafts can be deleted.
model IntakeForm {
  id              String           @id @default(uuid(7)) @db.Uuid
  businessId      String           @map("business_id") @db.Uuid
  serviceId       String           @map("service_id") @db.Uuid
  version         Int
  title           String
  /// The form engine's definition (I06 sets the shape).
  definition      Json             @default("{}")
  /// Deprecated (r0_intake_agreements): no longer written. The agreement the client signs now
  /// comes from FirmAgreement. Kept until after delivery because the published-form rule reads it.
  agreementText   String?          @map("agreement_text")
  status          IntakeFormStatus @default(DRAFT)
  publishedAt     DateTime?        @map("published_at") @db.Timestamptz(3)
  createdByUserId String?          @map("created_by_user_id") @db.Uuid
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  /// R37: the template (the firm's reusable form) this is a version of. The database fills it
  /// with the service's default template when an insert leaves it empty; it never changes
  /// after the first publish.
  templateId String? @map("template_id") @db.Uuid

  service  Service         @relation(fields: [businessId, serviceId], references: [businessId, id], onDelete: Restrict)
  template IntakeTemplate? @relation(fields: [businessId, templateId, serviceId], references: [businessId, id, serviceId], onDelete: Restrict)
  intakes  Intake[]

  // R37: versions are numbered per template (a service can have several templates).
  @@unique([businessId, templateId, version])
  @@unique([businessId, id])
  @@map("intake_forms")
}

/// One intake to fill in with one published form: for an engagement (portal) or for a lead
/// (Begin Online). At lead conversion it gets its engagement, once; its lead never changes.
model Intake {
  id              String       @id @default(uuid(7)) @db.Uuid
  businessId      String       @map("business_id") @db.Uuid
  formId          String       @map("form_id") @db.Uuid
  engagementId    String?      @map("engagement_id") @db.Uuid
  leadId          String?      @map("lead_id") @db.Uuid
  status          IntakeStatus @default(SENT)
  dueOn           DateTime?    @map("due_on") @db.Date
  createdByUserId String?      @map("created_by_user_id") @db.Uuid
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  /// The firm's request for changes: set exactly while the status is NEEDS_CORRECTION (the API
  /// clears it with the status change that ends it). Up to 2,000 characters, not only blanks,
  /// line breaks allowed, no other control, filler or invisible characters.
  correctionNote        String?   @map("correction_note")
  /// Set by the database (its clock) whenever correctionNote is set or changed; cleared with it.
  correctionRequestedAt DateTime? @map("correction_requested_at") @db.Timestamptz(3)

  // R37 (Intake Forms module): send setup, dates, assignee, secure link for leads.
  /// First send, set by the database when the intake leaves DRAFT; a resend never changes it.
  sentAt               DateTime?       @map("sent_at") @db.Timestamptz(3)
  /// After sentAt, and not before dueOn. The API extends it; a sweep sets EXPIRED from it.
  expiresAt            DateTime?       @map("expires_at") @db.Timestamptz(3)
  assignedUserId       String?         @map("assigned_user_id") @db.Uuid
  deliveryChannel      IntakeDelivery? @map("delivery_channel")
  /// Up to 200 characters. Names the email subject; no email copy is stored.
  messageSubject       String?         @map("message_subject")
  /// Up to 500 characters.
  messageBody          String?         @map("message_body")
  remindersEnabled     Boolean         @default(true) @map("reminders_enabled")
  allowSaveResume      Boolean         @default(true) @map("allow_save_resume")
  /// Moved forward by the database on every change of the row (the API also sets it on opens).
  lastActivityAt       DateTime        @default(now()) @map("last_activity_at") @db.Timestamptz(3)
  /// Set by the database while the status is COMPLETED, cleared when it leaves COMPLETED.
  completedAt          DateTime?       @map("completed_at") @db.Timestamptz(3)
  completedByUserId    String?         @map("completed_by_user_id") @db.Uuid
  /// Lead recipients only: SHA-256 of the secure link's token, with its expiry (both or neither).
  accessTokenHash      String?         @unique @map("access_token_hash")
  accessTokenExpiresAt DateTime?       @map("access_token_expires_at") @db.Timestamptz(3)
  /// "Auto-generate submission ID": a per-firm number the database gives when the firm's
  /// intake settings turn it on.
  referenceNumber      Int?            @map("reference_number")

  assignedMember Membership?        @relation("IntakeAssignedTo", fields: [businessId, assignedUserId], references: [businessId, userId], onDelete: Restrict)
  completedBy    Membership?        @relation("IntakeCompletedBy", fields: [businessId, completedByUserId], references: [businessId, userId], onDelete: Restrict)
  form           IntakeForm         @relation(fields: [businessId, formId], references: [businessId, id], onDelete: Restrict)
  engagement     Engagement?        @relation(fields: [businessId, engagementId], references: [businessId, id], onDelete: Restrict)
  lead           Lead?              @relation(fields: [businessId, leadId], references: [businessId, id], onDelete: Restrict)
  signatures     IntakeSignature[]
  submissions    IntakeSubmission[]
  documents      Document[]

  @@unique([businessId, id])
  @@unique([businessId, referenceNumber])
  @@index([businessId, engagementId])
  @@index([businessId, leadId])
  @@index([businessId, status, sentAt])
  @@index([businessId, assignedUserId, status])
  @@index([businessId, formId])
  @@index([businessId, lastActivityAt])
  @@map("intakes")
}

/// One version of an intake's answers. The draft is edited by autosave; submitting locks it
/// for good. Unlocking (owner or admin) or "needs correction" starts the next version as a new
/// draft. The signature is the agreement record: who, when, from which IP and browser.
model IntakeSubmission {
  id                String    @id @default(uuid(7)) @db.Uuid
  businessId        String    @map("business_id") @db.Uuid
  intakeId          String    @map("intake_id") @db.Uuid
  version           Int
  answers           Json      @default("{}")
  /// The steps saved at least once (step keys, at most 10, none twice): the stepper's ticks.
  /// Locked with the rest of the version on submit.
  savedSteps        String[]  @default([]) @map("saved_steps")
  submittedAt       DateTime? @map("submitted_at") @db.Timestamptz(3)
  /// Null for Begin Online (no login).
  submittedByUserId String?   @map("submitted_by_user_id") @db.Uuid
  signerName        String?   @map("signer_name")
  signedAt          DateTime? @map("signed_at") @db.Timestamptz(3)
  signerIp          String?   @map("signer_ip") @db.Inet
  signerUserAgent   String?   @map("signer_user_agent")
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  intake    Intake           @relation(fields: [businessId, intakeId], references: [businessId, id], onDelete: Restrict)
  signature IntakeSignature?

  @@unique([businessId, intakeId, version])
  // Target of same-firm foreign keys (intake signatures).
  @@unique([businessId, id])
  @@map("intake_submissions")
}

/// A Begin Online visitor's request for a service, from the firm's public site (no login, no
/// account). Holds the intake and uploads until staff review it; converting sets the client
/// and the new engagement once (that engagement belongs to that client and is ACTIVE then).
/// The resume link stores only the token's SHA-256 and lasts at most 30 days. createdAt is the
/// database's clock; neither the draft nor its link outlives createdAt + 90 days.
model Lead {
  id                      String          @id @default(uuid(7)) @db.Uuid
  businessId              String          @map("business_id") @db.Uuid
  serviceId               String          @map("service_id") @db.Uuid
  status                  LeadStatus      @default(DRAFT)
  firstName               String          @map("first_name")
  lastName                String          @map("last_name")
  email                   String
  phone                   String?
  /// The year the firm prepares (2000 to 2100), fixed at the draft's start: set once, while a
  /// draft, then never changed.
  taxYear                 Int?            @map("tax_year")
  /// When the draft runs out. Required while DRAFT (on insert the database fills 30 days from
  /// now); a renewal is at most 30 days from then; kept as the lead leaves DRAFT, and frozen.
  /// An expired draft is not renewed and only becomes EXPIRED; no lead goes back to DRAFT.
  draftExpiresAt          DateTime?       @map("draft_expires_at") @db.Timestamptz(3)
  resumeTokenHash         String?         @unique @map("resume_token_hash")
  resumeExpiresAt         DateTime?       @map("resume_expires_at") @db.Timestamptz(3)
  submittedAt             DateTime?       @map("submitted_at") @db.Timestamptz(3)
  clientId                String?         @map("client_id") @db.Uuid
  engagementId            String?         @map("engagement_id") @db.Uuid
  reviewedByUserId        String?         @map("reviewed_by_user_id") @db.Uuid
  reviewedAt              DateTime?       @map("reviewed_at") @db.Timestamptz(3)
  declineReason           String?         @map("decline_reason")
  // R37 (Leads module): the list, profile and convert screens.
  /// Shown as "LD-" + number: given by the database, per firm, from 10001, in order; never changes.
  number                  Int             @default(0)
  businessName            String?         @map("business_name")
  addressLine1            String?         @map("address_line1")
  addressLine2            String?         @map("address_line2")
  city                    String?
  state                   String?
  postalCode              String?         @map("postal_code")
  preferredContactMethods ContactMethod[] @default([]) @map("preferred_contact_methods")
  /// "Evenings (after 5 PM)": free text, up to 100 characters.
  bestTimeToContact       String?         @map("best_time_to_contact")
  source                  LeadSource      @default(OTHER)
  /// The campaign or landing page ("Back Taxes Campaign"), up to 200 characters.
  sourceDetail            String?         @map("source_detail")
  priority                LeadPriority?
  assignedUserId          String?         @map("assigned_user_id") @db.Uuid
  /// The next follow-up: type and time together, with an optional note; none once the lead is
  /// closed (converted, declined, lost or expired).
  nextActionType          LeadActionType? @map("next_action_type")
  nextActionAt            DateTime?       @map("next_action_at") @db.Timestamptz(3)
  nextActionNote          String?         @map("next_action_note")
  /// Hidden from lists, never deleted.
  archivedAt              DateTime?       @map("archived_at") @db.Timestamptz(3)
  archivedByUserId        String?         @map("archived_by_user_id") @db.Uuid
  /// Who made the last change; the activity row's author.
  updatedByUserId         String?         @map("updated_by_user_id") @db.Uuid
  createdAt               DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt               DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  service            Service                    @relation(fields: [businessId, serviceId], references: [businessId, id], onDelete: Restrict)
  engagement         Engagement?                @relation(fields: [businessId, clientId, engagementId], references: [businessId, clientId, id], onDelete: Restrict)
  intakes            Intake[]
  signatures         IntakeSignature[]
  uploads            LeadUpload[]
  outboundRecipients OutboundMessageRecipient[]

  // R39
  segmentMembers CommunicationSegmentMember[]
  commConsents   CommunicationConsent[]
  commAudience   CommunicationAudienceEntry[]
  commRecipients CommunicationRecipient[]
  assignedMember Membership?                  @relation("LeadAssignedTo", fields: [businessId, assignedUserId], references: [businessId, userId], onDelete: Restrict)
  archivedBy     Membership?                  @relation("LeadArchivedBy", fields: [businessId, archivedByUserId], references: [businessId, userId], onDelete: Restrict)
  updatedBy      Membership?                  @relation("LeadUpdatedBy", fields: [businessId, updatedByUserId], references: [businessId, userId], onDelete: Restrict)
  services       LeadService[]
  tags           LeadTag[]
  activities     LeadActivity[]

  @@unique([businessId, id])
  @@unique([businessId, number])
  @@index([businessId, status, createdAt])
  @@index([businessId, email])
  @@index([businessId, assignedUserId, status])
  @@index([businessId, source])
  @@index([businessId, nextActionAt])
  @@index([businessId, createdAt])
  @@map("leads")
}

/// A file uploaded during Begin Online, before the lead has an engagement. Same rules as a
/// document: under `tenant/<business_id>/`, at most 10 MB, starts unscanned, scan result set
/// once, file fixed. Added only while the lead is a DRAFT. At conversion it becomes a Document
/// with the same S3 key (Document.leadUploadId), so the object is never moved.
model LeadUpload {
  id          String     @id @default(uuid(7)) @db.Uuid
  businessId  String     @map("business_id") @db.Uuid
  leadId      String     @map("lead_id") @db.Uuid
  /// The form's upload slot this file answers.
  slot        String
  fileName    String     @map("file_name")
  contentType String     @map("content_type")
  sizeBytes   Int        @map("size_bytes")
  /// SHA-256 of the file, hex.
  sha256      String
  s3Key       String     @unique @map("s3_key")
  scanStatus  ScanStatus @default(PENDING) @map("scan_status")
  scannedAt   DateTime?  @map("scanned_at") @db.Timestamptz(3)
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  lead     Lead      @relation(fields: [businessId, leadId], references: [businessId, id], onDelete: Restrict)
  document Document?

  @@unique([businessId, id])
  @@index([businessId, leadId])
  @@map("lead_uploads")
}

/// One notification for one person in one firm (the bell and the Notification Center). It
/// always names the record it opens. The payload holds only safe values for the text (a due
/// date, a count), never SSNs, amounts, document content or message text. The recipient must
/// be a member or client account of the firm. After insert only readAt changes; never deleted.
model Notification {
  id              String               @id @default(uuid(7)) @db.Uuid
  businessId      String               @map("business_id") @db.Uuid
  recipientUserId String               @map("recipient_user_id") @db.Uuid
  category        NotificationCategory
  /// Event key, e.g. "document_request.created".
  type            String
  /// The record the notification opens, e.g. "document_request" and its id.
  entityType      String               @map("entity_type")
  entityId        String               @map("entity_id") @db.Uuid
  payload         Json                 @default("{}")
  /// The producer's stable key, so a retried job never creates a second bell item (unique per
  /// recipient when set).
  eventKey        String?              @map("event_key")
  readAt          DateTime?            @map("read_at") @db.Timestamptz(3)
  createdAt       DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)

  business   Business               @relation(fields: [businessId], references: [id])
  deliveries NotificationDelivery[]

  @@unique([businessId, id])
  @@unique([businessId, recipientUserId, eventKey])
  @@index([businessId, recipientUserId, createdAt])
  @@map("notifications")
}

/// The email or SMS copy of a notification: an outbox for the sender (R6). One row per
/// notification and channel. No address and no content are stored: the sender looks them up
/// when it sends. QUEUED -> SENT, FAILED (retried back to QUEUED) or SKIPPED; SENT and SKIPPED
/// are final.
model NotificationDelivery {
  id                String          @id @default(uuid(7)) @db.Uuid
  businessId        String          @map("business_id") @db.Uuid
  notificationId    String          @map("notification_id") @db.Uuid
  channel           DeliveryChannel
  status            DeliveryStatus  @default(QUEUED)
  attempts          Int             @default(0)
  /// The provider's message id (SES or SNS), for support and bounce handling.
  providerMessageId String?         @map("provider_message_id")
  /// A short error code from the provider, never message content.
  lastError         String?         @map("last_error")
  sentAt            DateTime?       @map("sent_at") @db.Timestamptz(3)
  createdAt         DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  notification Notification @relation(fields: [businessId, notificationId], references: [businessId, id], onDelete: Restrict)

  @@unique([businessId, notificationId, channel])
  @@index([businessId, status, createdAt])
  @@map("notification_deliveries")
}

/// A person's email and SMS choice for one category in one firm. No row means the defaults
/// (email on, SMS off). The bell is always on, and ACCOUNT notices cannot be switched off.
model NotificationPreference {
  id         String               @id @default(uuid(7)) @db.Uuid
  businessId String               @map("business_id") @db.Uuid
  userId     String               @map("user_id") @db.Uuid
  category   NotificationCategory
  email      Boolean              @default(true)
  sms        Boolean              @default(false)
  createdAt  DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)

  business Business @relation(fields: [businessId], references: [id])

  @@unique([businessId, userId, category])
  @@map("notification_preferences")
}

/// A kind of appointment the firm offers ("Tax consultation", 30 minutes, video). Clients can
/// book only types marked clientBookable. Archived, not deleted, once used.
model AppointmentType {
  id              String       @id @default(uuid(7)) @db.Uuid
  businessId      String       @map("business_id") @db.Uuid
  name            String
  durationMinutes Int          @map("duration_minutes")
  locationKind    LocationKind @default(VIDEO) @map("location_kind")
  clientBookable  Boolean      @default(false) @map("client_bookable")
  sortOrder       Int          @default(0) @map("sort_order")
  archivedAt      DateTime?    @map("archived_at") @db.Timestamptz(3)
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  /// Clients reschedule or cancel until this many hours before the start (0 to 720; 0 = until
  /// the start).
  cancelCutoffHours Int @default(24) @map("cancel_cutoff_hours")

  // R37: shown in Manage Appointment Types.
  /// Up to 500 characters.
  description         String?
  /// The service this type is for (optional).
  serviceId           String?        @map("service_id") @db.Uuid
  /// The default colour of its appointments.
  color               CalendarColor?
  /// Reminders new appointments of this type start with: [{ channel, offsetMinutes }], at most 10.
  /// Minutes kept free before and after (0 to 240); copied onto each appointment.
  bufferBeforeMinutes Int            @default(0) @map("buffer_before_minutes")
  bufferAfterMinutes  Int            @default(0) @map("buffer_after_minutes")
  /// Clients book at least this long ahead (minutes, up to 30 days) and at most this far (days).
  minNoticeMinutes    Int            @default(0) @map("min_notice_minutes")
  maxAdvanceDays      Int?           @map("max_advance_days")
  reminderDefaults    Json           @default("[]") @map("reminder_defaults")

  service      Service?      @relation(fields: [businessId, serviceId], references: [businessId, id], onDelete: Restrict)
  business     Business      @relation(fields: [businessId], references: [id])
  appointments Appointment[]

  @@unique([businessId, name])
  @@unique([businessId, id])
  @@map("appointment_types")
}

/// A staff member's regular working hours: one row per range, several a day allowed (a lunch
/// break). Times of day in the firm's timezone (business_settings.timezone); weekday 0 = Sunday.
model WorkingHours {
  id         String   @id @default(uuid(7)) @db.Uuid
  businessId String   @map("business_id") @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  weekday    Int
  startsAt   DateTime @map("starts_at") @db.Time(0)
  endsAt     DateTime @map("ends_at") @db.Time(0)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  member Membership @relation(fields: [businessId, userId], references: [businessId, userId], onDelete: Restrict)

  @@index([businessId, userId, weekday])
  @@map("working_hours")
}

/// Time a staff member is not available (holiday, training), or the whole firm when userId is
/// null. An appointment cannot overlap it.
model BlockedTime {
  id              String          @id @default(uuid(7)) @db.Uuid
  businessId      String          @map("business_id") @db.Uuid
  userId          String?         @map("user_id") @db.Uuid
  startsAt        DateTime        @map("starts_at") @db.Timestamptz(3)
  endsAt          DateTime        @map("ends_at") @db.Timestamptz(3)
  /// Internal; never shown to clients.
  reason          String?
  createdByUserId String?         @map("created_by_user_id") @db.Uuid
  /// Time off is shown apart from other blocked time.
  kind            BlockedTimeKind @default(BLOCKED)
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  member Membership? @relation(fields: [businessId, userId], references: [businessId, userId], onDelete: Restrict)

  @@index([businessId, userId, startsAt])
  @@map("blocked_times")
}

/// One meeting between a staff member and a client; staff and client booking write the same
/// record. The database blocks double booking (no two overlapping live appointments for the
/// same staff member, or for the same client) and overlap with blocked time. A reschedule
/// updates the times in place; the database counts it. Cancelled is final; never deleted.
model Appointment {
  id              String            @id @default(uuid(7)) @db.Uuid
  businessId      String            @map("business_id") @db.Uuid
  clientId        String            @map("client_id") @db.Uuid
  engagementId    String?           @map("engagement_id") @db.Uuid
  staffUserId     String            @map("staff_user_id") @db.Uuid
  typeId          String?           @map("type_id") @db.Uuid
  startsAt        DateTime          @map("starts_at") @db.Timestamptz(3)
  endsAt          DateTime          @map("ends_at") @db.Timestamptz(3)
  status          AppointmentStatus @default(SCHEDULED)
  locationKind    LocationKind      @map("location_kind")
  /// The address, phone number or video link.
  locationDetails String?           @map("location_details")
  bookedByUserId  String?           @map("booked_by_user_id") @db.Uuid
  /// True when the client booked it in the portal.
  bookedByClient  Boolean           @default(false) @map("booked_by_client")
  /// Set by the database when the times change.
  rescheduledAt   DateTime?         @map("rescheduled_at") @db.Timestamptz(3)
  rescheduleCount Int               @default(0) @map("reschedule_count")
  /// Set when the reminder went out; the database clears it on a reschedule, so the new time
  /// gets its own reminder.
  reminderSentAt  DateTime?         @map("reminder_sent_at") @db.Timestamptz(3)
  cancelledAt     DateTime?         @map("cancelled_at") @db.Timestamptz(3)
  cancelReason    String?           @map("cancel_reason")
  createdAt       DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  // R37 (Appointments module): the related service, notes, colour, confirmation and booking key.
  // Internal meetings and leads' appointments (client optional) wait for the API: see the PR.
  /// The related service (the screens' Service column).
  serviceId           String?        @map("service_id") @db.Uuid
  /// An IANA name; empty means the firm's time zone (business_settings.timezone).
  timeZone            String?        @map("time_zone")
  /// A day-long entry: may run past 12 hours (up to 25, for a daylight saving day).
  allDay              Boolean        @default(false) @map("all_day")
  /// Empty means the type's colour. A token name; the screens map it to packages/ui.
  color               CalendarColor?
  /// Staff only, never shown to clients, never in notices or the audit log. Up to 5,000.
  internalNotes       String?        @map("internal_notes")
  /// Shown to the client in the portal and in notices. Up to 2,000.
  clientInstructions  String?        @map("client_instructions")
  /// Empty while SCHEDULED means "Pending"; set means "Confirmed".
  confirmedAt         DateTime?      @map("confirmed_at") @db.Timestamptz(3)
  /// A retry of the same booking returns the first one; unique per firm.
  idempotencyKey      String?        @map("idempotency_key") @db.Uuid
  /// Where in the firm (in-person appointments only), and the room, which cannot be double booked.
  officeId            String?        @map("office_id") @db.Uuid
  roomId              String?        @map("room_id") @db.Uuid
  /// One of a repeating series; every occurrence is a normal appointment of its own.
  seriesId            String?        @map("series_id") @db.Uuid
  /// Minutes kept free around it for the staff member (copied from the type when booked).
  bufferBeforeMinutes Int            @default(0) @map("buffer_before_minutes")
  bufferAfterMinutes  Int            @default(0) @map("buffer_after_minutes")

  client     Client                @relation(fields: [businessId, clientId], references: [businessId, id], onDelete: Restrict)
  engagement Engagement?           @relation(fields: [businessId, clientId, engagementId], references: [businessId, clientId, id], onDelete: Restrict)
  staff      Membership            @relation(fields: [businessId, staffUserId], references: [businessId, userId], onDelete: Restrict)
  service    Service?              @relation(fields: [businessId, serviceId], references: [businessId, id], onDelete: Restrict)
  office     FirmOffice?           @relation(fields: [businessId, officeId], references: [businessId, id], onDelete: Restrict)
  room       FirmRoom?             @relation(fields: [businessId, officeId, roomId], references: [businessId, officeId, id], onDelete: Restrict)
  reminders  AppointmentReminder[]
  series     AppointmentSeries?    @relation(fields: [businessId, seriesId], references: [businessId, id], onDelete: Restrict)
  type       AppointmentType?      @relation(fields: [businessId, typeId], references: [businessId, id], onDelete: Restrict)

  @@unique([businessId, idempotencyKey])
  // Target of the reminders' same-firm foreign key.
  @@unique([businessId, id])
  @@index([businessId, seriesId])
  @@index([businessId, staffUserId, startsAt])
  @@index([businessId, clientId, startsAt])
  @@index([businessId, startsAt])
  @@map("appointments")
}

/// A subject thread between the firm and one client, optionally about one of that client's
/// engagements and linked to a related record. Never deleted.
model MessageThread {
  id              String    @id @default(uuid(7)) @db.Uuid
  businessId      String    @map("business_id") @db.Uuid
  clientId        String    @map("client_id") @db.Uuid
  engagementId    String?   @map("engagement_id") @db.Uuid
  subject         String
  /// The record the thread is about, e.g. "document_request" and its id.
  entityType      String?   @map("entity_type")
  entityId        String?   @map("entity_id") @db.Uuid
  /// When false, the client can read but not reply.
  repliesEnabled  Boolean   @default(true) @map("replies_enabled")
  /// Set by the database when a message is added.
  lastMessageAt   DateTime? @map("last_message_at") @db.Timestamptz(3)
  createdByUserId String?   @map("created_by_user_id") @db.Uuid
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  /// R36 (Messages, r36_message_workspace): the staff member who owns the thread, and when it was
  /// archived (out of the active inbox, history kept; null: active).
  assignedUserId String?   @map("assigned_user_id") @db.Uuid
  archivedAt     DateTime? @map("archived_at") @db.Timestamptz(3)

  client     Client              @relation(fields: [businessId, clientId], references: [businessId, id], onDelete: Restrict)
  engagement Engagement?         @relation(fields: [businessId, clientId, engagementId], references: [businessId, clientId, id], onDelete: Restrict)
  messages   Message[]
  assignedTo Membership?         @relation("MessageThreadAssignedTo", fields: [businessId, assignedUserId], references: [businessId, userId], onDelete: Restrict)
  mutes      MessageThreadMute[]
  tags       MessageThreadTag[]

  @@unique([businessId, id])
  @@index([businessId, clientId, lastMessageAt])
  @@index([businessId, assignedUserId])
  @@index([businessId, archivedAt])
  @@map("message_threads")
}

/// One message in a thread. The sender is a staff member (FIRM_TO_CLIENT) or a portal login
/// of the thread's own client (CLIENT_TO_FIRM). readAt is the receiving side's read state
/// (mark unread clears it). Otherwise never changed and never deleted.
model Message {
  id           String           @id @default(uuid(7)) @db.Uuid
  businessId   String           @map("business_id") @db.Uuid
  threadId     String           @map("thread_id") @db.Uuid
  senderUserId String           @map("sender_user_id") @db.Uuid
  direction    MessageDirection
  body         String
  readAt       DateTime?        @map("read_at") @db.Timestamptz(3)
  createdAt    DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)

  thread             MessageThread              @relation(fields: [businessId, threadId], references: [businessId, id], onDelete: Restrict)
  attachments        MessageAttachment[]
  outboundRecipients OutboundMessageRecipient[]

  @@unique([businessId, id])
  @@index([businessId, threadId, createdAt])
  @@map("messages")
}

/// A file attached to a message: always a document in the vault (scanned, retained), from an
/// engagement of the thread's client. Insert-only.
model MessageAttachment {
  id         String   @id @default(uuid(7)) @db.Uuid
  businessId String   @map("business_id") @db.Uuid
  messageId  String   @map("message_id") @db.Uuid
  documentId String   @map("document_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  message  Message  @relation(fields: [businessId, messageId], references: [businessId, id], onDelete: Restrict)
  document Document @relation(fields: [businessId, documentId], references: [businessId, id], onDelete: Restrict)

  @@unique([businessId, messageId, documentId])
  @@index([businessId, documentId])
  @@map("message_attachments")
}

/// A client's private notepad entry (Messages and Notes). Never shown to the firm: the database
/// shows it only to its own client login (db.forBusiness(businessId, { actorUserId })). Each
/// save adds a version; the latest is shown; text never changes and nothing is deleted.
model ClientPrivateNote {
  id         String   @id @default(uuid(7)) @db.Uuid
  businessId String   @map("business_id") @db.Uuid
  /// The client's portal login that owns the note.
  userId     String   @map("user_id") @db.Uuid
  body       String
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  owner    ClientAccount       @relation(fields: [businessId, userId], references: [businessId, userId], onDelete: Restrict)
  reminder ClientNoteReminder?

  @@unique([businessId, id])
  @@index([businessId, userId, createdAt])
  @@map("client_private_notes")
}

/// The optional reminder on a client's note, kept apart from the note so the reminder sender
/// can find due reminders without ever reading note text. Editable; deleting removes it.
model ClientNoteReminder {
  id         String    @id @default(uuid(7)) @db.Uuid
  businessId String    @map("business_id") @db.Uuid
  noteId     String    @map("note_id") @db.Uuid
  /// The note's owner, so the reminder can be sent without opening the note.
  userId     String    @map("user_id") @db.Uuid
  remindAt   DateTime  @map("remind_at") @db.Timestamptz(3)
  remindedAt DateTime? @map("reminded_at") @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  note ClientPrivateNote @relation(fields: [businessId, noteId], references: [businessId, id], onDelete: Restrict)

  @@unique([businessId, noteId])
  @@index([businessId, remindAt])
  @@map("client_note_reminders")
}

/// A firm's invoice to one client, optionally for one of that client's engagements. Money is in
/// integer cents. The database keeps the totals: subtotal is the sum of the lines and total is
/// subtotal minus discount. Lines change only while DRAFT or SCHEDULED. PAID needs the money Stripe
/// took (SUCCEEDED or REFUNDED payments: a refund never makes an invoice owed again) plus live (not
/// voided) offline payments covering the total, the database's app_invoice_paid_cents. PAID and
/// CANCELED are final, except that the database reopens a PAID invoice when voiding an offline
/// payment leaves it uncovered. An invoice holding money (live offline payments, or a SUCCEEDED
/// Stripe payment) cannot be canceled. Never deleted.
model Invoice {
  id              String        @id @default(uuid(7)) @db.Uuid
  businessId      String        @map("business_id") @db.Uuid
  clientId        String        @map("client_id") @db.Uuid
  engagementId    String?       @map("engagement_id") @db.Uuid
  /// Unique per firm, e.g. "INV-1001".
  number          String
  status          InvoiceStatus @default(DRAFT)
  currency        String        @default("usd")
  /// Kept by the database from the lines.
  subtotalCents   Int           @default(0) @map("subtotal_cents")
  discountCents   Int           @default(0) @map("discount_cents")
  /// Kept by the database: subtotal minus discount.
  totalCents      Int           @default(0) @map("total_cents")
  /// SCHEDULED invoices are issued on this date (Upcoming).
  scheduledFor    DateTime?     @map("scheduled_for") @db.Date
  dueOn           DateTime?     @map("due_on") @db.Date
  issuedAt        DateTime?     @map("issued_at") @db.Timestamptz(3)
  paidAt          DateTime?     @map("paid_at") @db.Timestamptz(3)
  canceledAt      DateTime?     @map("canceled_at") @db.Timestamptz(3)
  cancelReason    String?       @map("cancel_reason")
  createdByUserId String?       @map("created_by_user_id") @db.Uuid
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  // R36 (Invoices and Payments, r36_invoice_core): see the marked section at the end of the file.
  /// The staff member responsible for the invoice.
  assignedUserId          String?                @map("assigned_user_id") @db.Uuid
  /// A code such as `net_14` or `due_on_receipt`; the firm's own terms are codes too.
  paymentTerms            String?                @map("payment_terms")
  /// PERCENT: `discount_percent` is what the firm typed and the API sets `discount_cents` from it.
  discountType            InvoiceDiscountType    @default(FIXED) @map("discount_type")
  discountPercent         Decimal?               @map("discount_percent") @db.Decimal(5, 2)
  /// Tax, kept by the database: the rate is copied from `tax_rate_id` while the invoice is a draft
  /// or scheduled, and tax is that rate on the taxable lines (after the discount's share).
  taxRateId               String?                @map("tax_rate_id") @db.Uuid
  taxRateBps              Int                    @default(0) @map("tax_rate_bps")
  taxableSubtotalCents    Int                    @default(0) @map("taxable_subtotal_cents")
  taxCents                Int                    @default(0) @map("tax_cents")
  /// Shown on the invoice to the client; firm only below it (never shown to the client).
  notesToClient           String?                @map("notes_to_client")
  internalNote            String?                @map("internal_note")
  templateId              String?                @map("template_id") @db.Uuid
  emailClient             Boolean                @default(true) @map("email_client")
  includeAttachments      Boolean                @default(true) @map("include_attachments")
  allowTip                Boolean                @default(false) @map("allow_tip")
  requirePaymentBeforeDue Boolean                @default(false) @map("require_payment_before_due")
  /// The methods the client may use on this invoice (MANUAL: the firm records it).
  paymentMethods          InvoicePaymentMethod[] @default([CARD, ACH, MANUAL]) @map("payment_methods")
  autopay                 Boolean                @default(false)
  /// R36: the recurring schedule that made this invoice and the period it covers (both or neither;
  /// one invoice per schedule and period, so a rerun of the job makes no second one).
  recurringInvoiceId      String?                @map("recurring_invoice_id") @db.Uuid
  recurringPeriodOn       DateTime?              @map("recurring_period_on") @db.Date

  client               Client                @relation(fields: [businessId, clientId], references: [businessId, id], onDelete: Restrict)
  engagement           Engagement?           @relation(fields: [businessId, clientId, engagementId], references: [businessId, clientId, id], onDelete: Restrict)
  createdBy            Membership?           @relation(fields: [businessId, createdByUserId], references: [businessId, userId], onDelete: Restrict)
  assignedTo           Membership?           @relation("InvoiceAssignedTo", fields: [businessId, assignedUserId], references: [businessId, userId], onDelete: Restrict)
  taxRate              InvoiceTaxRate?       @relation(fields: [businessId, taxRateId], references: [businessId, id], onDelete: Restrict)
  template             InvoiceTemplate?      @relation(fields: [businessId, templateId], references: [businessId, id], onDelete: Restrict)
  lines                InvoiceLine[]
  tracking             InvoiceTracking?
  attachments          InvoiceAttachment[]
  recurring            RecurringInvoice?     @relation(fields: [businessId, recurringInvoiceId], references: [businessId, id], onDelete: Restrict)
  events               InvoiceEvent[]
  payments             Payment[]
  offlinePayments      OfflinePayment[]
  promotionRedemptions PromotionRedemption[]

  @@unique([businessId, number])
  @@unique([businessId, id])
  @@index([businessId, clientId, status])
  @@index([businessId, status, dueOn])
  @@index([businessId, assignedUserId])
  @@index([businessId, recurringInvoiceId])
  @@map("invoices")
}

/// One line of an invoice: quantity (up to 2 decimals) times the unit amount, rounded to cents.
model InvoiceLine {
  id              String   @id @default(uuid(7)) @db.Uuid
  businessId      String   @map("business_id") @db.Uuid
  invoiceId       String   @map("invoice_id") @db.Uuid
  description     String
  quantity        Decimal  @default(1) @db.Decimal(10, 2)
  unitAmountCents Int      @map("unit_amount_cents")
  /// Set by the database: quantity times unit amount, rounded to cents.
  amountCents     Int      @default(0) @map("amount_cents")
  sortOrder       Int      @default(0) @map("sort_order")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  // R36: the catalog service the line came from (null: a custom one-time line), the name it had
  // then (a later rename or price change never rewrites an invoice) and its tax treatment.
  serviceId      String? @map("service_id") @db.Uuid
  itemName       String? @map("item_name")
  taxable        Boolean @default(false)
  /// The add-on of that service the line came from, if it did.
  serviceAddOnId String? @map("service_add_on_id") @db.Uuid

  invoice Invoice       @relation(fields: [businessId, invoiceId], references: [businessId, id], onDelete: Restrict)
  service Service?      @relation(fields: [businessId, serviceId], references: [businessId, id], onDelete: Restrict)
  addOn   ServiceAddOn? @relation(fields: [businessId, serviceAddOnId], references: [businessId, id], onDelete: Restrict)

  @@index([businessId, invoiceId])
  @@index([businessId, serviceId])
  @@index([businessId, serviceAddOnId])
  @@map("invoice_lines")
}

/// A payment toward an invoice through the processor (Stripe hosted checkout). It starts
/// PENDING, inserted when the checkout is created, for no more than the balance due; it becomes
/// SUCCEEDED or REFUNDED only after a recorded processor event names it, so money is confirmed
/// only by a verified webhook. Never deleted.
model Payment {
  id                  String           @id @default(uuid(7)) @db.Uuid
  businessId          String           @map("business_id") @db.Uuid
  invoiceId           String           @map("invoice_id") @db.Uuid
  amountCents         Int              @map("amount_cents")
  currency            String           @default("usd")
  status              PaymentStatus    @default(PENDING)
  processor           PaymentProcessor @default(STRIPE)
  /// The checkout session or payment intent id.
  processorRef        String           @map("processor_ref")
  /// The firm's Stripe connected account the checkout ran on (acct_...).
  accountId           String           @map("account_id")
  /// A short code from the processor when it failed.
  failureCode         String?          @map("failure_code")
  paidAt              DateTime?        @map("paid_at") @db.Timestamptz(3)
  refundedAt          DateTime?        @map("refunded_at") @db.Timestamptz(3)
  /// Kept by the database: the cents of this payment's refunds that are not FAILED. A guard so
  /// refunds never exceed the payment, even at the same moment; the refund rows stay the record.
  refundReservedCents Int              @default(0) @map("refund_reserved_cents")
  /// R36: how the client paid, from the processor once it is known (Payment Method column): the
  /// method type (`card`, `us_bank_account`), the card brand and the last 4 digits. Never more.
  methodType          String?          @map("method_type")
  cardBrand           String?          @map("card_brand")
  last4               String?
  /// A tip on top of the invoice (it is not part of the amount that pays the invoice).
  tipCents            Int              @default(0) @map("tip_cents")
  createdAt           DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  invoice       Invoice         @relation(fields: [businessId, invoiceId], references: [businessId, id], onDelete: Restrict)
  events        PaymentEvent[]
  refunds       PaymentRefund[]
  invoiceEvents InvoiceEvent[]

  @@unique([processor, processorRef])
  @@unique([businessId, id])
  @@index([businessId, invoiceId])
  @@map("payments")
}

/// A check or cash payment toward an invoice, recorded by an active Owner or Admin acting as
/// themselves, on an OPEN invoice with no open Stripe checkout, never above the balance due.
/// Separate from Payment (Stripe only). Fixed once recorded and never deleted: a mistake is voided
/// once, with a reason, through the database function app_void_offline_payment (never a plain
/// update), and a void that leaves a PAID invoice uncovered reopens it.
model OfflinePayment {
  id               String               @id @default(uuid(7)) @db.Uuid
  businessId       String               @map("business_id") @db.Uuid
  invoiceId        String               @map("invoice_id") @db.Uuid
  method           OfflinePaymentMethod
  amountCents      Int                  @map("amount_cents")
  /// Always the invoice's currency.
  currency         String               @default("usd")
  /// The check number (required for CHECK) or a cash receipt number: 1 to 20 letters, digits or
  /// hyphens. Never a bank account or routing number.
  reference        String?
  /// The day the firm received the money (the firm's calendar); never in the future.
  receivedOn       DateTime             @map("received_on") @db.Date
  /// Firm-only note, at most 500 characters.
  note             String?
  /// The record request's idempotency key (new per dialog, the same on a retry).
  idempotencyKey   String               @map("idempotency_key") @db.Uuid
  /// Always the acting person, an active Owner or Admin (checked by the database).
  recordedByUserId String               @map("recorded_by_user_id") @db.Uuid
  /// Set by the database (now()).
  recordedAt       DateTime             @default(now()) @map("recorded_at") @db.Timestamptz(3)
  /// The void: all three set together, once, by app_void_offline_payment(id, reason), acting as an
  /// active Owner or Admin. voidedAt is set by the database.
  voidedAt         DateTime?            @map("voided_at") @db.Timestamptz(3)
  voidedByUserId   String?              @map("voided_by_user_id") @db.Uuid
  voidReason       String?              @map("void_reason")
  updatedAt        DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)
  /// R36: where the money was deposited ("Deposit To"), one of the firm's accounts; fixed with the rest.
  depositAccountId String?              @map("deposit_account_id") @db.Uuid

  invoice        Invoice         @relation(fields: [businessId, invoiceId], references: [businessId, id], onDelete: Restrict)
  recordedBy     Membership      @relation("OfflinePaymentRecordedBy", fields: [businessId, recordedByUserId], references: [businessId, userId], onDelete: Restrict)
  voidedBy       Membership?     @relation("OfflinePaymentVoidedBy", fields: [businessId, voidedByUserId], references: [businessId, userId], onDelete: Restrict)
  depositAccount DepositAccount? @relation(fields: [businessId, depositAccountId], references: [businessId, id], onDelete: Restrict)
  invoiceEvents  InvoiceEvent[]

  @@unique([businessId, id])
  @@unique([businessId, idempotencyKey])
  @@index([businessId, invoiceId])
  @@map("offline_payments")
}

/// One processor webhook event, recorded before it is processed. The event id is unique, so a
/// duplicate delivery fails the insert and is skipped. Only the type is kept, not the payload.
model PaymentEvent {
  id               String           @id @default(uuid(7)) @db.Uuid
  businessId       String           @map("business_id") @db.Uuid
  processor        PaymentProcessor @default(STRIPE)
  processorEventId String           @map("processor_event_id")
  /// The Stripe connected account that sent the event (event.account); must be the firm's.
  accountId        String           @map("account_id")
  /// e.g. "checkout.session.completed".
  type             String
  paymentId        String?          @map("payment_id") @db.Uuid
  receivedAt       DateTime         @default(now()) @map("received_at") @db.Timestamptz(3)
  processedAt      DateTime?        @map("processed_at") @db.Timestamptz(3)

  payment Payment?        @relation(fields: [businessId, paymentId], references: [businessId, id], onDelete: Restrict)
  refunds PaymentRefund[]

  @@unique([processor, processorEventId])
  @@unique([businessId, id])
  @@index([businessId, paymentId])
  @@map("payment_events")
}

/// One Stripe refund of a payment (re_ id). The rows are the only record of refunds: a refund
/// counts once Stripe's charge.refunded event confirms it (SUCCEEDED, with that event), which also
/// records refunds a firm makes in its own Stripe dashboard. A payment's refunds never add up to
/// more than the payment; the database sets the payment REFUNDED when they cover all of it. The
/// invoice stays PAID. Never deleted.
model PaymentRefund {
  id                String              @id @default(uuid(7)) @db.Uuid
  businessId        String              @map("business_id") @db.Uuid
  paymentId         String              @map("payment_id") @db.Uuid
  processor         PaymentProcessor    @default(STRIPE)
  /// Stripe's refund id (re_...).
  processorRefundId String              @map("processor_refund_id")
  /// The payment's connected account (acct_...).
  accountId         String              @map("account_id")
  amountCents       Int                 @map("amount_cents")
  currency          String              @default("usd")
  status            PaymentRefundStatus @default(PENDING)
  /// The charge.refunded event that confirmed it.
  eventId           String?             @map("event_id") @db.Uuid
  refundedAt        DateTime?           @map("refunded_at") @db.Timestamptz(3)
  createdAt         DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)

  payment Payment       @relation(fields: [businessId, paymentId], references: [businessId, id], onDelete: Restrict)
  event   PaymentEvent? @relation(fields: [businessId, eventId], references: [businessId, id], onDelete: Restrict)

  @@unique([processor, processorRefundId])
  @@index([businessId, paymentId])
  @@map("payment_refunds")
}

/// A content editor record shown in the portal: a resource or tip (markdown body), or an
/// external link (https URL, opens in a new tab). Visible to clients once published.
model ContentItem {
  id              String      @id @default(uuid(7)) @db.Uuid
  businessId      String      @map("business_id") @db.Uuid
  kind            ContentKind
  /// Groups items on the page, e.g. "Business Startup Guide", "Payroll Resources".
  category        String?
  title           String
  body            String?
  url             String?
  description     String?
  /// External links: the icon shown on the card (a design-system icon name, never a URL).
  iconKey         String?     @map("icon_key")
  sortOrder       Int         @default(0) @map("sort_order")
  publishedAt     DateTime?   @map("published_at") @db.Timestamptz(3)
  createdByUserId String?     @map("created_by_user_id") @db.Uuid
  createdAt       DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  business  Business    @relation(fields: [businessId], references: [id])
  createdBy Membership? @relation(fields: [businessId, createdByUserId], references: [businessId, userId], onDelete: Restrict)

  @@index([businessId, kind, category, sortOrder])
  @@map("content_items")
}

/// A calculator the firm offers in the portal (Tax Return Calculator first). The calculation runs
/// in the browser from `config` (rates, brackets per tax year); results are never stored. Every
/// calculator shows its estimate disclaimer.
model CalculatorDefinition {
  id         String   @id @default(uuid(7)) @db.Uuid
  businessId String   @map("business_id") @db.Uuid
  /// e.g. "tax_return".
  key        String
  title      String
  config     Json     @default("{}")
  disclaimer String
  enabled    Boolean  @default(true)
  sortOrder  Int      @default(0) @map("sort_order")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  business Business @relation(fields: [businessId], references: [id])

  @@unique([businessId, key])
  @@map("calculator_definitions")
}

/// A firm's own Stripe connected account (Stripe Connect: Firmivra's account is the platform,
/// each firm is paid into its own account). One per firm; the account id never changes once
/// set. The firm sees and updates its own row; platform scope can read it so the webhook can
/// find which firm an account belongs to. Payments run only on this account, and webhook events
/// are accepted only from it.
model StripeAccount {
  id               String                 @id @default(uuid(7)) @db.Uuid
  businessId       String                 @unique @map("business_id") @db.Uuid
  /// acct_...
  accountId        String                 @unique @map("account_id")
  onboardingStatus StripeOnboardingStatus @default(PENDING) @map("onboarding_status")
  chargesEnabled   Boolean                @default(false) @map("charges_enabled")
  payoutsEnabled   Boolean                @default(false) @map("payouts_enabled")
  detailsSubmitted Boolean                @default(false) @map("details_submitted")
  createdAt        DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime               @updatedAt @map("updated_at") @db.Timestamptz(3)

  business Business @relation(fields: [businessId], references: [id])

  @@map("stripe_accounts")
}

/// Append-only: one row per status change of a firm application (and its submission), written by
/// a trigger on firm_applications. Platform data: admin and platform scope only.
model FirmApplicationStatusHistory {
  id              String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  applicationId   String                 @map("application_id") @db.Uuid
  fromStatus      FirmApplicationStatus? @map("from_status")
  toStatus        FirmApplicationStatus  @map("to_status")
  /// The reviewer, when a Super Admin made the change.
  changedByUserId String?                @map("changed_by_user_id") @db.Uuid
  /// The decision reason at the time (request for information, decline).
  reason          String?
  changedAt       DateTime               @default(now()) @map("changed_at") @db.Timestamptz(3)

  application FirmApplication @relation(fields: [applicationId], references: [id], onDelete: Restrict)

  @@index([applicationId, changedAt])
  @@map("firm_application_status_history")
}

/// A client's acceptance of one exact version of the firm's Terms or Privacy (portal sign-up
/// writes one row for each). Insert-only: an acceptance is never changed or deleted. The client
/// can see their own; the firm sees its clients'.
model LegalAcceptance {
  id              String   @id @default(uuid(7)) @db.Uuid
  businessId      String   @map("business_id") @db.Uuid
  /// The client's portal login at this firm.
  clientAccountId String   @map("client_account_id") @db.Uuid
  legalDocumentId String   @map("legal_document_id") @db.Uuid
  acceptedAt      DateTime @default(now()) @map("accepted_at") @db.Timestamptz(3)
  ip              String?  @db.Inet
  userAgent       String?  @map("user_agent")

  clientAccount ClientAccount     @relation(fields: [businessId, clientAccountId], references: [businessId, id], onDelete: Restrict)
  legalDocument FirmLegalDocument @relation(fields: [businessId, legalDocumentId], references: [businessId, id], onDelete: Restrict)

  @@unique([clientAccountId, legalDocumentId])
  @@index([businessId, clientAccountId])
  @@map("legal_acceptances")
}

/// Where a sign-up verification code was sent.
enum VerificationChannel {
  EMAIL
  PHONE
}

/// One code sent to a client during portal sign-up (R3), kept on the server so replaying an old
/// sign-up cookie cannot reset the attempts. Only the code's HMAC is stored. The database sets
/// `created_at` (its clock, for the resend gap) and keeps `expires_at` within 15 minutes. After
/// insert only `attempts` (+1 at a time) and `consumed_at` (once, only on the newest unexpired
/// code for that account and channel) change; a used code is final; nothing is deleted.
model VerificationCode {
  id              String              @id @default(uuid(7)) @db.Uuid
  businessId      String              @map("business_id") @db.Uuid
  clientAccountId String              @map("client_account_id") @db.Uuid
  channel         VerificationChannel
  /// The exact address the code went to: a lower-case email, or an E.164 phone number.
  target          String
  /// Hex HMAC-SHA256 of the code with a server key; never the code itself.
  codeHash        String              @map("code_hash")
  attempts        Int                 @default(0)
  expiresAt       DateTime            @map("expires_at") @db.Timestamptz(3)
  consumedAt      DateTime?           @map("consumed_at") @db.Timestamptz(3)
  createdAt       DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)

  clientAccount ClientAccount @relation(fields: [businessId, clientAccountId], references: [businessId, id], onDelete: Restrict)

  @@index([clientAccountId, channel, createdAt(sort: Desc)])
  @@map("verification_codes")
}

/// How a client prefers to be contacted (My Profile).
enum ContactMethod {
  EMAIL
  PHONE
  TEXT
}

/// Individual (1040) or business (1120, 1120-S, 1065...) return.
enum TaxFilingType {
  INDIVIDUAL
  BUSINESS
}

/// The status the client sees on a return (portal Taxes tab).
enum TaxReturnStatus {
  IN_PROGRESS
  FILED
  ACCEPTED
  REJECTED
  COMPLETED
}

/// A client's tax return for one year (portal Taxes tab, R10): annual, or one quarter's estimate.
/// Older years can exist without an engagement. The return PDF is one of the client's own
/// documents, never an INTERNAL one. Only a return that was never filed can be deleted.
model TaxReturn {
  id           String          @id @default(uuid(7)) @db.Uuid
  businessId   String          @map("business_id") @db.Uuid
  clientId     String          @map("client_id") @db.Uuid
  /// The engagement it was prepared in, if any (one of this client's).
  engagementId String?         @map("engagement_id") @db.Uuid
  taxYear      Int             @map("tax_year")
  filingType   TaxFilingType   @map("filing_type")
  /// 1 to 4 for a quarterly estimate; empty for the annual return.
  quarter      Int?
  /// The form, e.g. "1040" or "1120-S".
  formType     String?         @map("form_type")
  status       TaxReturnStatus @default(IN_PROGRESS)
  filedOn      DateTime?       @map("filed_on") @db.Date
  /// The return PDF the client can view and download.
  documentId   String?         @map("document_id") @db.Uuid
  /// Set by the database the first time the return leaves IN_PROGRESS; never changes. A return
  /// with it set is never deleted.
  firstFiledAt DateTime?       @map("first_filed_at") @db.Timestamptz(3)
  createdAt    DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  // R37 (Tax Returns module): the firm's workflow, people, dates and amendments. `status` stays
  // what the client sees and follows workflowStatus (the database keeps the two together).
  workflowStatus         TaxReturnWorkflowStatus @default(IN_PREPARATION) @map("workflow_status")
  /// Why the last move was made; required when a return moves back a step.
  statusReason           String?                 @map("status_reason")
  preparerUserId         String?                 @map("preparer_user_id") @db.Uuid
  reviewerUserId         String?                 @map("reviewer_user_id") @db.Uuid
  /// Individual returns only.
  filingStatus           TaxpayerFilingStatus?   @map("filing_status")
  /// The filing deadline (or the estimate's due date); an extension never moves it.
  dueOn                  DateTime?               @map("due_on") @db.Date
  /// The filed return this one amends (the same client's), with the reason.
  amendsReturnId         String?                 @map("amends_return_id") @db.Uuid
  amendReason            String?                 @map("amend_reason")
  /// Quarterly estimates only: the amount in cents, its status and when it was paid.
  estimateAmountCents    Int?                    @map("estimate_amount_cents")
  estimateStatus         TaxEstimateStatus?      @map("estimate_status")
  estimatePaidOn         DateTime?               @map("estimate_paid_on") @db.Date
  /// The manual final validation (there is no tax software here): when and by whom.
  finalValidatedAt       DateTime?               @map("final_validated_at") @db.Timestamptz(3)
  finalValidatedByUserId String?                 @map("final_validated_by_user_id") @db.Uuid
  importSource           String?                 @map("import_source")
  importedAt             DateTime?               @map("imported_at") @db.Timestamptz(3)
  /// Hidden from lists, never deleted.
  archivedAt             DateTime?               @map("archived_at") @db.Timestamptz(3)
  /// Who made the last change; the history row's author.
  updatedByUserId        String?                 @map("updated_by_user_id") @db.Uuid

  preparer       Membership?              @relation("TaxReturnPreparer", fields: [businessId, preparerUserId], references: [businessId, userId], onDelete: Restrict)
  reviewer       Membership?              @relation("TaxReturnReviewer", fields: [businessId, reviewerUserId], references: [businessId, userId], onDelete: Restrict)
  finalValidator Membership?              @relation("TaxReturnValidator", fields: [businessId, finalValidatedByUserId], references: [businessId, userId], onDelete: Restrict)
  updatedBy      Membership?              @relation("TaxReturnUpdatedBy", fields: [businessId, updatedByUserId], references: [businessId, userId], onDelete: Restrict)
  amends         TaxReturn?               @relation("TaxReturnAmends", fields: [businessId, clientId, amendsReturnId], references: [businessId, clientId, id], onDelete: Restrict)
  amendedBy      TaxReturn[]              @relation("TaxReturnAmends")
  history        TaxReturnHistory[]
  filings        TaxReturnFiling[]
  approvals      TaxReturnApproval[]
  checklist      TaxReturnChecklistItem[]
  authorizations TaxReturnAuthorization[]
  documents      TaxReturnDocument[]

  client     Client      @relation(fields: [businessId, clientId], references: [businessId, id], onDelete: Restrict)
  engagement Engagement? @relation(fields: [businessId, clientId, engagementId], references: [businessId, clientId, id], onDelete: Restrict)
  document   Document?   @relation(fields: [businessId, documentId], references: [businessId, id], onDelete: Restrict)

  // R37: target of the amendment and child-table keys; the list's filters and sorts.
  @@unique([businessId, clientId, id])
  @@unique([businessId, id])
  @@index([businessId, clientId, taxYear])
  @@index([businessId, documentId])
  @@index([businessId, taxYear, workflowStatus])
  @@index([businessId, preparerUserId, workflowStatus])
  @@index([businessId, reviewerUserId])
  @@index([businessId, updatedAt])
  @@index([businessId, dueOn])
  @@index([businessId, amendsReturnId])
  @@map("tax_returns")
}

/// One agreement a firm keeps for intakes (docs/SYSTEM-DESIGN.md, intake agreements): the
/// firm-wide agreement (one unarchived per firm) or an extra one for a service. Its text lives in
/// insert-only versions. Only sort_order and archived_at change (archived once); never deleted.
model FirmAgreement {
  id              String         @id @default(uuid(7)) @db.Uuid
  businessId      String         @map("business_id") @db.Uuid
  scope           AgreementScope
  /// Only for SERVICE agreements.
  serviceId       String?        @map("service_id") @db.Uuid
  sortOrder       Int            @default(0) @map("sort_order")
  archivedAt      DateTime?      @map("archived_at") @db.Timestamptz(3)
  createdByUserId String         @map("created_by_user_id") @db.Uuid
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  service   Service?               @relation(fields: [businessId, serviceId], references: [businessId, id], onDelete: Restrict)
  createdBy Membership             @relation(fields: [businessId, createdByUserId], references: [businessId, userId], onDelete: Restrict)
  versions  FirmAgreementVersion[]

  @@unique([businessId, id])
  @@index([businessId, serviceId])
  @@map("firm_agreements")
}

/// The PDF original of an agreement version, uploaded by the firm. Same file rules as a document:
/// under `tenant/<business_id>/agreements/`, PDF only, at most 10 MB, starts unscanned, scan
/// result set once, file fixed. A version may link it only once it is CLEAN. Never deleted.
model FirmAgreementFile {
  id               String     @id @default(uuid(7)) @db.Uuid
  businessId       String     @map("business_id") @db.Uuid
  fileName         String     @map("file_name")
  contentType      String     @default("application/pdf") @map("content_type")
  sizeBytes        Int        @map("size_bytes")
  /// SHA-256 of the file, hex.
  sha256           String
  s3Key            String     @unique @map("s3_key")
  scanStatus       ScanStatus @default(PENDING) @map("scan_status")
  scannedAt        DateTime?  @map("scanned_at") @db.Timestamptz(3)
  uploadedByUserId String     @map("uploaded_by_user_id") @db.Uuid
  createdAt        DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)

  uploadedBy Membership             @relation(fields: [businessId, uploadedByUserId], references: [businessId, userId], onDelete: Restrict)
  versions   FirmAgreementVersion[]

  @@unique([businessId, id])
  // Target of the version's (file, hash) foreign key, so a version's pdf_sha256 is the file's.
  @@unique([businessId, id, sha256])
  @@map("firm_agreement_files")
}

/// One published version of a firm agreement. Insert-only: a change is a new version, numbered
/// 1, 2, 3… per agreement. The database sets body_sha256 from the Markdown, and refuses a PDF
/// that is not CLEAN or an archived agreement. Clients sign a version; its hashes are pinned.
model FirmAgreementVersion {
  id                String    @id @default(uuid(7)) @db.Uuid
  businessId        String    @map("business_id") @db.Uuid
  agreementId       String    @map("agreement_id") @db.Uuid
  version           Int
  title             String
  /// The text the client reads (Markdown, rendered with raw HTML off).
  bodyMarkdown      String    @map("body_markdown")
  /// SHA-256 of body_markdown in UTF-8, hex. Set by the database on insert; any value sent is replaced.
  bodySha256        String    @default("") @map("body_sha256")
  /// [{ key, label, text, required }], 0 to 8 with unique keys. The firm-wide agreement needs a required one.
  acknowledgments   Json      @default("[]")
  /// The PDF original (both set or both null).
  pdfFileId         String?   @map("pdf_file_id") @db.Uuid
  pdfSha256         String?   @map("pdf_sha256")
  effectiveDate     DateTime? @map("effective_date") @db.Date
  publishedByUserId String    @map("published_by_user_id") @db.Uuid
  publishedAt       DateTime  @default(now()) @map("published_at") @db.Timestamptz(3)

  agreement   FirmAgreement              @relation(fields: [businessId, agreementId], references: [businessId, id], onDelete: Restrict)
  pdfFile     FirmAgreementFile?         @relation(fields: [businessId, pdfFileId, pdfSha256], references: [businessId, id, sha256], onDelete: Restrict)
  publishedBy Membership                 @relation(fields: [businessId, publishedByUserId], references: [businessId, userId], onDelete: Restrict)
  signatures  IntakeSignatureAgreement[]

  @@unique([businessId, agreementId, version])
  @@unique([businessId, id])
  @@map("firm_agreement_versions")
}

/// The signature evidence for one submitted intake version (Begin Online lead or portal client).
/// Insert-only. Written while the submission is a draft; setting the submission's submitted_at
/// needs it, with the same name, time, IP and browser. signed_at is the database's time.
/// acknowledgments copies each one shown: [{ agreementVersionId, key, label, text, required, checked }].
model IntakeSignature {
  id                String          @id @default(uuid(7)) @db.Uuid
  businessId        String          @map("business_id") @db.Uuid
  submissionId      String          @map("submission_id") @db.Uuid
  intakeId          String          @map("intake_id") @db.Uuid
  /// Begin Online: the intake's lead. Exactly one of leadId and clientAccountId.
  leadId            String?         @map("lead_id") @db.Uuid
  /// Portal: a login of the engagement's client.
  clientAccountId   String?         @map("client_account_id") @db.Uuid
  printedName       String          @map("printed_name")
  signatureText     String          @map("signature_text")
  signatureMethod   SignatureMethod @default(TYPED) @map("signature_method")
  signerTitle       String?         @map("signer_title")
  signerEmail       String?         @map("signer_email")
  acknowledgments   Json            @default("[]")
  /// Begin Online's Terms of Service and Privacy Policy tick: the versions accepted (both or neither).
  termsDocumentId   String?         @map("terms_document_id") @db.Uuid
  privacyDocumentId String?         @map("privacy_document_id") @db.Uuid
  /// SHA-256 hex of the canonical answers, and of the canonical evidence (apps/api esign/core).
  answersSha256     String          @map("answers_sha256")
  evidenceSha256    String          @map("evidence_sha256")
  /// Set by the database (transaction time); any value sent is replaced.
  signedAt          DateTime        @default(now()) @map("signed_at") @db.Timestamptz(3)
  ip                String?         @db.Inet
  userAgent         String?         @map("user_agent")
  createdAt         DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)

  submission    IntakeSubmission           @relation(fields: [businessId, submissionId], references: [businessId, id], onDelete: Restrict)
  intake        Intake                     @relation(fields: [businessId, intakeId], references: [businessId, id], onDelete: Restrict)
  lead          Lead?                      @relation(fields: [businessId, leadId], references: [businessId, id], onDelete: Restrict)
  clientAccount ClientAccount?             @relation(fields: [businessId, clientAccountId], references: [businessId, id], onDelete: Restrict)
  terms         FirmLegalDocument?         @relation("IntakeSignatureTerms", fields: [businessId, termsDocumentId], references: [businessId, id], onDelete: Restrict)
  privacy       FirmLegalDocument?         @relation("IntakeSignaturePrivacy", fields: [businessId, privacyDocumentId], references: [businessId, id], onDelete: Restrict)
  agreements    IntakeSignatureAgreement[]

  // One signature per submission version.
  @@unique([businessId, submissionId])
  @@unique([businessId, id])
  @@index([businessId, intakeId])
  @@map("intake_signatures")
}

/// One agreement version an intake signature covers, with the hashes the signer saw (they must
/// equal the version's). Insert-only, only while the submission is a draft, and only the current
/// version of an unarchived agreement.
model IntakeSignatureAgreement {
  businessId         String  @map("business_id") @db.Uuid
  signatureId        String  @map("signature_id") @db.Uuid
  agreementVersionId String  @map("agreement_version_id") @db.Uuid
  bodySha256         String  @map("body_sha256")
  pdfSha256          String? @map("pdf_sha256")

  signature        IntakeSignature      @relation(fields: [businessId, signatureId], references: [businessId, id], onDelete: Restrict)
  agreementVersion FirmAgreementVersion @relation(fields: [businessId, agreementVersionId], references: [businessId, id], onDelete: Restrict)

  @@id([signatureId, agreementVersionId])
  @@index([businessId, agreementVersionId])
  @@map("intake_signature_agreements")
}

// ---------- Firm Sign (R13, migration r0_esign) ----------
// The built-in e-signature module, behind the per-firm module `esign`
// (business_settings.enabled_modules, changed only by app_set_business_module). Every table is a
// firm table with forced RLS. The value lists match packages/types/src/esign/enums.ts.

/// A signature request's status. DELIVERED is shown as "Sent".
enum EsignRequestStatus {
  DRAFT
  NEEDS_APPROVAL
  SENT
  DELIVERED
  VIEWED
  PARTIALLY_SIGNED
  COMPLETED
  DECLINED
  EXPIRED
  VOIDED
}

/// Where a request was started.
enum EsignSource {
  TAB
  CLIENT_RECORD
  TEMPLATE
  BULK
}

enum EsignRouting {
  SEQUENTIAL
  PARALLEL
}

enum EsignRecipientKind {
  SIGNER
  APPROVER
  CC
}

/// The spec's signing roles; CUSTOM takes a role label.
enum EsignRecipientRole {
  CLIENT
  SPOUSE
  BUSINESS_OWNER
  EMPLOYEE
  PREPARER
  MANAGER
  WITNESS
  CUSTOM
}

enum EsignRecipientStatus {
  WAITING
  SENT
  DELIVERED
  VIEWED
  SIGNED
  APPROVED
  REJECTED
  DECLINED
}

enum EsignDelivery {
  EMAIL
  PORTAL
  IN_PERSON
}

/// LINK, EMAIL_CODE and ACCESS_CODE are chosen for a recipient; PORTAL_SESSION and IN_PERSON are
/// only recorded on events.
enum EsignAuthMethod {
  LINK
  EMAIL_CODE
  ACCESS_CODE
  PORTAL_SESSION
  IN_PERSON
}

enum EsignFieldType {
  SIGNATURE
  INITIALS
  DATE_SIGNED
  PRINTED_NAME
  EMAIL
  PHONE
  ADDRESS
  TEXT
  CHECKBOX
  RADIO
  DROPDOWN
  ATTACHMENT
}

enum EsignEventType {
  CREATED
  EDITED
  APPROVAL_REQUESTED
  APPROVED
  APPROVAL_REJECTED
  SENT
  DELIVERED
  VIEWED
  AUTH_PASSED
  AUTH_FAILED
  CONSENTED
  SIGNED
  REMINDER_SENT
  EXPIRY_WARNING_SENT
  DECLINED
  EXPIRED
  VOIDED
  CORRECTED
  REPLACED
  COMPLETED
  COPY_SENT
  DOWNLOADED
  IN_PERSON_STARTED
  IN_PERSON_ENDED
}

enum EsignActorKind {
  STAFF
  SIGNER
  CLIENT
  SYSTEM
}

enum EsignTemplateVisibility {
  FIRM
  PRIVATE
}

enum EsignBulkItemState {
  QUEUED
  SENT
  NOT_SENT
}

/// Who a recipient is: one of the client's portal logins, a staff member, or someone else.
enum EsignRecipientLinkType {
  CLIENT_LOGIN
  STAFF
  EXTERNAL
}

/// SIGN: the invitation's link. COPY: the completed-copy link (30 days). IN_PERSON: a kiosk link.
enum EsignLinkPurpose {
  SIGN
  COPY
  IN_PERSON
}

enum EsignCodeKind {
  EMAIL
  ACCESS
}

/// A Staff member's Firm Sign access beyond STAFF (no row: STAFF).
enum EsignStaffRole {
  MANAGER
  VIEWER
}

enum EsignApprovalDecision {
  APPROVE
  REJECT
}

enum EsignEmailStatus {
  QUEUED
  SENT
  FAILED
}

/// An upload started and not confirmed: a request's file, or a signer's attachment.
enum EsignUploadKind {
  DOCUMENT
  ATTACHMENT
}

/// The firm's defaults for new requests (Signing Settings). No row: the platform's defaults.
model EsignSettings {
  businessId             String          @id @map("business_id") @db.Uuid
  expiryDays             Int             @default(30) @map("expiry_days")
  reminderFirstAfterDays Int             @default(3) @map("reminder_first_after_days")
  reminderEveryDays      Int             @default(3) @map("reminder_every_days")
  reminderMax            Int             @default(3) @map("reminder_max")
  expiryWarningDays      Int             @default(2) @map("expiry_warning_days")
  authMethod             EsignAuthMethod @default(EMAIL_CODE) @map("auth_method")
  requireApproval        Boolean         @default(false) @map("require_approval")
  emailMessage           String?         @map("email_message")
  createdAt              DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt              DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  business Business @relation(fields: [businessId], references: [id])

  @@map("esign_settings")
}

/// A published version of the firm's e-signature consent text. Insert-only; numbered 1, 2, 3 per
/// firm; sha256 is the hex SHA-256 of body_markdown in UTF-8 (CHECK).
model EsignConsentVersion {
  id                String   @id @default(uuid(7)) @db.Uuid
  businessId        String   @map("business_id") @db.Uuid
  version           Int
  bodyMarkdown      String   @map("body_markdown")
  sha256            String
  publishedAt       DateTime @default(now()) @map("published_at") @db.Timestamptz(3)
  /// Null for a version the platform seeded.
  publishedByUserId String?  @map("published_by_user_id") @db.Uuid

  publishedBy Membership?      @relation("EsignConsentPublishedBy", fields: [businessId, publishedByUserId], references: [businessId, userId], onDelete: Restrict)
  recipients  EsignRecipient[]

  @@unique([businessId, version])
  @@unique([businessId, id])
  @@map("esign_consent_versions")
}

/// A Staff member made a Firm Sign MANAGER or VIEWER. Owner and Admin follow their firm role.
model EsignMemberRole {
  businessId String         @map("business_id") @db.Uuid
  userId     String         @map("user_id") @db.Uuid
  role       EsignStaffRole
  updatedAt  DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  member Membership @relation("EsignMemberRole", fields: [businessId, userId], references: [businessId, userId], onDelete: Restrict)

  @@id([businessId, userId])
  @@map("esign_member_roles")
}

/// A reusable request: name, visibility and owner. `version` is the newest version (what `use`
/// copies). `updated_at` is the API's optimistic lock. Never deleted; archived instead. Active
/// names are unique per firm, case-insensitively (SQL-only partial index).
model EsignTemplate {
  id          String                  @id @default(uuid(7)) @db.Uuid
  businessId  String                  @map("business_id") @db.Uuid
  name        String
  description String?
  visibility  EsignTemplateVisibility
  ownerUserId String                  @map("owner_user_id") @db.Uuid
  version     Int                     @default(1)
  createdAt   DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime                @default(now()) @map("updated_at") @db.Timestamptz(3)
  archivedAt  DateTime?               @map("archived_at") @db.Timestamptz(3)

  owner    Membership             @relation("EsignTemplateOwner", fields: [businessId, ownerUserId], references: [businessId, userId], onDelete: Restrict)
  versions EsignTemplateVersion[]
  requests EsignRequest[]

  @@unique([businessId, id])
  @@index([businessId, updatedAt])
  @@map("esign_templates")
}

/// One version of a template: the packet (a CLEAN PDF in the template's folder), roles, fields
/// and settings. Insert-only, numbered 1, 2, 3 per template.
model EsignTemplateVersion {
  businessId             String       @map("business_id") @db.Uuid
  templateId             String       @map("template_id") @db.Uuid
  version                Int
  s3Key                  String       @unique @map("s3_key")
  sha256                 String
  sizeBytes              Int          @map("size_bytes")
  /// [{ width, height }] in PDF points, one per page.
  pageSizes              Json         @map("page_sizes")
  /// EsignTemplateRole[] and EsignTemplateField[] (packages/types).
  roles                  Json
  fields                 Json
  routing                EsignRouting
  expiryDays             Int          @map("expiry_days")
  reminderFirstAfterDays Int          @map("reminder_first_after_days")
  reminderEveryDays      Int          @map("reminder_every_days")
  reminderMax            Int          @map("reminder_max")
  expiryWarningDays      Int          @map("expiry_warning_days")
  emailSubject           String?      @map("email_subject")
  emailMessage           String?      @map("email_message")
  /// What changed, in the saver's words.
  note                   String?
  savedByUserId          String       @map("saved_by_user_id") @db.Uuid
  savedAt                DateTime     @default(now()) @map("saved_at") @db.Timestamptz(3)

  template    EsignTemplate    @relation(fields: [businessId, templateId], references: [businessId, id], onDelete: Restrict)
  savedBy     Membership       @relation("EsignTemplateVersionSavedBy", fields: [businessId, savedByUserId], references: [businessId, userId], onDelete: Restrict)
  requests    EsignRequest[]   @relation("EsignRequestTemplateVersion")
  bulkBatches EsignBulkBatch[]

  @@id([templateId, version])
  @@unique([businessId, templateId, version])
  @@map("esign_template_versions")
}

/// A signature request. Inserted as a DRAFT; the database checks the status path, freezes what was
/// sent, sets the closing facts once, and lets only a DRAFT be deleted. `last_activity_at` is the
/// API's optimistic lock. `page_plan` is the packet: [{ documentId, page, rotation }], at most 100.
model EsignRequest {
  id                     String             @id @default(uuid(7)) @db.Uuid
  businessId             String             @map("business_id") @db.Uuid
  title                  String
  status                 EsignRequestStatus @default(DRAFT)
  source                 EsignSource
  clientId               String?            @map("client_id") @db.Uuid
  engagementId           String?            @map("engagement_id") @db.Uuid
  senderUserId           String             @map("sender_user_id") @db.Uuid
  /// Staff only: never in an email, a log or the audit.
  internalNote           String?            @map("internal_note")
  emailSubject           String?            @map("email_subject")
  emailMessage           String?            @map("email_message")
  routing                EsignRouting
  expiryDays             Int                @map("expiry_days")
  reminderFirstAfterDays Int                @map("reminder_first_after_days")
  reminderEveryDays      Int                @map("reminder_every_days")
  reminderMax            Int                @map("reminder_max")
  expiryWarningDays      Int                @map("expiry_warning_days")
  pagePlan               Json               @default("[]") @map("page_plan")
  createdAt              DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  lastActivityAt         DateTime           @default(now()) @map("last_activity_at") @db.Timestamptz(3)
  sentAt                 DateTime?          @map("sent_at") @db.Timestamptz(3)
  expiresAt              DateTime?          @map("expires_at") @db.Timestamptz(3)
  /// Every signer signed: the completion job files the final PDF from this time (PARTIALLY_SIGNED only).
  completionDueAt        DateTime?          @map("completion_due_at") @db.Timestamptz(3)
  completedAt            DateTime?          @map("completed_at") @db.Timestamptz(3)
  /// Hex SHA-256 of the packet as sent, of the signed PDF and of the certificate.
  originalSha256         String?            @map("original_sha256")
  finalSha256            String?            @map("final_sha256")
  certificateSha256      String?            @map("certificate_sha256")
  /// The filed documents (FIRM_TO_CLIENT, CLEAN, legal hold): set once, after COMPLETED.
  finalDocumentId        String?            @map("final_document_id") @db.Uuid
  certificateDocumentId  String?            @map("certificate_document_id") @db.Uuid
  expiredAt              DateTime?          @map("expired_at") @db.Timestamptz(3)
  voidedAt               DateTime?          @map("voided_at") @db.Timestamptz(3)
  /// Staff only, up to 500 characters.
  voidReason             String?            @map("void_reason")
  voidedByUserId         String?            @map("voided_by_user_id") @db.Uuid
  replacesRequestId      String?            @map("replaces_request_id") @db.Uuid
  replacedByRequestId    String?            @map("replaced_by_request_id") @db.Uuid
  expiryWarnedAt         DateTime?          @map("expiry_warned_at") @db.Timestamptz(3)
  /// The template and version it was made from (both or neither).
  templateId             String?            @map("template_id") @db.Uuid
  templateVersion        Int?               @map("template_version")

  client              Client?                  @relation(fields: [businessId, clientId], references: [businessId, id], onDelete: Restrict)
  engagement          Engagement?              @relation(fields: [businessId, clientId, engagementId], references: [businessId, clientId, id], onDelete: Restrict)
  sender              Membership               @relation("EsignRequestSender", fields: [businessId, senderUserId], references: [businessId, userId], onDelete: Restrict)
  voidedBy            Membership?              @relation("EsignRequestVoidedBy", fields: [businessId, voidedByUserId], references: [businessId, userId], onDelete: Restrict)
  replaces            EsignRequest?            @relation("EsignReplaces", fields: [businessId, replacesRequestId], references: [businessId, id], onDelete: Restrict)
  replacedOf          EsignRequest?            @relation("EsignReplaces")
  replacedBy          EsignRequest?            @relation("EsignReplacedBy", fields: [businessId, replacedByRequestId], references: [businessId, id], onDelete: Restrict)
  replacedByOf        EsignRequest?            @relation("EsignReplacedBy")
  finalDocument       Document?                @relation("EsignFinalDocument", fields: [businessId, finalDocumentId], references: [businessId, id], onDelete: Restrict)
  certificateDocument Document?                @relation("EsignCertificateDocument", fields: [businessId, certificateDocumentId], references: [businessId, id], onDelete: Restrict)
  template            EsignTemplate?           @relation(fields: [businessId, templateId], references: [businessId, id], onDelete: Restrict)
  templateVersionRow  EsignTemplateVersion?    @relation("EsignRequestTemplateVersion", fields: [businessId, templateId, templateVersion], references: [businessId, templateId, version], onDelete: Restrict)
  filedDocuments      Document[]               @relation("EsignFiledDocuments")
  documents           EsignDocument[]
  recipients          EsignRecipient[]
  fields              EsignField[]
  events              EsignEvent[]
  approvalNotes       EsignApprovalNote[]
  emails              EsignEmail[]
  links               EsignSigningLink[]
  uploads             EsignPendingUpload[]
  attachments         EsignAttachment[]
  taxAuthorizations   TaxReturnAuthorization[]

  @@unique([businessId, id])
  @@unique([businessId, replacesRequestId])
  @@unique([businessId, replacedByRequestId])
  @@unique([businessId, finalDocumentId])
  @@unique([businessId, certificateDocumentId])
  @@index([businessId, status, lastActivityAt])
  @@index([businessId, status, expiresAt])
  @@index([businessId, completionDueAt])
  @@index([businessId, sentAt])
  @@index([businessId, clientId])
  @@index([businessId, senderUserId])
  @@map("esign_requests")
}

/// One uploaded or vault file of a request (PDF, JPG or PNG, at most 10 MB), under the request's
/// folder. Added and removed only while the request is a DRAFT; afterwards only the scan result
/// is set, once. source_document_id is the vault document it was copied from (no FK: the vault
/// file may later be deleted under its retention).
model EsignDocument {
  id               String     @id @default(uuid(7)) @db.Uuid
  businessId       String     @map("business_id") @db.Uuid
  requestId        String     @map("request_id") @db.Uuid
  position         Int
  fileName         String     @map("file_name")
  contentType      String     @map("content_type")
  sizeBytes        Int        @map("size_bytes")
  pageCount        Int        @map("page_count")
  pageSizes        Json       @map("page_sizes")
  sourceDocumentId String?    @map("source_document_id") @db.Uuid
  s3Key            String     @unique @map("s3_key")
  sha256           String
  scanStatus       ScanStatus @default(PENDING) @map("scan_status")
  scannedAt        DateTime?  @map("scanned_at") @db.Timestamptz(3)
  createdAt        DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)

  request EsignRequest @relation(fields: [businessId, requestId], references: [businessId, id], onDelete: Cascade)

  @@unique([businessId, id])
  @@unique([businessId, requestId, position])
  @@map("esign_documents")
}

/// A signer, approver or CC of a request. Added and removed only while the request is a DRAFT.
/// token_version only rises: a link works only at its recipient's current version. Once signed,
/// who they are and what they adopted never change. Only the access code's HMAC is kept.
model EsignRecipient {
  id               String                 @id @default(uuid(7)) @db.Uuid
  businessId       String                 @map("business_id") @db.Uuid
  requestId        String                 @map("request_id") @db.Uuid
  /// Order on the request (the list order).
  position         Int
  kind             EsignRecipientKind
  role             EsignRecipientRole
  roleLabel        String?                @map("role_label")
  routingOrder     Int                    @map("routing_order")
  name             String
  email            String?
  phone            String?
  linkType         EsignRecipientLinkType @map("link_type")
  clientAccountId  String?                @map("client_account_id") @db.Uuid
  staffUserId      String?                @map("staff_user_id") @db.Uuid
  delivery         EsignDelivery
  authMethod       EsignAuthMethod        @map("auth_method")
  accessCodeHash   String?                @map("access_code_hash")
  colorIndex       Int                    @map("color_index")
  status           EsignRecipientStatus   @default(WAITING)
  sentAt           DateTime?              @map("sent_at") @db.Timestamptz(3)
  viewedAt         DateTime?              @map("viewed_at") @db.Timestamptz(3)
  signedAt         DateTime?              @map("signed_at") @db.Timestamptz(3)
  declinedAt       DateTime?              @map("declined_at") @db.Timestamptz(3)
  declineReason    String?                @map("decline_reason")
  lastRemindedAt   DateTime?              @map("last_reminded_at") @db.Timestamptz(3)
  reminderCount    Int                    @default(0) @map("reminder_count")
  tokenVersion     Int                    @default(0) @map("token_version")
  /// The consent version the signer accepted (pinned).
  consentVersionId String?                @map("consent_version_id") @db.Uuid
  consentedAt      DateTime?              @map("consented_at") @db.Timestamptz(3)
  /// What the signer adopted: a typed text or a PNG (at most 200 KB) per mark.
  printedName      String?                @map("printed_name")
  signatureMethod  SignatureMethod?       @map("signature_method")
  signatureText    String?                @map("signature_text")
  signaturePng     Bytes?                 @map("signature_png")
  initialsMethod   SignatureMethod?       @map("initials_method")
  initialsText     String?                @map("initials_text")
  initialsPng      Bytes?                 @map("initials_png")
  adoptedAt        DateTime?              @map("adopted_at") @db.Timestamptz(3)
  createdAt        DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)

  request        EsignRequest            @relation(fields: [businessId, requestId], references: [businessId, id], onDelete: Cascade)
  clientAccount  ClientAccount?          @relation(fields: [businessId, clientAccountId], references: [businessId, id], onDelete: Restrict)
  staff          Membership?             @relation("EsignRecipientStaff", fields: [businessId, staffUserId], references: [businessId, userId], onDelete: Restrict)
  consentVersion EsignConsentVersion?    @relation(fields: [businessId, consentVersionId], references: [businessId, id], onDelete: Restrict)
  fields         EsignField[]
  codes          EsignVerificationCode[]
  links          EsignSigningLink[]
  approvalNotes  EsignApprovalNote[]
  emails         EsignEmail[]
  uploads        EsignPendingUpload[]
  attachments    EsignAttachment[]
  kioskLocks     EsignKioskLock[]

  @@unique([businessId, id])
  @@unique([businessId, requestId, id])
  @@index([businessId, requestId])
  @@index([businessId, clientAccountId])
  @@index([businessId, staffUserId])
  @@map("esign_recipients")
}

/// A recipient's email code (EMAIL: HMAC, expiry, tries, the sends of the last hour) or access
/// code tries (ACCESS: the code's HMAC is on the recipient). Only HMACs are kept.
model EsignVerificationCode {
  businessId  String        @map("business_id") @db.Uuid
  recipientId String        @map("recipient_id") @db.Uuid
  kind        EsignCodeKind
  codeHash    String?       @map("code_hash")
  expiresAt   DateTime?     @map("expires_at") @db.Timestamptz(3)
  tries       Int           @default(0)
  /// When codes were sent within the last hour (at most 5).
  sentTimes   DateTime[]    @default([]) @map("sent_times") @db.Timestamptz(3)
  updatedAt   DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  recipient EsignRecipient @relation(fields: [businessId, recipientId], references: [businessId, id], onDelete: Cascade)

  @@id([recipientId, kind])
  @@index([businessId])
  @@map("esign_verification_codes")
}

/// A field on a packet page, in fractions of the page as shown. Placed only while the request is a
/// DRAFT; afterwards only the signer's value and `filled` change. value_enc is ciphertext made with
/// the firm's KMS key (a sender's typed value or a signer's), never a plain value.
model EsignField {
  id          String         @id @default(uuid(7)) @db.Uuid
  businessId  String         @map("business_id") @db.Uuid
  requestId   String         @map("request_id") @db.Uuid
  /// Null: the sender fills it.
  recipientId String?        @map("recipient_id") @db.Uuid
  position    Int
  type        EsignFieldType
  pageIndex   Int            @map("page_index")
  x           Float
  y           Float
  w           Float
  h           Float
  required    Boolean
  label       String?
  /// One of the merge keys in packages/types (EsignMergeKey).
  mergeKey    String?        @map("merge_key")
  options     String[]       @default([])
  groupKey    String?        @map("group_key")
  valueEnc    Bytes?         @map("value_enc")
  filled      Boolean        @default(false)

  request     EsignRequest         @relation(fields: [businessId, requestId], references: [businessId, id], onDelete: Cascade)
  recipient   EsignRecipient?      @relation(fields: [businessId, requestId, recipientId], references: [businessId, requestId, id], onDelete: Cascade)
  uploads     EsignPendingUpload[]
  attachments EsignAttachment[]

  @@unique([businessId, id])
  @@unique([businessId, requestId, id])
  @@index([businessId, requestId])
  @@map("esign_fields")
}

/// The request's timeline, with names as they were then; never a field value. Insert-only.
model EsignEvent {
  id            String           @id @default(uuid(7)) @db.Uuid
  businessId    String           @map("business_id") @db.Uuid
  requestId     String           @map("request_id") @db.Uuid
  type          EsignEventType
  createdAt     DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  actorKind     EsignActorKind   @map("actor_kind")
  actorUserId   String?          @map("actor_user_id") @db.Uuid
  actorName     String           @map("actor_name")
  /// The recipient as they were (no FK: a draft's recipients can be replaced).
  recipientId   String?          @map("recipient_id") @db.Uuid
  recipientName String?          @map("recipient_name")
  reason        String?
  authMethod    EsignAuthMethod? @map("auth_method")
  /// For the certificate's audit trail.
  ip            String?          @db.Inet
  userAgent     String?          @map("user_agent")

  request EsignRequest @relation(fields: [businessId, requestId], references: [businessId, id], onDelete: Cascade)

  @@index([businessId, requestId, createdAt])
  @@map("esign_events")
}

/// An approver's decision and note (staff only). Insert-only.
model EsignApprovalNote {
  id          String                @id @default(uuid(7)) @db.Uuid
  businessId  String                @map("business_id") @db.Uuid
  requestId   String                @map("request_id") @db.Uuid
  recipientId String                @map("recipient_id") @db.Uuid
  decision    EsignApprovalDecision
  note        String?
  createdAt   DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)

  request   EsignRequest   @relation(fields: [businessId, requestId], references: [businessId, id], onDelete: Cascade)
  recipient EsignRecipient @relation(fields: [businessId, requestId, recipientId], references: [businessId, requestId, id], onDelete: Cascade)

  @@index([businessId, requestId, createdAt])
  @@map("esign_approval_notes")
}

/// Firm Sign's email outbox: a recipient's or (staff updates) a member's, and the template; never
/// the address, the link or the token. QUEUED, then SENT or FAILED (the error's class name only).
model EsignEmail {
  id          String           @id @default(uuid(7)) @db.Uuid
  businessId  String           @map("business_id") @db.Uuid
  requestId   String           @map("request_id") @db.Uuid
  recipientId String?          @map("recipient_id") @db.Uuid
  userId      String?          @map("user_id") @db.Uuid
  template    String
  status      EsignEmailStatus @default(QUEUED)
  error       String?
  attempts    Int              @default(0)
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  sentAt      DateTime?        @map("sent_at") @db.Timestamptz(3)

  request   EsignRequest    @relation(fields: [businessId, requestId], references: [businessId, id], onDelete: Cascade)
  recipient EsignRecipient? @relation(fields: [businessId, requestId, recipientId], references: [businessId, requestId, id], onDelete: Cascade)
  member    Membership?     @relation("EsignEmailMember", fields: [businessId, userId], references: [businessId, userId], onDelete: Restrict)

  @@index([businessId, status, createdAt])
  @@index([businessId, requestId])
  @@map("esign_emails")
}

/// A recipient's signing, copy or in-person link, by the token's SHA-256 only (never the token).
/// It works only while its token_version is the recipient's (and, for COPY and IN_PERSON, until
/// expires_at). Insert-only.
model EsignSigningLink {
  id           String           @id @default(uuid(7)) @db.Uuid
  businessId   String           @map("business_id") @db.Uuid
  tokenHash    String           @map("token_hash")
  requestId    String           @map("request_id") @db.Uuid
  recipientId  String           @map("recipient_id") @db.Uuid
  tokenVersion Int              @map("token_version")
  purpose      EsignLinkPurpose
  expiresAt    DateTime?        @map("expires_at") @db.Timestamptz(3)
  createdAt    DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)

  request   EsignRequest   @relation(fields: [businessId, requestId], references: [businessId, id], onDelete: Cascade)
  recipient EsignRecipient @relation(fields: [businessId, requestId, recipientId], references: [businessId, requestId, id], onDelete: Cascade)

  @@unique([businessId, tokenHash])
  @@index([businessId, recipientId])
  @@map("esign_signing_links")
}

/// An upload started and not confirmed (a request's file by its staff member, or a signer's
/// attachment), by the token's SHA-256. Taken once; the job sweeps rows older than 15 minutes.
model EsignPendingUpload {
  businessId  String          @map("business_id") @db.Uuid
  tokenHash   String          @map("token_hash")
  kind        EsignUploadKind
  requestId   String          @map("request_id") @db.Uuid
  /// DOCUMENT: who started it.
  userId      String?         @map("user_id") @db.Uuid
  /// ATTACHMENT: the signer and their field.
  recipientId String?         @map("recipient_id") @db.Uuid
  fieldId     String?         @map("field_id") @db.Uuid
  /// The document's or attachment's id once confirmed (the last part of the key).
  fileId      String          @map("file_id") @db.Uuid
  s3Key       String          @map("s3_key")
  fileName    String          @map("file_name")
  contentType String          @map("content_type")
  sizeBytes   Int             @map("size_bytes")
  sha256      String
  createdAt   DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)

  request   EsignRequest    @relation(fields: [businessId, requestId], references: [businessId, id], onDelete: Cascade)
  member    Membership?     @relation("EsignUploadMember", fields: [businessId, userId], references: [businessId, userId], onDelete: Restrict)
  recipient EsignRecipient? @relation(fields: [businessId, requestId, recipientId], references: [businessId, requestId, id], onDelete: Cascade)
  field     EsignField?     @relation(fields: [businessId, requestId, fieldId], references: [businessId, requestId, id], onDelete: Cascade)

  @@id([businessId, tokenHash])
  @@index([businessId, createdAt])
  @@map("esign_pending_uploads")
}

/// A signer's file for one ATTACHMENT field (one per field), under the request's attachments/
/// folder; shown to the firm only once CLEAN. The scan result is set once.
model EsignAttachment {
  id          String     @id @default(uuid(7)) @db.Uuid
  businessId  String     @map("business_id") @db.Uuid
  requestId   String     @map("request_id") @db.Uuid
  recipientId String     @map("recipient_id") @db.Uuid
  fieldId     String     @map("field_id") @db.Uuid
  s3Key       String     @unique @map("s3_key")
  fileName    String     @map("file_name")
  contentType String     @map("content_type")
  sizeBytes   Int        @map("size_bytes")
  sha256      String
  scanStatus  ScanStatus @default(PENDING) @map("scan_status")
  scannedAt   DateTime?  @map("scanned_at") @db.Timestamptz(3)
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)

  request   EsignRequest   @relation(fields: [businessId, requestId], references: [businessId, id], onDelete: Cascade)
  recipient EsignRecipient @relation(fields: [businessId, requestId, recipientId], references: [businessId, requestId, id], onDelete: Cascade)
  field     EsignField     @relation(fields: [businessId, requestId, fieldId], references: [businessId, requestId, id], onDelete: Cascade)

  @@unique([businessId, recipientId, fieldId])
  @@index([businessId, requestId])
  @@map("esign_attachments")
}

/// An in-person signing's lock on a staff member's Firm Sign access in one firm (one at a time):
/// every other firm route answers KIOSK_LOCKED until the staff password ends it.
model EsignKioskLock {
  businessId     String   @map("business_id") @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  requestId      String   @map("request_id") @db.Uuid
  recipientId    String   @map("recipient_id") @db.Uuid
  signerName     String   @map("signer_name")
  startedAt      DateTime @default(now()) @map("started_at") @db.Timestamptz(3)
  linkExpiresAt  DateTime @map("link_expires_at") @db.Timestamptz(3)
  activeAt       DateTime @default(now()) @map("active_at") @db.Timestamptz(3)
  wrongPasswords Int      @default(0) @map("wrong_passwords")

  member    Membership     @relation("EsignKioskLock", fields: [businessId, userId], references: [businessId, userId], onDelete: Restrict)
  recipient EsignRecipient @relation(fields: [businessId, requestId, recipientId], references: [businessId, requestId, id], onDelete: Cascade)

  @@id([businessId, userId])
  @@map("esign_kiosk_locks")
}

/// A bulk send from one template version: one separate request per client (at most 200), made
/// and sent by the job. Insert-only; `roles` holds the role fills (never an access code).
model EsignBulkBatch {
  id              String   @id @default(uuid(7)) @db.Uuid
  businessId      String   @map("business_id") @db.Uuid
  templateId      String   @map("template_id") @db.Uuid
  templateVersion Int      @map("template_version")
  templateName    String   @map("template_name")
  createdByUserId String   @map("created_by_user_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  title           String?
  roles           Json     @default("[]")

  templateVersionRow EsignTemplateVersion @relation(fields: [businessId, templateId, templateVersion], references: [businessId, templateId, version], onDelete: Restrict)
  createdBy          Membership           @relation("EsignBulkCreatedBy", fields: [businessId, createdByUserId], references: [businessId, userId], onDelete: Restrict)
  items              EsignBulkItem[]

  @@unique([businessId, id])
  @@index([businessId, createdAt])
  @@map("esign_bulk_batches")
}

/// One client's row of a batch. request_id is chosen with the batch, so a rerun finds the DRAFT it
/// made (no FK: the request exists only once `created`). Changes only while QUEUED.
model EsignBulkItem {
  businessId   String             @map("business_id") @db.Uuid
  batchId      String             @map("batch_id") @db.Uuid
  position     Int
  clientId     String             @map("client_id") @db.Uuid
  engagementId String?            @map("engagement_id") @db.Uuid
  requestId    String             @map("request_id") @db.Uuid
  created      Boolean            @default(false)
  state        EsignBulkItemState @default(QUEUED)
  /// A readiness or error code (packages/types) when NOT_SENT.
  problem      String?
  attempts     Int                @default(0)

  batch      EsignBulkBatch @relation(fields: [businessId, batchId], references: [businessId, id], onDelete: Restrict)
  client     Client         @relation(fields: [businessId, clientId], references: [businessId, id], onDelete: Restrict)
  engagement Engagement?    @relation(fields: [businessId, clientId, engagementId], references: [businessId, clientId, id], onDelete: Restrict)

  @@id([batchId, position])
  @@unique([businessId, requestId])
  @@unique([batchId, clientId])
  @@index([businessId, state])
  @@map("esign_bulk_items")
}

// ---------- R36: money and portal modules (Invoices and Payments, Services and Pricing, Messages,
// Client portal tab, Company profile and branding). Rasel's request, Oct 14. Every table below is a
// firm table: business_id, same-firm foreign keys, forced RLS with the business policy. Money is in
// integer cents. Stripe stays the only payment provider. ----------

/// Percentage or a fixed amount. PERCENT keeps what the firm typed in `discount_percent`.
enum InvoiceDiscountType {
  PERCENT
  FIXED
}

/// A tax rate the firm configures (never hard-coded): an invoice copies the rate it uses.
/// Archived, not deleted, once used. One live default per firm (SQL-only partial unique index).
model InvoiceTaxRate {
  id         String    @id @default(uuid(7)) @db.Uuid
  businessId String    @map("business_id") @db.Uuid
  name       String
  /// Basis points: 800 is 8.00%, at most 10000.
  rateBps    Int       @map("rate_bps")
  isDefault  Boolean   @default(false) @map("is_default")
  archivedAt DateTime? @map("archived_at") @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  business  Business           @relation(fields: [businessId], references: [id])
  invoices  Invoice[]
  recurring RecurringInvoice[]

  @@unique([businessId, name])
  @@unique([businessId, id])
  @@map("invoice_tax_rates")
}

/// How a client may pay one invoice. MANUAL is paid outside the system and recorded by the firm.
enum InvoicePaymentMethod {
  CARD
  ACH
  MANUAL
}

/// A reusable invoice layout the firm picks when creating an invoice ("Standard Invoice"). Its
/// memo starts the invoice's notes; the firm's brand (logo, colours) comes from its branding.
/// Archived, not deleted, once used. One live default per firm (SQL-only partial unique index).
model InvoiceTemplate {
  id          String    @id @default(uuid(7)) @db.Uuid
  businessId  String    @map("business_id") @db.Uuid
  name        String
  description String?
  /// Up to 500 characters; the same for the footer printed under the lines.
  memo        String?
  footer      String?
  showLogo    Boolean   @default(true) @map("show_logo")
  isDefault   Boolean   @default(false) @map("is_default")
  archivedAt  DateTime? @map("archived_at") @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  business          Business           @relation(fields: [businessId], references: [id])
  invoices          Invoice[]
  recurringInvoices RecurringInvoice[]

  @@unique([businessId, name])
  @@unique([businessId, id])
  @@map("invoice_templates")
}

/// How a late fee is worked out.
enum LateFeeType {
  PERCENT
  FIXED
}

/// What an invoice event records: what happened to the invoice, or what staff noted about it.
enum InvoiceEventType {
  CREATED
  SENT
  RESENT
  VIEWED
  REMINDER_SENT
  OVERDUE_REMINDER_SENT
  RECEIPT_SENT
  PAYMENT_LINK_COPIED
  NOTE
  ACTIVITY_LOGGED
  FOLLOW_UP_SCHEDULED
  ARCHIVED
  UNARCHIVED
}

enum InvoiceActorKind {
  STAFF
  CLIENT
  SYSTEM
}

/// The firm's payment settings (Payment Settings screen), one row per firm; no row means the
/// defaults below. The gateway is the firm's Stripe account (`stripe_accounts`); nothing here is a
/// credential. Money values are cents.
model PaymentSettings {
  businessId              String       @id @map("business_id") @db.Uuid
  acceptCard              Boolean      @default(true) @map("accept_card")
  acceptAch               Boolean      @default(true) @map("accept_ach")
  acceptManual            Boolean      @default(true) @map("accept_manual")
  autoReceipts            Boolean      @default(true) @map("auto_receipts")
  sendReminders           Boolean      @default(true) @map("send_reminders")
  notifyOverdue           Boolean      @default(true) @map("notify_overdue")
  autoApplyPayments       Boolean      @default(true) @map("auto_apply_payments")
  /// Shown as "Next invoice: INV-001247"; letters, digits and hyphens, up to 10.
  invoicePrefix           String       @default("INV-") @map("invoice_prefix")
  /// A terms code (`net_14`).
  defaultTerms            String       @default("net_14") @map("default_terms")
  defaultMemo             String?      @map("default_memo")
  /// "Due Soon": an open invoice due within this many days.
  dueSoonDays             Int          @default(14) @map("due_soon_days")
  reminderDaysBefore      Int          @default(3) @map("reminder_days_before")
  /// Repeat the overdue reminder every this many days (0: once).
  overdueReminderDays     Int          @default(7) @map("overdue_reminder_days")
  retryAttempts           Int          @default(3) @map("retry_attempts")
  retryIntervalDays       Int          @default(3) @map("retry_interval_days")
  lateFeeEnabled          Boolean      @default(false) @map("late_fee_enabled")
  lateFeeType             LateFeeType? @map("late_fee_type")
  lateFeePercent          Decimal?     @map("late_fee_percent") @db.Decimal(5, 2)
  lateFeeCents            Int?         @map("late_fee_cents")
  tippingEnabled          Boolean      @default(false) @map("tipping_enabled")
  requirePaymentBeforeDue Boolean      @default(false) @map("require_payment_before_due")
  portalPaymentsEnabled   Boolean      @default(true) @map("portal_payments_enabled")
  updatedByUserId         String?      @map("updated_by_user_id") @db.Uuid
  createdAt               DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt               DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  business  Business    @relation(fields: [businessId], references: [id])
  updatedBy Membership? @relation(fields: [businessId, updatedByUserId], references: [businessId, userId], onDelete: Restrict)

  @@map("payment_settings")
}

/// What happens around an invoice that is not part of its money, so it can change on a PAID or
/// canceled invoice too: when the client viewed it (the Viewed tab), reminders, AutoPay retries and
/// archiving. One row per invoice, made when the first of these happens.
model InvoiceTracking {
  invoiceId             String    @id @map("invoice_id") @db.Uuid
  businessId            String    @map("business_id") @db.Uuid
  firstViewedAt         DateTime? @map("first_viewed_at") @db.Timestamptz(3)
  lastViewedAt          DateTime? @map("last_viewed_at") @db.Timestamptz(3)
  viewCount             Int       @default(0) @map("view_count")
  lastReminderAt        DateTime? @map("last_reminder_at") @db.Timestamptz(3)
  reminderCount         Int       @default(0) @map("reminder_count")
  lastOverdueReminderAt DateTime? @map("last_overdue_reminder_at") @db.Timestamptz(3)
  autopayAttempts       Int       @default(0) @map("autopay_attempts")
  lastAutopayAttemptAt  DateTime? @map("last_autopay_attempt_at") @db.Timestamptz(3)
  /// A short code from the processor, never a message.
  autopayFailureCode    String?   @map("autopay_failure_code")
  /// Archived invoices leave the active views; the record stays.
  archivedAt            DateTime? @map("archived_at") @db.Timestamptz(3)
  archivedByUserId      String?   @map("archived_by_user_id") @db.Uuid
  updatedAt             DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  invoice    Invoice     @relation(fields: [businessId, invoiceId], references: [businessId, id], onDelete: Restrict)
  archivedBy Membership? @relation(fields: [businessId, archivedByUserId], references: [businessId, userId], onDelete: Restrict)

  @@unique([businessId, invoiceId])
  @@index([businessId, archivedAt])
  @@map("invoice_tracking")
}

/// An invoice's activity timeline ("View Invoice: full invoice and activity"): sends, views,
/// reminders, receipts, staff notes and logged billing activity. Insert-only; firm-side only
/// (a client sees none of it). A NOTE or ACTIVITY_LOGGED event has its text.
model InvoiceEvent {
  id               String           @id @default(uuid(7)) @db.Uuid
  businessId       String           @map("business_id") @db.Uuid
  invoiceId        String           @map("invoice_id") @db.Uuid
  type             InvoiceEventType
  actorKind        InvoiceActorKind @default(STAFF) @map("actor_kind")
  /// The staff member, for STAFF events.
  actorUserId      String?          @map("actor_user_id") @db.Uuid
  /// Up to 2000 characters; never card or bank details.
  body             String?
  /// The payment a RECEIPT_SENT (or payment) event is about: a Stripe one or an offline one.
  paymentId        String?          @map("payment_id") @db.Uuid
  offlinePaymentId String?          @map("offline_payment_id") @db.Uuid
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)

  invoice        Invoice         @relation(fields: [businessId, invoiceId], references: [businessId, id], onDelete: Restrict)
  actor          Membership?     @relation(fields: [businessId, actorUserId], references: [businessId, userId], onDelete: Restrict)
  payment        Payment?        @relation(fields: [businessId, paymentId], references: [businessId, id], onDelete: Restrict)
  offlinePayment OfflinePayment? @relation(fields: [businessId, offlinePaymentId], references: [businessId, id], onDelete: Restrict)

  @@index([businessId, invoiceId, createdAt])
  @@map("invoice_events")
}

/// A vault document sent with the invoice (the client's own, never INTERNAL, scanned clean).
/// Added and removed until the invoice is PAID or canceled; the document itself stays.
model InvoiceAttachment {
  id            String   @id @default(uuid(7)) @db.Uuid
  businessId    String   @map("business_id") @db.Uuid
  invoiceId     String   @map("invoice_id") @db.Uuid
  documentId    String   @map("document_id") @db.Uuid
  addedByUserId String?  @map("added_by_user_id") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  invoice  Invoice     @relation(fields: [businessId, invoiceId], references: [businessId, id], onDelete: Restrict)
  document Document    @relation(fields: [businessId, documentId], references: [businessId, id], onDelete: Restrict)
  addedBy  Membership? @relation(fields: [businessId, addedByUserId], references: [businessId, userId], onDelete: Restrict)

  @@unique([businessId, invoiceId, documentId])
  @@index([businessId, documentId])
  @@map("invoice_attachments")
}

/// A place the firm deposits money received ("Operating Bank Account"), named by the firm for its
/// own books; never a bank number. Archived, not deleted, once used. One live default per firm.
model DepositAccount {
  id         String    @id @default(uuid(7)) @db.Uuid
  businessId String    @map("business_id") @db.Uuid
  name       String
  isDefault  Boolean   @default(false) @map("is_default")
  archivedAt DateTime? @map("archived_at") @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  business        Business         @relation(fields: [businessId], references: [id])
  offlinePayments OfflinePayment[]

  @@unique([businessId, name])
  @@unique([businessId, id])
  @@map("deposit_accounts")
}

/// How often a recurring invoice, or a recurring service's billing, comes round.
enum BillingFrequency {
  ONE_TIME
  WEEKLY
  BIWEEKLY
  SEMI_MONTHLY
  MONTHLY
  QUARTERLY
  SEMIANNUAL
  ANNUAL
}

/// ACTIVE sends on its schedule (Upcoming when `start_on` is still ahead); PAUSED keeps its place
/// and history; COMPLETED ran out its end rule; ENDED was stopped or archived by the firm.
enum RecurringInvoiceStatus {
  ACTIVE
  PAUSED
  COMPLETED
  ENDED
}

enum InvoiceDelivery {
  EMAIL
  PORTAL
  EMAIL_AND_PORTAL
}

/// A schedule that makes invoices for one client (Recurring Invoices screen). The amount is its
/// lines (`recurring_invoice_lines`); the schedule's own prices are the billing agreement, so a
/// catalog price change never reaches it silently. The job makes a draft or sends, per `auto_send`,
/// one invoice per period (`invoices.recurring_period_on`).
model RecurringInvoice {
  id              String                 @id @default(uuid(7)) @db.Uuid
  businessId      String                 @map("business_id") @db.Uuid
  clientId        String                 @map("client_id") @db.Uuid
  engagementId    String?                @map("engagement_id") @db.Uuid
  /// What the schedule is called ("Monthly Bookkeeping"), shown in the table's template column.
  name            String
  templateId      String?                @map("template_id") @db.Uuid
  frequency       BillingFrequency
  startOn         DateTime               @map("start_on") @db.Date
  /// The next period to invoice; null once COMPLETED or ENDED.
  nextSendOn      DateTime?              @map("next_send_on") @db.Date
  /// The end rule: never (both empty), on a date, or after a number of invoices.
  endOn           DateTime?              @map("end_on") @db.Date
  maxOccurrences  Int?                   @map("max_occurrences")
  occurrences     Int                    @default(0)
  status          RecurringInvoiceStatus @default(ACTIVE)
  autoSend        Boolean                @default(true) @map("auto_send")
  autopay         Boolean                @default(false)
  delivery        InvoiceDelivery        @default(EMAIL_AND_PORTAL)
  paymentTerms    String?                @map("payment_terms")
  taxRateId       String?                @map("tax_rate_id") @db.Uuid
  discountType    InvoiceDiscountType    @default(FIXED) @map("discount_type")
  discountPercent Decimal?               @map("discount_percent") @db.Decimal(5, 2)
  discountCents   Int                    @default(0) @map("discount_cents")
  notesToClient   String?                @map("notes_to_client")
  assignedUserId  String?                @map("assigned_user_id") @db.Uuid
  createdByUserId String?                @map("created_by_user_id") @db.Uuid
  pausedAt        DateTime?              @map("paused_at") @db.Timestamptz(3)
  endedAt         DateTime?              @map("ended_at") @db.Timestamptz(3)
  createdAt       DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime               @updatedAt @map("updated_at") @db.Timestamptz(3)

  client     Client                 @relation(fields: [businessId, clientId], references: [businessId, id], onDelete: Restrict)
  engagement Engagement?            @relation(fields: [businessId, clientId, engagementId], references: [businessId, clientId, id], onDelete: Restrict)
  template   InvoiceTemplate?       @relation(fields: [businessId, templateId], references: [businessId, id], onDelete: Restrict)
  taxRate    InvoiceTaxRate?        @relation(fields: [businessId, taxRateId], references: [businessId, id], onDelete: Restrict)
  assignedTo Membership?            @relation("RecurringAssignedTo", fields: [businessId, assignedUserId], references: [businessId, userId], onDelete: Restrict)
  createdBy  Membership?            @relation("RecurringCreatedBy", fields: [businessId, createdByUserId], references: [businessId, userId], onDelete: Restrict)
  lines      RecurringInvoiceLine[]
  invoices   Invoice[]

  @@unique([businessId, id])
  @@index([businessId, status, nextSendOn])
  @@index([businessId, clientId])
  @@map("recurring_invoices")
}

/// One line of a recurring invoice, copied onto each invoice it makes. Quantity up to 2 decimals.
model RecurringInvoiceLine {
  id                 String   @id @default(uuid(7)) @db.Uuid
  businessId         String   @map("business_id") @db.Uuid
  recurringInvoiceId String   @map("recurring_invoice_id") @db.Uuid
  serviceId          String?  @map("service_id") @db.Uuid
  itemName           String?  @map("item_name")
  description        String
  quantity           Decimal  @default(1) @db.Decimal(10, 2)
  unitAmountCents    Int      @map("unit_amount_cents")
  taxable            Boolean  @default(false)
  sortOrder          Int      @default(0) @map("sort_order")
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  recurring RecurringInvoice @relation(fields: [businessId, recurringInvoiceId], references: [businessId, id], onDelete: Restrict)
  service   Service?         @relation(fields: [businessId, serviceId], references: [businessId, id], onDelete: Restrict)

  @@index([businessId, recurringInvoiceId])
  @@map("recurring_invoice_lines")
}

enum PaymentMethodStatus {
  ACTIVE
  REMOVED
}

/// A payment method the client saved for AutoPay: Stripe's references and what the screens show
/// (type, brand, last 4, expiry), never a card or bank number. It is on the firm's own Stripe
/// account, and the client authorized charging it (who and when). Removed, never deleted.
model ClientPaymentMethod {
  id                 String              @id @default(uuid(7)) @db.Uuid
  businessId         String              @map("business_id") @db.Uuid
  clientId           String              @map("client_id") @db.Uuid
  processor          PaymentProcessor    @default(STRIPE)
  /// Stripe's customer (cus_...) and payment method (pm_...) on the firm's account (acct_...).
  customerRef        String              @map("customer_ref")
  methodRef          String              @map("method_ref")
  accountId          String              @map("account_id")
  methodType         String              @map("method_type")
  cardBrand          String?             @map("card_brand")
  last4              String
  expMonth           Int?                @map("exp_month")
  expYear            Int?                @map("exp_year")
  status             PaymentMethodStatus @default(ACTIVE)
  isDefault          Boolean             @default(false) @map("is_default")
  authorizedAt       DateTime            @map("authorized_at") @db.Timestamptz(3)
  /// The client's portal login that authorized it.
  authorizedByUserId String?             @map("authorized_by_user_id") @db.Uuid
  removedAt          DateTime?           @map("removed_at") @db.Timestamptz(3)
  createdAt          DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)

  client       Client         @relation(fields: [businessId, clientId], references: [businessId, id], onDelete: Restrict)
  authorizedBy ClientAccount? @relation(fields: [businessId, authorizedByUserId], references: [businessId, userId], onDelete: Restrict)

  @@unique([processor, methodRef])
  @@unique([businessId, id])
  @@index([businessId, clientId, status])
  @@map("client_payment_methods")
}

/// DRAFT is not sold yet; ACTIVE is selectable for new sales; INACTIVE keeps its history but is not
/// offered. Archiving (`archived_at`) hides a service from both lists and keeps every record.
enum ServiceStatus {
  DRAFT
  ACTIVE
  INACTIVE
}

enum ServicePricingType {
  FIXED
  STARTING_AT
  HOURLY
  CUSTOM_QUOTE
  RECURRING
}

enum ServiceInclusionKind {
  INCLUDED
  NOT_INCLUDED
}

/// A group of services and packages ("Tax Preparation", "Advisory"). Deactivated (`archived_at`),
/// not deleted, while services use it; an unused one may be deleted.
model ServiceCategory {
  id          String    @id @default(uuid(7)) @db.Uuid
  businessId  String    @map("business_id") @db.Uuid
  name        String
  description String?
  iconKey     String?   @map("icon_key")
  /// `#rrggbb`.
  color       String?
  sortOrder   Int       @default(0) @map("sort_order")
  archivedAt  DateTime? @map("archived_at") @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  business         Business          @relation(fields: [businessId], references: [id])
  services         Service[]
  packages         ServicePackage[]
  promotionTargets PromotionTarget[]

  @@unique([businessId, name])
  @@unique([businessId, id])
  @@map("service_categories")
}

/// One line of a service's "What's Included" or "Not Included" list, in order.
model ServiceInclusion {
  id         String               @id @default(uuid(7)) @db.Uuid
  businessId String               @map("business_id") @db.Uuid
  serviceId  String               @map("service_id") @db.Uuid
  kind       ServiceInclusionKind
  text       String
  sortOrder  Int                  @default(0) @map("sort_order")
  createdAt  DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)

  service Service @relation(fields: [businessId, serviceId], references: [businessId, id], onDelete: Restrict)

  @@index([businessId, serviceId, kind, sortOrder])
  @@map("service_inclusions")
}

enum ServiceLineItemMode {
  INFORMATIONAL
  ADDITIVE
}

/// A component charge of a service (Service Line Items). Total is quantity times rate. With the
/// service's `line_item_mode` ADDITIVE they add up to the price; INFORMATIONAL ones only describe it.
model ServiceLineItem {
  id          String   @id @default(uuid(7)) @db.Uuid
  businessId  String   @map("business_id") @db.Uuid
  serviceId   String   @map("service_id") @db.Uuid
  name        String
  description String?
  quantity    Decimal  @default(1) @db.Decimal(10, 2)
  rateCents   Int      @map("rate_cents")
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  service Service @relation(fields: [businessId, serviceId], references: [businessId, id], onDelete: Restrict)

  @@index([businessId, serviceId, sortOrder])
  @@map("service_line_items")
}

/// An extra a service offers (Optional Add-Ons): a name, a price, optionally another catalog
/// service it stands for. `required` ones are always added; `client_selectable` ones the client may
/// choose; never both. Archived, not deleted, once an invoice used it.
model ServiceAddOn {
  id               String    @id @default(uuid(7)) @db.Uuid
  businessId       String    @map("business_id") @db.Uuid
  serviceId        String    @map("service_id") @db.Uuid
  name             String
  description      String?
  priceCents       Int       @map("price_cents")
  linkedServiceId  String?   @map("linked_service_id") @db.Uuid
  clientSelectable Boolean   @default(false) @map("client_selectable")
  required         Boolean   @default(false)
  sortOrder        Int       @default(0) @map("sort_order")
  archivedAt       DateTime? @map("archived_at") @db.Timestamptz(3)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  service       Service               @relation(fields: [businessId, serviceId], references: [businessId, id], onDelete: Restrict)
  linkedService Service?              @relation("ServiceAddOnLinked", fields: [businessId, linkedServiceId], references: [businessId, id], onDelete: Restrict)
  invoiceLines  InvoiceLine[]
  packageAddOns ServicePackageAddOn[]

  @@unique([businessId, id])
  @@unique([businessId, serviceId, name])
  @@map("service_add_ons")
}

/// A sellable bundle of catalog services at one price (Package Builder). Its services stay in the
/// catalog: removing one from a package never deletes it. "Total of selected services" and "client
/// savings" are worked out from current prices, never stored. The package price and discount are
/// what the firm decided; a draft may still lack its price. Archived, not deleted, once used.
model ServicePackage {
  id                String               @id @default(uuid(7)) @db.Uuid
  businessId        String               @map("business_id") @db.Uuid
  name              String
  categoryId        String?              @map("category_id") @db.Uuid
  shortDescription  String               @map("short_description")
  status            ServiceStatus        @default(DRAFT)
  iconKey           String?              @map("icon_key")
  packagePriceCents Int?                 @map("package_price_cents")
  /// An optional display and calculation aid: none, a percentage or a fixed amount off the services' total.
  discountType      InvoiceDiscountType? @map("discount_type")
  discountPercent   Decimal?             @map("discount_percent") @db.Decimal(5, 2)
  discountCents     Int?                 @map("discount_cents")
  visibleToClients  Boolean              @default(false) @map("visible_to_clients")
  allowClientAddOns Boolean              @default(false) @map("allow_client_add_ons")
  displayOnPortal   Boolean              @default(false) @map("display_on_portal")
  /// Staff only, up to 500 characters.
  internalNotes     String?              @map("internal_notes")
  updatedByUserId   String?              @map("updated_by_user_id") @db.Uuid
  archivedAt        DateTime?            @map("archived_at") @db.Timestamptz(3)
  createdAt         DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)

  business         Business              @relation(fields: [businessId], references: [id])
  category         ServiceCategory?      @relation(fields: [businessId, categoryId], references: [businessId, id], onDelete: Restrict)
  updatedBy        Membership?           @relation("PackageUpdatedBy", fields: [businessId, updatedByUserId], references: [businessId, userId], onDelete: Restrict)
  items            ServicePackageItem[]
  addOns           ServicePackageAddOn[]
  promotionTargets PromotionTarget[]

  @@unique([businessId, name])
  @@unique([businessId, id])
  @@index([businessId, status])
  @@map("service_packages")
}

/// A service in a package. `included` marks it part of the base package (it counts toward the
/// comparison value); one that is not included is listed but not part of the price.
model ServicePackageItem {
  id         String   @id @default(uuid(7)) @db.Uuid
  businessId String   @map("business_id") @db.Uuid
  packageId  String   @map("package_id") @db.Uuid
  serviceId  String   @map("service_id") @db.Uuid
  included   Boolean  @default(true)
  sortOrder  Int      @default(0) @map("sort_order")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  package ServicePackage @relation(fields: [businessId, packageId], references: [businessId, id], onDelete: Restrict)
  service Service        @relation(fields: [businessId, serviceId], references: [businessId, id], onDelete: Restrict)

  @@unique([businessId, packageId, serviceId])
  @@index([businessId, serviceId])
  @@map("service_package_items")
}

/// An optional extra a client may add to a package: one of a service's add-ons (`service_add_on_id`)
/// or one made for the package. Name and price are the package's own, so later catalog edits do not
/// change what the package offers.
model ServicePackageAddOn {
  id             String   @id @default(uuid(7)) @db.Uuid
  businessId     String   @map("business_id") @db.Uuid
  packageId      String   @map("package_id") @db.Uuid
  serviceAddOnId String?  @map("service_add_on_id") @db.Uuid
  name           String
  description    String?
  priceCents     Int      @map("price_cents")
  sortOrder      Int      @default(0) @map("sort_order")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  package ServicePackage @relation(fields: [businessId, packageId], references: [businessId, id], onDelete: Restrict)
  addOn   ServiceAddOn?  @relation(fields: [businessId, serviceAddOnId], references: [businessId, id], onDelete: Restrict)

  @@unique([businessId, packageId, name])
  @@map("service_package_add_ons")
}

/// What a promotion discounts.
enum PromotionAppliesTo {
  ALL
  CATEGORIES
  SERVICES
  PACKAGES
}

enum PromotionEligibility {
  ALL_CLIENTS
  NEW_CLIENTS
  EXISTING_CLIENTS
}

/// DRAFT is not live; ACTIVE is live inside its dates ("Scheduled" before `starts_at` and "Expired"
/// after `ends_at` are worked out from the dates); INACTIVE was ended by the firm.
enum PromotionStatus {
  DRAFT
  ACTIVE
  INACTIVE
}

/// A date-limited or rule-based discount (Discounts and Promotions). Changing or ending one never
/// rewrites a completed invoice: the discount an invoice got is on the invoice and in its
/// redemption. By default a promotion does not stack with another on the same invoice.
model Promotion {
  id              String               @id @default(uuid(7)) @db.Uuid
  businessId      String               @map("business_id") @db.Uuid
  /// The firm's own name for it; not shown to clients.
  name            String
  description     String?
  discountType    InvoiceDiscountType  @map("discount_type")
  discountPercent Decimal?             @map("discount_percent") @db.Decimal(5, 2)
  discountCents   Int?                 @map("discount_cents")
  appliesTo       PromotionAppliesTo   @default(ALL) @map("applies_to")
  /// The window, in instants; the firm picks them in its own time zone.
  startsAt        DateTime?            @map("starts_at") @db.Timestamptz(3)
  endsAt          DateTime?            @map("ends_at") @db.Timestamptz(3)
  eligibility     PromotionEligibility @default(ALL_CLIENTS)
  /// Upper-case letters, digits, hyphens and underscores; unique in the firm.
  promoCode       String?              @map("promo_code")
  allowStacking   Boolean              @default(false) @map("allow_stacking")
  status          PromotionStatus      @default(DRAFT)
  createdAt       DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)

  business    Business              @relation(fields: [businessId], references: [id])
  targets     PromotionTarget[]
  redemptions PromotionRedemption[]

  @@unique([businessId, id])
  @@index([businessId, status])
  @@map("promotions")
}

/// One category, service or package a promotion applies to (for appliesTo CATEGORIES, SERVICES or
/// PACKAGES; ALL has none). Exactly one of the three is set, and it matches the promotion's kind.
model PromotionTarget {
  id          String   @id @default(uuid(7)) @db.Uuid
  businessId  String   @map("business_id") @db.Uuid
  promotionId String   @map("promotion_id") @db.Uuid
  categoryId  String?  @map("category_id") @db.Uuid
  serviceId   String?  @map("service_id") @db.Uuid
  packageId   String?  @map("package_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  promotion Promotion        @relation(fields: [businessId, promotionId], references: [businessId, id], onDelete: Restrict)
  category  ServiceCategory? @relation(fields: [businessId, categoryId], references: [businessId, id], onDelete: Restrict)
  service   Service?         @relation(fields: [businessId, serviceId], references: [businessId, id], onDelete: Restrict)
  package   ServicePackage?  @relation(fields: [businessId, packageId], references: [businessId, id], onDelete: Restrict)

  @@index([businessId, promotionId])
  @@map("promotion_targets")
}

/// A promotion used on an invoice: who, which invoice and how much it took off. Insert-only, one per
/// promotion and invoice (a retry is a duplicate). Usage is the count of these.
model PromotionRedemption {
  id            String   @id @default(uuid(7)) @db.Uuid
  businessId    String   @map("business_id") @db.Uuid
  promotionId   String   @map("promotion_id") @db.Uuid
  invoiceId     String   @map("invoice_id") @db.Uuid
  clientId      String   @map("client_id") @db.Uuid
  discountCents Int      @map("discount_cents")
  redeemedAt    DateTime @default(now()) @map("redeemed_at") @db.Timestamptz(3)

  promotion Promotion @relation(fields: [businessId, promotionId], references: [businessId, id], onDelete: Restrict)
  invoice   Invoice   @relation(fields: [businessId, invoiceId], references: [businessId, id], onDelete: Restrict)
  client    Client    @relation(fields: [businessId, clientId], references: [businessId, id], onDelete: Restrict)

  @@unique([promotionId, invoiceId])
  @@index([businessId, invoiceId])
  @@index([businessId, clientId])
  @@map("promotion_redemptions")
}

/// Where a message goes: the client portal, email or a text message.
enum MessageChannel {
  PORTAL
  EMAIL
  SMS
}

/// A staff member silences internal alerts for one thread (Mute Conversation): messages still
/// arrive and the thread stays visible. `muted_until` empty is until unmuted. Unmuting deletes it.
model MessageThreadMute {
  id         String    @id @default(uuid(7)) @db.Uuid
  businessId String    @map("business_id") @db.Uuid
  threadId   String    @map("thread_id") @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  mutedUntil DateTime? @map("muted_until") @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  thread MessageThread @relation(fields: [businessId, threadId], references: [businessId, id], onDelete: Restrict)
  member Membership    @relation(fields: [businessId, userId], references: [businessId, userId], onDelete: Restrict)

  @@unique([threadId, userId])
  @@index([businessId, userId])
  @@map("message_thread_mutes")
}

/// A searchable tag on a thread; unique per thread ignoring case (SQL-only index).
model MessageThreadTag {
  id         String   @id @default(uuid(7)) @db.Uuid
  businessId String   @map("business_id") @db.Uuid
  threadId   String   @map("thread_id") @db.Uuid
  tag        String
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  thread MessageThread @relation(fields: [businessId, threadId], references: [businessId, id], onDelete: Restrict)

  @@index([businessId, threadId])
  @@index([businessId, tag])
  @@map("message_thread_tags")
}

/// The firm's Messages settings, one row per firm; no row means the column defaults. Provider
/// connections and credentials are in Integrations, never here.
model MessageSettings {
  businessId             String    @id @map("business_id") @db.Uuid
  portalEnabled          Boolean   @default(true) @map("portal_enabled")
  emailEnabled           Boolean   @default(true) @map("email_enabled")
  smsEnabled             Boolean   @default(false) @map("sms_enabled")
  /// The display name messages come from by default; the sending address is verified elsewhere.
  senderName             String?   @map("sender_name")
  /// The firm's default signature, up to 1000 characters; a member's own is `message_signatures`.
  signature              String?
  notifyUnread           Boolean   @default(true) @map("notify_unread")
  notifyAssignment       Boolean   @default(true) @map("notify_assignment")
  notifyReply            Boolean   @default(true) @map("notify_reply")
  notifyFailure          Boolean   @default(true) @map("notify_failure")
  notifyBulkComplete     Boolean   @default(true) @map("notify_bulk_complete")
  /// Who a new conversation goes to when nobody is named.
  defaultAssigneeUserId  String?   @map("default_assignee_user_id") @db.Uuid
  readReceiptsEnabled    Boolean   @default(false) @map("read_receipts_enabled")
  /// Archive threads after this many months of silence; empty keeps them open.
  retentionMonths        Int?      @map("retention_months")
  attachmentMaxMb        Int       @default(10) @map("attachment_max_mb")
  /// File types clients and staff may attach (extensions, lower case, from the approved list).
  allowedAttachmentTypes String[]  @default(["pdf", "doc", "docx", "jpg", "png"]) @map("allowed_attachment_types")
  /// No SMS or client alerts between these times of day, in the firm's time zone (both or neither).
  quietHoursStart        DateTime? @map("quiet_hours_start") @db.Time(0)
  quietHoursEnd          DateTime? @map("quiet_hours_end") @db.Time(0)
  /// A bulk send to more recipients than this needs an explicit confirmation.
  bulkConfirmThreshold   Int       @default(100) @map("bulk_confirm_threshold")
  bulkRequiresManager    Boolean   @default(true) @map("bulk_requires_manager")
  updatedByUserId        String?   @map("updated_by_user_id") @db.Uuid
  createdAt              DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt              DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  business        Business    @relation(fields: [businessId], references: [id])
  defaultAssignee Membership? @relation("MessageSettingsAssignee", fields: [businessId, defaultAssigneeUserId], references: [businessId, userId], onDelete: Restrict)
  updatedBy       Membership? @relation("MessageSettingsChangedBy", fields: [businessId, updatedByUserId], references: [businessId, userId], onDelete: Restrict)

  @@map("message_settings")
}

/// A member's own message signature, used on their messages instead of the firm's.
model MessageSignature {
  id         String   @id @default(uuid(7)) @db.Uuid
  businessId String   @map("business_id") @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  body       String
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  member Membership @relation(fields: [businessId, userId], references: [businessId, userId], onDelete: Restrict)

  @@unique([businessId, userId])
  @@map("message_signatures")
}

/// DIRECT: one conversation message to chosen recipients (New Message); BULK: a campaign to an
/// audience built from filters (Send Bulk Message).
enum OutboundMessageKind {
  DIRECT
  BULK
}

/// DRAFT -> SCHEDULED or SENDING -> SENT, PARTIAL or FAILED; DRAFT or SCHEDULED -> CANCELED. The text
/// can change until it is sending; SENT, PARTIAL, FAILED and CANCELED are final.
enum OutboundMessageStatus {
  DRAFT
  SCHEDULED
  SENDING
  SENT
  PARTIAL
  FAILED
  CANCELED
}

enum MessageAudience {
  CLIENTS
  LEADS
  BOTH
}

/// A message composed to one or more recipients, or a bulk campaign (Frames 2 and 3): its channel,
/// content, options, schedule and the audience snapshot. The text changes only while DRAFT or SCHEDULED.
model OutboundMessage {
  id                    String                @id @default(uuid(7)) @db.Uuid
  businessId            String                @map("business_id") @db.Uuid
  kind                  OutboundMessageKind
  channel               MessageChannel
  status                OutboundMessageStatus @default(DRAFT)
  subject               String?
  body                  String
  templateId            String?               @map("template_id") @db.Uuid
  /// The firm's local time, kept as an instant; allowed only while SCHEDULED.
  scheduledFor          DateTime?             @map("scheduled_for") @db.Timestamptz(3)
  /// The record it is about, e.g. "invoice" and its id (both or neither).
  relatedEntityType     String?               @map("related_entity_type")
  relatedEntityId       String?               @map("related_entity_id") @db.Uuid
  assignedUserId        String?               @map("assigned_user_id") @db.Uuid
  requestReadReceipt    Boolean               @default(false) @map("request_read_receipt")
  addToTimeline         Boolean               @default(true) @map("add_to_timeline")
  sendCopyToSender      Boolean               @default(false) @map("send_copy_to_sender")
  notifyOnComplete      Boolean               @default(false) @map("notify_on_complete")
  addToCommunicationLog Boolean               @default(false) @map("add_to_communication_log")
  /// BULK: who it goes to, and the filters that built the list (the API's own shape, up to 8 KB).
  audience              MessageAudience?
  audienceFilters       Json?                 @map("audience_filters")
  totalCount            Int?                  @map("total_count")
  canReceiveCount       Int?                  @map("can_receive_count")
  cannotReceiveCount    Int?                  @map("cannot_receive_count")
  /// A bulk send to more recipients than the firm's threshold needs this first.
  highVolumeConfirmedAt DateTime?             @map("high_volume_confirmed_at") @db.Timestamptz(3)
  createdByUserId       String                @map("created_by_user_id") @db.Uuid
  completedAt           DateTime?             @map("completed_at") @db.Timestamptz(3)
  canceledAt            DateTime?             @map("canceled_at") @db.Timestamptz(3)
  createdAt             DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)

  business   Business                   @relation(fields: [businessId], references: [id])
  template   MessageTemplate?           @relation(fields: [businessId, templateId], references: [businessId, id], onDelete: Restrict)
  assignedTo Membership?                @relation("OutboundAssignedTo", fields: [businessId, assignedUserId], references: [businessId, userId], onDelete: Restrict)
  createdBy  Membership                 @relation("OutboundCreatedBy", fields: [businessId, createdByUserId], references: [businessId, userId], onDelete: Restrict)
  recipients OutboundMessageRecipient[]
  files      OutboundMessageFile[]

  @@unique([businessId, id])
  @@index([businessId, status, scheduledFor])
  @@index([businessId, createdAt])
  @@map("outbound_messages")
}

/// QUEUED -> SENT -> DELIVERED -> READ, or FAILED (retried back to QUEUED, never after SENT), or
/// SKIPPED with the reason (final). A SENT recipient is never sent to again.
enum OutboundRecipientStatus {
  QUEUED
  SENT
  DELIVERED
  READ
  FAILED
  SKIPPED
}

/// Why a recipient could not receive the message ("Cannot Receive").
enum OutboundExclusion {
  NO_CONTACT
  NO_CONSENT
  NO_PORTAL_ACCESS
  PROVIDER_UNAVAILABLE
  SUPPRESSED
  NOT_PERMITTED
  MANUALLY_EXCLUDED
  DUPLICATE
}

/// One recipient of an outbound message, one row per recipient and channel (the idempotency: a
/// retry finds the row, never makes a second). A client's or a lead's. A portal delivery links the
/// conversation message it created. Only the outcome changes.
model OutboundMessageRecipient {
  id                String                  @id @default(uuid(7)) @db.Uuid
  businessId        String                  @map("business_id") @db.Uuid
  outboundMessageId String                  @map("outbound_message_id") @db.Uuid
  clientId          String?                 @map("client_id") @db.Uuid
  leadId            String?                 @map("lead_id") @db.Uuid
  channel           MessageChannel
  status            OutboundRecipientStatus @default(QUEUED)
  exclusion         OutboundExclusion?
  attempts          Int                     @default(0)
  /// The provider's message id, for support and bounces; never the address or the text.
  providerMessageId String?                 @map("provider_message_id")
  /// A short error code from the provider, never message content.
  lastError         String?                 @map("last_error")
  messageId         String?                 @map("message_id") @db.Uuid
  sentAt            DateTime?               @map("sent_at") @db.Timestamptz(3)
  deliveredAt       DateTime?               @map("delivered_at") @db.Timestamptz(3)
  readAt            DateTime?               @map("read_at") @db.Timestamptz(3)
  createdAt         DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime                @updatedAt @map("updated_at") @db.Timestamptz(3)

  outbound OutboundMessage @relation(fields: [businessId, outboundMessageId], references: [businessId, id], onDelete: Restrict)
  client   Client?         @relation(fields: [businessId, clientId], references: [businessId, id], onDelete: Restrict)
  lead     Lead?           @relation(fields: [businessId, leadId], references: [businessId, id], onDelete: Restrict)
  message  Message?        @relation(fields: [businessId, messageId], references: [businessId, id], onDelete: Restrict)

  @@index([businessId, outboundMessageId, status])
  @@index([businessId, clientId])
  @@index([businessId, leadId])
  @@map("outbound_message_recipients")
}

/// Part of the firm workspace a client's portal can show. The firm's default and a client's own are
/// both rows of `portal_module_visibility`; a module's visibility never shares every record in it.
enum PortalModule {
  TAX_RETURNS
  DOCUMENTS
  INVOICES_PAYMENTS
  APPOINTMENTS
  INTAKE_FORMS
  TASKS_REQUESTS
  MESSAGES
  REPORTS
}

enum BrandTheme {
  LIGHT
  DARK
  SYSTEM
}

enum SidebarStyle {
  SOLID
  GRADIENT
}

enum SidebarPosition {
  LEFT
  RIGHT
}

enum DateFormat {
  MDY
  DMY
  YMD
}

/// A file attached to an outbound message (compose and bulk): a firm file under
/// `tenant/<business_id>/messages/`, at most 25 MB, scanned before it is sent. Added and removed
/// while the message is a draft or scheduled; the scan result is set once.
model OutboundMessageFile {
  id                String     @id @default(uuid(7)) @db.Uuid
  businessId        String     @map("business_id") @db.Uuid
  outboundMessageId String     @map("outbound_message_id") @db.Uuid
  fileName          String     @map("file_name")
  contentType       String     @map("content_type")
  sizeBytes         Int        @map("size_bytes")
  /// SHA-256 of the file, hex.
  sha256            String
  s3Key             String     @unique @map("s3_key")
  scanStatus        ScanStatus @default(PENDING) @map("scan_status")
  scannedAt         DateTime?  @map("scanned_at") @db.Timestamptz(3)
  uploadedByUserId  String     @map("uploaded_by_user_id") @db.Uuid
  createdAt         DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)

  outbound   OutboundMessage @relation(fields: [businessId, outboundMessageId], references: [businessId, id], onDelete: Restrict)
  uploadedBy Membership      @relation(fields: [businessId, uploadedByUserId], references: [businessId, userId], onDelete: Restrict)

  @@index([businessId, outboundMessageId])
  @@map("outbound_message_files")
}

/// Which portal modules show: the firm's default (`client_id` empty) and a client's own override.
/// No row means the default in the API's code (every module shown except REPORTS). Changing it never
/// deletes a record.
model PortalModuleVisibility {
  id              String       @id @default(uuid(7)) @db.Uuid
  businessId      String       @map("business_id") @db.Uuid
  clientId        String?      @map("client_id") @db.Uuid
  module          PortalModule
  visible         Boolean
  changedByUserId String?      @map("changed_by_user_id") @db.Uuid
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  business  Business    @relation(fields: [businessId], references: [id])
  client    Client?     @relation(fields: [businessId, clientId], references: [businessId, id], onDelete: Restrict)
  changedBy Membership? @relation(fields: [businessId, changedByUserId], references: [businessId, userId], onDelete: Restrict)

  @@index([businessId, clientId])
  @@map("portal_module_visibility")
}

/// A client's portal is locked (Lock Portal Access): their logins cannot sign in while the row
/// exists; unlocking deletes it. Nothing about the client or their records changes.
model ClientPortalLock {
  id             String   @id @default(uuid(7)) @db.Uuid
  businessId     String   @map("business_id") @db.Uuid
  clientId       String   @map("client_id") @db.Uuid
  lockedByUserId String   @map("locked_by_user_id") @db.Uuid
  /// Up to 200 characters, for the firm.
  reason         String?
  lockedAt       DateTime @default(now()) @map("locked_at") @db.Timestamptz(3)

  client   Client     @relation(fields: [businessId, clientId], references: [businessId, id], onDelete: Restrict)
  lockedBy Membership @relation(fields: [businessId, lockedByUserId], references: [businessId, userId], onDelete: Restrict)

  @@unique([businessId, clientId])
  @@map("client_portal_locks")
}

/// A client's portal activity feed (invitation, activation, sign-in, uploads, views, forms, invoice
/// views, payments): what the Activity tab and Recent Portal Activity show, with the address for
/// authorized staff. Insert-only; the audit log stays authoritative.
model ClientPortalActivity {
  id              String           @id @default(uuid(7)) @db.Uuid
  businessId      String           @map("business_id") @db.Uuid
  clientId        String           @map("client_id") @db.Uuid
  clientAccountId String?          @map("client_account_id") @db.Uuid
  /// A code such as `document.uploaded` or `portal.sign_in`.
  type            String
  entityType      String?          @map("entity_type")
  entityId        String?          @map("entity_id") @db.Uuid
  actorKind       InvoiceActorKind @default(CLIENT) @map("actor_kind")
  actorUserId     String?          @map("actor_user_id") @db.Uuid
  ip              String?          @db.Inet
  occurredAt      DateTime         @default(now()) @map("occurred_at") @db.Timestamptz(3)

  client        Client         @relation(fields: [businessId, clientId], references: [businessId, id], onDelete: Restrict)
  clientAccount ClientAccount? @relation(fields: [businessId, clientAccountId], references: [businessId, id], onDelete: Restrict)
  actor         Membership?    @relation(fields: [businessId, actorUserId], references: [businessId, userId], onDelete: Restrict)

  @@index([businessId, clientId, occurredAt])
  @@map("client_portal_activity")
}

/// The clients a staff member opened last in Client Portal ("Recent Clients").
model PortalRecentClient {
  id           String   @id @default(uuid(7)) @db.Uuid
  businessId   String   @map("business_id") @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  clientId     String   @map("client_id") @db.Uuid
  lastViewedAt DateTime @default(now()) @map("last_viewed_at") @db.Timestamptz(3)

  member Membership @relation(fields: [businessId, userId], references: [businessId, userId], onDelete: Restrict)
  client Client     @relation(fields: [businessId, clientId], references: [businessId, id], onDelete: Restrict)

  @@unique([businessId, userId, clientId])
  @@index([businessId, userId, lastViewedAt])
  @@map("portal_recent_clients")
}

/// Branding beyond the logo and colours: email, client portal and document branding (one row per
/// firm; no row means the firm's main branding and Firmivra's defaults). Asset keys are under the
/// firm's own prefix. Nothing here can remove required Firmivra security or legal notices.
model BusinessBrandProfile {
  businessId        String   @id @map("business_id") @db.Uuid
  emailLogoKey      String?  @map("email_logo_key")
  emailFromName     String?  @map("email_from_name")
  replyToEmail      String?  @map("reply_to_email")
  emailHeader       String?  @map("email_header")
  emailFooter       String?  @map("email_footer")
  emailDisclaimer   String?  @map("email_disclaimer")
  portalLogoKey     String?  @map("portal_logo_key")
  portalBrandColor  String?  @map("portal_brand_color")
  portalAccentColor String?  @map("portal_accent_color")
  letterheadHeader  String?  @map("letterhead_header")
  letterheadFooter  String?  @map("letterhead_footer")
  documentFooter    String?  @map("document_footer")
  signatureBlock    String?  @map("signature_block")
  legalText         String?  @map("legal_text")
  updatedByUserId   String?  @map("updated_by_user_id") @db.Uuid
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  business  Business    @relation(fields: [businessId], references: [id])
  updatedBy Membership? @relation(fields: [businessId, updatedByUserId], references: [businessId, userId], onDelete: Restrict)

  @@map("business_brand_profiles")
}

/// One published version of the firm's branding: what was live, so a sent email or a generated
/// document keeps the branding it was made with. Insert-only; numbered 1, 2, 3 per firm.
model BusinessBrandVersion {
  id                String   @id @default(uuid(7)) @db.Uuid
  businessId        String   @map("business_id") @db.Uuid
  version           Int
  /// The published values (colours, theme, asset keys, texts), up to 32 KB; never a secret.
  snapshot          Json
  publishedByUserId String?  @map("published_by_user_id") @db.Uuid
  publishedAt       DateTime @default(now()) @map("published_at") @db.Timestamptz(3)

  business    Business    @relation(fields: [businessId], references: [id])
  publishedBy Membership? @relation(fields: [businessId, publishedByUserId], references: [businessId, userId], onDelete: Restrict)

  @@unique([businessId, version])
  @@map("business_brand_versions")
}

// =====================================================================================
// R39: Communications, Templates, Reports, Integrations, Payroll, Business Advisory.
// Tenant tables: business_id, forced RLS, same-firm foreign keys. Actor columns
// (created_by_user_id and the like) are plain ids set by the API from the session.

// ---------- Templates (message templates; Firm Sign templates are esign_templates) ----------

enum MessageTemplateKind {
  EMAIL
  SMS
  PORTAL_MESSAGE
  DOCUMENT_REQUEST
  INTAKE_ORGANIZER
  ENGAGEMENT_AGREEMENT
  INVOICE_PAYMENT
  APPOINTMENT
  TASK
  TAX_WORKFLOW
  BOOKKEEPING
  PAYROLL
  LEAD_FOLLOW_UP
  CAMPAIGN
  LETTER_NOTICE
  ANNOUNCEMENT
}

/// DRAFT is not offered to automations; ARCHIVED is hidden from pickers but kept for history.
enum MessageTemplateStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

/// Who can use a template: its owner only, the whole team, or the people in message_template_shares.
enum MessageTemplateAccess {
  PRIVATE
  TEAM
  SELECTED
}

/// A firm's own category inside one template kind ("Tax Season", "Appointments"). Archived, not deleted.
model TemplateCategory {
  id          String              @id @default(uuid(7)) @db.Uuid
  businessId  String              @map("business_id") @db.Uuid
  kind        MessageTemplateKind
  name        String
  description String?
  sortOrder   Int                 @default(0) @map("sort_order")
  archivedAt  DateTime?           @map("archived_at") @db.Timestamptz(3)
  createdAt   DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)

  templates MessageTemplate[]

  @@unique([businessId, kind, name])
  @@unique([businessId, id])
  @@map("template_categories")
}

/// A reusable message or checklist for Communications, Automations, Appointments and the other
/// modules. `body` and `subject` keep merge fields as `[Client First Name]` tokens; they resolve
/// at use time. Each save adds a message_template_versions row. `starterKey` marks one of the 48
/// preloaded templates (unique per firm, so seeding is repeatable). Archived, never deleted.
model MessageTemplate {
  id                   String                @id @default(uuid(7)) @db.Uuid
  businessId           String                @map("business_id") @db.Uuid
  kind                 MessageTemplateKind
  categoryId           String?               @map("category_id") @db.Uuid
  name                 String
  description          String?
  subject              String?
  previewText          String?               @map("preview_text")
  body                 String
  status               MessageTemplateStatus @default(DRAFT)
  access               MessageTemplateAccess @default(TEAM)
  tags                 String[]              @default([])
  /// Offered to Automations (only an ACTIVE template with a kind automations support).
  includeInAutomations Boolean               @default(false) @map("include_in_automations")
  starterKey           String?               @map("starter_key")
  /// The newest version number.
  version              Int                   @default(1)
  ownerUserId          String                @map("owner_user_id") @db.Uuid
  updatedByUserId      String?               @map("updated_by_user_id") @db.Uuid
  archivedAt           DateTime?             @map("archived_at") @db.Timestamptz(3)
  createdAt            DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)

  category       TemplateCategory?           @relation(fields: [businessId, categoryId], references: [businessId, id], onDelete: Restrict)
  versions       MessageTemplateVersion[]
  attachments    MessageTemplateAttachment[]
  shares         MessageTemplateShare[]
  favorites      MessageTemplateFavorite[]
  uses           MessageTemplateUse[]
  communications Communication[]

  outboundMessages OutboundMessage[]

  @@unique([businessId, id])
  @@unique([businessId, starterKey])
  @@index([businessId, kind, status])
  @@index([businessId, categoryId])
  @@index([businessId, ownerUserId])
  @@map("message_templates")
}

/// Insert-only snapshot of every save. Sends record the version they used.
model MessageTemplateVersion {
  id            String   @id @default(uuid(7)) @db.Uuid
  businessId    String   @map("business_id") @db.Uuid
  templateId    String   @map("template_id") @db.Uuid
  version       Int
  name          String
  subject       String?
  body          String
  savedByUserId String   @map("saved_by_user_id") @db.Uuid
  savedAt       DateTime @default(now()) @map("saved_at") @db.Timestamptz(3)

  template MessageTemplate @relation(fields: [businessId, templateId], references: [businessId, id], onDelete: Restrict)

  @@unique([businessId, templateId, version])
  @@map("message_template_versions")
}

/// A file attached to a template: an S3 key under the firm's prefix, never file content.
model MessageTemplateAttachment {
  id          String   @id @default(uuid(7)) @db.Uuid
  businessId  String   @map("business_id") @db.Uuid
  templateId  String   @map("template_id") @db.Uuid
  fileName    String   @map("file_name")
  contentType String   @map("content_type")
  sizeBytes   Int      @map("size_bytes")
  s3Key       String   @unique @map("s3_key")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  template MessageTemplate @relation(fields: [businessId, templateId], references: [businessId, id], onDelete: Restrict)

  @@index([businessId, templateId])
  @@map("message_template_attachments")
}

/// A person a SELECTED template is shared with ("Shared with Me").
model MessageTemplateShare {
  businessId String   @map("business_id") @db.Uuid
  templateId String   @map("template_id") @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  template MessageTemplate @relation(fields: [businessId, templateId], references: [businessId, id], onDelete: Cascade)

  @@id([templateId, userId])
  @@index([businessId, userId])
  @@map("message_template_shares")
}

/// A person's own favourite; it never changes anyone else's.
model MessageTemplateFavorite {
  businessId String   @map("business_id") @db.Uuid
  templateId String   @map("template_id") @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  template MessageTemplate @relation(fields: [businessId, templateId], references: [businessId, id], onDelete: Cascade)

  @@id([templateId, userId])
  @@index([businessId, userId])
  @@map("message_template_favorites")
}

/// Insert-only: one row per real use or send (never a preview or an edit). The use count is the
/// number of rows. `purpose` is the module ("communication", "automation", "appointment"...).
model MessageTemplateUse {
  id           String   @id @default(uuid(7)) @db.Uuid
  businessId   String   @map("business_id") @db.Uuid
  templateId   String   @map("template_id") @db.Uuid
  version      Int
  purpose      String
  entityType   String?  @map("entity_type")
  entityId     String?  @map("entity_id") @db.Uuid
  usedByUserId String?  @map("used_by_user_id") @db.Uuid
  usedAt       DateTime @default(now()) @map("used_at") @db.Timestamptz(3)

  template MessageTemplate @relation(fields: [businessId, templateId], references: [businessId, id], onDelete: Restrict)

  @@index([businessId, templateId, usedAt])
  @@map("message_template_uses")
}

/// One row per firm: the footer, disclaimer and signature the Branding & Letterhead tool adds to
/// letters and emails. The logo, name and colours come from business_settings.
model TemplateBranding {
  businessId        String   @id @map("business_id") @db.Uuid
  footerText        String?  @map("footer_text")
  disclaimer        String?
  signatureText     String?  @map("signature_text")
  letterheadEnabled Boolean  @default(true) @map("letterhead_enabled")
  updatedByUserId   String?  @map("updated_by_user_id") @db.Uuid
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("template_branding")
}

/// A firm-defined merge field (the Custom group): `[Key]` in a template, filled from `fallback`.
model CustomMergeField {
  id         String   @id @default(uuid(7)) @db.Uuid
  businessId String   @map("business_id") @db.Uuid
  key        String
  label      String
  fallback   String?
  sortOrder  Int      @default(0) @map("sort_order")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([businessId, key])
  @@map("custom_merge_fields")
}

// ---------- Integrations (connection records; Stripe and meeting links stay as they are) ----------

enum IntegrationConnectionStatus {
  CONNECTED
  SYNCING
  /// Authorization expired, a sync keeps failing, or a permission is missing (statusReason says which).
  NEEDS_ATTENTION
  PAUSED
  DISCONNECTED
}

/// Live (production) or Test (sandbox) credentials; the two never mix.
enum IntegrationEnvironment {
  LIVE
  TEST
}

enum IntegrationSyncDirection {
  IMPORT
  EXPORT
  TWO_WAY
}

enum IntegrationSyncMode {
  AUTO
  MANUAL
}

enum IntegrationSyncRunStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  PARTIAL
}

/// A firm's link to one outside provider (QuickBooks, Microsoft 365, Zoom, a payroll provider, a
/// custom API...). The catalog (names, categories, what each provider can do) lives in code, so
/// `provider` is a lower-case key the API checks against it. NEVER a secret: tokens and keys live
/// in the secret store, and `secretRef` only names where (a secret name or ARN). `settings` holds
/// non-secret options (default calendar, folders, event list). At most one connection per
/// provider and environment. Disconnected, never deleted: imported records and history stay.
model IntegrationConnection {
  id                String                      @id @default(uuid(7)) @db.Uuid
  businessId        String                      @map("business_id") @db.Uuid
  provider          String
  environment       IntegrationEnvironment      @default(LIVE)
  status            IntegrationConnectionStatus @default(CONNECTED)
  /// Why it needs attention, as a short code ("authorization_expired", "sync_failed").
  statusReason      String?                     @map("status_reason")
  /// The connected company, mailbox or account, as the provider names it.
  accountLabel      String?                     @map("account_label")
  /// Last 4 characters of the provider's account id, for the masked display.
  accountIdLast4    String?                     @map("account_id_last4")
  secretRef         String?                     @map("secret_ref")
  secretRotatedAt   DateTime?                   @map("secret_rotated_at") @db.Timestamptz(3)
  settings          Json                        @default("{}")
  /// The provider objects being synced ("invoices", "customers", "calendar"...).
  entities          String[]                    @default([])
  direction         IntegrationSyncDirection    @default(TWO_WAY)
  syncMode          IntegrationSyncMode         @default(AUTO) @map("sync_mode")
  syncEveryMinutes  Int?                        @map("sync_every_minutes")
  connectedAt       DateTime                    @default(now()) @map("connected_at") @db.Timestamptz(3)
  connectedByUserId String?                     @map("connected_by_user_id") @db.Uuid
  disconnectedAt    DateTime?                   @map("disconnected_at") @db.Timestamptz(3)
  lastSyncAt        DateTime?                   @map("last_sync_at") @db.Timestamptz(3)
  nextSyncAt        DateTime?                   @map("next_sync_at") @db.Timestamptz(3)
  lastCheckAt       DateTime?                   @map("last_check_at") @db.Timestamptz(3)
  createdAt         DateTime                    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime                    @updatedAt @map("updated_at") @db.Timestamptz(3)

  mappings       IntegrationFieldMapping[]
  syncRuns       IntegrationSyncRun[]
  communications Communication[]
  payrollClients PayrollClient[]

  @@unique([businessId, id])
  @@unique([businessId, provider, environment])
  @@index([businessId, status])
  @@map("integration_connections")
}

/// One mapped pair for a connection: a Firmivra field and the provider's field ("client.name" and
/// "Customer Name"), grouped by `scope` ("client", "lead", "invoice", "expense").
model IntegrationFieldMapping {
  id            String                   @id @default(uuid(7)) @db.Uuid
  businessId    String                   @map("business_id") @db.Uuid
  connectionId  String                   @map("connection_id") @db.Uuid
  scope         String
  localField    String                   @map("local_field")
  externalField String                   @map("external_field")
  direction     IntegrationSyncDirection @default(TWO_WAY)
  sortOrder     Int                      @default(0) @map("sort_order")
  createdAt     DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(3)

  connection IntegrationConnection @relation(fields: [businessId, connectionId], references: [businessId, id], onDelete: Cascade)

  @@unique([businessId, connectionId, scope, localField])
  @@map("integration_field_mappings")
}

/// One sync (or connection test, or webhook delivery) of one object type. Insert, then finish
/// once. `errorCode` and `errorMessage` are short and never carry tokens or record content. The
/// health counts (failed syncs, records pending) and Recent Activity read these rows.
model IntegrationSyncRun {
  id                String                   @id @default(uuid(7)) @db.Uuid
  businessId        String                   @map("business_id") @db.Uuid
  connectionId      String                   @map("connection_id") @db.Uuid
  /// "invoices", "customers", "test", "webhook"...
  entity            String
  status            IntegrationSyncRunStatus @default(QUEUED)
  manual            Boolean                  @default(false)
  requestedByUserId String?                  @map("requested_by_user_id") @db.Uuid
  recordCount       Int                      @default(0) @map("record_count")
  failedCount       Int                      @default(0) @map("failed_count")
  errorCode         String?                  @map("error_code")
  errorMessage      String?                  @map("error_message")
  startedAt         DateTime?                @map("started_at") @db.Timestamptz(3)
  finishedAt        DateTime?                @map("finished_at") @db.Timestamptz(3)
  createdAt         DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)

  connection IntegrationConnection @relation(fields: [businessId, connectionId], references: [businessId, id], onDelete: Restrict)

  @@index([businessId, connectionId, createdAt])
  @@index([businessId, status])
  @@map("integration_sync_runs")
}

enum IntegrationRequestStatus {
  NEW
  REVIEWING
  PLANNED
  IN_DEVELOPMENT
  AVAILABLE
  DECLINED
}

/// A firm's request for an integration that is not listed. Super Admin reviews it (status and
/// internal note) and the requester is told when the status changes.
model IntegrationRequest {
  id                String                   @id @default(uuid(7)) @db.Uuid
  businessId        String                   @map("business_id") @db.Uuid
  requestedByUserId String                   @map("requested_by_user_id") @db.Uuid
  providerName      String                   @map("provider_name")
  websiteUrl        String?                  @map("website_url")
  category          String?
  connectTo         String                   @map("connect_to")
  businessReason    String?                  @map("business_reason")
  status            IntegrationRequestStatus @default(NEW)
  internalNote      String?                  @map("internal_note")
  statusChangedAt   DateTime?                @map("status_changed_at") @db.Timestamptz(3)
  createdAt         DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([businessId, createdAt])
  @@index([status, createdAt])
  @@map("integration_requests")
}

// ---------- Communications: segments, lists and consent ----------

/// How a campaign goes out. Consent and suppression exist only for EMAIL and SMS.
enum CommunicationChannel {
  EMAIL
  SMS
  ANNOUNCEMENT
}

/// DYNAMIC: members come from `criteria` each time. STATIC: members are saved rows.
enum SegmentType {
  DYNAMIC
  STATIC
}

enum SegmentAudience {
  CLIENTS
  LEADS
  BOTH
}

/// A contact's standing on one channel. Anything but OPTED_IN keeps them out of campaigns.
enum ConsentStatus {
  OPTED_IN
  OPTED_OUT
  BOUNCED
  INVALID
  COMPLAINED
}

/// A saved audience: a dynamic segment (AND/OR groups in `criteria`, such as status, service,
/// tags, tax year, last contact) or a static list. `memberCount` is the last count the API
/// calculated at `lastRefreshedAt`; a campaign always recounts before it sends. Archived, never
/// deleted, so a scheduled campaign never loses its audience.
model CommunicationSegment {
  id              String          @id @default(uuid(7)) @db.Uuid
  businessId      String          @map("business_id") @db.Uuid
  name            String
  description     String?
  type            SegmentType
  audience        SegmentAudience @default(CLIENTS)
  criteria        Json            @default("{}")
  criteriaSummary String?         @map("criteria_summary")
  memberCount     Int             @default(0) @map("member_count")
  lastRefreshedAt DateTime?       @map("last_refreshed_at") @db.Timestamptz(3)
  ownerUserId     String          @map("owner_user_id") @db.Uuid
  archivedAt      DateTime?       @map("archived_at") @db.Timestamptz(3)
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  members CommunicationSegmentMember[]
  entries CommunicationAudienceEntry[]

  @@unique([businessId, id])
  @@unique([businessId, name])
  @@index([businessId, type])
  @@map("communication_segments")
}

/// A saved member of a STATIC list: one client or one lead.
model CommunicationSegmentMember {
  id         String   @id @default(uuid(7)) @db.Uuid
  businessId String   @map("business_id") @db.Uuid
  segmentId  String   @map("segment_id") @db.Uuid
  clientId   String?  @map("client_id") @db.Uuid
  leadId     String?  @map("lead_id") @db.Uuid
  addedAt    DateTime @default(now()) @map("added_at") @db.Timestamptz(3)

  segment CommunicationSegment @relation(fields: [businessId, segmentId], references: [businessId, id], onDelete: Cascade)
  client  Client?              @relation(fields: [businessId, clientId], references: [businessId, id], onDelete: Restrict)
  lead    Lead?                @relation(fields: [businessId, leadId], references: [businessId, id], onDelete: Restrict)

  @@unique([segmentId, clientId])
  @@unique([segmentId, leadId])
  @@index([businessId, clientId])
  @@index([businessId, leadId])
  @@map("communication_segment_members")
}

/// One contact's current standing on one channel (opt-in, opt-out, bounce, invalid, complaint).
/// No row: the firm's default applies. The API checks it again right before every send. The
/// history is in the audit log; `sourceCommunicationId` names the campaign that caused it.
model CommunicationConsent {
  id                    String               @id @default(uuid(7)) @db.Uuid
  businessId            String               @map("business_id") @db.Uuid
  clientId              String?              @map("client_id") @db.Uuid
  leadId                String?              @map("lead_id") @db.Uuid
  channel               CommunicationChannel
  status                ConsentStatus
  /// Where it came from: "portal", "unsubscribe_link", "reply_stop", "staff", "provider".
  source                String
  sourceCommunicationId String?              @map("source_communication_id") @db.Uuid
  changedByUserId       String?              @map("changed_by_user_id") @db.Uuid
  createdAt             DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)

  client Client? @relation(fields: [businessId, clientId], references: [businessId, id], onDelete: Restrict)
  lead   Lead?   @relation(fields: [businessId, leadId], references: [businessId, id], onDelete: Restrict)

  @@unique([businessId, clientId, channel])
  @@unique([businessId, leadId, channel])
  @@index([businessId, channel, status])
  @@map("communication_consents")
}

// ---------- Communications: campaigns ----------

/// DRAFT or SCHEDULED can be edited. SENDING, PAUSED, SENT, FAILED and CANCELLED never change
/// their content. Archiving is `archivedAt`, not a status, so it can be undone.
enum CommunicationStatus {
  DRAFT
  SCHEDULED
  SENDING
  PAUSED
  SENT
  FAILED
  CANCELLED
}

/// How a campaign was made from an earlier one (never by changing the earlier one).
enum CommunicationSourceKind {
  DUPLICATE
  RESEND_FAILED
  FOLLOW_UP
}

/// A segment, one person, or one person left out by hand.
enum AudienceEntryKind {
  SEGMENT
  CLIENT
  LEAD
  EXCLUDE_CLIENT
  EXCLUDE_LEAD
}

/// A bulk email, text or portal announcement, from draft to results. Once it leaves
/// DRAFT/SCHEDULED its content is a frozen snapshot (subject, body, sender, template and
/// version used). `idempotencyKey` stops a double send. The counts are the audience snapshot at
/// send time: selected, left out by the system (`exclusionCounts` by reason: unsubscribed,
/// invalid, missing channel, duplicate) and by hand, and the final count sent to. `connectionId`
/// is the email or SMS provider connection (Integrations) it goes out through. Never deleted.
model Communication {
  id                    String                   @id @default(uuid(7)) @db.Uuid
  businessId            String                   @map("business_id") @db.Uuid
  channel               CommunicationChannel
  /// Internal campaign name, never sent to recipients.
  name                  String
  status                CommunicationStatus      @default(DRAFT)
  subject               String?
  previewText           String?                  @map("preview_text")
  body                  String                   @default("")
  fromName              String?                  @map("from_name")
  replyTo               String?                  @map("reply_to")
  connectionId          String?                  @map("connection_id") @db.Uuid
  templateId            String?                  @map("template_id") @db.Uuid
  templateVersion       Int?                     @map("template_version")
  /// [{ fileName, contentType, sizeBytes, s3Key }], by reference only.
  attachments           Json                     @default("[]")
  scheduledFor          DateTime?                @map("scheduled_for") @db.Timestamptz(3)
  /// The firm's time zone name the schedule was picked in.
  timezone              String?
  startedAt             DateTime?                @map("started_at") @db.Timestamptz(3)
  sentAt                DateTime?                @map("sent_at") @db.Timestamptz(3)
  cancelledAt           DateTime?                @map("cancelled_at") @db.Timestamptz(3)
  archivedAt            DateTime?                @map("archived_at") @db.Timestamptz(3)
  idempotencyKey        String?                  @map("idempotency_key")
  sourceCommunicationId String?                  @map("source_communication_id") @db.Uuid
  sourceKind            CommunicationSourceKind? @map("source_kind")
  selectedCount         Int?                     @map("selected_count")
  autoExcludedCount     Int?                     @map("auto_excluded_count")
  manualExcludedCount   Int?                     @map("manual_excluded_count")
  finalCount            Int?                     @map("final_count")
  exclusionCounts       Json                     @default("{}") @map("exclusion_counts")
  /// Announcements: when the portal shows it, and where.
  publishStartsAt       DateTime?                @map("publish_starts_at") @db.Timestamptz(3)
  publishEndsAt         DateTime?                @map("publish_ends_at") @db.Timestamptz(3)
  visibility            String?
  createdByUserId       String                   @map("created_by_user_id") @db.Uuid
  updatedByUserId       String?                  @map("updated_by_user_id") @db.Uuid
  createdAt             DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(3)

  template   MessageTemplate?             @relation(fields: [businessId, templateId], references: [businessId, id], onDelete: Restrict)
  connection IntegrationConnection?       @relation(fields: [businessId, connectionId], references: [businessId, id], onDelete: Restrict)
  source     Communication?               @relation("CommunicationSource", fields: [businessId, sourceCommunicationId], references: [businessId, id], onDelete: Restrict)
  derived    Communication[]              @relation("CommunicationSource")
  audience   CommunicationAudienceEntry[]
  recipients CommunicationRecipient[]
  events     CommunicationEvent[]

  @@unique([businessId, id])
  @@unique([businessId, idempotencyKey])
  @@index([businessId, status, scheduledFor])
  @@index([businessId, channel, createdAt])
  @@index([businessId, archivedAt])
  @@map("communications")
}

/// What the sender chose: segments, individuals, and people left out by hand. A segment entry
/// keeps the segment's name and criteria as they were when the campaign was sent
/// (`criteriaSnapshot`), so the results stay true if the segment changes later.
model CommunicationAudienceEntry {
  id               String            @id @default(uuid(7)) @db.Uuid
  businessId       String            @map("business_id") @db.Uuid
  communicationId  String            @map("communication_id") @db.Uuid
  kind             AudienceEntryKind
  segmentId        String?           @map("segment_id") @db.Uuid
  clientId         String?           @map("client_id") @db.Uuid
  leadId           String?           @map("lead_id") @db.Uuid
  segmentName      String?           @map("segment_name")
  criteriaSnapshot Json?             @map("criteria_snapshot")
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)

  communication Communication         @relation(fields: [businessId, communicationId], references: [businessId, id], onDelete: Cascade)
  segment       CommunicationSegment? @relation(fields: [businessId, segmentId], references: [businessId, id], onDelete: Restrict)
  client        Client?               @relation(fields: [businessId, clientId], references: [businessId, id], onDelete: Restrict)
  lead          Lead?                 @relation(fields: [businessId, leadId], references: [businessId, id], onDelete: Restrict)

  @@unique([communicationId, kind, segmentId])
  @@unique([communicationId, kind, clientId])
  @@unique([communicationId, kind, leadId])
  @@index([businessId, segmentId])
  @@map("communication_audience_entries")
}

// ---------- Communications: recipients and delivery events ----------

/// Where one recipient stands, in Firmivra's own words (provider states are normalized to these).
enum CommunicationRecipientStatus {
  QUEUED
  SENT
  DELIVERED
  OPENED
  CLICKED
  BOUNCED
  UNSUBSCRIBED
  FAILED
  /// Left out at send time (invalid address, suppressed...); failureCode says why.
  NOT_SENT
}

enum CommunicationEventType {
  QUEUED
  SENT
  DELIVERED
  OPENED
  CLICKED
  BOUNCED
  COMPLAINED
  UNSUBSCRIBED
  FAILED
}

/// One person a campaign was sent to: the recipient snapshot taken when sending started (one
/// client or one lead, once per campaign). No address or number is stored in full, only a masked
/// form for the results table. Only the delivery status and engagement figures change after
/// insert. Test sends are not recipients.
model CommunicationRecipient {
  id                String                       @id @default(uuid(7)) @db.Uuid
  businessId        String                       @map("business_id") @db.Uuid
  communicationId   String                       @map("communication_id") @db.Uuid
  clientId          String?                      @map("client_id") @db.Uuid
  leadId            String?                      @map("lead_id") @db.Uuid
  status            CommunicationRecipientStatus @default(QUEUED)
  /// "j***@example.com" or "***-***-1234".
  addressMask       String                       @map("address_mask")
  providerMessageId String?                      @map("provider_message_id")
  failureCode       String?                      @map("failure_code")
  sentAt            DateTime?                    @map("sent_at") @db.Timestamptz(3)
  deliveredAt       DateTime?                    @map("delivered_at") @db.Timestamptz(3)
  firstOpenedAt     DateTime?                    @map("first_opened_at") @db.Timestamptz(3)
  openCount         Int                          @default(0) @map("open_count")
  firstClickedAt    DateTime?                    @map("first_clicked_at") @db.Timestamptz(3)
  clickCount        Int                          @default(0) @map("click_count")
  unsubscribedAt    DateTime?                    @map("unsubscribed_at") @db.Timestamptz(3)
  createdAt         DateTime                     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime                     @updatedAt @map("updated_at") @db.Timestamptz(3)

  communication Communication        @relation(fields: [businessId, communicationId], references: [businessId, id], onDelete: Restrict)
  client        Client?              @relation(fields: [businessId, clientId], references: [businessId, id], onDelete: Restrict)
  lead          Lead?                @relation(fields: [businessId, leadId], references: [businessId, id], onDelete: Restrict)
  events        CommunicationEvent[]

  @@unique([businessId, id])
  @@unique([communicationId, clientId])
  @@unique([communicationId, leadId])
  @@index([businessId, communicationId, status])
  @@map("communication_recipients")
}

/// Insert-only: one normalized provider or system event of a sent campaign (the Activity tab and
/// the daily engagement chart). `providerEventId` makes a repeated webhook delivery a no-op.
/// `detailCode` is a short code, never message content.
model CommunicationEvent {
  id              String                 @id @default(uuid(7)) @db.Uuid
  businessId      String                 @map("business_id") @db.Uuid
  communicationId String                 @map("communication_id") @db.Uuid
  recipientId     String?                @map("recipient_id") @db.Uuid
  type            CommunicationEventType
  occurredAt      DateTime               @map("occurred_at") @db.Timestamptz(3)
  providerEventId String?                @map("provider_event_id")
  detailCode      String?                @map("detail_code")
  createdAt       DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)

  communication Communication           @relation(fields: [businessId, communicationId], references: [businessId, id], onDelete: Restrict)
  recipient     CommunicationRecipient? @relation(fields: [businessId, recipientId], references: [businessId, id], onDelete: Restrict)

  @@unique([communicationId, providerEventId])
  @@index([businessId, communicationId, occurredAt])
  @@index([businessId, recipientId])
  @@map("communication_events")
}

// ---------- Reports: saved report definitions (engagement_reports stay as they are) ----------

enum ReportCategory {
  FINANCIAL
  CLIENT
  TAX
  BOOKKEEPING
  PAYROLL
  LEADS
  COMMUNICATIONS
  TEAM_PRODUCTIVITY
  ADVISORY
}

enum ReportVisibility {
  PRIVATE
  /// The people in report_shares and the roles in `sharedRoles`.
  SELECTED
  COMPANY
}

/// A saved report keeps its settings, with either a fixed date range or a rolling one.
enum ReportDateRule {
  FIXED
  ROLLING
}

/// Which money "Total Revenue" means in every report, KPI card and export of the firm.
enum RevenueBasis {
  COLLECTED
  INVOICED
}

/// A saved report: what the Custom Report Builder stores. Built-in quick reports live in code.
/// It holds the definition (source, ordered columns, filters, grouping, sort, date rule, chart),
/// never frozen results. Field names are validated by the API against the source's field list;
/// the database also refuses any column that names a secret or an identifier no report may show.
/// Archived, never deleted, so a past run still points at it.
model ReportDefinition {
  id                String           @id @default(uuid(7)) @db.Uuid
  businessId        String           @map("business_id") @db.Uuid
  category          ReportCategory
  /// The primary dataset ("invoices_payments", "clients", "returns"...).
  dataSource        String           @map("data_source")
  name              String
  description       String?
  /// Selected columns, in display order.
  columns           String[]         @default([])
  /// Conditions: [{ field, op, value }] or AND/OR groups of them.
  filters           Json             @default("[]")
  groupBy           String?          @map("group_by")
  sortBy            String?          @map("sort_by")
  sortDescending    Boolean          @default(false) @map("sort_descending")
  showTotals        Boolean          @default(false) @map("show_totals")
  showPercentage    Boolean          @default(false) @map("show_percentage")
  includeComparison Boolean          @default(false) @map("include_comparison")
  /// "previous_period" or "same_period_last_year".
  compareTo         String?          @map("compare_to")
  dateRule          ReportDateRule   @default(ROLLING) @map("date_rule")
  /// ROLLING: "last_7_days", "this_month", "previous_month", "this_year"...
  datePreset        String?          @map("date_preset")
  dateFrom          DateTime?        @map("date_from") @db.Date
  dateTo            DateTime?        @map("date_to") @db.Date
  chartType         String           @default("auto") @map("chart_type")
  showDataLabels    Boolean          @default(false) @map("show_data_labels")
  includeTaxRevenue Boolean          @default(false) @map("include_tax_revenue")
  visibility        ReportVisibility @default(PRIVATE)
  /// With SELECTED: firm roles that can open it (OWNER, ADMIN, STAFF).
  sharedRoles       String[]         @default([]) @map("shared_roles")
  ownerUserId       String           @map("owner_user_id") @db.Uuid
  archivedAt        DateTime?        @map("archived_at") @db.Timestamptz(3)
  createdAt         DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  shares    ReportShare[]
  favorites ReportFavorite[]
  schedules ReportSchedule[]
  runs      ReportRun[]

  @@unique([businessId, id])
  @@index([businessId, category])
  @@index([businessId, ownerUserId])
  @@map("report_definitions")
}

/// A person a SELECTED report is shared with.
model ReportShare {
  businessId   String   @map("business_id") @db.Uuid
  definitionId String   @map("definition_id") @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  definition ReportDefinition @relation(fields: [businessId, definitionId], references: [businessId, id], onDelete: Cascade)

  @@id([definitionId, userId])
  @@index([businessId, userId])
  @@map("report_shares")
}

/// A person's own favourite report.
model ReportFavorite {
  businessId   String   @map("business_id") @db.Uuid
  definitionId String   @map("definition_id") @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  definition ReportDefinition @relation(fields: [businessId, definitionId], references: [businessId, id], onDelete: Cascade)

  @@id([definitionId, userId])
  @@index([businessId, userId])
  @@map("report_favorites")
}

/// One row per firm: the metric definitions every report, KPI card and export shares, so the
/// numbers reconcile. `staleAfterMinutes` is when a cached aggregate shows a freshness warning.
model ReportSettings {
  businessId        String       @id @map("business_id") @db.Uuid
  revenueBasis      RevenueBasis @default(COLLECTED) @map("revenue_basis")
  includeTaxDefault Boolean      @default(false) @map("include_tax_default")
  defaultDatePreset String       @default("this_year") @map("default_date_preset")
  staleAfterMinutes Int          @default(60) @map("stale_after_minutes")
  updatedByUserId   String?      @map("updated_by_user_id") @db.Uuid
  createdAt         DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("report_settings")
}

// ---------- Reports: schedules and run history ----------

enum ReportFrequency {
  DAILY
  WEEKLY
  MONTHLY
  QUARTERLY
  ANNUAL
}

enum ReportFormat {
  PDF
  XLSX
  CSV
}

/// VIEW: opened on screen (Recent Reports). EXPORT: a download. SCHEDULED: made by a schedule.
/// SNAPSHOT: a saved copy of the numbers at that moment.
enum ReportRunKind {
  VIEW
  EXPORT
  SCHEDULED
  SNAPSHOT
}

enum ReportRunStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
}

/// A recurring run of a saved report (`definitionId`) or of a built-in quick report (`systemKey`),
/// in the firm's time zone. `nextRunAt` is what the scheduler job reads.
model ReportSchedule {
  id                  String           @id @default(uuid(7)) @db.Uuid
  businessId          String           @map("business_id") @db.Uuid
  definitionId        String?          @map("definition_id") @db.Uuid
  systemKey           String?          @map("system_key")
  name                String
  frequency           ReportFrequency
  /// WEEKLY: 0 = Sunday to 6.
  weekday             Int?
  /// MONTHLY, QUARTERLY (the first month of each quarter) and ANNUAL: 1 to 31 (the API clamps to the month's last day).
  dayOfMonth          Int?             @map("day_of_month")
  monthOfYear         Int?             @map("month_of_year")
  runTime             DateTime         @map("run_time") @db.Time(0)
  timezone            String
  /// The date range each run uses, a rolling preset such as "previous_month".
  datePreset          String           @map("date_preset")
  formats             ReportFormat[]
  deliverEmail        Boolean          @default(true) @map("deliver_email")
  deliverInApp        Boolean          @default(false) @map("deliver_in_app")
  active              Boolean          @default(true)
  /// "Delete Schedule": stops future runs, keeps the schedule for the runs that point at it.
  deletedAt           DateTime?        @map("deleted_at") @db.Timestamptz(3)
  nextRunAt           DateTime?        @map("next_run_at") @db.Timestamptz(3)
  lastRunAt           DateTime?        @map("last_run_at") @db.Timestamptz(3)
  lastStatus          ReportRunStatus? @map("last_status")
  consecutiveFailures Int              @default(0) @map("consecutive_failures")
  ownerUserId         String           @map("owner_user_id") @db.Uuid
  createdAt           DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  definition ReportDefinition?         @relation(fields: [businessId, definitionId], references: [businessId, id], onDelete: Restrict)
  recipients ReportScheduleRecipient[]
  runs       ReportRun[]

  @@unique([businessId, id])
  @@index([businessId, active, nextRunAt])
  @@map("report_schedules")
}

/// Who gets a scheduled report: a firm member, or an outside email the firm approved.
model ReportScheduleRecipient {
  id         String   @id @default(uuid(7)) @db.Uuid
  businessId String   @map("business_id") @db.Uuid
  scheduleId String   @map("schedule_id") @db.Uuid
  userId     String?  @map("user_id") @db.Uuid
  email      String?
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  schedule ReportSchedule @relation(fields: [businessId, scheduleId], references: [businessId, id], onDelete: Cascade)

  @@unique([scheduleId, userId])
  @@unique([scheduleId, email])
  @@map("report_schedule_recipients")
}

/// One view, export, scheduled run or snapshot (the Recent Reports list and the audit of exports).
/// `definitionSnapshot` keeps the settings it ran with, so a later edit never changes what it was.
/// The file, if any, is an S3 key under the firm's prefix. Finished runs never change.
/// `sensitive` marks an export of financial or client data (also written to the audit log).
model ReportRun {
  id                 String          @id @default(uuid(7)) @db.Uuid
  businessId         String          @map("business_id") @db.Uuid
  definitionId       String?         @map("definition_id") @db.Uuid
  systemKey          String?         @map("system_key")
  scheduleId         String?         @map("schedule_id") @db.Uuid
  kind               ReportRunKind
  status             ReportRunStatus @default(QUEUED)
  requestedByUserId  String?         @map("requested_by_user_id") @db.Uuid
  format             ReportFormat?
  rangeFrom          DateTime?       @map("range_from") @db.Date
  rangeTo            DateTime?       @map("range_to") @db.Date
  definitionSnapshot Json            @default("{}") @map("definition_snapshot")
  s3Key              String?         @unique @map("s3_key")
  rowCount           Int?            @map("row_count")
  sensitive          Boolean         @default(false)
  errorCode          String?         @map("error_code")
  startedAt          DateTime?       @map("started_at") @db.Timestamptz(3)
  finishedAt         DateTime?       @map("finished_at") @db.Timestamptz(3)
  createdAt          DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)

  definition ReportDefinition? @relation(fields: [businessId, definitionId], references: [businessId, id], onDelete: Restrict)
  schedule   ReportSchedule?   @relation(fields: [businessId, scheduleId], references: [businessId, id], onDelete: Restrict)

  @@index([businessId, createdAt])
  @@index([businessId, definitionId])
  @@index([businessId, scheduleId])
  @@map("report_runs")
}

// ---------- Payroll: tracking only (Firmivra never runs payroll; the connected provider does) ----------

/// Firmivra's own workflow status for a payroll client, not the provider's.
enum PayrollClientStatus {
  ON_TRACK
  PROCESSING
  ACTION_REQUIRED
  PAST_DUE
  NOT_STARTED
  ON_HOLD
  ARCHIVED
}

enum PayrollFrequency {
  WEEKLY
  BIWEEKLY
  SEMI_MONTHLY
  MONTHLY
}

enum PayrollActivityKind {
  PAYROLL_REVIEW
  CLIENT_CALL
  PROVIDER_ISSUE
  NOTICE_FOLLOW_UP
  DOCUMENT_FOLLOW_UP
  OTHER
}

/// A client's payroll service, one per PAYROLL engagement. The engagement carries the plan
/// (service and package), the client and the history; tasks, notes, documents, appointments and
/// messages hang on that engagement. This row adds the payroll workflow: status, schedule, the
/// provider (`providerKey`, and the Integrations connection when connected), the employee count
/// the provider reported and when, next and last pay dates, and the assigned staff. Dates and
/// counts the provider has not confirmed stay empty: nothing is estimated. Paused or archived,
/// never deleted.
model PayrollClient {
  id                String              @id @default(uuid(7)) @db.Uuid
  businessId        String              @map("business_id") @db.Uuid
  clientId          String              @map("client_id") @db.Uuid
  engagementId      String              @map("engagement_id") @db.Uuid
  status            PayrollClientStatus @default(NOT_STARTED)
  frequency         PayrollFrequency?
  /// The payroll provider's catalog key ("gusto", "adp"...), set even before a connection exists.
  providerKey       String?             @map("provider_key")
  connectionId      String?             @map("connection_id") @db.Uuid
  industry          String?
  /// Reported by the provider or imported; null until then.
  employeeCount     Int?                @map("employee_count")
  employeeCountAt   DateTime?           @map("employee_count_at") @db.Timestamptz(3)
  nextPayrollOn     DateTime?           @map("next_payroll_on") @db.Date
  /// Where the next date came from: "provider" or "schedule".
  nextPayrollSource String?             @map("next_payroll_source")
  lastRunOn         DateTime?           @map("last_run_on") @db.Date
  lastSyncedAt      DateTime?           @map("last_synced_at") @db.Timestamptz(3)
  lastSyncAttemptAt DateTime?           @map("last_sync_attempt_at") @db.Timestamptz(3)
  assignedUserId    String?             @map("assigned_user_id") @db.Uuid
  serviceSince      DateTime?           @map("service_since") @db.Date
  pausedAt          DateTime?           @map("paused_at") @db.Timestamptz(3)
  archivedAt        DateTime?           @map("archived_at") @db.Timestamptz(3)
  /// Client-level options: report schedule, reminders, document checklist, portal visibility.
  settings          Json                @default("{}")
  createdAt         DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)

  client     Client                 @relation(fields: [businessId, clientId], references: [businessId, id], onDelete: Restrict)
  engagement Engagement             @relation(fields: [businessId, clientId, engagementId], references: [businessId, clientId, id], onDelete: Restrict)
  connection IntegrationConnection? @relation(fields: [businessId, connectionId], references: [businessId, id], onDelete: Restrict)
  changes    PayrollClientChange[]
  activities PayrollActivity[]
  workers    PayrollWorker[]
  runs       PayrollRun[]
  filings    PayrollFiling[]
  reports    PayrollReport[]
  yearEnds   PayrollYearEnd[]

  @@unique([businessId, id])
  @@unique([businessId, engagementId])
  @@unique([businessId, clientId, engagementId])
  @@index([businessId, status])
  @@index([businessId, nextPayrollOn])
  @@index([businessId, assignedUserId])
  @@map("payroll_clients")
}

/// Insert-only history of a payroll client's service: status, frequency, plan, assignee, pause,
/// archive, provider. Values are short codes or names, never payroll figures.
model PayrollClientChange {
  id              String   @id @default(uuid(7)) @db.Uuid
  businessId      String   @map("business_id") @db.Uuid
  payrollClientId String   @map("payroll_client_id") @db.Uuid
  field           String
  oldValue        String?  @map("old_value")
  newValue        String?  @map("new_value")
  reason          String?
  changedByUserId String?  @map("changed_by_user_id") @db.Uuid
  changedAt       DateTime @default(now()) @map("changed_at") @db.Timestamptz(3)

  payrollClient PayrollClient @relation(fields: [businessId, payrollClientId], references: [businessId, id], onDelete: Restrict)

  @@index([businessId, payrollClientId, changedAt])
  @@map("payroll_client_changes")
}

/// Insert-only log of what staff did for a payroll client (a review, a call, a provider issue).
/// Internal; never shown to the client.
model PayrollActivity {
  id              String              @id @default(uuid(7)) @db.Uuid
  businessId      String              @map("business_id") @db.Uuid
  payrollClientId String              @map("payroll_client_id") @db.Uuid
  kind            PayrollActivityKind
  summary         String
  occurredAt      DateTime            @default(now()) @map("occurred_at") @db.Timestamptz(3)
  loggedByUserId  String              @map("logged_by_user_id") @db.Uuid
  createdAt       DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)

  payrollClient PayrollClient @relation(fields: [businessId, payrollClientId], references: [businessId, id], onDelete: Restrict)

  @@index([businessId, payrollClientId, occurredAt])
  @@map("payroll_activities")
}

/// One row per firm: payroll module defaults. Provider credentials are never here (Integrations).
model PayrollSettings {
  businessId         String   @id @map("business_id") @db.Uuid
  defaultAssigneeId  String?  @map("default_assignee_id") @db.Uuid
  reminderDaysBefore Int      @default(3) @map("reminder_days_before")
  staleAfterHours    Int      @default(48) @map("stale_after_hours")
  /// Workflow labels, due-date rules, document request templates, report visibility.
  settings           Json     @default("{}")
  updatedByUserId    String?  @map("updated_by_user_id") @db.Uuid
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("payroll_settings")
}

// ---------- Payroll: workers and runs ----------

enum PayrollWorkerType {
  FULL_TIME
  PART_TIME
  CONTRACTOR
}

enum PayrollWorkerStatus {
  ACTIVE
  ON_LEAVE
  INACTIVE
  PENDING_SETUP
}

enum PayrollPayType {
  HOURLY
  SALARY
  COMMISSION
}

/// Firmivra's workflow for a run. The provider's own status is kept apart in `providerStatus`.
/// COMPLETED is final.
enum PayrollRunStatus {
  NOT_STARTED
  DRAFT
  IN_PROGRESS
  READY_FOR_REVIEW
  APPROVED
  SUBMITTED
  PROCESSING
  COMPLETED
  NEEDS_ATTENTION
}

/// An employee or contractor of a payroll client, as the provider or the firm lists them. No SSN,
/// no bank details, nothing that identifies a worker beyond name and job: those stay in the
/// provider. `rateCents` is the pay rate in cents (per hour, or per year for a salary) and the
/// API shows it only to staff allowed to see pay. Inactive, never deleted.
model PayrollWorker {
  id                 String              @id @default(uuid(7)) @db.Uuid
  businessId         String              @map("business_id") @db.Uuid
  payrollClientId    String              @map("payroll_client_id") @db.Uuid
  /// The provider's id for the worker, to match them on the next sync.
  externalId         String?             @map("external_id")
  displayName        String              @map("display_name")
  workerType         PayrollWorkerType   @map("worker_type")
  status             PayrollWorkerStatus @default(ACTIVE)
  payType            PayrollPayType?     @map("pay_type")
  rateCents          Int?                @map("rate_cents")
  department         String?
  jobTitle           String?             @map("job_title")
  startedOn          DateTime?           @map("started_on") @db.Date
  /// Readiness only (bank details validated at the provider); never the details.
  directDepositReady Boolean?            @map("direct_deposit_ready")
  /// "provider", "import" or "manual".
  source             String              @default("manual")
  sourceSyncedAt     DateTime?           @map("source_synced_at") @db.Timestamptz(3)
  lastChangeAt       DateTime?           @map("last_change_at") @db.Timestamptz(3)
  lastChangeNote     String?             @map("last_change_note")
  createdAt          DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)

  payrollClient PayrollClient     @relation(fields: [businessId, payrollClientId], references: [businessId, id], onDelete: Restrict)
  runLines      PayrollRunLine[]
  runIssues     PayrollRunIssue[]

  @@unique([businessId, id])
  @@unique([payrollClientId, externalId])
  @@index([businessId, payrollClientId, status])
  @@map("payroll_workers")
}

/// One pay period of one payroll client: the Run Payroll workflow (period, hours, earnings and
/// deductions, taxes and employer costs, review and approval). Money is in cents and stays empty
/// until the provider (or the firm, from a provider report) supplies it; Firmivra calculates no
/// payroll tax. Where the parts are all present the database checks the sums: gross, net,
/// employer costs and total cost. Approval is Firmivra's; submission is separate and needs the
/// provider to confirm it. A COMPLETED run never changes. Never deleted.
model PayrollRun {
  id                    String           @id @default(uuid(7)) @db.Uuid
  businessId            String           @map("business_id") @db.Uuid
  payrollClientId       String           @map("payroll_client_id") @db.Uuid
  periodStart           DateTime         @map("period_start") @db.Date
  periodEnd             DateTime         @map("period_end") @db.Date
  payDate               DateTime         @map("pay_date") @db.Date
  frequency             PayrollFrequency
  status                PayrollRunStatus @default(NOT_STARTED)
  /// The wizard step the preparer is on, 1 to 5.
  step                  Int              @default(1)
  includeContractors    Boolean          @default(true) @map("include_contractors")
  providerRunId         String?          @map("provider_run_id")
  providerStatus        String?          @map("provider_status")
  /// "provider" (read from the provider) or "manual".
  source                String           @default("manual")
  /// True once the figures below are the provider's confirmed ones.
  figuresConfirmed      Boolean          @default(false) @map("figures_confirmed")
  employeeCount         Int?             @map("employee_count")
  regularPayCents       Int?             @map("regular_pay_cents")
  overtimePayCents      Int?             @map("overtime_pay_cents")
  otherEarningsCents    Int?             @map("other_earnings_cents")
  grossCents            Int?             @map("gross_cents")
  employeeTaxesCents    Int?             @map("employee_taxes_cents")
  deductionsCents       Int?             @map("deductions_cents")
  netCents              Int?             @map("net_cents")
  employerTaxesCents    Int?             @map("employer_taxes_cents")
  employerBenefitsCents Int?             @map("employer_benefits_cents")
  employerCostsCents    Int?             @map("employer_costs_cents")
  totalCostCents        Int?             @map("total_cost_cents")
  preparedByUserId      String?          @map("prepared_by_user_id") @db.Uuid
  readyAt               DateTime?        @map("ready_at") @db.Timestamptz(3)
  approvedAt            DateTime?        @map("approved_at") @db.Timestamptz(3)
  approvedByUserId      String?          @map("approved_by_user_id") @db.Uuid
  submittedAt           DateTime?        @map("submitted_at") @db.Timestamptz(3)
  submittedByUserId     String?          @map("submitted_by_user_id") @db.Uuid
  /// The provider's confirmation reference after a submission.
  providerConfirmation  String?          @map("provider_confirmation")
  reopenedAt            DateTime?        @map("reopened_at") @db.Timestamptz(3)
  reopenReason          String?          @map("reopen_reason")
  completedAt           DateTime?        @map("completed_at") @db.Timestamptz(3)
  createdAt             DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  payrollClient PayrollClient     @relation(fields: [businessId, payrollClientId], references: [businessId, id], onDelete: Restrict)
  lines         PayrollRunLine[]
  issues        PayrollRunIssue[]
  reports       PayrollReport[]

  @@unique([businessId, id])
  @@unique([payrollClientId, periodStart, periodEnd])
  @@index([businessId, status, payDate])
  @@index([businessId, payrollClientId, payDate])
  @@map("payroll_runs")
}

// ---------- Payroll: run lines and exceptions ----------

enum PayrollLineStatus {
  READY
  WARNING
  ERROR
  PENDING_CHANGE
  EXCLUDED
}

enum PayrollIssueSeverity {
  INFO
  WARNING
  /// Blocks approval until resolved.
  ERROR
}

/// One worker's line in a run (the employee pay grid): hours and the pay parts in cents. The
/// total is checked against the parts. Lines of a run change only while it is being prepared.
model PayrollRunLine {
  id                 String            @id @default(uuid(7)) @db.Uuid
  businessId         String            @map("business_id") @db.Uuid
  runId              String            @map("run_id") @db.Uuid
  workerId           String            @map("worker_id") @db.Uuid
  hours              Decimal           @default(0) @db.Decimal(7, 2)
  regularPayCents    Int               @default(0) @map("regular_pay_cents")
  overtimePayCents   Int               @default(0) @map("overtime_pay_cents")
  otherEarningsCents Int               @default(0) @map("other_earnings_cents")
  deductionsCents    Int               @default(0) @map("deductions_cents")
  totalPayCents      Int               @default(0) @map("total_pay_cents")
  status             PayrollLineStatus @default(READY)
  note               String?
  createdAt          DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  run    PayrollRun    @relation(fields: [businessId, runId], references: [businessId, id], onDelete: Restrict)
  worker PayrollWorker @relation(fields: [businessId, workerId], references: [businessId, id], onDelete: Restrict)

  @@unique([runId, workerId])
  @@index([businessId, workerId])
  @@map("payroll_run_lines")
}

/// A warning or blocking error found for a run (missing bank validation, invalid hours, a tax
/// setup issue, an unusual overtime figure), from the provider or the firm's checks. The message
/// is short and names no pay, SSN or bank detail. An unresolved ERROR blocks approval.
model PayrollRunIssue {
  id               String               @id @default(uuid(7)) @db.Uuid
  businessId       String               @map("business_id") @db.Uuid
  runId            String               @map("run_id") @db.Uuid
  workerId         String?              @map("worker_id") @db.Uuid
  severity         PayrollIssueSeverity
  code             String
  message          String
  resolvedAt       DateTime?            @map("resolved_at") @db.Timestamptz(3)
  resolvedByUserId String?              @map("resolved_by_user_id") @db.Uuid
  createdAt        DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)

  run    PayrollRun     @relation(fields: [businessId, runId], references: [businessId, id], onDelete: Restrict)
  worker PayrollWorker? @relation(fields: [businessId, workerId], references: [businessId, id], onDelete: Restrict)

  @@index([businessId, runId, severity])
  @@map("payroll_run_issues")
}

// ---------- Payroll: filings, reports and year-end ----------

/// Only what the provider or an import confirmed. A Firmivra task being done never makes a filing
/// FILED or PAID.
enum PayrollFilingStatus {
  UPCOMING
  IN_PROGRESS
  FILED
  PAID
  FAILED
  NEEDS_ATTENTION
  UNKNOWN
}

enum PayrollPaymentStatus {
  SCHEDULED
  PAID
  FAILED
  UNKNOWN
}

enum PayrollReportKind {
  REGISTER
  EARNINGS
  DEDUCTIONS
  EMPLOYER_TAX
  TAX_FILING
  JOURNAL
  LABOR
  W2_W3
  FORM_1099
  OTHER
}

enum PayrollYearEndStatus {
  NOT_STARTED
  IN_PROGRESS
  RECONCILED
  DELIVERED
  ARCHIVED
}

/// Federal, state and local payroll filing and payment visibility for a payroll client: forms
/// (941, 940, W-2, W-3, state withholding...) with period, due date and status. Shown only as
/// the provider or an import confirmed it; FILED and PAID need that confirmation and its source.
model PayrollFiling {
  id              String               @id @default(uuid(7)) @db.Uuid
  businessId      String               @map("business_id") @db.Uuid
  payrollClientId String               @map("payroll_client_id") @db.Uuid
  form            String
  /// "federal", or a state or locality code.
  jurisdiction    String
  periodStart     DateTime             @map("period_start") @db.Date
  periodEnd       DateTime             @map("period_end") @db.Date
  dueOn           DateTime?            @map("due_on") @db.Date
  status          PayrollFilingStatus  @default(UNKNOWN)
  paymentStatus   PayrollPaymentStatus @default(UNKNOWN) @map("payment_status")
  /// The agency or provider reference, when there is one.
  confirmationRef String?              @map("confirmation_ref")
  /// "provider" or "import".
  source          String?
  sourceSyncedAt  DateTime?            @map("source_synced_at") @db.Timestamptz(3)
  confirmedAt     DateTime?            @map("confirmed_at") @db.Timestamptz(3)
  createdAt       DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)

  payrollClient PayrollClient @relation(fields: [businessId, payrollClientId], references: [businessId, id], onDelete: Restrict)

  @@unique([payrollClientId, form, jurisdiction, periodStart, periodEnd])
  @@index([businessId, payrollClientId, dueOn])
  @@map("payroll_filings")
}

/// A payroll report the provider supplied or the firm pulled or imported (register, earnings,
/// deductions, employer tax, journal, W-2/W-3...) for a period or one run. Insert-only: a new
/// pull is a new version, so earlier versions stay. The file, if any, is a vault document of the
/// same firm (`documentId`; checked by the database, so it cannot point at another firm's file).
model PayrollReport {
  id                String            @id @default(uuid(7)) @db.Uuid
  businessId        String            @map("business_id") @db.Uuid
  payrollClientId   String            @map("payroll_client_id") @db.Uuid
  runId             String?           @map("run_id") @db.Uuid
  kind              PayrollReportKind
  periodStart       DateTime          @map("period_start") @db.Date
  periodEnd         DateTime          @map("period_end") @db.Date
  version           Int               @default(1)
  documentId        String?           @map("document_id") @db.Uuid
  /// "provider" or "import".
  source            String
  pulledAt          DateTime          @default(now()) @map("pulled_at") @db.Timestamptz(3)
  requestedByUserId String?           @map("requested_by_user_id") @db.Uuid
  createdAt         DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)

  payrollClient PayrollClient @relation(fields: [businessId, payrollClientId], references: [businessId, id], onDelete: Restrict)
  run           PayrollRun?   @relation(fields: [businessId, runId], references: [businessId, id], onDelete: Restrict)

  @@unique([payrollClientId, kind, periodStart, periodEnd, version])
  @@index([businessId, payrollClientId, kind])
  @@map("payroll_reports")
}

/// A client's year-end payroll workflow for one tax year: worker review, missing information,
/// W-2/W-3, 1099, reconciliation, client delivery. `items` maps each step to its state. Statutory
/// dates stay in Compliance & Deadlines. Archived, never deleted, so year-end versions stay.
model PayrollYearEnd {
  id                String               @id @default(uuid(7)) @db.Uuid
  businessId        String               @map("business_id") @db.Uuid
  payrollClientId   String               @map("payroll_client_id") @db.Uuid
  taxYear           Int                  @map("tax_year")
  status            PayrollYearEndStatus @default(NOT_STARTED)
  items             Json                 @default("{}")
  exceptionsNote    String?              @map("exceptions_note")
  reconciledAt      DateTime?            @map("reconciled_at") @db.Timestamptz(3)
  deliveredAt       DateTime?            @map("delivered_at") @db.Timestamptz(3)
  deliveredByUserId String?              @map("delivered_by_user_id") @db.Uuid
  createdAt         DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)

  payrollClient PayrollClient @relation(fields: [businessId, payrollClientId], references: [businessId, id], onDelete: Restrict)

  @@unique([payrollClientId, taxYear])
  @@map("payroll_year_ends")
}

// ---------- Business Advisory: clients, services and settings ----------

enum AdvisoryClientStatus {
  IN_PROGRESS
  SCHEDULED
  NEEDS_REVIEW
  ON_HOLD
  COMPLETED
  ARCHIVED
}

enum AdvisoryServiceStatus {
  INTERESTED
  PROPOSED
  ACCEPTED
  IN_PROGRESS
  AWAITING_CLIENT
  COMPLETED
  DECLINED
  ON_HOLD
}

/// A client has one PRIMARY service focus (exactly one, in SQL) and any number of ADDITIONAL ones.
enum AdvisoryServiceRole {
  PRIMARY
  ADDITIONAL
}

/// A client in the advisory program. The BUSINESS_DEVELOPMENT engagement (optional, one per
/// client) carries the meetings (appointments), tasks, notes and documents; this row adds the
/// advisory workflow: status, advisor, the business stage, and the Business Health Score with the
/// factors and time it was calculated at (the formula lives in advisory_settings, never an
/// opaque score). Archived, never deleted.
model AdvisoryClient {
  id               String               @id @default(uuid(7)) @db.Uuid
  businessId       String               @map("business_id") @db.Uuid
  clientId         String               @map("client_id") @db.Uuid
  engagementId     String?              @map("engagement_id") @db.Uuid
  status           AdvisoryClientStatus @default(IN_PROGRESS)
  advisorUserId    String?              @map("advisor_user_id") @db.Uuid
  industry         String?
  /// "idea", "startup", "growth", "established"...: the firm's own words.
  businessStage    String?              @map("business_stage")
  /// 0 to 100, from the formula in advisory_settings; null until calculated.
  healthScore      Int?                 @map("health_score")
  /// What went into the score, by factor: [{ factor, weight, value }].
  healthFactors    Json                 @default("[]") @map("health_factors")
  healthComputedAt DateTime?            @map("health_computed_at") @db.Timestamptz(3)
  since            DateTime?            @db.Date
  archivedAt       DateTime?            @map("archived_at") @db.Timestamptz(3)
  createdAt        DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)

  client      Client                      @relation(fields: [businessId, clientId], references: [businessId, id], onDelete: Restrict)
  engagement  Engagement?                 @relation(fields: [businessId, clientId, engagementId], references: [businessId, clientId, id], onDelete: Restrict)
  workstreams AdvisoryWorkstream[]
  plans       AdvisoryPlan[]
  goals       AdvisoryGoal[]
  recs        AdvisoryRecommendation[]
  actions     AdvisoryActionItem[]
  financials  AdvisoryFinancialSnapshot[]

  @@unique([businessId, id])
  @@unique([businessId, clientId])
  @@unique([businessId, engagementId])
  @@unique([businessId, clientId, engagementId])
  @@index([businessId, status])
  @@index([businessId, advisorUserId])
  @@map("advisory_clients")
}

/// One service for an advisory client (business formation, EIN support, business planning,
/// branding, website, banking readiness, funding, financial analysis, growth, operations,
/// marketing and sales, staffing...) from the firm's own Services & Pricing catalog, with its
/// status and package. Regulated specialist needs are tracked as referral or project steps.
model AdvisoryWorkstream {
  id               String                @id @default(uuid(7)) @db.Uuid
  businessId       String                @map("business_id") @db.Uuid
  advisoryClientId String                @map("advisory_client_id") @db.Uuid
  serviceId        String                @map("service_id") @db.Uuid
  role             AdvisoryServiceRole   @default(ADDITIONAL)
  status           AdvisoryServiceStatus @default(INTERESTED)
  packageName      String?               @map("package_name")
  startedOn        DateTime?             @map("started_on") @db.Date
  completedOn      DateTime?             @map("completed_on") @db.Date
  createdAt        DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)

  advisoryClient AdvisoryClient @relation(fields: [businessId, advisoryClientId], references: [businessId, id], onDelete: Restrict)
  service        Service        @relation(fields: [businessId, serviceId], references: [businessId, id], onDelete: Restrict)
  goals          AdvisoryGoal[]

  @@unique([businessId, id])
  @@unique([advisoryClientId, serviceId])
  @@index([businessId, status])
  @@map("advisory_workstreams")
}

/// One row per firm: how the Business Health Score is calculated (factor weights, so the score
/// is explainable and configurable) and when financial figures count as stale.
model AdvisorySettings {
  businessId          String   @id @map("business_id") @db.Uuid
  healthFormula       Json     @default("[]") @map("health_formula")
  staleFinancialsDays Int      @default(120) @map("stale_financials_days")
  defaultAdvisorId    String?  @map("default_advisor_id") @db.Uuid
  updatedByUserId     String?  @map("updated_by_user_id") @db.Uuid
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("advisory_settings")
}

// ---------- Business Advisory: plans ----------

enum AdvisoryPlanStatus {
  DRAFT
  IN_REVIEW
  FINALIZED
  SENT
  IN_PROGRESS
  COMPLETED
  ARCHIVED
}

/// A business plan for an advisory client (the five-step Create/Edit Business Plan): its working
/// copy. Steps 1 to 3 live in three JSON documents the API validates with zod from
/// packages/types: `profile` (business identity, address, contacts, team, products and
/// services; the EIN is never here, only on the client's profile, masked), `assessment` (the
/// qualitative parts: sales, market, operations, strengths and challenges) and `strategy`
/// (goals and areas). The numbers, goals, milestones,
/// recommendations and action items are their own tables. Finalizing or sending adds an
/// immutable advisory_plan_versions row. Archived, never deleted.
model AdvisoryPlan {
  id               String             @id @default(uuid(7)) @db.Uuid
  businessId       String             @map("business_id") @db.Uuid
  advisoryClientId String             @map("advisory_client_id") @db.Uuid
  name             String
  targetYear       Int                @map("target_year")
  /// "growth", "startup", "funding"...: the firm's own plan types.
  planType         String?            @map("plan_type")
  status           AdvisoryPlanStatus @default(DRAFT)
  /// The wizard step the author is on, 1 to 5.
  step             Int                @default(1)
  /// The newest finalized version; 0 until the first.
  currentVersion   Int                @default(0) @map("current_version")
  profile          Json               @default("{}")
  assessment       Json               @default("{}")
  strategy         Json               @default("{}")
  finalizedAt      DateTime?          @map("finalized_at") @db.Timestamptz(3)
  sentAt           DateTime?          @map("sent_at") @db.Timestamptz(3)
  sentByUserId     String?            @map("sent_by_user_id") @db.Uuid
  createdByUserId  String             @map("created_by_user_id") @db.Uuid
  updatedByUserId  String?            @map("updated_by_user_id") @db.Uuid
  archivedAt       DateTime?          @map("archived_at") @db.Timestamptz(3)
  createdAt        DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  advisoryClient AdvisoryClient        @relation(fields: [businessId, advisoryClientId], references: [businessId, id], onDelete: Restrict)
  versions       AdvisoryPlanVersion[]
  goals          AdvisoryGoal[]

  recs    AdvisoryRecommendation[]
  actions AdvisoryActionItem[]

  financials AdvisoryFinancialSnapshot[]

  @@unique([businessId, id])
  @@index([businessId, advisoryClientId, targetYear])
  @@index([businessId, status])
  @@map("advisory_plans")
}

/// The record of a finalized or sent plan: everything the plan said at that moment (profile,
/// assessment, strategy, goals, recommendations, service workstreams, financial assumptions),
/// the date of the source data, and, once delivered, when, how and by whom. Insert-only except
/// that the delivery facts are set once. A later edit of the plan never changes a version.
model AdvisoryPlanVersion {
  id                String    @id @default(uuid(7)) @db.Uuid
  businessId        String    @map("business_id") @db.Uuid
  planId            String    @map("plan_id") @db.Uuid
  versionNo         Int       @map("version_no")
  content           Json
  sourceDataAsOf    DateTime? @map("source_data_as_of") @db.Date
  createdByUserId   String    @map("created_by_user_id") @db.Uuid
  deliveredAt       DateTime? @map("delivered_at") @db.Timestamptz(3)
  /// "portal", "email" or "download".
  deliveredChannel  String?   @map("delivered_channel")
  deliveredByUserId String?   @map("delivered_by_user_id") @db.Uuid
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  plan AdvisoryPlan @relation(fields: [businessId, planId], references: [businessId, id], onDelete: Restrict)

  @@unique([planId, versionNo])
  @@map("advisory_plan_versions")
}

// ---------- Business Advisory: goals and milestones ----------

enum AdvisoryGoalStatus {
  NOT_STARTED
  PLANNING
  IN_PROGRESS
  ON_TRACK
  AT_RISK
  OVERDUE
  COMPLETED
  CANCELLED
}

/// A business goal of an advisory client ("Increase annual revenue by 25%"), optionally part of a
/// plan and linked to one of the client's service workstreams. `area` is the firm's own grouping
/// (revenue growth, profitability, funding, expansion, staffing, operations, marketing and sales,
/// business setup, financial management). Progress is 0 to 100. Archived, never deleted.
model AdvisoryGoal {
  id               String             @id @default(uuid(7)) @db.Uuid
  businessId       String             @map("business_id") @db.Uuid
  advisoryClientId String             @map("advisory_client_id") @db.Uuid
  planId           String?            @map("plan_id") @db.Uuid
  workstreamId     String?            @map("workstream_id") @db.Uuid
  title            String
  description      String?
  area             String?
  targetDate       DateTime?          @map("target_date") @db.Date
  status           AdvisoryGoalStatus @default(NOT_STARTED)
  progressPercent  Int                @default(0) @map("progress_percent")
  ownerUserId      String?            @map("owner_user_id") @db.Uuid
  completedAt      DateTime?          @map("completed_at") @db.Timestamptz(3)
  archivedAt       DateTime?          @map("archived_at") @db.Timestamptz(3)
  createdAt        DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  advisoryClient AdvisoryClient           @relation(fields: [businessId, advisoryClientId], references: [businessId, id], onDelete: Restrict)
  plan           AdvisoryPlan?            @relation(fields: [businessId, planId], references: [businessId, id], onDelete: Restrict)
  workstream     AdvisoryWorkstream?      @relation(fields: [businessId, workstreamId], references: [businessId, id], onDelete: Restrict)
  milestones     AdvisoryMilestone[]
  recs           AdvisoryRecommendation[]
  actions        AdvisoryActionItem[]

  @@unique([businessId, id])
  @@index([businessId, advisoryClientId, status])
  @@index([businessId, targetDate])
  @@map("advisory_goals")
}

/// A step toward a goal, with its owner, target date, status and progress.
model AdvisoryMilestone {
  id              String             @id @default(uuid(7)) @db.Uuid
  businessId      String             @map("business_id") @db.Uuid
  goalId          String             @map("goal_id") @db.Uuid
  title           String
  targetDate      DateTime?          @map("target_date") @db.Date
  status          AdvisoryGoalStatus @default(NOT_STARTED)
  progressPercent Int                @default(0) @map("progress_percent")
  ownerUserId     String?            @map("owner_user_id") @db.Uuid
  sortOrder       Int                @default(0) @map("sort_order")
  completedAt     DateTime?          @map("completed_at") @db.Timestamptz(3)
  createdAt       DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  goal AdvisoryGoal @relation(fields: [businessId, goalId], references: [businessId, id], onDelete: Restrict)

  actions AdvisoryActionItem[]

  @@unique([businessId, id])
  @@index([businessId, goalId, sortOrder])
  @@map("advisory_milestones")
}

// ---------- Business Advisory: recommendations and action items ----------

enum AdvisoryRecommendationStatus {
  PROPOSED
  ACCEPTED
  IN_PROGRESS
  IMPLEMENTED
  NOT_APPLICABLE
  DECLINED
}

enum AdvisoryActionStatus {
  NOT_STARTED
  IN_PROGRESS
  DONE
  CANCELLED
}

enum AdvisoryPriority {
  LOW
  NORMAL
  HIGH
}

/// Who an action item is for. Tasks (the `tasks` table) can only name a staff member, but an
/// advisory action item is often the client's ("Gather 3 vendor quotes") or the firm team's.
enum AdvisoryAssigneeKind {
  STAFF
  CLIENT
  TEAM
}

/// An advisor's recommendation (SBA loan, job costing system, Section 179...) with its category,
/// rationale and expected impact. `impactLabel` is the words shown ("+15% Profit", "Better
/// Efficiency"); `impactCents` the amount when it is money. Only client-visible ones reach the
/// client portal or a sent plan. Never deleted.
model AdvisoryRecommendation {
  id               String                       @id @default(uuid(7)) @db.Uuid
  businessId       String                       @map("business_id") @db.Uuid
  advisoryClientId String                       @map("advisory_client_id") @db.Uuid
  planId           String?                      @map("plan_id") @db.Uuid
  goalId           String?                      @map("goal_id") @db.Uuid
  title            String
  /// funding, operations, tax_strategy, growth, team_development...
  category         String?
  rationale        String?
  impactLabel      String?                      @map("impact_label")
  impactCents      Int?                         @map("impact_cents")
  status           AdvisoryRecommendationStatus @default(PROPOSED)
  clientVisible    Boolean                      @default(false) @map("client_visible")
  decidedAt        DateTime?                    @map("decided_at") @db.Timestamptz(3)
  createdByUserId  String                       @map("created_by_user_id") @db.Uuid
  createdAt        DateTime                     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime                     @updatedAt @map("updated_at") @db.Timestamptz(3)

  advisoryClient AdvisoryClient @relation(fields: [businessId, advisoryClientId], references: [businessId, id], onDelete: Restrict)
  plan           AdvisoryPlan?  @relation(fields: [businessId, planId], references: [businessId, id], onDelete: Restrict)
  goal           AdvisoryGoal?  @relation(fields: [businessId, goalId], references: [businessId, id], onDelete: Restrict)

  @@index([businessId, advisoryClientId, status])
  @@map("advisory_recommendations")
}

/// Something to do for an advisory client: assigned to a staff member, to the client, or to the
/// firm team, with a due date, priority and status ("overdue" is a past due date on an open item,
/// worked out when read). Client-visible items show in the portal. Never deleted.
model AdvisoryActionItem {
  id               String               @id @default(uuid(7)) @db.Uuid
  businessId       String               @map("business_id") @db.Uuid
  advisoryClientId String               @map("advisory_client_id") @db.Uuid
  planId           String?              @map("plan_id") @db.Uuid
  goalId           String?              @map("goal_id") @db.Uuid
  milestoneId      String?              @map("milestone_id") @db.Uuid
  title            String
  details          String?
  assigneeKind     AdvisoryAssigneeKind @default(STAFF) @map("assignee_kind")
  /// With STAFF only.
  assigneeUserId   String?              @map("assignee_user_id") @db.Uuid
  dueOn            DateTime?            @map("due_on") @db.Date
  priority         AdvisoryPriority     @default(NORMAL)
  status           AdvisoryActionStatus @default(NOT_STARTED)
  clientVisible    Boolean              @default(false) @map("client_visible")
  completedAt      DateTime?            @map("completed_at") @db.Timestamptz(3)
  createdByUserId  String               @map("created_by_user_id") @db.Uuid
  createdAt        DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)

  advisoryClient AdvisoryClient     @relation(fields: [businessId, advisoryClientId], references: [businessId, id], onDelete: Restrict)
  plan           AdvisoryPlan?      @relation(fields: [businessId, planId], references: [businessId, id], onDelete: Restrict)
  goal           AdvisoryGoal?      @relation(fields: [businessId, goalId], references: [businessId, id], onDelete: Restrict)
  milestone      AdvisoryMilestone? @relation(fields: [businessId, milestoneId], references: [businessId, id], onDelete: Restrict)

  @@index([businessId, advisoryClientId, status])
  @@index([businessId, assigneeUserId, status])
  @@index([businessId, dueOn])
  @@map("advisory_action_items")
}

// ---------- Business Advisory: financial snapshots ----------

enum AdvisoryFinancialSource {
  MANUAL
  BOOKKEEPING
  PAYROLL
  BANK
  UPLOADED
}

/// A client's financial position for a period, in cents: revenue, expenses, net profit (checked
/// against them), cash flow, debt, headcount and optional budget figures, with its source and as-of
/// date. Insert-only: a correction is a new row. A manual override of figures from a source
/// (`overridden`) needs a reason and the person, and the earlier row stays as the "old value".
model AdvisoryFinancialSnapshot {
  id                  String                  @id @default(uuid(7)) @db.Uuid
  businessId          String                  @map("business_id") @db.Uuid
  advisoryClientId    String                  @map("advisory_client_id") @db.Uuid
  planId              String?                 @map("plan_id") @db.Uuid
  periodStart         DateTime                @map("period_start") @db.Date
  periodEnd           DateTime                @map("period_end") @db.Date
  revenueCents        Int?                    @map("revenue_cents")
  expensesCents       Int?                    @map("expenses_cents")
  netProfitCents      Int?                    @map("net_profit_cents")
  cashFlowCents       Int?                    @map("cash_flow_cents")
  debtCents           Int?                    @map("debt_cents")
  budgetRevenueCents  Int?                    @map("budget_revenue_cents")
  budgetExpensesCents Int?                    @map("budget_expenses_cents")
  headcount           Int?
  source              AdvisoryFinancialSource @default(MANUAL)
  asOf                DateTime                @map("as_of") @db.Date
  overridden          Boolean                 @default(false)
  overrideReason      String?                 @map("override_reason")
  overriddenByUserId  String?                 @map("overridden_by_user_id") @db.Uuid
  createdByUserId     String                  @map("created_by_user_id") @db.Uuid
  createdAt           DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)

  advisoryClient AdvisoryClient @relation(fields: [businessId, advisoryClientId], references: [businessId, id], onDelete: Restrict)
  plan           AdvisoryPlan?  @relation(fields: [businessId, planId], references: [businessId, id], onDelete: Restrict)

  @@index([businessId, advisoryClientId, periodEnd])
  @@map("advisory_financial_snapshots")
}

// ---------- Staff management (R35, migration r35_staff_roles_teams) ----------
// Departments, teams and who is in them, for Staff Management and Settings > Users & Roles
// (docs/mockups/firm-workspace/staff-management). Every table is a firm table with forced RLS.
// Departments and teams are never deleted: INACTIVE or ARCHIVED instead, so history stays.

enum StaffGroupStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

/// A member's place in a team: their one primary team, their one backup team, or a member.
enum TeamMemberKind {
  PRIMARY
  BACKUP
  MEMBER
}

/// A department (Tax, Bookkeeping, Payroll...). Names are unique per firm among those not
/// archived, case-insensitively (SQL-only partial index).
model Department {
  id               String           @id @default(uuid(7)) @db.Uuid
  businessId       String           @map("business_id") @db.Uuid
  name             String
  description      String?
  headMembershipId String?          @map("head_membership_id") @db.Uuid
  status           StaffGroupStatus @default(ACTIVE)
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  business Business           @relation(fields: [businessId], references: [id])
  head     Membership?        @relation("DepartmentHead", fields: [businessId, headMembershipId], references: [businessId, id], onDelete: Restrict)
  teams    Team[]
  members  MemberDepartment[]

  @@unique([businessId, id])
  @@index([businessId, status])
  @@map("departments")
}

/// A team inside one department. Names are unique per firm among those not archived,
/// case-insensitively (SQL-only partial index).
model Team {
  id               String           @id @default(uuid(7)) @db.Uuid
  businessId       String           @map("business_id") @db.Uuid
  departmentId     String           @map("department_id") @db.Uuid
  name             String
  description      String?
  leadMembershipId String?          @map("lead_membership_id") @db.Uuid
  status           StaffGroupStatus @default(ACTIVE)
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  department Department   @relation(fields: [businessId, departmentId], references: [businessId, id], onDelete: Restrict)
  lead       Membership?  @relation("TeamLead", fields: [businessId, leadMembershipId], references: [businessId, id], onDelete: Restrict)
  members    TeamMember[]

  @@unique([businessId, id])
  @@index([businessId, departmentId])
  @@map("teams")
}

/// A member of a team. A member has at most one PRIMARY and one BACKUP team (SQL-only partial
/// indexes); added only to an ACTIVE team.
model TeamMember {
  businessId   String         @map("business_id") @db.Uuid
  teamId       String         @map("team_id") @db.Uuid
  membershipId String         @map("membership_id") @db.Uuid
  kind         TeamMemberKind @default(MEMBER)
  createdAt    DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  team       Team       @relation(fields: [businessId, teamId], references: [businessId, id], onDelete: Restrict)
  membership Membership @relation(fields: [businessId, membershipId], references: [businessId, id], onDelete: Restrict)

  @@id([teamId, membershipId])
  @@index([businessId, membershipId])
  @@map("team_members")
}

/// A member's department (Department(s) on Create Staff); added only to an ACTIVE department.
model MemberDepartment {
  businessId   String   @map("business_id") @db.Uuid
  membershipId String   @map("membership_id") @db.Uuid
  departmentId String   @map("department_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  membership Membership @relation(fields: [businessId, membershipId], references: [businessId, id], onDelete: Restrict)
  department Department @relation(fields: [businessId, departmentId], references: [businessId, id], onDelete: Restrict)

  @@id([membershipId, departmentId])
  @@index([businessId, departmentId])
  @@map("member_departments")
}

// ---------- Staff details, access and security (R35, migration r35_staff_details) ----------
// What Create/Edit Staff and Staff Account Access & Security keep about a member, beyond the
// membership itself (role, status, job title, meeting link) and the person's login (name, email,
// phone: one user row across firms). One row per member in each table, created when the member
// is added or when the first field is saved. Firm tables with forced RLS. Compensation is also
// walled off in the database: only the acting Owner or Admin reads or writes it.

enum StaffEmploymentType {
  W2
  FORM_1099
  FULL_TIME
  PART_TIME
  CONTRACT
  TEMPORARY
  SEASONAL
  INTERN
  OTHER
}

/// The "User Access Level" on Create Staff. It labels the member's authority; what they can do
/// comes from the role and its permissions, never from this field alone.
enum StaffAccessLevel {
  STANDARD_USER
  MANAGER
  ADMINISTRATOR
}

enum StaffAuthMethod {
  AUTHENTICATOR_APP
  SMS
  EMAIL
  BACKUP_CODES
}

/// Where a member may sign in from: anywhere, only the listed IP addresses or networks, or only
/// the listed countries (approximate, from the viewer's IP; telemetry, not proof of location).
enum StaffAccessLocation {
  ANYWHERE
  ALLOWED_IPS
  ALLOWED_COUNTRIES
}

enum StaffPayType {
  SALARY
  HOURLY
  COMMISSION
  PER_PROJECT
  OTHER
}

enum StaffPayFrequency {
  WEEKLY
  BIWEEKLY
  SEMIMONTHLY
  MONTHLY
  ANNUALLY
}

/// Employment, assignment and internal-note details of one member. Dates are calendar dates
/// (no time); `time_zone` is an IANA name.
model StaffProfile {
  membershipId      String               @map("membership_id") @db.Uuid
  businessId        String               @map("business_id") @db.Uuid
  employmentType    StaffEmploymentType? @map("employment_type")
  /// Company-defined or custom ("Full-Time", "Mon-Thu"), up to 80 characters.
  workSchedule      String?              @map("work_schedule")
  /// The office or branch, up to 100 characters.
  office            String?
  hireDate          DateTime?            @map("hire_date") @db.Date
  endDate           DateTime?            @map("end_date") @db.Date
  supervisorId      String?              @map("supervisor_membership_id") @db.Uuid
  timeZone          String?              @map("time_zone")
  /// Unique per firm, ignoring case (SQL-only partial index).
  employeeId        String?              @map("employee_id")
  /// A service code (like `TAX_PREPARATION`): the member's main specialty.
  primarySpecialty  String?              @map("primary_specialty")
  /// Service codes that limit the member to those areas of work; empty means no limit.
  serviceAreas      String[]             @default([]) @map("service_areas")
  /// Clients or tasks the member can carry at once (1 to 10,000); null means no limit.
  maxWorkload       Int?                 @map("max_workload")
  acceptsNewClients Boolean              @default(true) @map("accepts_new_clients")
  accessLevel       StaffAccessLevel     @default(STANDARD_USER) @map("access_level")
  /// The member signs in from this date (inclusive, in their time zone) and not before.
  accessStartsOn    DateTime?            @map("access_starts_on") @db.Date
  /// Internal notes for Owners and Admins, up to 500 characters.
  notes             String?
  notesUpdatedAt    DateTime?            @map("notes_updated_at") @db.Timestamptz(3)
  notesUpdatedById  String?              @map("notes_updated_by_membership_id") @db.Uuid
  createdAt         DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)

  member         Membership  @relation("StaffProfileMember", fields: [businessId, membershipId], references: [businessId, id], onDelete: Restrict)
  supervisor     Membership? @relation("StaffSupervisor", fields: [businessId, supervisorId], references: [businessId, id], onDelete: Restrict)
  notesUpdatedBy Membership? @relation("StaffNotesUpdatedBy", fields: [businessId, notesUpdatedById], references: [businessId, id], onDelete: Restrict)

  @@id([businessId, membershipId])
  @@index([businessId, supervisorId])
  @@map("staff_profiles")
}

/// A member's sign-in rules and security notices. Two-factor sign-in is always required for
/// staff (the staff user pool), so there is no column for it. The API enforces `autoLogoutMinutes`,
/// the concurrent-session limit and the location rule on every request or sign-in.
model StaffSecuritySettings {
  membershipId            String              @map("membership_id") @db.Uuid
  businessId              String              @map("business_id") @db.Uuid
  requirePasswordChange   Boolean             @default(true) @map("require_password_change")
  passwordChangedAt       DateTime?           @map("password_changed_at") @db.Timestamptz(3)
  /// Set by the API at each sign-in; the directory's "Last Login".
  lastLoginAt             DateTime?           @map("last_login_at") @db.Timestamptz(3)
  allowedAuthMethods      StaffAuthMethod[]   @default([AUTHENTICATOR_APP, BACKUP_CODES]) @map("allowed_auth_methods")
  accessLocation          StaffAccessLocation @default(ANYWHERE) @map("access_location")
  /// IP addresses or networks (like `203.0.113.7` or `203.0.113.0/24`), at most 20; used when
  /// `accessLocation` is ALLOWED_IPS.
  allowedIps              String[]            @default([]) @map("allowed_ips")
  /// ISO 3166 two-letter codes, at most 50; used when `accessLocation` is ALLOWED_COUNTRIES.
  allowedCountries        String[]            @default([]) @map("allowed_countries")
  restrictDevices         Boolean             @default(false) @map("restrict_devices")
  /// Sign out after this many idle minutes (5 to 480); null means the firm's default.
  autoLogoutMinutes       Int?                @map("auto_logout_minutes")
  /// The account turns inactive on this date (inclusive); the API deactivates it then.
  disableOn               DateTime?           @map("disable_on") @db.Date
  maxConcurrentSessions   Int                 @default(1) @map("max_concurrent_sessions")
  signOutOtherSessions    Boolean             @default(false) @map("sign_out_other_sessions")
  allowTrustedDevices     Boolean             @default(false) @map("allow_trusted_devices")
  recoveryEmail           String?             @map("recovery_email")
  recoveryEmailVerifiedAt DateTime?           @map("recovery_email_verified_at") @db.Timestamptz(3)
  notifyNewDeviceLogin    Boolean             @default(true) @map("notify_new_device_login")
  notifyFailedLogins      Boolean             @default(true) @map("notify_failed_logins")
  notifyPasswordChanges   Boolean             @default(true) @map("notify_password_changes")
  notifySecurityAlerts    Boolean             @default(true) @map("notify_security_alerts")
  notifyLockouts          Boolean             @default(true) @map("notify_lockouts")
  /// When and why the account was locked (status LOCKED); both cleared on unlock.
  lockedAt                DateTime?           @map("locked_at") @db.Timestamptz(3)
  lockedReason            String?             @map("locked_reason")
  createdAt               DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt               DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)

  member Membership @relation(fields: [businessId, membershipId], references: [businessId, id], onDelete: Restrict)

  @@id([businessId, membershipId])
  @@map("staff_security_settings")
}

/// Pay details: HR data, restricted. The database shows these rows only to the acting Owner or
/// Admin (the session's actor), so a bug in a route or a role list cannot expose them. Never
/// logged, never in an audit entry's metadata (audit that it changed, not the values).
model StaffCompensation {
  membershipId String             @map("membership_id") @db.Uuid
  businessId   String             @map("business_id") @db.Uuid
  payType      StaffPayType?      @map("pay_type")
  /// The rate or salary in cents of USD (0 to 100,000,000.00).
  rateCents    BigInt?            @map("rate_cents")
  payFrequency StaffPayFrequency? @map("pay_frequency")
  /// A short description of a commission arrangement, up to 200 characters.
  commission   String?
  /// The payroll system's id for the member, up to 40 characters.
  payrollId    String?            @map("payroll_id")
  updatedAt    DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  member Membership @relation(fields: [businessId, membershipId], references: [businessId, id], onDelete: Restrict)

  @@id([businessId, membershipId])
  @@map("staff_compensation")
}

/// A Create Staff form saved with "Save as Draft": no account, no invitation, no access. It
/// holds what was typed so far (`data`, at most 20,000 characters; the database refuses
/// password, token or secret keys) and the step the person was on (1 to 4). Deleted once the
/// staff member is created or the draft is discarded.
model StaffDraft {
  id          String   @id @default(uuid(7)) @db.Uuid
  businessId  String   @map("business_id") @db.Uuid
  createdById String   @map("created_by_membership_id") @db.Uuid
  step        Int      @default(1)
  data        Json
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  createdBy Membership @relation(fields: [businessId, createdById], references: [businessId, id], onDelete: Restrict)

  @@index([businessId, updatedAt])
  @@map("staff_drafts")
}

// ---------- Staff documents and sessions (R35, migration r35_staff_documents_sessions) ----------
// HR files kept for a member, and the member's signed-in sessions. Firm tables with forced RLS.
// Documents are also walled off in the database: only the acting Owner or Admin reads or writes
// them (they hold W-4 and direct deposit forms). Login history needs no table: it is the audit
// log's `auth.signed_in` and `auth.sign_in_failed` rows.

enum StaffDocumentType {
  EMPLOYMENT_AGREEMENT
  CONTRACTOR_AGREEMENT
  W4
  DIRECT_DEPOSIT
  NDA
  CREDENTIAL_LICENSE
  TRAINING_ACKNOWLEDGMENT
  OTHER
}

/// A file kept for a staff member. The object is in the firm's private prefix
/// (`tenant/<business_id>/staff/<membership_id>/...`), served only through short-lived signed
/// links, scanned before anyone downloads it (PENDING until the scanner sets the result once).
/// Replacing a file adds a new row and archives the old one; nothing is deleted (retention).
model StaffDocument {
  id           String            @id @default(uuid(7)) @db.Uuid
  businessId   String            @map("business_id") @db.Uuid
  membershipId String            @map("membership_id") @db.Uuid
  type         StaffDocumentType
  fileName     String            @map("file_name")
  /// PDF, JPEG, PNG, DOC or DOCX only (database CHECK).
  contentType  String            @map("content_type")
  /// 1 byte to 10 MB.
  sizeBytes    Int               @map("size_bytes")
  /// Hex SHA-256 of the file.
  sha256       String
  s3Key        String            @unique @map("s3_key")
  scanStatus   ScanStatus        @default(PENDING) @map("scan_status")
  scannedAt    DateTime?         @map("scanned_at") @db.Timestamptz(3)
  uploadedById String?           @map("uploaded_by_membership_id") @db.Uuid
  createdAt    DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  archivedAt   DateTime?         @map("archived_at") @db.Timestamptz(3)

  member     Membership  @relation("StaffDocumentOwner", fields: [businessId, membershipId], references: [businessId, id], onDelete: Restrict)
  uploadedBy Membership? @relation("StaffDocumentUploader", fields: [businessId, uploadedById], references: [businessId, id], onDelete: Restrict)

  @@index([businessId, membershipId, createdAt])
  @@map("staff_documents")
}

/// One signed-in browser or device of a member (Active Sessions). `tokenHash` is the hex SHA-256
/// of an identifier the API derives from the session's refresh token, never the token. Device
/// and place are telemetry from the request (user agent and IP), not proof of who or where.
/// "Sign out" sets `revokedAt` and revokes the Cognito refresh token; the concurrent-session
/// limit counts rows with no `revokedAt` seen in the last 7 days (the refresh token's life).
model StaffSession {
  id           String    @id @default(uuid(7)) @db.Uuid
  businessId   String    @map("business_id") @db.Uuid
  membershipId String    @map("membership_id") @db.Uuid
  tokenHash    String    @unique @map("token_hash")
  /// A label like "Chrome on macOS", up to 100 characters.
  device       String
  ip           String?
  /// Approximate place from the IP, up to 100 characters; null when unknown.
  place        String?
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  lastActiveAt DateTime  @default(now()) @map("last_active_at") @db.Timestamptz(3)
  revokedAt    DateTime? @map("revoked_at") @db.Timestamptz(3)

  member Membership @relation(fields: [businessId, membershipId], references: [businessId, id], onDelete: Restrict)

  @@index([businessId, membershipId, revokedAt])
  @@map("staff_sessions")
}

// ---------- Permission matrix overrides (R35, migration r35_permission_overrides) ----------
// The module and capability grid of Settings > Users & Roles and Create Staff step 2. The
// defaults of each role are code (packages/types team/permissions.ts); these tables hold only
// what a firm changed from them: a role's row differs from its default, and a member's row
// differs from their role's (after the firm's role changes). A row says granted or taken away.
// "Reset to Default" deletes the rows. The Owner's permissions cannot be changed, and the API
// refuses a change that would give someone what its author cannot grant, or an Edit with no View.

enum PermissionModule {
  DASHBOARD
  CLIENTS
  LEADS
  APPOINTMENTS
  INTAKE_FORMS
  DOCUMENTS
  CLIENT_PORTAL
  TASKS
  TAX_RETURNS
  BOOKKEEPING
  PAYROLL
  TAX_PLANNING
  BUSINESS_ADVISORY
  INVOICES_PAYMENTS
  MESSAGES
  COMMUNICATIONS
  AUTOMATIONS
  COMPLIANCE
  REPORTS
  TEMPLATES
  SERVICES_PRICING
  STAFF_MANAGEMENT
  INTEGRATIONS
  SETTINGS
}

/// What a person may do in a module. "Full Access" is all of them (not stored). The Users &
/// Roles grid's "Admin" column is MANAGE: configuration and access of the module.
enum PermissionCapability {
  VIEW
  CREATE
  EDIT
  DELETE
  APPROVE
  MANAGE
  EXPORT
}

/// A firm's change to one capability of one role. Never for the OWNER role (database CHECK).
model RolePermission {
  businessId  String               @map("business_id") @db.Uuid
  role        MembershipRole
  module      PermissionModule
  capability  PermissionCapability
  granted     Boolean
  updatedById String?              @map("updated_by_membership_id") @db.Uuid
  updatedAt   DateTime             @default(now()) @map("updated_at") @db.Timestamptz(3)

  updatedBy Membership? @relation(fields: [businessId, updatedById], references: [businessId, id], onDelete: Restrict)

  @@id([businessId, role, module, capability])
  @@map("role_permissions")
}

/// A firm's change to one capability of one member, on top of their role's.
model MemberPermission {
  businessId   String               @map("business_id") @db.Uuid
  membershipId String               @map("membership_id") @db.Uuid
  module       PermissionModule
  capability   PermissionCapability
  granted      Boolean
  updatedById  String?              @map("updated_by_membership_id") @db.Uuid
  updatedAt    DateTime             @default(now()) @map("updated_at") @db.Timestamptz(3)

  member    Membership  @relation("MemberPermissionSubject", fields: [businessId, membershipId], references: [businessId, id], onDelete: Restrict)
  updatedBy Membership? @relation("MemberPermissionChangedBy", fields: [businessId, updatedById], references: [businessId, id], onDelete: Restrict)

  @@id([businessId, membershipId, module, capability])
  @@map("member_permissions")
}

// ---------- R38: work modules (Rasel, Oct 14) ----------
// The database for Bookkeeping, Tax Planning, Tasks, Compliance & Deadlines and Automations
// (docs/mockups/firm-workspace/<module>/source). Firm tables with forced RLS, one migration per
// group (r38_*). Rows that say who acted keep a plain user id, as tasks.created_by_user_id does;
// assignees are same-firm members through a foreign key.

/// A firm-configured task category ("Business Advisory", "Bookkeeping"). Archived, not deleted.
model TaskType {
  id         String    @id @default(uuid(7)) @db.Uuid
  businessId String    @map("business_id") @db.Uuid
  name       String
  sortOrder  Int       @default(0) @map("sort_order")
  archivedAt DateTime? @map("archived_at") @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  business  Business       @relation(fields: [businessId], references: [id])
  tasks     Task[]
  templates TaskTemplate[]
  series    TaskSeries[]

  @@unique([businessId, id])
  @@unique([businessId, name])
  @@map("task_types")
}

/// An additional assignee (collaborator) of a task. Being one never gives access to the client.
model TaskAssignee {
  businessId String   @map("business_id") @db.Uuid
  taskId     String   @map("task_id") @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  task   Task       @relation(fields: [businessId, taskId], references: [businessId, id], onDelete: Cascade)
  member Membership @relation(fields: [businessId, userId], references: [businessId, userId], onDelete: Restrict)

  @@id([taskId, userId])
  @@index([businessId, userId])
  @@map("task_assignees")
}

/// One step of a task's checklist (ordered). A required item must be completed before the task
/// can be (database rule). An item may be assigned to a member without giving them the client.
model TaskChecklistItem {
  id                String    @id @default(uuid(7)) @db.Uuid
  businessId        String    @map("business_id") @db.Uuid
  taskId            String    @map("task_id") @db.Uuid
  label             String
  /// Display order within the task; the API renumbers on a move (not unique, so a move is one update).
  position          Int
  required          Boolean   @default(false)
  completedAt       DateTime? @map("completed_at") @db.Timestamptz(3)
  completedByUserId String?   @map("completed_by_user_id") @db.Uuid
  assignedUserId    String?   @map("assigned_user_id") @db.Uuid
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  task           Task        @relation(fields: [businessId, taskId], references: [businessId, id], onDelete: Cascade)
  assignedMember Membership? @relation(fields: [businessId, assignedUserId], references: [businessId, userId], onDelete: Restrict)

  @@index([businessId, taskId, position])
  @@map("task_checklist_items")
}

/// A reminder rule of a task: daysBefore the due date (0 = the due day) at timeOfDay (the firm's
/// timezone; the API's default when null), in-app and by email or SMS. lastFiredFor is the due
/// date the reminder last fired for, so a retry never sends it twice.
model TaskReminder {
  id           String            @id @default(uuid(7)) @db.Uuid
  businessId   String            @map("business_id") @db.Uuid
  taskId       String            @map("task_id") @db.Uuid
  daysBefore   Int               @map("days_before")
  timeOfDay    DateTime?         @map("time_of_day") @db.Time(0)
  inApp        Boolean           @default(true) @map("in_app")
  channels     DeliveryChannel[] @default([])
  lastFiredFor DateTime?         @map("last_fired_for") @db.Date
  createdAt    DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  task Task @relation(fields: [businessId, taskId], references: [businessId, id], onDelete: Cascade)

  @@unique([businessId, taskId, daysBefore, timeOfDay])
  @@map("task_reminders")
}

/// A document attached to a task: one of the task's client's documents. The client sees it in
/// the portal only when the task is client-visible AND this row is approved (clientVisible), and
/// never when the document is INTERNAL.
model TaskAttachment {
  id            String   @id @default(uuid(7)) @db.Uuid
  businessId    String   @map("business_id") @db.Uuid
  taskId        String   @map("task_id") @db.Uuid
  documentId    String   @map("document_id") @db.Uuid
  clientVisible Boolean  @default(false) @map("client_visible")
  addedByUserId String?  @map("added_by_user_id") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  task     Task     @relation(fields: [businessId, taskId], references: [businessId, id], onDelete: Cascade)
  document Document @relation(fields: [businessId, documentId], references: [businessId, id], onDelete: Cascade)

  @@unique([businessId, taskId, documentId])
  @@index([businessId, documentId])
  @@map("task_attachments")
}

/// A reusable task: what a new task starts with (name, instructions, type, service, priority,
/// assignment rule, due date relative to creation, checklist, reminders, visibility). checklist
/// is an array of {label, required}; reminders an array of {daysBefore, timeOfDay, inApp,
/// channels}; recurrence, when set, is a saved recurring setup (the series' recurrence columns
/// as JSON). Archived, not deleted.
model TaskTemplate {
  id                   String             @id @default(uuid(7)) @db.Uuid
  businessId           String             @map("business_id") @db.Uuid
  name                 String
  description          String?
  typeId               String?            @map("type_id") @db.Uuid
  serviceId            String?            @map("service_id") @db.Uuid
  priority             TaskPriority       @default(MEDIUM)
  assignmentRule       TaskAssignmentRule @default(UNASSIGNED) @map("assignment_rule")
  assignedUserId       String?            @map("assigned_user_id") @db.Uuid
  /// The due date is this many days after the task is created.
  dueOffsetDays        Int?               @map("due_offset_days")
  clientVisibleDefault Boolean            @default(false) @map("client_visible_default")
  checklist            Json               @default("[]")
  reminders            Json               @default("[]")
  recurrence           Json?
  createdByUserId      String?            @map("created_by_user_id") @db.Uuid
  archivedAt           DateTime?          @map("archived_at") @db.Timestamptz(3)
  createdAt            DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  type                  TaskType?              @relation(fields: [businessId, typeId], references: [businessId, id], onDelete: Restrict)
  service               Service?               @relation(fields: [businessId, serviceId], references: [businessId, id], onDelete: Restrict)
  assignedMember        Membership?            @relation(fields: [businessId, assignedUserId], references: [businessId, userId], onDelete: Restrict)
  tasks                 Task[]
  complianceDeadlines   ComplianceDeadline[]
  complianceRecurrences ComplianceRecurrence[]

  @@unique([businessId, id])
  @@unique([businessId, name])
  @@map("task_templates")
}

/// A recurring task definition (the Set Up Recurring Task screen). Each due date makes one task
/// from a snapshot of these defaults (see TaskOccurrence); a later edit never rewrites tasks
/// already made. `pattern` holds the repeat-on choice: {weekdays: [0-6]} for weekly, {monthly:
/// "DAY_OF_MONTH"} or {monthly: "NTH_WEEKDAY", nth: 1-5, weekday: 0-6} for monthly.
model TaskSeries {
  id                  String             @id @default(uuid(7)) @db.Uuid
  businessId          String             @map("business_id") @db.Uuid
  clientId            String             @map("client_id") @db.Uuid
  engagementId        String?            @map("engagement_id") @db.Uuid
  serviceId           String?            @map("service_id") @db.Uuid
  typeId              String?            @map("type_id") @db.Uuid
  title               String
  details             String?
  priority            TaskPriority       @default(MEDIUM)
  assignmentRule      TaskAssignmentRule @default(UNASSIGNED) @map("assignment_rule")
  assignedUserId      String?            @map("assigned_user_id") @db.Uuid
  /// Collaborators of every task made; each must be a member of the firm (checked by the database).
  extraAssigneeIds    String[]           @default([]) @map("extra_assignee_ids") @db.Uuid
  interval            Int                @default(1)
  unit                RecurrenceUnit
  pattern             Json               @default("{}")
  startOn             DateTime           @map("start_on") @db.Date
  endMode             RecurrenceEnd      @default(NEVER) @map("end_mode")
  endAfterCount       Int?               @map("end_after_count")
  endOn               DateTime?          @map("end_on") @db.Date
  holidayRule         HolidayRule        @default(NEXT_BUSINESS_DAY) @map("holiday_rule")
  /// Make each task at the start of its period instead of leadDays before its due date.
  createAtPeriodStart Boolean            @default(false) @map("create_at_period_start")
  leadDays            Int?               @map("lead_days")
  linkTaxCalendar     Boolean            @default(false) @map("link_tax_calendar")
  dueTime             DateTime?          @map("due_time") @db.Time(0)
  clientVisible       Boolean            @default(false) @map("client_visible")
  notifyClient        Boolean            @default(false) @map("notify_client")
  checklist           Json               @default("[]")
  reminders           Json               @default("[]")
  status              TaskSeriesStatus   @default(ACTIVE)
  pausedAt            DateTime?          @map("paused_at") @db.Timestamptz(3)
  endedAt             DateTime?          @map("ended_at") @db.Timestamptz(3)
  createdByUserId     String?            @map("created_by_user_id") @db.Uuid
  createdAt           DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  client         Client           @relation(fields: [businessId, clientId], references: [businessId, id], onDelete: Restrict)
  engagement     Engagement?      @relation(fields: [businessId, clientId, engagementId], references: [businessId, clientId, id], onDelete: Restrict)
  service        Service?         @relation(fields: [businessId, serviceId], references: [businessId, id], onDelete: Restrict)
  type           TaskType?        @relation(fields: [businessId, typeId], references: [businessId, id], onDelete: Restrict)
  assignedMember Membership?      @relation(fields: [businessId, assignedUserId], references: [businessId, userId], onDelete: Restrict)
  occurrences    TaskOccurrence[]

  @@unique([businessId, id])
  @@index([businessId, clientId])
  @@index([businessId, status])
  @@map("task_series")
}

/// One due date of a series. The unique (series, scheduledOn) makes generation idempotent: a
/// retry finds the row instead of making a second task. scheduledOn is the unadjusted date,
/// dueOn the one after the holiday rule. A GENERATED row points at its task; SKIPPED has a reason.
model TaskOccurrence {
  id          String              @id @default(uuid(7)) @db.Uuid
  businessId  String              @map("business_id") @db.Uuid
  seriesId    String              @map("series_id") @db.Uuid
  scheduledOn DateTime            @map("scheduled_on") @db.Date
  dueOn       DateTime            @map("due_on") @db.Date
  state       TaskOccurrenceState @default(SCHEDULED)
  taskId      String?             @map("task_id") @db.Uuid
  skipReason  String?             @map("skip_reason")
  /// A safe code for the last failure (never a message with client data), and the tries so far.
  failureCode String?             @map("failure_code")
  attempts    Int                 @default(0)
  generatedAt DateTime?           @map("generated_at") @db.Timestamptz(3)
  createdAt   DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)

  series TaskSeries @relation(fields: [businessId, seriesId], references: [businessId, id], onDelete: Restrict)
  task   Task?      @relation(fields: [businessId, taskId], references: [businessId, id], onDelete: Restrict)

  @@unique([businessId, seriesId, scheduledOn])
  @@unique([businessId, taskId])
  @@index([businessId, state, dueOn])
  @@map("task_occurrences")
}

/// A compliance obligation of one client with a due date (Compliance & Deadlines). It is the
/// source of truth for the obligation and its date; Tasks is the work. A government deadline
/// keeps the rule's date (statutoryDueOn) apart from the date the firm works to (dueOn), and a
/// firm override needs a reason (dueOverridden, dueOverrideReason). The extension is tracked
/// apart from the payment date, which an extension never moves. Overdue and Due Soon are derived
/// (see DeadlineStatus). Archived, never deleted.
model ComplianceDeadline {
  id                  String             @id @default(uuid(7)) @db.Uuid
  businessId          String             @map("business_id") @db.Uuid
  clientId            String             @map("client_id") @db.Uuid
  engagementId        String?            @map("engagement_id") @db.Uuid
  name                String
  type                DeadlineType
  source              DeadlineSource     @default(FIRM)
  description         String?
  /// Staff only.
  internalNotes       String?            @map("internal_notes")
  /// Shown to the client when clientVisible.
  clientNotes         String?            @map("client_notes")
  /// Federal tax classification or entity code, e.g. "LLC_MULTI_MEMBER" (the client's, when set).
  entityType          String?            @map("entity_type")
  taxYear             Int?               @map("tax_year")
  /// e.g. "Q3 (Jul-Sep)", "Annual".
  filingPeriod        String?            @map("filing_period")
  relatedForm         String?            @map("related_form")
  /// The authority: "IRS", "GA DOR", "GA SOS", a county.
  agency              String?
  jurisdiction        JurisdictionLevel?
  /// Two-letter state code, for state and local deadlines.
  state               String?
  statutoryDueOn      DateTime?          @map("statutory_due_on") @db.Date
  dueOn               DateTime           @map("due_on") @db.Date
  /// Time of day, in the firm's timezone; the end of the day when null.
  dueTime             DateTime?          @map("due_time") @db.Time(0)
  dueOverridden       Boolean            @default(false) @map("due_overridden")
  dueOverrideReason   String?            @map("due_override_reason")
  extensionFiledOn    DateTime?          @map("extension_filed_on") @db.Date
  extendedDueOn       DateTime?          @map("extended_due_on") @db.Date
  /// The payment date, kept separate: an extension to file is not an extension to pay.
  paymentDueOn        DateTime?          @map("payment_due_on") @db.Date
  priority            TaskPriority       @default(MEDIUM)
  status              DeadlineStatus     @default(UPCOMING)
  assignedUserId      String?            @map("assigned_user_id") @db.Uuid
  clientVisible       Boolean            @default(false) @map("client_visible")
  /// Make a task from taskTemplateId when the deadline is created (once: see tasks.template_id).
  createTask          Boolean            @default(false) @map("create_task")
  taskTemplateId      String?            @map("task_template_id") @db.Uuid
  completedAt         DateTime?          @map("completed_at") @db.Timestamptz(3)
  completedByUserId   String?            @map("completed_by_user_id") @db.Uuid
  /// Completion evidence: when it was filed or paid, and the confirmation number.
  filedOn             DateTime?          @map("filed_on") @db.Date
  confirmationNumber  String?            @map("confirmation_number")
  notApplicableReason String?            @map("not_applicable_reason")
  /// The library entry that made this deadline, and why it applies to the client (rule and
  /// calendar version): at most one deadline per client, entry and due date (SQL only).
  calendarEntryId     String?            @map("calendar_entry_id") @db.Uuid
  applicabilityReason String?            @map("applicability_reason")
  /// The recurring definition that made it (with calendarEntryId when it came from the library).
  recurrenceId        String?            @map("recurrence_id") @db.Uuid
  createdByUserId     String?            @map("created_by_user_id") @db.Uuid
  archivedAt          DateTime?          @map("archived_at") @db.Timestamptz(3)
  createdAt           DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  client                        Client                         @relation(fields: [businessId, clientId], references: [businessId, id], onDelete: Restrict)
  engagement                    Engagement?                    @relation(fields: [businessId, clientId, engagementId], references: [businessId, clientId, id], onDelete: Restrict)
  assignedMember                Membership?                    @relation(fields: [businessId, assignedUserId], references: [businessId, userId], onDelete: Restrict)
  taskTemplate                  TaskTemplate?                  @relation(fields: [businessId, taskTemplateId], references: [businessId, id], onDelete: Restrict)
  calendarEntry                 ComplianceCalendarEntry?       @relation(fields: [businessId, calendarEntryId], references: [businessId, id], onDelete: Restrict)
  recurrence                    ComplianceRecurrence?          @relation(fields: [businessId, recurrenceId], references: [businessId, id], onDelete: Restrict)
  reminders                     ComplianceDeadlineReminder[]
  documents                     ComplianceDeadlineDocument[]
  links                         ComplianceDeadlineLink[]       @relation("DeadlineLinks")
  linkedFrom                    ComplianceDeadlineLink[]       @relation("DeadlineLinked")
  tasks                         Task[]
  complianceApplicabilityRecord ComplianceApplicabilityRecord?
  complianceLogs                ComplianceLog[]

  @@unique([businessId, id])
  @@index([businessId, status, dueOn])
  @@index([businessId, clientId, dueOn])
  @@index([businessId, assignedUserId, status])
  @@index([businessId, type])
  @@map("compliance_deadlines")
}

/// A reminder rule of a deadline: daysBefore the due date (0 = the due day), in-app and by email
/// or SMS. lastFiredFor is the due date it last fired for, so a retry never sends it twice.
model ComplianceDeadlineReminder {
  id           String            @id @default(uuid(7)) @db.Uuid
  businessId   String            @map("business_id") @db.Uuid
  deadlineId   String            @map("deadline_id") @db.Uuid
  daysBefore   Int               @map("days_before")
  inApp        Boolean           @default(true) @map("in_app")
  channels     DeliveryChannel[] @default([])
  lastFiredFor DateTime?         @map("last_fired_for") @db.Date
  createdAt    DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)

  deadline ComplianceDeadline @relation(fields: [businessId, deadlineId], references: [businessId, id], onDelete: Cascade)

  @@unique([businessId, deadlineId, daysBefore])
  @@map("compliance_deadline_reminders")
}

/// A document attached to a deadline: one of the deadline client's documents.
model ComplianceDeadlineDocument {
  id            String   @id @default(uuid(7)) @db.Uuid
  businessId    String   @map("business_id") @db.Uuid
  deadlineId    String   @map("deadline_id") @db.Uuid
  documentId    String   @map("document_id") @db.Uuid
  addedByUserId String?  @map("added_by_user_id") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  deadline ComplianceDeadline @relation(fields: [businessId, deadlineId], references: [businessId, id], onDelete: Cascade)
  document Document           @relation(fields: [businessId, documentId], references: [businessId, id], onDelete: Cascade)

  @@unique([businessId, deadlineId, documentId])
  @@index([businessId, documentId])
  @@map("compliance_deadline_documents")
}

/// "Related deadlines": a link from one deadline to another of the same client.
model ComplianceDeadlineLink {
  businessId        String   @map("business_id") @db.Uuid
  deadlineId        String   @map("deadline_id") @db.Uuid
  relatedDeadlineId String   @map("related_deadline_id") @db.Uuid
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  deadline        ComplianceDeadline @relation("DeadlineLinks", fields: [businessId, deadlineId], references: [businessId, id], onDelete: Cascade)
  relatedDeadline ComplianceDeadline @relation("DeadlineLinked", fields: [businessId, relatedDeadlineId], references: [businessId, id], onDelete: Cascade)

  @@id([deadlineId, relatedDeadlineId])
  @@index([businessId, relatedDeadlineId])
  @@map("compliance_deadline_links")
}

/// One version of an official calendar in the firm's library: an authority and jurisdiction for
/// one effective year, with its source and when it was retrieved and last verified. Importing
/// makes a DRAFT; publishing supersedes the previous PUBLISHED version, which stays for rollback.
/// A failed import never touches the published one.
model ComplianceCalendar {
  id                String            @id @default(uuid(7)) @db.Uuid
  businessId        String            @map("business_id") @db.Uuid
  family            CalendarFamily
  /// "IRS", "Georgia Secretary of State".
  authority         String
  jurisdiction      JurisdictionLevel
  state             String?
  effectiveYear     Int               @map("effective_year")
  /// 1, 2, 3... per family, authority, state and year.
  version           Int               @default(1)
  name              String
  /// The official page the dates come from.
  sourceUrl         String            @map("source_url")
  retrievedAt       DateTime?         @map("retrieved_at") @db.Timestamptz(3)
  verifiedAt        DateTime?         @map("verified_at") @db.Timestamptz(3)
  status            CalendarStatus    @default(DRAFT)
  publishedAt       DateTime?         @map("published_at") @db.Timestamptz(3)
  publishedByUserId String?           @map("published_by_user_id") @db.Uuid
  createdByUserId   String?           @map("created_by_user_id") @db.Uuid
  createdAt         DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  entries        ComplianceCalendarEntry[]
  complianceLogs ComplianceLog[]

  @@unique([businessId, id])
  @@unique([businessId, family, authority, state, effectiveYear, version])
  @@index([businessId, status])
  @@map("compliance_calendars")
}

/// A deadline of a calendar version: a fixed date for the year, or a formula (for example the
/// 15th day of the 3rd month after year end, in `rule`), with the form it belongs to.
model ComplianceCalendarEntry {
  id          String           @id @default(uuid(7)) @db.Uuid
  businessId  String           @map("business_id") @db.Uuid
  calendarId  String           @map("calendar_id") @db.Uuid
  name        String
  type        DeadlineType
  form        String?
  description String?
  ruleKind    CalendarRuleKind @map("rule_kind")
  dueOn       DateTime?        @map("due_on") @db.Date
  rule        Json?
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  calendar                     ComplianceCalendar            @relation(fields: [businessId, calendarId], references: [businessId, id], onDelete: Restrict)
  deadlines                    ComplianceDeadline[]
  complianceRecurrences        ComplianceRecurrence[]
  complianceApplicabilityRules ComplianceApplicabilityRule[]

  @@unique([businessId, id])
  @@unique([businessId, calendarId, name, dueOn])
  @@index([businessId, calendarId])
  @@map("compliance_calendar_entries")
}

/// A recurring deadline definition, or a template of one (isTemplate: the Quick Templates and
/// "Use Existing Template"; a template never makes deadlines). Made from scratch or from a
/// library entry. The unadjusted statutory date is kept on each deadline, so the holiday rule
/// never loses it. `repeatRule` holds the repeat-on choice (a day of the month, an nth weekday, a
/// quarter rule); `reminders` an array of {daysBefore, inApp, channels}.
model ComplianceRecurrence {
  id                String             @id @default(uuid(7)) @db.Uuid
  businessId        String             @map("business_id") @db.Uuid
  name              String
  type              DeadlineType
  description       String?
  agency            String?
  relatedForm       String?            @map("related_form")
  jurisdiction      JurisdictionLevel?
  state             String?
  calendarEntryId   String?            @map("calendar_entry_id") @db.Uuid
  frequency         DeadlineFrequency
  /// Every N months (or days) for CUSTOM.
  interval          Int?
  repeatRule        Json               @default("{}") @map("repeat_rule")
  startOn           DateTime?          @map("start_on") @db.Date
  endMode           RecurrenceEnd      @default(NEVER) @map("end_mode")
  endAfterCount     Int?               @map("end_after_count")
  endOn             DateTime?          @map("end_on") @db.Date
  holidayRule       HolidayRule        @default(NEXT_BUSINESS_DAY) @map("holiday_rule")
  isTemplate        Boolean            @default(false) @map("is_template")
  createTask        Boolean            @default(false) @map("create_task")
  taskTemplateId    String?            @map("task_template_id") @db.Uuid
  assignedUserId    String?            @map("assigned_user_id") @db.Uuid
  clientVisible     Boolean            @default(false) @map("client_visible")
  remindClient      Boolean            @default(false) @map("remind_client")
  addToTaxCalendar  Boolean            @default(true) @map("add_to_tax_calendar")
  notifyTeam        Boolean            @default(false) @map("notify_team")
  reminders         Json               @default("[]")
  sendPastDueNotice Boolean            @default(false) @map("send_past_due_notice")
  escalateToManager Boolean            @default(false) @map("escalate_to_manager")
  status            TaskSeriesStatus   @default(ACTIVE)
  pausedAt          DateTime?          @map("paused_at") @db.Timestamptz(3)
  endedAt           DateTime?          @map("ended_at") @db.Timestamptz(3)
  createdByUserId   String?            @map("created_by_user_id") @db.Uuid
  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  calendarEntry  ComplianceCalendarEntry?      @relation(fields: [businessId, calendarEntryId], references: [businessId, id], onDelete: Restrict)
  taskTemplate   TaskTemplate?                 @relation(fields: [businessId, taskTemplateId], references: [businessId, id], onDelete: Restrict)
  assignedMember Membership?                   @relation(fields: [businessId, assignedUserId], references: [businessId, userId], onDelete: Restrict)
  deadlines      ComplianceDeadline[]
  rules          ComplianceApplicabilityRule[]
  complianceLogs ComplianceLog[]

  @@unique([businessId, id])
  @@unique([businessId, name, isTemplate])
  @@index([businessId, status])
  @@map("compliance_recurrences")
}

/// Which clients get (or are only suggested) a library entry's or a recurrence's deadline:
/// federal tax classification and entity codes, states, services, statuses that exclude, and
/// anything else in `criteria` (election, fiscal year end, payroll or sales tax registration).
/// `version` goes up on every change, so a decision records the version that made it.
model ComplianceApplicabilityRule {
  id                          String               @id @default(uuid(7)) @db.Uuid
  businessId                  String               @map("business_id") @db.Uuid
  name                        String
  calendarEntryId             String?              @map("calendar_entry_id") @db.Uuid
  recurrenceId                String?              @map("recurrence_id") @db.Uuid
  outcome                     ApplicabilityOutcome @default(SUGGEST)
  entityTypes                 String[]             @default([]) @map("entity_types")
  states                      String[]             @default([])
  services                    ServiceKind[]        @default([])
  /// Clients with one of these statuses (tax-exempt, dissolved, closed, not registered) never match.
  excludeStatuses             String[]             @default([]) @map("exclude_statuses")
  /// Only clients whose prior-year tax liability is above this, in cents.
  priorYearLiabilityOverCents Int?                 @map("prior_year_liability_over_cents")
  criteria                    Json                 @default("{}")
  active                      Boolean              @default(true)
  version                     Int                  @default(1)
  createdByUserId             String?              @map("created_by_user_id") @db.Uuid
  createdAt                   DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                   DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)

  calendarEntry ComplianceCalendarEntry?        @relation(fields: [businessId, calendarEntryId], references: [businessId, id], onDelete: Restrict)
  recurrence    ComplianceRecurrence?           @relation(fields: [businessId, recurrenceId], references: [businessId, id], onDelete: Restrict)
  decisions     ComplianceApplicabilityRecord[]

  @@unique([businessId, id])
  @@index([businessId, calendarEntryId])
  @@index([businessId, recurrenceId])
  @@map("compliance_applicability_rules")
}

/// What a rule decided for one client and due date: suggested, needing review (data missing, so
/// nothing is generated silently), confirmed by staff (the deadline it made) or dismissed with a
/// reason. A change of the client's classification re-evaluates without touching old records.
model ComplianceApplicabilityRecord {
  id              String                @id @default(uuid(7)) @db.Uuid
  businessId      String                @map("business_id") @db.Uuid
  clientId        String                @map("client_id") @db.Uuid
  ruleId          String                @map("rule_id") @db.Uuid
  ruleVersion     Int                   @map("rule_version")
  dueOn           DateTime              @map("due_on") @db.Date
  decision        ApplicabilityDecision
  /// Why it applies (or why it needs review or was dismissed), with the rule and calendar version.
  reason          String
  deadlineId      String?               @map("deadline_id") @db.Uuid
  decidedByUserId String?               @map("decided_by_user_id") @db.Uuid
  decidedAt       DateTime?             @map("decided_at") @db.Timestamptz(3)
  createdAt       DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)

  client   Client                      @relation(fields: [businessId, clientId], references: [businessId, id], onDelete: Restrict)
  rule     ComplianceApplicabilityRule @relation(fields: [businessId, ruleId], references: [businessId, id], onDelete: Restrict)
  deadline ComplianceDeadline?         @relation(fields: [businessId, deadlineId], references: [businessId, id], onDelete: Restrict)

  @@unique([businessId, clientId, ruleId, dueOn])
  @@unique([businessId, deadlineId])
  @@index([businessId, decision])
  @@map("compliance_applicability_records")
}

/// Compliance logs (Frame 3 "Logs"): calendar imports, verification, publish and rollback,
/// deadline generation, due-date overrides and errors. Append-only. `message` is a short safe
/// text and `details` ids and counts only: never client data, tokens or file contents.
model ComplianceLog {
  id           String            @id @default(uuid(7)) @db.Uuid
  businessId   String            @map("business_id") @db.Uuid
  kind         ComplianceLogKind
  outcome      LogOutcome
  calendarId   String?           @map("calendar_id") @db.Uuid
  deadlineId   String?           @map("deadline_id") @db.Uuid
  recurrenceId String?           @map("recurrence_id") @db.Uuid
  message      String?
  details      Json              @default("{}")
  actorUserId  String?           @map("actor_user_id") @db.Uuid
  createdAt    DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)

  calendar   ComplianceCalendar?   @relation(fields: [businessId, calendarId], references: [businessId, id], onDelete: Restrict)
  deadline   ComplianceDeadline?   @relation(fields: [businessId, deadlineId], references: [businessId, id], onDelete: Restrict)
  recurrence ComplianceRecurrence? @relation(fields: [businessId, recurrenceId], references: [businessId, id], onDelete: Restrict)

  @@index([businessId, createdAt])
  @@index([businessId, kind, outcome])
  @@map("compliance_logs")
}

/// A firm's Compliance settings (the Settings button): the Due Soon and At Risk thresholds, how
/// old a calendar may get before it shows a stale warning, default reminders for new deadlines,
/// past-due and manager escalation, and a default task template per deadline type
/// (`taskTemplates`: {DEADLINE_TYPE: task template id}, checked by the API). One row per firm.
model ComplianceSettings {
  businessId        String   @id @map("business_id") @db.Uuid
  dueSoonDays       Int      @default(14) @map("due_soon_days")
  /// A high-priority deadline this close to its date puts the client at risk.
  atRiskDays        Int      @default(7) @map("at_risk_days")
  staleCalendarDays Int      @default(90) @map("stale_calendar_days")
  defaultReminders  Json     @default("[]") @map("default_reminders")
  sendPastDueNotice Boolean  @default(false) @map("send_past_due_notice")
  escalateToManager Boolean  @default(false) @map("escalate_to_manager")
  escalateAfterDays Int      @default(3) @map("escalate_after_days")
  taskTemplates     Json     @default("{}") @map("task_templates")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  business Business @relation(fields: [businessId], references: [id])

  @@map("compliance_settings")
}

/// An automation rule (the Rules table and the Create Rule builder). The rule is the identity
/// and the switch (name, category, priority, owner, status); what it does lives in immutable
/// versions, and a run records the version it used. Archived, never deleted, once it has run.
model AutomationRule {
  id               String           @id @default(uuid(7)) @db.Uuid
  businessId       String           @map("business_id") @db.Uuid
  name             String
  description      String?
  category         AutomationModule
  priority         TaskPriority     @default(MEDIUM)
  status           AutomationStatus @default(DRAFT)
  ownerUserId      String?          @map("owner_user_id") @db.Uuid
  /// The version new runs use; set once a version exists (an ACTIVE rule has one).
  currentVersionId String?          @map("current_version_id") @db.Uuid
  /// Deactivates the rule on this date.
  expiresOn        DateTime?        @map("expires_on") @db.Date
  lastRunAt        DateTime?        @map("last_run_at") @db.Timestamptz(3)
  createdByUserId  String?          @map("created_by_user_id") @db.Uuid
  archivedAt       DateTime?        @map("archived_at") @db.Timestamptz(3)
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  owner          Membership?             @relation(fields: [businessId, ownerUserId], references: [businessId, userId], onDelete: Restrict)
  currentVersion AutomationRuleVersion?  @relation("AutomationCurrentVersion", fields: [businessId, currentVersionId], references: [businessId, id], onDelete: Restrict)
  versions       AutomationRuleVersion[] @relation("AutomationRuleVersions")
  automationRuns AutomationRun[]

  @@unique([businessId, id])
  @@unique([businessId, currentVersionId])
  @@index([businessId, status])
  @@index([businessId, category])
  @@map("automation_rules")
}

/// One saved configuration of a rule, never changed afterwards: trigger (module, event code,
/// timing and offset), conditions (match ALL or ANY of {field, operator, value} rows) and ordered
/// actions ({id, type, config, delayMinutes}), and settings ({preventDuplicatesDays, logAll,
/// notifyOnFailure, addToCalendar, quietHours, safetyThreshold}). triggerEvent is a code such as
/// "deadline.approaching", checked by the API against the module's events.
model AutomationRuleVersion {
  id              String           @id @default(uuid(7)) @db.Uuid
  businessId      String           @map("business_id") @db.Uuid
  ruleId          String           @map("rule_id") @db.Uuid
  version         Int
  triggerModule   AutomationModule @map("trigger_module")
  triggerEvent    String           @map("trigger_event")
  timing          AutomationTiming @default(IMMEDIATE)
  offsetValue     Int?             @map("offset_value")
  offsetUnit      OffsetUnit?      @map("offset_unit")
  matchMode       MatchMode        @default(ALL) @map("match_mode")
  conditions      Json             @default("[]")
  actions         Json
  settings        Json             @default("{}")
  createdByUserId String?          @map("created_by_user_id") @db.Uuid
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)

  rule           AutomationRule  @relation("AutomationRuleVersions", fields: [businessId, ruleId], references: [businessId, id], onDelete: Restrict)
  currentOf      AutomationRule? @relation("AutomationCurrentVersion")
  automationRuns AutomationRun[]

  @@unique([businessId, id])
  @@unique([businessId, ruleId, version])
  @@map("automation_rule_versions")
}

/// A reusable rule setup (Popular Automation Templates, Save as Template, Import Templates):
/// `definition` has the same shape as a version's trigger, conditions, actions and settings, with
/// merge variables instead of client data, and never a secret or token. Using one makes a DRAFT
/// rule for review. Archived, not deleted.
model AutomationTemplate {
  id                   String           @id @default(uuid(7)) @db.Uuid
  businessId           String           @map("business_id") @db.Uuid
  name                 String
  description          String?
  category             AutomationModule
  definition           Json
  /// Integrations the template needs to be connected, by code (the Integrations module's).
  requiredIntegrations String[]         @default([]) @map("required_integrations")
  createdByUserId      String?          @map("created_by_user_id") @db.Uuid
  archivedAt           DateTime?        @map("archived_at") @db.Timestamptz(3)
  createdAt            DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([businessId, name])
  @@map("automation_templates")
}

/// One execution of a rule version for one source event and record (Automation Logs). The id is
/// the stable run id. sourceEventKey makes it idempotent: the same event for the same rule never
/// starts a second run. correlationId and depth follow a chain of runs started by runs (loop
/// protection). A dry run (Test / Preview) has no side effects. A manual re-run retries only the
/// failed actions of this run (rerun* record who, why and how many times). Never deleted.
model AutomationRun {
  id                String              @id @default(uuid(7)) @db.Uuid
  businessId        String              @map("business_id") @db.Uuid
  ruleId            String              @map("rule_id") @db.Uuid
  ruleVersionId     String              @map("rule_version_id") @db.Uuid
  status            AutomationRunStatus @default(PENDING)
  dryRun            Boolean             @default(false) @map("dry_run")
  sourceModule      AutomationModule    @map("source_module")
  sourceEventKey    String              @map("source_event_key")
  /// The client the record belongs to, when it has one.
  clientId          String?             @map("client_id") @db.Uuid
  /// The record that triggered the run (its kind, e.g. "deadline", and id), kept as ids only.
  recordKind        String?             @map("record_kind")
  recordId          String?             @map("record_id") @db.Uuid
  correlationId     String              @map("correlation_id") @db.Uuid
  depth             Int                 @default(0)
  parentRunId       String?             @map("parent_run_id") @db.Uuid
  startedAt         DateTime?           @map("started_at") @db.Timestamptz(3)
  finishedAt        DateTime?           @map("finished_at") @db.Timestamptz(3)
  durationMs        Int?                @map("duration_ms")
  /// A safe code and short message for a failed or skipped run: never client data or tokens.
  errorCode         String?             @map("error_code")
  message           String?
  rerunCount        Int                 @default(0) @map("rerun_count")
  lastRerunAt       DateTime?           @map("last_rerun_at") @db.Timestamptz(3)
  lastRerunByUserId String?             @map("last_rerun_by_user_id") @db.Uuid
  lastRerunReason   String?             @map("last_rerun_reason")
  createdAt         DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)

  rule        AutomationRule              @relation(fields: [businessId, ruleId], references: [businessId, id], onDelete: Restrict)
  ruleVersion AutomationRuleVersion       @relation(fields: [businessId, ruleVersionId], references: [businessId, id], onDelete: Restrict)
  client      Client?                     @relation(fields: [businessId, clientId], references: [businessId, id], onDelete: Restrict)
  parentRun   AutomationRun?              @relation("AutomationRunChain", fields: [businessId, parentRunId], references: [businessId, id], onDelete: Restrict)
  childRuns   AutomationRun[]             @relation("AutomationRunChain")
  executions  AutomationActionExecution[]

  @@unique([businessId, id])
  @@unique([businessId, ruleId, sourceEventKey])
  @@index([businessId, createdAt])
  @@index([businessId, status, createdAt])
  @@index([businessId, ruleId, createdAt])
  @@index([businessId, clientId])
  @@map("automation_runs")
}

/// One action of a run, in the rule version's order. idempotencyKey (unique per firm) makes a
/// retry or a duplicate event safe: an action that SUCCEEDED is never run again (the database
/// refuses to move it back). A delayed action waits PENDING until scheduledFor. resultKind and
/// resultId name what it made (a task, a message), as ids only.
model AutomationActionExecution {
  id             String                @id @default(uuid(7)) @db.Uuid
  businessId     String                @map("business_id") @db.Uuid
  runId          String                @map("run_id") @db.Uuid
  /// The action's id inside the rule version.
  actionKey      String                @map("action_key")
  position       Int
  actionType     String                @map("action_type")
  status         ActionExecutionStatus @default(PENDING)
  idempotencyKey String                @map("idempotency_key")
  scheduledFor   DateTime?             @map("scheduled_for") @db.Timestamptz(3)
  attempts       Int                   @default(0)
  /// False for a failure a retry cannot fix (an invalid address): shown as an actionable failure.
  retryable      Boolean               @default(true)
  errorCode      String?               @map("error_code")
  detail         String?
  resultKind     String?               @map("result_kind")
  resultId       String?               @map("result_id") @db.Uuid
  startedAt      DateTime?             @map("started_at") @db.Timestamptz(3)
  finishedAt     DateTime?             @map("finished_at") @db.Timestamptz(3)
  createdAt      DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)

  run AutomationRun @relation(fields: [businessId, runId], references: [businessId, id], onDelete: Restrict)

  @@unique([businessId, runId, actionKey])
  @@unique([businessId, idempotencyKey])
  @@index([businessId, status, scheduledFor])
  @@map("automation_action_executions")
}

/// A firm's Automation settings: quiet hours for client messages, the default duplicate window,
/// loop depth and safety threshold for new rules, who is told when a rule fails, the minutes each
/// action is counted as saving (the Time Saved figure) and how long logs are kept. One row per firm.
model AutomationSettings {
  businessId            String    @id @map("business_id") @db.Uuid
  quietStart            DateTime? @map("quiet_start") @db.Time(0)
  quietEnd              DateTime? @map("quiet_end") @db.Time(0)
  defaultDedupeDays     Int       @default(7) @map("default_dedupe_days")
  maxDepth              Int       @default(3) @map("max_depth")
  safetyThreshold       Int       @default(500) @map("safety_threshold")
  failureAlertUserIds   String[]  @default([]) @map("failure_alert_user_ids") @db.Uuid
  minutesSavedPerAction Int       @default(5) @map("minutes_saved_per_action")
  logRetentionDays      Int       @default(365) @map("log_retention_days")
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  business Business @relation(fields: [businessId], references: [id])

  @@map("automation_settings")
}

/// A firm's Bookkeeping settings (the Bookkeeping Settings button): the defaults new bookkeeping
/// clients start with. The Json fields are arrays or objects the API validates: statusRules
/// {missingDocumentsAfterDays, overdueAfterDays...}, reminderDefaults [{daysBefore, channels}],
/// reportSchedule [{report, cadence, dueDay, delivery}], documentChecklist [{label, cadence}] and
/// closeChecklist [{key, label, required}] (what a new period's checklist is made from). One row per firm.
model BookkeepingSettings {
  businessId          String        @id @map("business_id") @db.Uuid
  defaultCadence      ReportCadence @default(MONTHLY) @map("default_cadence")
  /// The day of the month after a period when it should be closed.
  closeTargetDay      Int           @default(10) @map("close_target_day")
  /// Reports due within this many days are "upcoming".
  upcomingReportDays  Int           @default(14) @map("upcoming_report_days")
  /// A sync older than this shows a stale warning.
  staleSyncHours      Int           @default(48) @map("stale_sync_hours")
  /// A reconciliation may be approved when its difference is within this.
  reconToleranceCents Int           @default(0) @map("recon_tolerance_cents")
  statusRules         Json          @default("{}") @map("status_rules")
  reminderDefaults    Json          @default("[]") @map("reminder_defaults")
  reportSchedule      Json          @default("[]") @map("report_schedule")
  documentChecklist   Json          @default("[]") @map("document_checklist")
  closeChecklist      Json          @default("[]") @map("close_checklist")
  createdAt           DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  business Business @relation(fields: [businessId], references: [id])

  @@map("bookkeeping_settings")
}

/// What Bookkeeping adds to a client's Bookkeeping engagement (the engagement is the enrolment:
/// its package is the plan, its assigned member the responsible bookkeeper, its status the
/// service's). One row per engagement, only for the Bookkeeping service. Holds the cadence and
/// next report date, the workflow status with the exact reason, the reviewer, pause and archive,
/// and the client's own settings. Never deleted. Figures from an accounting system are not here:
/// there is no ledger sync yet.
model BookkeepingProfile {
  id                  String            @id @default(uuid(7)) @db.Uuid
  businessId          String            @map("business_id") @db.Uuid
  engagementId        String            @map("engagement_id") @db.Uuid
  cadence             ReportCadence     @default(MONTHLY)
  /// Months between reports for CUSTOM.
  cadenceMonths       Int?              @map("cadence_months")
  closeTargetDay      Int?              @map("close_target_day")
  /// The next report's due date, kept current by the API from the cadence and the last period.
  nextReportDueOn     DateTime?         @map("next_report_due_on") @db.Date
  status              BookkeepingStatus @default(NOT_STARTED)
  statusSource        StatusSource      @default(AUTOMATIC) @map("status_source")
  /// Why: "3 documents outstanding", "Sync failed Oct 12".
  statusReason        String?           @map("status_reason")
  statusChangedAt     DateTime          @default(now()) @map("status_changed_at") @db.Timestamptz(3)
  reviewerUserId      String?           @map("reviewer_user_id") @db.Uuid
  pausedAt            DateTime?         @map("paused_at") @db.Timestamptz(3)
  pauseReason         String?           @map("pause_reason")
  archivedAt          DateTime?         @map("archived_at") @db.Timestamptz(3)
  /// What the client portal shows by default: {reports, tasks, documents, notes} booleans.
  portalDefaults      Json              @default("{}") @map("portal_defaults")
  /// Client overrides of the firm's settings; null uses the firm's.
  reportSchedule      Json?             @map("report_schedule")
  documentChecklist   Json?             @map("document_checklist")
  categorizationRules Json              @default("[]") @map("categorization_rules")
  /// Alerts on or off: {missingDocuments, staleSync, overdueClose, failedIntegration}.
  alerts              Json              @default("{}")
  createdAt           DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  engagement Engagement  @relation(fields: [businessId, engagementId], references: [businessId, id], onDelete: Restrict)
  reviewer   Membership? @relation(fields: [businessId, reviewerUserId], references: [businessId, userId], onDelete: Restrict)

  @@unique([businessId, id])
  @@unique([businessId, engagementId])
  @@index([businessId, status])
  @@index([businessId, nextReportDueOn])
  @@map("bookkeeping_profiles")
}

/// The bookkeeping activity history of an engagement (the View Activity action and the
/// Activity tab): status changes, syncs, document requests, reports, close steps, logged calls.
/// Append-only; `summary` is a short safe line, `details` ids and old and new values only.
model BookkeepingActivity {
  id           String                  @id @default(uuid(7)) @db.Uuid
  businessId   String                  @map("business_id") @db.Uuid
  engagementId String                  @map("engagement_id") @db.Uuid
  kind         BookkeepingActivityKind
  summary      String
  details      Json                    @default("{}")
  actorUserId  String?                 @map("actor_user_id") @db.Uuid
  createdAt    DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)

  engagement Engagement @relation(fields: [businessId, engagementId], references: [businessId, id], onDelete: Restrict)

  @@index([businessId, engagementId, createdAt])
  @@map("bookkeeping_activity")
}

/// A client's link to an accounting system (QuickBooks Online, Xero, FreshBooks, Zoho Books...):
/// `provider` is a code, never an enum, so providers stay modular. credentialRef names where the
/// provider's tokens are kept (the secret store); a token is never stored in this table or shown
/// to staff. One live connection per provider company and per client and provider; disconnecting
/// keeps the row and its history and reconnecting reuses it. A failed sync never clears
/// lastSuccessfulSyncAt: it only moves forward.
model BookkeepingConnection {
  id                   String           @id @default(uuid(7)) @db.Uuid
  businessId           String           @map("business_id") @db.Uuid
  engagementId         String           @map("engagement_id") @db.Uuid
  provider             String
  /// The company's id at the provider (a realm id, an organisation id).
  providerCompanyId    String           @map("provider_company_id")
  companyName          String?          @map("company_name")
  status               ConnectionStatus @default(CONNECTED)
  credentialRef        String?          @map("credential_ref")
  lastSyncAt           DateTime?        @map("last_sync_at") @db.Timestamptz(3)
  lastSuccessfulSyncAt DateTime?        @map("last_successful_sync_at") @db.Timestamptz(3)
  /// A safe code for the latest failure (EXPIRED_TOKEN, RATE_LIMITED), cleared by a good sync.
  lastErrorCode        String?          @map("last_error_code")
  connectedByUserId    String?          @map("connected_by_user_id") @db.Uuid
  connectedAt          DateTime         @default(now()) @map("connected_at") @db.Timestamptz(3)
  disconnectedAt       DateTime?        @map("disconnected_at") @db.Timestamptz(3)
  createdAt            DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  engagement Engagement           @relation(fields: [businessId, engagementId], references: [businessId, id], onDelete: Restrict)
  syncRuns   BookkeepingSyncRun[]
  accounts   BookkeepingAccount[]

  @@unique([businessId, id])
  @@index([businessId, engagementId])
  @@index([businessId, status])
  @@map("bookkeeping_connections")
}

/// One sync of a connection (View Sync Details): how it started, how it ended, a safe error code
/// and short message, and counts of what it brought in. Updated once when it finishes; never deleted.
model BookkeepingSyncRun {
  id                String      @id @default(uuid(7)) @db.Uuid
  businessId        String      @map("business_id") @db.Uuid
  connectionId      String      @map("connection_id") @db.Uuid
  trigger           SyncTrigger
  outcome           SyncOutcome @default(RUNNING)
  startedAt         DateTime    @default(now()) @map("started_at") @db.Timestamptz(3)
  finishedAt        DateTime?   @map("finished_at") @db.Timestamptz(3)
  errorCode         String?     @map("error_code")
  message           String?
  /// Counts only, e.g. {accounts: 4, categories: 87}.
  counts            Json        @default("{}")
  requestedByUserId String?     @map("requested_by_user_id") @db.Uuid

  connection BookkeepingConnection @relation(fields: [businessId, connectionId], references: [businessId, id], onDelete: Restrict)

  @@index([businessId, connectionId, startedAt])
  @@map("bookkeeping_sync_runs")
}

/// A bank or credit card account of a bookkeeping client (the Bank & Credit Card Accounts card):
/// synced from a connection or added by hand. Only the last digits are kept (mask), never a full
/// account number. The balance is shown with its date; a credit card balance is negative. The
/// accounts marked `reconcile` are the ones a period's reconciliation needs.
model BookkeepingAccount {
  id              String                 @id @default(uuid(7)) @db.Uuid
  businessId      String                 @map("business_id") @db.Uuid
  engagementId    String                 @map("engagement_id") @db.Uuid
  connectionId    String?                @map("connection_id") @db.Uuid
  name            String
  type            BookkeepingAccountType
  institution     String?
  /// The last 2 to 4 characters of the account number.
  mask            String?
  /// The account's id at the provider; unique per client and provider connection.
  sourceAccountId String?                @map("source_account_id")
  currency        String                 @default("usd")
  balanceCents    Int?                   @map("balance_cents")
  balanceAsOf     DateTime?              @map("balance_as_of") @db.Timestamptz(3)
  status          ConnectionStatus       @default(CONNECTED)
  reconcile       Boolean                @default(true)
  archivedAt      DateTime?              @map("archived_at") @db.Timestamptz(3)
  createdAt       DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime               @updatedAt @map("updated_at") @db.Timestamptz(3)

  engagement                 Engagement                  @relation(fields: [businessId, engagementId], references: [businessId, id], onDelete: Restrict)
  connection                 BookkeepingConnection?      @relation(fields: [businessId, connectionId], references: [businessId, id], onDelete: Restrict)
  bookkeepingReconciliations BookkeepingReconciliation[]

  @@unique([businessId, id])
  @@unique([businessId, engagementId, connectionId, sourceAccountId])
  @@index([businessId, engagementId])
  @@map("bookkeeping_accounts")
}

/// One reporting period of a bookkeeping client (a month, a quarter): its close workflow and,
/// when known, its income and expense totals. status goes NOT_STARTED, IN_PROGRESS,
/// READY_FOR_REVIEW, APPROVED, CLOSED; CLOSED locks the period (and its checklist and
/// reconciliations) until it is reopened with a reason, which raises closeVersion. The totals,
/// and the uncategorized count, are null until entered or imported: an unavailable value is never
/// invented. Never deleted.
model BookkeepingPeriod {
  id                 String                  @id @default(uuid(7)) @db.Uuid
  businessId         String                  @map("business_id") @db.Uuid
  engagementId       String                  @map("engagement_id") @db.Uuid
  kind               BookkeepingPeriodKind   @default(MONTH)
  periodStart        DateTime                @map("period_start") @db.Date
  periodEnd          DateTime                @map("period_end") @db.Date
  /// "September 2026", "Q3 2026".
  label              String
  status             BookkeepingPeriodStatus @default(NOT_STARTED)
  closeByOn          DateTime?               @map("close_by_on") @db.Date
  readyForReviewAt   DateTime?               @map("ready_for_review_at") @db.Timestamptz(3)
  readyForReviewBy   String?                 @map("ready_for_review_by") @db.Uuid
  approvedAt         DateTime?               @map("approved_at") @db.Timestamptz(3)
  approvedBy         String?                 @map("approved_by") @db.Uuid
  closedAt           DateTime?               @map("closed_at") @db.Timestamptz(3)
  closedBy           String?                 @map("closed_by") @db.Uuid
  /// Raised by one each time a closed period is reopened.
  closeVersion       Int                     @default(1) @map("close_version")
  reopenedAt         DateTime?               @map("reopened_at") @db.Timestamptz(3)
  reopenedBy         String?                 @map("reopened_by") @db.Uuid
  reopenReason       String?                 @map("reopen_reason")
  incomeCents        Int?                    @map("income_cents")
  expensesCents      Int?                    @map("expenses_cents")
  figuresSource      FiguresSource?          @map("figures_source")
  figuresAsOf        DateTime?               @map("figures_as_of") @db.Timestamptz(3)
  uncategorizedCount Int?                    @map("uncategorized_count")
  createdAt          DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime                @updatedAt @map("updated_at") @db.Timestamptz(3)

  engagement         Engagement                  @relation(fields: [businessId, engagementId], references: [businessId, id], onDelete: Restrict)
  closeItems         BookkeepingCloseItem[]
  reconciliations    BookkeepingReconciliation[]
  bookkeepingReports BookkeepingReport[]

  @@unique([businessId, id])
  @@unique([businessId, engagementId, periodStart, periodEnd])
  @@index([businessId, status, closeByOn])
  @@map("bookkeeping_periods")
}

/// A step of a period's close checklist (categorization, reconciliations, refunds, settlements,
/// documents, adjustments, P&L, balance sheet, open items, reports, reviewer approval, client
/// delivery), made from the firm's closeChecklist. A required step must be done before the period
/// closes. Locked while the period is CLOSED.
model BookkeepingCloseItem {
  id                String    @id @default(uuid(7)) @db.Uuid
  businessId        String    @map("business_id") @db.Uuid
  periodId          String    @map("period_id") @db.Uuid
  itemKey           String    @map("item_key")
  label             String
  required          Boolean   @default(true)
  position          Int
  completedAt       DateTime? @map("completed_at") @db.Timestamptz(3)
  completedByUserId String?   @map("completed_by_user_id") @db.Uuid
  note              String?
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  period BookkeepingPeriod @relation(fields: [businessId, periodId], references: [businessId, id], onDelete: Restrict)

  @@unique([businessId, periodId, itemKey])
  @@index([businessId, periodId, position])
  @@map("bookkeeping_close_items")
}

/// The reconciliation of one account for one period: the statement's beginning and ending
/// balances, what has been cleared, the difference (ending minus cleared, which the database
/// checks) and the open exceptions. It can be approved only when the difference is within the
/// tolerance; a reopen needs a reason. Saving progress is just updating the row. The statement is
/// a document of the same client, kept as a record: it cannot be deleted while a reconciliation
/// uses it. Locked while the period is CLOSED.
model BookkeepingReconciliation {
  id                    String               @id @default(uuid(7)) @db.Uuid
  businessId            String               @map("business_id") @db.Uuid
  periodId              String               @map("period_id") @db.Uuid
  accountId             String               @map("account_id") @db.Uuid
  statementStart        DateTime             @map("statement_start") @db.Date
  statementEnd          DateTime             @map("statement_end") @db.Date
  beginningBalanceCents Int                  @map("beginning_balance_cents")
  endingBalanceCents    Int                  @map("ending_balance_cents")
  clearedBalanceCents   Int                  @default(0) @map("cleared_balance_cents")
  clearedCount          Int                  @default(0) @map("cleared_count")
  /// ending minus cleared; zero when reconciled.
  differenceCents       Int                  @map("difference_cents")
  toleranceCents        Int                  @default(0) @map("tolerance_cents")
  /// Open exceptions: unmatched, duplicate, refund and settlement items.
  exceptionsCount       Int                  @default(0) @map("exceptions_count")
  statementDocumentId   String?              @map("statement_document_id") @db.Uuid
  status                ReconciliationStatus @default(IN_PROGRESS)
  readyForReviewAt      DateTime?            @map("ready_for_review_at") @db.Timestamptz(3)
  approvedAt            DateTime?            @map("approved_at") @db.Timestamptz(3)
  approvedBy            String?              @map("approved_by") @db.Uuid
  reopenedAt            DateTime?            @map("reopened_at") @db.Timestamptz(3)
  reopenedBy            String?              @map("reopened_by") @db.Uuid
  reopenReason          String?              @map("reopen_reason")
  createdAt             DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)

  period    BookkeepingPeriod  @relation(fields: [businessId, periodId], references: [businessId, id], onDelete: Restrict)
  account   BookkeepingAccount @relation(fields: [businessId, accountId], references: [businessId, id], onDelete: Restrict)
  statement Document?          @relation(fields: [businessId, statementDocumentId], references: [businessId, id], onDelete: Restrict)

  @@unique([businessId, periodId, accountId])
  @@index([businessId, status])
  @@map("bookkeeping_reconciliations")
}

/// The preparation, review and delivery of one bookkeeping report for a client and period
/// (Upcoming Reports, Reports tab, report review). The report the client sees is the existing
/// engagement report it points at (engagementReportId), published through that workflow; this row
/// is the work around it: due date, who generated, reviewed and delivered it, and when.
/// DELIVERED needs a published report of the same client and freezes the row. One row per client,
/// type and period (custom reports per name). Never deleted.
model BookkeepingReport {
  id                 String                @id @default(uuid(7)) @db.Uuid
  businessId         String                @map("business_id") @db.Uuid
  engagementId       String                @map("engagement_id") @db.Uuid
  /// The close period it belongs to; null for a quarterly or yearly report across periods.
  periodId           String?               @map("period_id") @db.Uuid
  reportType         BookkeepingReportType @map("report_type")
  customName         String?               @map("custom_name")
  /// "September 2026", "Q3 2026", "2026".
  periodLabel        String                @map("period_label")
  basis              AccountingBasis?
  dueOn              DateTime?             @map("due_on") @db.Date
  status             ReportReviewStatus    @default(NOT_STARTED)
  generatedAt        DateTime?             @map("generated_at") @db.Timestamptz(3)
  generatedByUserId  String?               @map("generated_by_user_id") @db.Uuid
  reviewedAt         DateTime?             @map("reviewed_at") @db.Timestamptz(3)
  reviewedByUserId   String?               @map("reviewed_by_user_id") @db.Uuid
  reviewNote         String?               @map("review_note")
  deliveredAt        DateTime?             @map("delivered_at") @db.Timestamptz(3)
  deliveredByUserId  String?               @map("delivered_by_user_id") @db.Uuid
  /// The published engagement report the client sees.
  engagementReportId String?               @map("engagement_report_id") @db.Uuid
  createdAt          DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)

  engagement       Engagement         @relation(fields: [businessId, engagementId], references: [businessId, id], onDelete: Restrict)
  period           BookkeepingPeriod? @relation(fields: [businessId, periodId], references: [businessId, id], onDelete: Restrict)
  engagementReport EngagementReport?  @relation(fields: [engagementReportId], references: [id], onDelete: Restrict)

  @@unique([businessId, id])
  @@unique([engagementReportId])
  @@index([businessId, engagementId, status])
  @@index([businessId, status, dueOn])
  @@map("bookkeeping_reports")
}

/// The firm's strategy library (Strategies & Recommendations): a named strategy with its category,
/// default priority, eligibility criteria, the inputs and documents it needs and an implementation
/// checklist. A strategy that plans or opportunities used is made inactive or archived, never
/// deleted, and its name can change without rewriting history (snapshots keep the name used).
/// `eligibility` is the criteria object the screening reads; `implementationChecklist` an array of
/// {label}.
model TaxPlanningStrategy {
  id                      String           @id @default(uuid(7)) @db.Uuid
  businessId              String           @map("business_id") @db.Uuid
  name                    String
  category                StrategyCategory
  description             String?
  defaultPriority         TaskPriority     @default(MEDIUM) @map("default_priority")
  eligibility             Json             @default("{}")
  requiredInputs          String[]         @default([]) @map("required_inputs")
  requiredDocuments       String[]         @default([]) @map("required_documents")
  implementationChecklist Json             @default("[]") @map("implementation_checklist")
  active                  Boolean          @default(true)
  archivedAt              DateTime?        @map("archived_at") @db.Timestamptz(3)
  createdByUserId         String?          @map("created_by_user_id") @db.Uuid
  createdAt               DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt               DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  planStrategies   TaxPlanStrategy[]
  taxOpportunities TaxOpportunity[]

  @@unique([businessId, id])
  @@unique([businessId, name])
  @@index([businessId, category, active])
  @@map("tax_planning_strategies")
}

/// A client's planning plan (Create / Edit Planning Plan, stages 1 and 3 to 5): the client, year,
/// filing status, entity, type, goals, notes (internal, and a separate client-facing note), who is
/// assigned, the target date and the next client discussion. Optionally inside the client's Tax
/// Planning engagement. Its strategies are TaxPlanStrategy rows. Archived, never deleted.
model TaxPlan {
  id                 String           @id @default(uuid(7)) @db.Uuid
  businessId         String           @map("business_id") @db.Uuid
  clientId           String           @map("client_id") @db.Uuid
  engagementId       String?          @map("engagement_id") @db.Uuid
  name               String
  planYear           Int              @map("plan_year")
  /// Null for a business-only plan.
  filingStatus       TaxFilingStatus? @map("filing_status")
  /// The client's entity or tax classification code, as on its record.
  entityType         String?          @map("entity_type")
  planType           TaxPlanType      @default(COMPREHENSIVE) @map("plan_type")
  status             TaxPlanStatus    @default(DRAFT)
  goals              PlanningGoal[]   @default([])
  /// The client's own goal, with OTHER.
  otherGoal          String?          @map("other_goal")
  /// Staff only.
  notes              String?
  /// Shown to the client only when set.
  clientNotes        String?          @map("client_notes")
  assignedUserId     String?          @map("assigned_user_id") @db.Uuid
  targetCompletionOn DateTime?        @map("target_completion_on") @db.Date
  nextDiscussionOn   DateTime?        @map("next_discussion_on") @db.Date
  createdByUserId    String?          @map("created_by_user_id") @db.Uuid
  archivedAt         DateTime?        @map("archived_at") @db.Timestamptz(3)
  createdAt          DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  client              Client               @relation(fields: [businessId, clientId], references: [businessId, id], onDelete: Restrict)
  engagement          Engagement?          @relation(fields: [businessId, clientId, engagementId], references: [businessId, clientId, id], onDelete: Restrict)
  assignedMember      Membership?          @relation(fields: [businessId, assignedUserId], references: [businessId, userId], onDelete: Restrict)
  strategies          TaxPlanStrategy[]
  taxPlanInputs       TaxPlanInput[]
  taxPlanVersions     TaxPlanVersion[]
  taxPlanDocuments    TaxPlanDocument[]
  taxSavingsScenarios TaxSavingsScenario[]
  taxOpportunities    TaxOpportunity[]

  @@unique([businessId, id])
  @@index([businessId, status])
  @@index([businessId, clientId, planYear])
  @@index([businessId, assignedUserId, status])
  @@map("tax_plans")
}

/// A strategy in a plan: from the library (strategyId) or a custom one for this client
/// (customName and customCategory). priority, the estimated savings with the year of the data it
/// used, an authorized override (with its reason) and the assumptions are kept on the row, so a
/// later change to the library never rewrites a plan. Estimates are estimates, never guarantees;
/// null means unavailable and is never invented.
model TaxPlanStrategy {
  id                    String             @id @default(uuid(7)) @db.Uuid
  businessId            String             @map("business_id") @db.Uuid
  planId                String             @map("plan_id") @db.Uuid
  strategyId            String?            @map("strategy_id") @db.Uuid
  customName            String?            @map("custom_name")
  customCategory        StrategyCategory?  @map("custom_category")
  /// The name and category as the plan shows them (a copy of the library's when it was added).
  displayName           String             @map("display_name")
  selected              Boolean            @default(true)
  priority              TaskPriority       @default(MEDIUM)
  status                PlanStrategyStatus @default(PROPOSED)
  estimatedSavingsCents Int?               @map("estimated_savings_cents")
  /// The tax year of the data the estimate used, and when it was calculated.
  estimateDataYear      Int?               @map("estimate_data_year")
  estimateCalculatedAt  DateTime?          @map("estimate_calculated_at") @db.Timestamptz(3)
  overrideSavingsCents  Int?               @map("override_savings_cents")
  overrideReason        String?            @map("override_reason")
  overrideByUserId      String?            @map("override_by_user_id") @db.Uuid
  assumptions           String?
  implementedOn         DateTime?          @map("implemented_on") @db.Date
  position              Int                @default(0)
  createdAt             DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  plan             TaxPlan              @relation(fields: [businessId, planId], references: [businessId, id], onDelete: Cascade)
  strategy         TaxPlanningStrategy? @relation(fields: [businessId, strategyId], references: [businessId, id], onDelete: Restrict)
  taxPlanDocuments TaxPlanDocument[]
  taxOpportunities TaxOpportunity[]

  @@unique([businessId, id])
  @@unique([businessId, planId, strategyId])
  @@index([businessId, planId, position])
  @@map("tax_plan_strategies")
}

/// A figure a plan is built on (Create / Edit Planning Plan, Financial Overview): the key (agi,
/// w2_income, self_employment_income, retirement_contributions...), what kind it is, its tax year,
/// the amount or text, where it came from and when. Historical and projected figures are never
/// mixed up, a manual adjustment says why, and a missing figure has no row: nothing is invented.
model TaxPlanInput {
  id              String        @id @default(uuid(7)) @db.Uuid
  businessId      String        @map("business_id") @db.Uuid
  planId          String        @map("plan_id") @db.Uuid
  key             String
  kind            PlanInputKind
  taxYear         Int           @map("tax_year")
  amountCents     Int?          @map("amount_cents")
  textValue       String?       @map("text_value")
  /// "Tax return 2025", "Client estimate", "Manual entry".
  source          String
  asOf            DateTime?     @map("as_of") @db.Timestamptz(3)
  note            String?
  enteredByUserId String?       @map("entered_by_user_id") @db.Uuid
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  plan TaxPlan @relation(fields: [businessId, planId], references: [businessId, id], onDelete: Restrict)

  @@unique([businessId, planId, key, kind, taxYear])
  @@map("tax_plan_inputs")
}

/// A snapshot of a plan kept when it is finalized, generated or sent: the strategies chosen with
/// their names, priorities, estimates, overrides and assumptions, the inputs and when each came
/// from, all as they were. Insert-only: later edits make a new version and never rewrite what
/// was delivered.
model TaxPlanVersion {
  id              String           @id @default(uuid(7)) @db.Uuid
  businessId      String           @map("business_id") @db.Uuid
  planId          String           @map("plan_id") @db.Uuid
  version         Int
  event           PlanVersionEvent
  taxYear         Int              @map("tax_year")
  snapshot        Json
  /// The newest source figure in the snapshot, to show how fresh the data was.
  sourceDataAsOf  DateTime?        @map("source_data_as_of") @db.Timestamptz(3)
  createdByUserId String?          @map("created_by_user_id") @db.Uuid
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)

  plan TaxPlan @relation(fields: [businessId, planId], references: [businessId, id], onDelete: Restrict)

  @@unique([businessId, planId, version])
  @@map("tax_plan_versions")
}

/// A document attached to a plan (the upload box), with its type and, optionally, the plan
/// strategy it supports. One of the plan client's documents.
model TaxPlanDocument {
  id             String   @id @default(uuid(7)) @db.Uuid
  businessId     String   @map("business_id") @db.Uuid
  planId         String   @map("plan_id") @db.Uuid
  documentId     String   @map("document_id") @db.Uuid
  planStrategyId String?  @map("plan_strategy_id") @db.Uuid
  category       String?
  addedByUserId  String?  @map("added_by_user_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  plan         TaxPlan          @relation(fields: [businessId, planId], references: [businessId, id], onDelete: Restrict)
  document     Document         @relation(fields: [businessId, documentId], references: [businessId, id], onDelete: Cascade)
  planStrategy TaxPlanStrategy? @relation(fields: [businessId, planStrategyId], references: [businessId, id], onDelete: Restrict)

  @@unique([businessId, planId, documentId])
  @@index([businessId, documentId])
  @@map("tax_plan_documents")
}

/// A Tax Savings Calculator scenario: for a client or standalone, a tax year, the baseline and
/// strategy inputs, the baseline and modeled tax and their difference (checked), and the
/// assumptions. Saved to a plan (planId) it becomes a snapshot that never changes. An estimate,
/// never a guarantee; an unavailable result is null.
model TaxSavingsScenario {
  id               String           @id @default(uuid(7)) @db.Uuid
  businessId       String           @map("business_id") @db.Uuid
  clientId         String?          @map("client_id") @db.Uuid
  planId           String?          @map("plan_id") @db.Uuid
  name             String?
  taxYear          Int              @map("tax_year")
  filingStatus     TaxFilingStatus? @map("filing_status")
  baselineInputs   Json             @default("{}") @map("baseline_inputs")
  strategyInputs   Json             @default("{}") @map("strategy_inputs")
  baselineTaxCents Int?             @map("baseline_tax_cents")
  modeledTaxCents  Int?             @map("modeled_tax_cents")
  /// Baseline minus modeled; the projected saving.
  differenceCents  Int?             @map("difference_cents")
  assumptions      String?
  savedToPlanAt    DateTime?        @map("saved_to_plan_at") @db.Timestamptz(3)
  createdByUserId  String?          @map("created_by_user_id") @db.Uuid
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  client Client?  @relation(fields: [businessId, clientId], references: [businessId, id], onDelete: Restrict)
  plan   TaxPlan? @relation(fields: [businessId, planId], references: [businessId, id], onDelete: Restrict)

  @@index([businessId, clientId])
  @@index([businessId, planId])
  @@map("tax_savings_scenarios")
}

/// A planning opportunity for a client (the Opportunity queue and Planning Opportunity Details):
/// identified by a screening rule or by staff, with why, the data it used (and its tax year and
/// as-of date), the estimated saving and its basis, the impact, numbered recommended actions, the
/// eligibility checks and the documents needed. It is not a recommendation until staff review it.
/// Not applicable and dismissed need a reason and can be suppressed until a date. A client has one
/// open opportunity per library strategy and year. Never deleted; its history is TaxOpportunityEvent.
/// Json fields: clientDataUsed [{label, amountCents | text}], recommendedActions [text],
/// eligibility [{text, met}], documentsNeeded [{label, received}].
model TaxOpportunity {
  id                    String            @id @default(uuid(7)) @db.Uuid
  businessId            String            @map("business_id") @db.Uuid
  clientId              String            @map("client_id") @db.Uuid
  strategyId            String?           @map("strategy_id") @db.Uuid
  name                  String
  category              StrategyCategory
  priority              TaskPriority      @default(MEDIUM)
  description           String?
  taxYear               Int               @map("tax_year")
  status                OpportunityStatus @default(NEW)
  source                OpportunitySource
  /// The screening rule that found it, and its plain-language explanation.
  ruleId                String?           @map("rule_id")
  whyExplanation        String?           @map("why_explanation")
  /// False when the data was too thin to be sure; missingData says what was missing.
  dataComplete          Boolean           @default(true) @map("data_complete")
  missingData           String[]          @default([]) @map("missing_data")
  lastEvaluatedAt       DateTime?         @map("last_evaluated_at") @db.Timestamptz(3)
  clientDataUsed        Json              @default("[]") @map("client_data_used")
  estimatedSavingsCents Int?              @map("estimated_savings_cents")
  /// "Based on current year data", with the assumptions behind the estimate.
  estimateBasis         String?           @map("estimate_basis")
  suggestedActionCents  Int?              @map("suggested_action_cents")
  newTaxableIncomeCents Int?              @map("new_taxable_income_cents")
  /// Effective tax rates in basis points (1800 = 18%), before and after.
  effectiveRateBeforeBp Int?              @map("effective_rate_before_bp")
  effectiveRateAfterBp  Int?              @map("effective_rate_after_bp")
  recommendedActions    Json              @default("[]") @map("recommended_actions")
  eligibility           Json              @default("[]")
  documentsNeeded       Json              @default("[]") @map("documents_needed")
  assignedUserId        String?           @map("assigned_user_id") @db.Uuid
  planId                String?           @map("plan_id") @db.Uuid
  planStrategyId        String?           @map("plan_strategy_id") @db.Uuid
  discussionOn          DateTime?         @map("discussion_on") @db.Date
  reviewedAt            DateTime?         @map("reviewed_at") @db.Timestamptz(3)
  reviewedByUserId      String?           @map("reviewed_by_user_id") @db.Uuid
  dispositionReason     String?           @map("disposition_reason")
  /// Screening leaves a not applicable or dismissed opportunity alone until this date.
  suppressedUntil       DateTime?         @map("suppressed_until") @db.Date
  implementedOn         DateTime?         @map("implemented_on") @db.Date
  createdByUserId       String?           @map("created_by_user_id") @db.Uuid
  createdAt             DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  client         Client                @relation(fields: [businessId, clientId], references: [businessId, id], onDelete: Restrict)
  strategy       TaxPlanningStrategy?  @relation(fields: [businessId, strategyId], references: [businessId, id], onDelete: Restrict)
  assignedMember Membership?           @relation(fields: [businessId, assignedUserId], references: [businessId, userId], onDelete: Restrict)
  plan           TaxPlan?              @relation(fields: [businessId, planId], references: [businessId, id], onDelete: Restrict)
  planStrategy   TaxPlanStrategy?      @relation(fields: [businessId, planStrategyId], references: [businessId, id], onDelete: Restrict)
  events         TaxOpportunityEvent[]

  @@unique([businessId, id])
  @@index([businessId, status, priority])
  @@index([businessId, clientId, taxYear])
  @@index([businessId, strategyId, status])
  @@map("tax_opportunities")
}

/// The history of an opportunity: screenings, status changes with their reasons, assignment,
/// scheduled discussions, document checklist changes and plan links. Insert-only; `reason` and
/// `details` hold short text and ids, never client figures beyond what the opportunity shows.
model TaxOpportunityEvent {
  id            String               @id @default(uuid(7)) @db.Uuid
  businessId    String               @map("business_id") @db.Uuid
  opportunityId String               @map("opportunity_id") @db.Uuid
  kind          OpportunityEventKind
  fromStatus    OpportunityStatus?   @map("from_status")
  toStatus      OpportunityStatus?   @map("to_status")
  reason        String?
  details       Json                 @default("{}")
  actorUserId   String?              @map("actor_user_id") @db.Uuid
  createdAt     DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)

  opportunity TaxOpportunity @relation(fields: [businessId, opportunityId], references: [businessId, id], onDelete: Restrict)

  @@index([businessId, opportunityId, createdAt])
  @@map("tax_opportunity_events")
}

// =====================================================================================
// R37 (Rasel, Oct 14): gaps for Intake Forms, Documents, Tax Returns, Appointments, Clients
// and Leads, found against Octavia's designs and guides (docs/mockups/firm-workspace/*).
// Columns on existing models are marked "R37" where they sit; new enums and tables are here.
// =====================================================================================

/// How an intake is delivered to its recipient. PORTAL only for a client's intake (CHECK).
enum IntakeDelivery {
  EMAIL
  SMS
  PORTAL
}

/// The firm's Intake Forms settings page, one row per firm (created by the API on first read;
/// the defaults here are what "Reset defaults" restores). Automation toggles default off: the
/// mockup's "On" switches are not approvals (guide).
model IntakeSettings {
  businessId              String   @id @map("business_id") @db.Uuid
  // General
  defaultExpiryDays       Int      @default(14) @map("default_expiry_days")
  allowSaveResume         Boolean  @default(true) @map("allow_save_resume")
  requireSignature        Boolean  @default(true) @map("require_signature")
  autoSubmissionId        Boolean  @default(false) @map("auto_submission_id")
  defaultOwnerUserId      String?  @map("default_owner_user_id") @db.Uuid
  // Client experience
  showProgressBar         Boolean  @default(true) @map("show_progress_bar")
  thankYouMessage         String?  @map("thank_you_message")
  redirectAfterCompletion Boolean  @default(false) @map("redirect_after_completion")
  /// https only; required while redirectAfterCompletion is on.
  redirectUrl             String?  @map("redirect_url")
  // Notifications
  sendClientConfirmation  Boolean  @default(true) @map("send_client_confirmation")
  notifyAssignedStaff     Boolean  @default(true) @map("notify_assigned_staff")
  remindersEnabled        Boolean  @default(true) @map("reminders_enabled")
  firstReminderDays       Int      @default(3) @map("first_reminder_days")
  finalReminderDays       Int      @default(7) @map("final_reminder_days")
  expiryAlertHours        Int      @default(24) @map("expiry_alert_hours")
  // Automation (all off)
  autoCreateClient        Boolean  @default(false) @map("auto_create_client")
  autoCreateFollowUpTask  Boolean  @default(false) @map("auto_create_follow_up_task")
  routeByService          Boolean  @default(false) @map("route_by_service")
  followUpOwnerUserId     String?  @map("follow_up_owner_user_id") @db.Uuid
  // Branding and security
  useFirmBranding         Boolean  @default(true) @map("use_firm_branding")
  /// A subset of the platform's allowed upload types; checked by the API against UPLOAD_LIMITS.
  acceptedFileTypes       String[] @default(["application/pdf", "image/jpeg", "image/png"]) @map("accepted_file_types")
  /// 1 to 10: the platform's cap is 10 MB (the mockup's 20 MB is refused).
  maxFileSizeMb           Int      @default(10) @map("max_file_size_mb")
  consentRequired         Boolean  @default(true) @map("consent_required")
  createdAt               DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt               DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  business      Business    @relation(fields: [businessId], references: [id])
  defaultOwner  Membership? @relation("IntakeSettingsOwner", fields: [businessId, defaultOwnerUserId], references: [businessId, userId], onDelete: Restrict)
  followUpOwner Membership? @relation("IntakeSettingsFollowUp", fields: [businessId, followUpOwnerUserId], references: [businessId, userId], onDelete: Restrict)

  @@map("intake_settings")
}

/// A reusable intake form a firm keeps (Form Templates screen, "Create new intake form"). A
/// service can have several. The versions are IntakeForm rows, numbered per template and
/// unchangeable once published. One live template per service is the default: the form Begin
/// Online and "send for an engagement" use. Archived, never deleted.
model IntakeTemplate {
  id                    String    @id @default(uuid(7)) @db.Uuid
  businessId            String    @map("business_id") @db.Uuid
  /// The category tab (Personal Tax, Bookkeeping...): one of the firm's services.
  serviceId             String    @map("service_id") @db.Uuid
  /// At most one live (unarchived) default per service.
  serviceDefault        Boolean   @default(false) @map("service_default")
  /// Staff-only authoring notes, never sent to recipients; up to 500 characters.
  internalNotes         String?   @map("internal_notes")
  /// Pre-fills "Assign to" when the template is sent; a member of the firm.
  defaultAssignedUserId String?   @map("default_assigned_user_id") @db.Uuid
  /// Null: made by Firmivra or by the database for a service's first form.
  createdByUserId       String?   @map("created_by_user_id") @db.Uuid
  archivedAt            DateTime? @map("archived_at") @db.Timestamptz(3)
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  business        Business     @relation(fields: [businessId], references: [id])
  service         Service      @relation(fields: [businessId, serviceId], references: [businessId, id], onDelete: Restrict)
  defaultAssignee Membership?  @relation("IntakeTemplateAssignedTo", fields: [businessId, defaultAssignedUserId], references: [businessId, userId], onDelete: Restrict)
  createdBy       Membership?  @relation("IntakeTemplateCreatedBy", fields: [businessId, createdByUserId], references: [businessId, userId], onDelete: Restrict)
  forms           IntakeForm[]

  @@unique([businessId, id])
  // Target of the versions' same-service foreign key.
  @@unique([businessId, id, serviceId])
  @@index([businessId, serviceId, archivedAt])
  @@map("intake_templates")
}

/// Where a document is in review. "Signed" is not stored: Firm Sign's records say it.
enum DocumentReviewStatus {
  NEEDS_REVIEW
  IN_REVIEW
  VERIFIED
  REPLACEMENT_REQUESTED
  COMPLETED
}

/// CLIENT folders hold a client's documents; FIRM folders are the firm's own (never shared).
enum DocumentFolderScope {
  CLIENT
  FIRM
}

/// Folder colours, mapped to packages/ui tokens by the screens (no hex values here).
enum FolderColor {
  BLUE
  GREEN
  YELLOW
  ORANGE
  PINK
  PURPLE
  GRAY
}

/// A folder's default for "Make visible to client" on that client's own new documents. Never a
/// grant to all clients.
enum FolderClientAccess {
  NONE
  VIEW
  VIEW_UPLOAD
}

/// The folder tree of the document library (Settings > Folders & Categories). Document types
/// stay in DocumentCategory. Archived, deleted only while empty and without subfolders (API).
model DocumentFolder {
  id                  String              @id @default(uuid(7)) @db.Uuid
  businessId          String              @map("business_id") @db.Uuid
  /// One line, 1 to 80 characters; unique among live folders of the same parent.
  name                String
  description         String?
  parentId            String?             @map("parent_id") @db.Uuid
  /// The same as the parent's; fixed.
  scope               DocumentFolderScope @default(CLIENT)
  color               FolderColor         @default(BLUE)
  sortOrder           Int                 @default(0) @map("sort_order")
  requireExpiryDate   Boolean             @default(false) @map("require_expiry_date")
  remindBeforeExpiry  Boolean             @default(false) @map("remind_before_expiry")
  allowClientUploads  Boolean             @default(false) @map("allow_client_uploads")
  notifyStaffOnUpload Boolean             @default(false) @map("notify_staff_on_upload")
  defaultClientAccess FolderClientAccess  @default(NONE) @map("default_client_access")
  archivedAt          DateTime?           @map("archived_at") @db.Timestamptz(3)
  createdAt           DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)

  business  Business         @relation(fields: [businessId], references: [id])
  parent    DocumentFolder?  @relation("FolderTree", fields: [businessId, parentId], references: [businessId, id], onDelete: Restrict)
  children  DocumentFolder[] @relation("FolderTree")
  documents Document[]

  @@unique([businessId, id])
  @@index([businessId, parentId, sortOrder])
  @@map("document_folders")
}

enum DocumentRequestRecipient {
  /// The client's portal logins (the household).
  CLIENT
  /// A member of the firm (an internal request, e.g. "send me the signed copy").
  MEMBER
}

/// DRAFT is saved but not sent (the portal never shows it); OPEN is with the recipient;
/// SUBMITTED means the client pressed "Submit for review"; COMPLETED and CANCELLED are final.
/// "Outstanding", "Partially received", "Ready for review", "Overdue" and "Expired" are computed
/// from the items, dueOn and expiresAt, not stored.
enum DocumentRequestPacketStatus {
  DRAFT
  OPEN
  SUBMITTED
  COMPLETED
  CANCELLED
}

/// A document request as the screens show it ("Request #DR-0024"): a title, a due date, a
/// message and a checklist of items. Each item is a DocumentRequest row (packet_id), so the
/// accept, reject and "I don't have this" rules stay as they are. Never deleted: a draft that
/// is dropped is CANCELLED. After it is sent only the due date, assignee, reminder, expiry and
/// the closing facts change.
model DocumentRequestPacket {
  id                  String                      @id @default(uuid(7)) @db.Uuid
  businessId          String                      @map("business_id") @db.Uuid
  clientId            String                      @map("client_id") @db.Uuid
  engagementId        String                      @map("engagement_id") @db.Uuid
  /// "#DR-" + number: given by the database, per firm, in order; never changes.
  number              Int                         @default(0)
  recipientKind       DocumentRequestRecipient    @default(CLIENT) @map("recipient_kind")
  /// A member of the firm; only for recipientKind MEMBER.
  recipientUserId     String?                     @map("recipient_user_id") @db.Uuid
  /// The request type it was made from (a snapshot: later edits of the type change nothing here).
  templateId          String?                     @map("template_id") @db.Uuid
  title               String
  /// Required to send.
  dueOn               DateTime?                   @map("due_on") @db.Date
  status              DocumentRequestPacketStatus @default(DRAFT)
  /// Variables ({Client Name}, {Due Date}) are resolved when it is sent. Emails and SMS carry
  /// a prompt to sign in, never the documents' names.
  messageSubject      String?                     @map("message_subject")
  messageBody         String?                     @map("message_body")
  notifyEmail         Boolean                     @default(true) @map("notify_email")
  notifyPortal        Boolean                     @default(true) @map("notify_portal")
  notifySms           Boolean                     @default(false) @map("notify_sms")
  /// Days before the due date; null = no reminder. Stops when COMPLETED or CANCELLED.
  reminderDaysBefore  Int?                        @map("reminder_days_before")
  allowMultipleFiles  Boolean                     @default(true) @map("allow_multiple_files")
  allowClientComments Boolean                     @default(true) @map("allow_client_comments")
  /// After the due date; separate from it.
  expiresAt           DateTime?                   @map("expires_at") @db.Timestamptz(3)
  assignedUserId      String?                     @map("assigned_user_id") @db.Uuid
  requestedByUserId   String?                     @map("requested_by_user_id") @db.Uuid
  /// Set by the database when the status reaches them.
  sentAt              DateTime?                   @map("sent_at") @db.Timestamptz(3)
  submittedAt         DateTime?                   @map("submitted_at") @db.Timestamptz(3)
  completedAt         DateTime?                   @map("completed_at") @db.Timestamptz(3)
  cancelledAt         DateTime?                   @map("cancelled_at") @db.Timestamptz(3)
  createdAt           DateTime                    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime                    @updatedAt @map("updated_at") @db.Timestamptz(3)

  engagement      Engagement               @relation(fields: [businessId, clientId, engagementId], references: [businessId, clientId, id], onDelete: Restrict)
  recipientMember Membership?              @relation("PacketRecipientMember", fields: [businessId, recipientUserId], references: [businessId, userId], onDelete: Restrict)
  template        DocumentRequestTemplate? @relation(fields: [businessId, templateId], references: [businessId, id], onDelete: Restrict)
  assignedMember  Membership?              @relation("PacketAssignedTo", fields: [businessId, assignedUserId], references: [businessId, userId], onDelete: Restrict)
  requestedBy     Membership?              @relation("PacketRequestedBy", fields: [businessId, requestedByUserId], references: [businessId, userId], onDelete: Restrict)
  items           DocumentRequest[]

  @@unique([businessId, number])
  // Target of the items' same-engagement foreign key.
  @@unique([businessId, engagementId, id])
  @@unique([businessId, id])
  @@index([businessId, status, dueOn])
  @@index([businessId, clientId])
  @@index([businessId, assignedUserId, status])
  @@index([businessId, templateId])
  @@index([businessId, createdAt])
  @@map("document_request_packets")
}

/// A request type the firm reuses ("Personal Tax Intake", 6 documents): firm-wide, or a
/// member's own saved list (ownerUserId). Archived, never deleted.
model DocumentRequestTemplate {
  id          String    @id @default(uuid(7)) @db.Uuid
  businessId  String    @map("business_id") @db.Uuid
  name        String
  description String?
  /// Null: the whole firm's. Set: that member's own "saved list".
  ownerUserId String?   @map("owner_user_id") @db.Uuid
  sortOrder   Int       @default(0) @map("sort_order")
  archivedAt  DateTime? @map("archived_at") @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  business Business                      @relation(fields: [businessId], references: [id])
  owner    Membership?                   @relation("RequestTemplateOwner", fields: [businessId, ownerUserId], references: [businessId, userId], onDelete: Restrict)
  items    DocumentRequestTemplateItem[]
  packets  DocumentRequestPacket[]

  @@unique([businessId, id])
  @@map("document_request_templates")
}

model DocumentRequestTemplateItem {
  id          String   @id @default(uuid(7)) @db.Uuid
  businessId  String   @map("business_id") @db.Uuid
  templateId  String   @map("template_id") @db.Uuid
  title       String
  description String?
  required    Boolean  @default(true)
  categoryId  String?  @map("category_id") @db.Uuid
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  template DocumentRequestTemplate @relation(fields: [businessId, templateId], references: [businessId, id], onDelete: Restrict)
  category DocumentCategory?       @relation(fields: [businessId, categoryId], references: [businessId, id], onDelete: Restrict)

  @@index([businessId, templateId, sortOrder])
  @@map("document_request_template_items")
}

enum DocumentShareRecipient {
  /// A portal login of the document's own client.
  CLIENT
  /// A member of the firm (read access beyond the usual assigned-staff rule).
  MEMBER
}

/// Access to one document for one person, with its own permissions and expiry ("Share" screen).
/// Viewing is implied by any grant.
/// A grant adds access, never removes it: the firm's owners, admins and the client's assigned
/// staff, and a client's household for a document shared with the client, keep theirs. Grants to
/// a client are for documents the client may see (not INTERNAL). Revoked once, never deleted.
/// There is no public link and no external recipient.
model DocumentShare {
  id              String                 @id @default(uuid(7)) @db.Uuid
  businessId      String                 @map("business_id") @db.Uuid
  documentId      String                 @map("document_id") @db.Uuid
  recipientKind   DocumentShareRecipient @map("recipient_kind")
  /// recipientKind CLIENT: a login of the document's client.
  clientAccountId String?                @map("client_account_id") @db.Uuid
  /// recipientKind MEMBER.
  memberUserId    String?                @map("member_user_id") @db.Uuid
  canDownload     Boolean                @default(true) @map("can_download")
  /// May add a new version (never overwrite).
  canUpload       Boolean                @default(false) @map("can_upload")
  /// A permission only: the signing itself is Firm Sign's.
  canSign         Boolean                @default(false) @map("can_sign")
  expiresAt       DateTime?              @map("expires_at") @db.Timestamptz(3)
  grantedByUserId String                 @map("granted_by_user_id") @db.Uuid
  revokedAt       DateTime?              @map("revoked_at") @db.Timestamptz(3)
  revokedByUserId String?                @map("revoked_by_user_id") @db.Uuid
  createdAt       DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime               @updatedAt @map("updated_at") @db.Timestamptz(3)

  document      Document       @relation(fields: [businessId, documentId], references: [businessId, id], onDelete: Restrict)
  clientAccount ClientAccount? @relation(fields: [businessId, clientAccountId], references: [businessId, id], onDelete: Restrict)
  member        Membership?    @relation("ShareToMember", fields: [businessId, memberUserId], references: [businessId, userId], onDelete: Restrict)
  grantedBy     Membership     @relation("ShareGrantedBy", fields: [businessId, grantedByUserId], references: [businessId, userId], onDelete: Restrict)
  revokedBy     Membership?    @relation("ShareRevokedBy", fields: [businessId, revokedByUserId], references: [businessId, userId], onDelete: Restrict)

  @@index([businessId, documentId])
  @@index([businessId, clientAccountId])
  @@index([businessId, memberUserId])
  @@map("document_shares")
}

/// The firm's Documents settings (Expiration & Reminders, File Settings, General), one row per
/// firm, created by the API on first read. Null means "none" or "the platform's limit"; no
/// value comes from the mockups.
model DocumentSettings {
  businessId                 String   @id @map("business_id") @db.Uuid
  /// Default reminder for new requests, days before the due date (1 to 30).
  requestReminderDaysBefore  Int?     @map("request_reminder_days_before")
  /// Default expiry for new requests, days after sending (1 to 365).
  requestExpiryDays          Int?     @map("request_expiry_days")
  /// Remind staff this many days before a document's own expiry date (1 to 365).
  documentExpiryReminderDays Int?     @map("document_expiry_reminder_days")
  /// Default expiry for new shares, days (1 to 365).
  shareExpiryDays            Int?     @map("share_expiry_days")
  /// Narrows the platform's 10 MB; 1 to 10485760.
  uploadMaxBytes             Int?     @map("upload_max_bytes")
  /// A subset of the platform's upload types; empty means all of them.
  uploadTypes                String[] @default([]) @map("upload_types")
  defaultReviewerUserId      String?  @map("default_reviewer_user_id") @db.Uuid
  createdAt                  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  business        Business    @relation(fields: [businessId], references: [id])
  defaultReviewer Membership? @relation("DocumentSettingsReviewer", fields: [businessId, defaultReviewerUserId], references: [businessId, userId], onDelete: Restrict)

  @@map("document_settings")
}

/// Where a return is in the firm's own workflow (Tax Returns list and workspace). The client
/// sees the five-value TaxReturnStatus, which the database derives from this.
enum TaxReturnWorkflowStatus {
  IN_PREPARATION
  /// A side state: entered and left from any step without a reason.
  WAITING_ON_CLIENT
  READY_FOR_REVIEW
  READY_FOR_SIGNATURE
  READY_TO_FILE
  /// The firm recorded that the return was sent (status tracking only; nothing is transmitted).
  TRANSMITTED
  ACCEPTED
  REJECTED
  CLOSED
}

enum TaxpayerFilingStatus {
  SINGLE
  MARRIED_FILING_JOINTLY
  MARRIED_FILING_SEPARATELY
  HEAD_OF_HOUSEHOLD
  QUALIFYING_SURVIVING_SPOUSE
}

/// A quarterly estimate's own progress (Overdue is computed: past dueOn and not PAID).
enum TaxEstimateStatus {
  NOT_STARTED
  CALCULATED
  SENT_TO_CLIENT
  SCHEDULED
  PAID
}

/// Every change of a return's workflow status, preparer or reviewer, written by the database
/// (status log, assignment history, the reasons for moving back, and the "vs last month" counts).
model TaxReturnHistory {
  id              String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  businessId      String                  @map("business_id") @db.Uuid
  taxReturnId     String                  @map("tax_return_id") @db.Uuid
  workflowStatus  TaxReturnWorkflowStatus @map("workflow_status")
  preparerUserId  String?                 @map("preparer_user_id") @db.Uuid
  reviewerUserId  String?                 @map("reviewer_user_id") @db.Uuid
  reason          String?
  changedByUserId String?                 @map("changed_by_user_id") @db.Uuid
  /// The time of the change itself (not of its transaction's start).
  changedAt       DateTime                @default(dbgenerated("clock_timestamp()")) @map("changed_at") @db.Timestamptz(3)
  /// The order the rows were written in: the newest is the current state.
  seq             BigInt                  @default(autoincrement())

  // A return that was never filed can be deleted, and takes its history with it.
  taxReturn TaxReturn @relation(fields: [businessId, taxReturnId], references: [businessId, id], onDelete: Cascade)

  @@index([businessId, taxReturnId, seq])
  @@index([businessId, changedAt])
  @@map("tax_return_history")
}

enum TaxFilingMethod {
  EFILE
  /// Filed on paper: never shown as e-filed.
  PAPER
}

/// One jurisdiction's filing state. For EFILE it follows the newest attempt (the database sets
/// it); PAPER_FILED is for paper filings only.
enum TaxJurisdictionStatus {
  NOT_FILED
  TRANSMITTED
  ACCEPTED
  REJECTED
  PAPER_FILED
}

enum TaxAmountStatus {
  ESTIMATED
  FINAL
}

enum TaxAckStatus {
  PENDING
  ACCEPTED
  REJECTED
}

/// One jurisdiction of a return: the federal return ("US") and each state ("GA"): how it is
/// filed, where it stands, the refund or amount due the firm expects. Extensions are the compliance deadline's (R38). Status
/// tracking only: the firm records what its tax software did.
model TaxReturnFiling {
  id             String                @id @default(uuid(7)) @db.Uuid
  businessId     String                @map("business_id") @db.Uuid
  taxReturnId    String                @map("tax_return_id") @db.Uuid
  /// "US" for federal, or a two-letter state code.
  jurisdiction   String
  filingMethod   TaxFilingMethod       @default(EFILE) @map("filing_method")
  /// Closing the return waits for the required jurisdictions only.
  required       Boolean               @default(true)
  status         TaxJurisdictionStatus @default(NOT_FILED)
  paperFiledOn   DateTime?             @map("paper_filed_on") @db.Date
  /// In cents. At most one of the two is above zero; the amount's status says estimate or final.
  refundCents    Int?                  @map("refund_cents")
  amountDueCents Int?                  @map("amount_due_cents")
  amountStatus   TaxAmountStatus?      @map("amount_status")
  createdAt      DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)

  taxReturn TaxReturn                @relation(fields: [businessId, taxReturnId], references: [businessId, id], onDelete: Cascade)
  attempts  TaxReturnFilingAttempt[]

  @@unique([businessId, taxReturnId, jurisdiction])
  @@unique([businessId, id])
  @@index([businessId, status])
  @@map("tax_return_filings")
}

/// One recorded transmission of a filing and what came back. Entered by staff from their tax
/// software ("Recorded by", never "sent by Firmivra"); never deleted, and a rejection stays when
/// the next attempt is made.
model TaxReturnFilingAttempt {
  id                String       @id @default(uuid(7)) @db.Uuid
  businessId        String       @map("business_id") @db.Uuid
  filingId          String       @map("filing_id") @db.Uuid
  /// The submission id as the software or agency gave it.
  submissionId      String       @map("submission_id")
  transmittedAt     DateTime     @map("transmitted_at") @db.Timestamptz(3)
  ackStatus         TaxAckStatus @default(PENDING) @map("ack_status")
  acknowledgedAt    DateTime?    @map("acknowledged_at") @db.Timestamptz(3)
  rejectCode        String?      @map("reject_code")
  rejectDescription String?      @map("reject_description")
  correctiveAction  String?      @map("corrective_action")
  recordedByUserId  String       @map("recorded_by_user_id") @db.Uuid
  createdAt         DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)

  filing     TaxReturnFiling @relation(fields: [businessId, filingId], references: [businessId, id], onDelete: Cascade)
  recordedBy Membership      @relation("TaxAttemptRecordedBy", fields: [businessId, recordedByUserId], references: [businessId, userId], onDelete: Restrict)

  @@unique([businessId, filingId, submissionId])
  @@index([businessId, filingId, transmittedAt])
  @@index([businessId, ackStatus, transmittedAt])
  @@map("tax_return_filing_attempts")
}

enum TaxApprovalStatus {
  PENDING
  APPROVED
  /// Sent back to the preparer, with the reviewer's note.
  RETURNED
  /// A decided approval a material change cancelled; a new PENDING step replaces it.
  INVALIDATED
}

/// A required review step of a return ("Preparer Review", "Final Review / Approval"). A decided
/// step never changes, except to INVALIDATED; never deleted. Approving a return is the firm's
/// own act: this records who and when.
model TaxReturnApproval {
  id                 String            @id @default(uuid(7)) @db.Uuid
  businessId         String            @map("business_id") @db.Uuid
  taxReturnId        String            @map("tax_return_id") @db.Uuid
  /// The step's name, one line, up to 100 characters.
  step               String
  sortOrder          Int               @map("sort_order")
  assignedUserId     String?           @map("assigned_user_id") @db.Uuid
  status             TaxApprovalStatus @default(PENDING)
  decidedAt          DateTime?         @map("decided_at") @db.Timestamptz(3)
  decidedByUserId    String?           @map("decided_by_user_id") @db.Uuid
  /// The draft that was reviewed.
  approvedDocumentId String?           @map("approved_document_id") @db.Uuid
  /// The reviewer's note; required when RETURNED.
  note               String?
  createdAt          DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)

  taxReturn        TaxReturn   @relation(fields: [businessId, taxReturnId], references: [businessId, id], onDelete: Cascade)
  assignedMember   Membership? @relation("TaxApprovalAssignedTo", fields: [businessId, assignedUserId], references: [businessId, userId], onDelete: Restrict)
  decidedBy        Membership? @relation("TaxApprovalDecidedBy", fields: [businessId, decidedByUserId], references: [businessId, userId], onDelete: Restrict)
  approvedDocument Document?   @relation(fields: [businessId, approvedDocumentId], references: [businessId, id], onDelete: Restrict)

  @@index([businessId, taxReturnId, sortOrder])
  @@index([businessId, assignedUserId, status])
  @@map("tax_return_approvals")
}

enum TaxChecklistSection {
  /// The preparer's own list.
  PREPARATION
  /// The reviewer's list.
  REVIEW
  /// The manual final validation (there is no tax software here): what the firm checked.
  VALIDATION
}

/// OPEN and DONE are for the preparation and review lists; VALID, INFO, WARNING and ERROR for
/// the final validation.
enum TaxCheckResult {
  OPEN
  DONE
  VALID
  INFO
  WARNING
  ERROR
}

/// One line of a return's preparation or review checklist, or one result of its final
/// validation. The counts on the screen (errors, warnings, informational) are computed.
model TaxReturnChecklistItem {
  id                   String              @id @default(uuid(7)) @db.Uuid
  businessId           String              @map("business_id") @db.Uuid
  taxReturnId          String              @map("tax_return_id") @db.Uuid
  section              TaxChecklistSection
  /// One line, up to 200 characters.
  label                String
  sortOrder            Int                 @default(0) @map("sort_order")
  result               TaxCheckResult      @default(OPEN)
  note                 String?
  /// A WARNING is acknowledged by someone before the return is ready to file.
  acknowledgedAt       DateTime?           @map("acknowledged_at") @db.Timestamptz(3)
  acknowledgedByUserId String?             @map("acknowledged_by_user_id") @db.Uuid
  updatedByUserId      String?             @map("updated_by_user_id") @db.Uuid
  createdAt            DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)

  taxReturn      TaxReturn   @relation(fields: [businessId, taxReturnId], references: [businessId, id], onDelete: Cascade)
  acknowledgedBy Membership? @relation("TaxChecklistAcknowledgedBy", fields: [businessId, acknowledgedByUserId], references: [businessId, userId], onDelete: Restrict)
  updatedBy      Membership? @relation("TaxChecklistUpdatedBy", fields: [businessId, updatedByUserId], references: [businessId, userId], onDelete: Restrict)

  @@index([businessId, taxReturnId, section, sortOrder])
  @@map("tax_return_checklist_items")
}

enum TaxAuthorizationKind {
  /// The client's e-file authorization for the federal return (Form 8879 and its variants).
  FEDERAL_EFILE
  /// A state's e-file authorization.
  STATE_EFILE
  /// The client's consent or engagement for the return.
  CLIENT_CONSENT
}

/// One signature line of a return (Client Signatures on the review screen): which authorization,
/// whether it is required, and where it is signed: a Firm Sign request (whose status is the
/// status), or a wet signature the firm recorded (signedOn and the signed copy). Not a second
/// signing flow.
model TaxReturnAuthorization {
  id             String               @id @default(uuid(7)) @db.Uuid
  businessId     String               @map("business_id") @db.Uuid
  taxReturnId    String               @map("tax_return_id") @db.Uuid
  kind           TaxAuthorizationKind
  /// Two-letter state code; only for STATE_EFILE.
  jurisdiction   String?
  required       Boolean              @default(true)
  /// The Firm Sign request sent for this line (the client's own); a resend moves it to the
  /// replacing request.
  esignRequestId String?              @map("esign_request_id") @db.Uuid
  /// A signature recorded outside Firm Sign, with the signed copy; set together.
  signedOn       DateTime?            @map("signed_on") @db.Date
  documentId     String?              @map("document_id") @db.Uuid
  createdAt      DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)

  taxReturn    TaxReturn     @relation(fields: [businessId, taxReturnId], references: [businessId, id], onDelete: Cascade)
  esignRequest EsignRequest? @relation(fields: [businessId, esignRequestId], references: [businessId, id], onDelete: Restrict)
  document     Document?     @relation(fields: [businessId, documentId], references: [businessId, id], onDelete: Restrict)

  @@index([businessId, taxReturnId])
  @@index([businessId, esignRequestId])
  @@map("tax_return_authorizations")
}

/// What a file is in a return's folder: the draft, the signature form, the filed return, the
/// acknowledgment, a voucher, proof of payment or an extension form. Files stay ordinary
/// documents of the client; this adds the role. The filed return and acknowledgment links are
/// never removed.
enum TaxReturnDocumentKind {
  DRAFT_RETURN
  SIGNATURE_FORM
  FILED_RETURN
  ACKNOWLEDGMENT
  VOUCHER
  PAYMENT_PROOF
  EXTENSION
}

model TaxReturnDocument {
  id              String                @id @default(uuid(7)) @db.Uuid
  businessId      String                @map("business_id") @db.Uuid
  taxReturnId     String                @map("tax_return_id") @db.Uuid
  documentId      String                @map("document_id") @db.Uuid
  kind            TaxReturnDocumentKind
  /// "US" or a state code, when the file belongs to one jurisdiction.
  jurisdiction    String?
  createdByUserId String?               @map("created_by_user_id") @db.Uuid
  createdAt       DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)

  taxReturn TaxReturn   @relation(fields: [businessId, taxReturnId], references: [businessId, id], onDelete: Cascade)
  document  Document    @relation(fields: [businessId, documentId], references: [businessId, id], onDelete: Restrict)
  createdBy Membership? @relation("TaxDocumentAddedBy", fields: [businessId, createdByUserId], references: [businessId, userId], onDelete: Restrict)

  @@unique([businessId, taxReturnId, documentId])
  @@index([businessId, taxReturnId, kind, createdAt])
  @@index([businessId, documentId])
  @@map("tax_return_documents")
}

/// Calendar colours: token names the screens map to packages/ui (no hex values here).
enum CalendarColor {
  BLUE
  GREEN
  AMBER
  RED
  PURPLE
  GRAY
}

enum ReminderChannel {
  EMAIL
  SMS
  PORTAL
}

/// One reminder an appointment will send ("email, 1 day before"). The database keeps dueAt
/// (the start minus the offset) and clears sentAt when the appointment is rescheduled, so the new
/// time gets its own reminder. It replaces appointments.reminder_sent_at once the sender uses it.
model AppointmentReminder {
  id            String          @id @default(uuid(7)) @db.Uuid
  businessId    String          @map("business_id") @db.Uuid
  appointmentId String          @map("appointment_id") @db.Uuid
  channel       ReminderChannel
  /// Minutes before the start: 0 (at the start) to 43,200 (30 days). 1 week = 10,080.
  offsetMinutes Int             @map("offset_minutes")
  dueAt         DateTime        @default(now()) @map("due_at") @db.Timestamptz(3)
  sentAt        DateTime?       @map("sent_at") @db.Timestamptz(3)
  createdAt     DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)

  appointment Appointment @relation(fields: [businessId, appointmentId], references: [businessId, id], onDelete: Restrict)

  @@unique([businessId, appointmentId, channel, offsetMinutes])
  @@index([businessId, dueAt])
  @@map("appointment_reminders")
}

/// A place the firm meets clients (Schedule Appointment's Office / Branch). Archived, never
/// deleted once appointments use it.
model FirmOffice {
  id           String    @id @default(uuid(7)) @db.Uuid
  businessId   String    @map("business_id") @db.Uuid
  name         String
  addressLine1 String?   @map("address_line1")
  city         String?
  state        String?
  postalCode   String?   @map("postal_code")
  /// At most one live main office per firm.
  isMain       Boolean   @default(false) @map("is_main")
  sortOrder    Int       @default(0) @map("sort_order")
  archivedAt   DateTime? @map("archived_at") @db.Timestamptz(3)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  business     Business      @relation(fields: [businessId], references: [id])
  rooms        FirmRoom[]
  appointments Appointment[]

  @@unique([businessId, id])
  @@map("firm_offices")
}

/// A room of an office ("Conference Room 1"). Two live appointments never share a room at once.
model FirmRoom {
  id         String    @id @default(uuid(7)) @db.Uuid
  businessId String    @map("business_id") @db.Uuid
  officeId   String    @map("office_id") @db.Uuid
  name       String
  archivedAt DateTime? @map("archived_at") @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  office       FirmOffice    @relation(fields: [businessId, officeId], references: [businessId, id], onDelete: Restrict)
  appointments Appointment[]

  @@unique([businessId, officeId, id])
  @@unique([businessId, officeId, name])
  @@map("firm_rooms")
}

enum BlockedTimeKind {
  BLOCKED
  TIME_OFF
}

enum RecurrenceFrequency {
  DAILY
  WEEKLY
  MONTHLY
}

/// How a repeating appointment repeats. The API makes one appointment per occurrence (at most 52)
/// that each carry seriesId, so double-booking, reminders and cancelling work on each as usual.
model AppointmentSeries {
  id              String              @id @default(uuid(7)) @db.Uuid
  businessId      String              @map("business_id") @db.Uuid
  frequency       RecurrenceFrequency
  /// Every N days, weeks or months (1 to 12).
  intervalCount   Int                 @default(1) @map("interval_count")
  /// WEEKLY: the weekdays (0 = Sunday), each once.
  byWeekdays      Int[]               @default([]) @map("by_weekdays")
  /// It ends on a date, or after a number of occurrences: exactly one of the two.
  untilDate       DateTime?           @map("until_date") @db.Date
  occurrenceCount Int?                @map("occurrence_count")
  /// The zone the repeat is worked out in (an IANA name); fixed.
  timeZone        String              @map("time_zone")
  createdByUserId String?             @map("created_by_user_id") @db.Uuid
  createdAt       DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)

  createdBy    Membership?   @relation("SeriesCreatedBy", fields: [businessId, createdByUserId], references: [businessId, userId], onDelete: Restrict)
  appointments Appointment[]

  @@unique([businessId, id])
  @@map("appointment_series")
}

/// A one-day change to a staff member's weekly working hours: no hours that day (startsAt and
/// endsAt empty), or different hours. Times of day in the firm's time zone.
model AvailabilityOverride {
  id              String    @id @default(uuid(7)) @db.Uuid
  businessId      String    @map("business_id") @db.Uuid
  userId          String    @map("user_id") @db.Uuid
  date            DateTime  @db.Date
  startsAt        DateTime? @map("starts_at") @db.Time(0)
  endsAt          DateTime? @map("ends_at") @db.Time(0)
  createdByUserId String?   @map("created_by_user_id") @db.Uuid
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  staff Membership @relation("OverrideStaff", fields: [businessId, userId], references: [businessId, userId], onDelete: Restrict)

  @@index([businessId, userId, date])
  @@map("availability_overrides")
}

/// The firm's Appointments settings: booking limits and buffers every type starts from, and the
/// master email that gets a copy of appointment notices. Empty means none.
model AppointmentSettings {
  businessId              String   @id @map("business_id") @db.Uuid
  defaultBufferMinutes    Int      @default(0) @map("default_buffer_minutes")
  bookingMinNoticeMinutes Int      @default(0) @map("booking_min_notice_minutes")
  bookingMaxAdvanceDays   Int?     @map("booking_max_advance_days")
  /// A copy of confirmations, changes and cancellations goes here.
  copyEmail               String?  @map("copy_email")
  copyEnabled             Boolean  @default(true) @map("copy_enabled")
  copyReminders           Boolean  @default(false) @map("copy_reminders")
  createdAt               DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt               DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  business Business @relation(fields: [businessId], references: [id])

  @@map("appointment_settings")
}

enum ClientStatus {
  NEW
  PENDING_DOCUMENTS
  IN_PROGRESS
  ACTIVE
  ON_HOLD
  /// Still in the directory (the Inactive tab); archiving is separate and hides the client.
  INACTIVE
}

/// Not drawn in the designs (only the filter's name): High, Medium, Low as on tasks. To confirm.
enum ClientPriority {
  HIGH
  MEDIUM
  LOW
}

/// Every change of a client's status, written by the database (the Activity timeline, and the
/// "vs last month" counts on the list's cards).
model ClientStatusHistory {
  id              String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  businessId      String       @map("business_id") @db.Uuid
  clientId        String       @map("client_id") @db.Uuid
  status          ClientStatus
  changedByUserId String?      @map("changed_by_user_id") @db.Uuid
  /// The time of the change itself (not of its transaction's start).
  changedAt       DateTime     @default(dbgenerated("clock_timestamp()")) @map("changed_at") @db.Timestamptz(3)
  /// The order the rows were written in: the newest is the current state.
  seq             BigInt       @default(autoincrement())

  client Client @relation(fields: [businessId, clientId], references: [businessId, id], onDelete: Restrict)

  @@index([businessId, clientId, seq])
  @@index([businessId, changedAt])
  @@map("client_status_history")
}

/// A label the firm defines (Back Taxes, W-2, Investments) for its clients (and, later, leads).
/// Owners and admins create and archive them; staff apply existing ones. Archived, never deleted.
model Tag {
  id              String    @id @default(uuid(7)) @db.Uuid
  businessId      String    @map("business_id") @db.Uuid
  /// One line, 1 to 50 characters; unique among live tags of the firm, ignoring case.
  name            String
  archivedAt      DateTime? @map("archived_at") @db.Timestamptz(3)
  createdByUserId String?   @map("created_by_user_id") @db.Uuid
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  business  Business    @relation(fields: [businessId], references: [id])
  createdBy Membership? @relation("TagCreatedBy", fields: [businessId, createdByUserId], references: [businessId, userId], onDelete: Restrict)
  clients   ClientTag[]
  leads     LeadTag[]

  @@unique([businessId, id])
  @@map("tags")
}

/// A tag on a client. Removing a tag deletes its row (the audit log keeps who and when).
model ClientTag {
  businessId    String   @map("business_id") @db.Uuid
  clientId      String   @map("client_id") @db.Uuid
  tagId         String   @map("tag_id") @db.Uuid
  addedByUserId String?  @map("added_by_user_id") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  client  Client      @relation(fields: [businessId, clientId], references: [businessId, id], onDelete: Restrict)
  tag     Tag         @relation(fields: [businessId, tagId], references: [businessId, id], onDelete: Restrict)
  addedBy Membership? @relation("ClientTagAddedBy", fields: [businessId, addedByUserId], references: [businessId, userId], onDelete: Restrict)

  @@id([clientId, tagId])
  @@index([businessId, tagId])
  @@map("client_tags")
}

/// Where a lead came from (the list's source filter). Begin Online leads are BEGIN_ONLINE.
enum LeadSource {
  BEGIN_ONLINE
  WEBSITE_FORM
  FACEBOOK_AD
  INSTAGRAM
  GOOGLE_AD
  REFERRAL
  /// R47: the Leads design's other sources (a call, a walk-in, an email, an event).
  PHONE_CALL
  WALK_IN
  EMAIL
  EVENT
  OTHER
}

/// Set by hand, as on the designs (Hot, Warm, Cold); there is no score.
enum LeadPriority {
  HOT
  WARM
  COLD
}

enum LeadActionType {
  CALL
  EMAIL
  /// R47: a text message, and closing the lead ("No further action"; it still has a time, the
  /// moment it is closed).
  SMS
  APPOINTMENT
  SEND_DOCUMENTS
  FOLLOW_UP
  CLOSE_LEAD
}

/// A service a lead is interested in (the list can show several). The lead's own service
/// (Lead.serviceId, the Begin Online service) is kept as it is; this adds the others.
model LeadService {
  businessId String   @map("business_id") @db.Uuid
  leadId     String   @map("lead_id") @db.Uuid
  serviceId  String   @map("service_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  lead    Lead    @relation(fields: [businessId, leadId], references: [businessId, id], onDelete: Restrict)
  service Service @relation(fields: [businessId, serviceId], references: [businessId, id], onDelete: Restrict)

  @@id([leadId, serviceId])
  @@index([businessId, serviceId])
  @@map("lead_services")
}

/// A tag on a lead, from the same catalog as the clients' tags, so tags carry over when the
/// lead becomes a client.
model LeadTag {
  businessId    String   @map("business_id") @db.Uuid
  leadId        String   @map("lead_id") @db.Uuid
  tagId         String   @map("tag_id") @db.Uuid
  addedByUserId String?  @map("added_by_user_id") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  lead    Lead        @relation(fields: [businessId, leadId], references: [businessId, id], onDelete: Restrict)
  tag     Tag         @relation(fields: [businessId, tagId], references: [businessId, id], onDelete: Restrict)
  addedBy Membership? @relation("LeadTagAddedBy", fields: [businessId, addedByUserId], references: [businessId, userId], onDelete: Restrict)

  @@id([leadId, tagId])
  @@index([businessId, tagId])
  @@map("lead_tags")
}

enum LeadActivityKind {
  CREATED
  STATUS_CHANGED
  FORM_SUBMITTED
  EMAIL_SENT
  SMS_SENT
  CALL
  MEETING
  NOTE
  FOLLOW_UP
  FOLLOW_UP_COMPLETED
  APPOINTMENT_SCHEDULED
  TAG_ADDED
  ASSIGNED
  CONVERTED
  /// R47: a document uploaded for the lead, and the lead added to a campaign (Leads design).
  DOCUMENT
  CAMPAIGN
}

/// A lead's timeline (Recent Activity, the Activity and Notes tabs): what happened, by whom
/// (empty actor = "System" or the visitor), and when. The database writes CREATED, STATUS_CHANGED
/// and ASSIGNED; the API logs calls, meetings, notes, follow-ups and sent messages (never the
/// message text). Last contact is the newest email, SMS, call, meeting or appointment row.
/// Append-only.
model LeadActivity {
  id          String           @id @default(uuid(7)) @db.Uuid
  businessId  String           @map("business_id") @db.Uuid
  leadId      String           @map("lead_id") @db.Uuid
  kind        LeadActivityKind
  actorUserId String?          @map("actor_user_id") @db.Uuid
  /// When it happened; a logged call may be backdated, never set ahead.
  occurredAt  DateTime         @default(now()) @map("occurred_at") @db.Timestamptz(3)
  /// Up to 1,000 characters (R47): an email's subject, a tag's name, a logged call's summary.
  summary     String?
  /// A note or the notes of a call, up to 5,000 characters; required for a NOTE.
  body        String?
  /// STATUS_CHANGED only: the new status.
  status      LeadStatus?
  /// Safe values only (ids, the action type); never message content.
  metadata    Json             @default("{}")
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)

  lead  Lead        @relation(fields: [businessId, leadId], references: [businessId, id], onDelete: Restrict)
  actor Membership? @relation("LeadActivityActor", fields: [businessId, actorUserId], references: [businessId, userId], onDelete: Restrict)

  @@index([businessId, leadId, occurredAt])
  @@index([businessId, kind, occurredAt])
  @@map("lead_activities")
}

// ---------- R0 stage B5: Super Admin Sales Pipeline ----------
// Firmivra selling to prospective firms. One dataset behind the board, the list, the KPIs and the
// analytics: a contact (the master person record, never duplicated on conversion), its
// opportunities in a pipeline's stages, and their history, activity, follow-ups and notes. Platform
// data: only the Super Admin team and the platform's jobs reach it. Contract note:
// docs/work/R0-stage-b5-sales.md.

/// What a stage means for the lifecycle, the KPIs and the transaction sync.
enum SalesStageType {
  /// Working the lead (New Lead to Nurturing); counts in pipeline value.
  ACTIVE
  /// Converted to an active client (the conversion event).
  CONVERTED
  /// Set only by a linked transaction that is under contract.
  TRANSACTION_SYNCED
  /// Closed / past client.
  CLOSED
  /// The side exit: unqualified or lost, with a reason.
  LOST
}

enum SalesLeadSource {
  WEBSITE
  REFERRAL
  SOCIAL_MEDIA
  PAID_ADVERTISING
  ORGANIC_SEARCH
  EVENT
  PARTNER
  MANUAL_ENTRY
  OTHER
}

enum SalesLostReason {
  NOT_A_FIT
  BUDGET
  NO_RESPONSE
  CHOSE_COMPETITOR
  TIMING
  DUPLICATE
  INVALID_LEAD
  OTHER
}

/// The linked transaction's state, as the transaction side reports it.
enum SalesTransactionStatus {
  OPEN
  UNDER_CONTRACT
  CLOSED
  TERMINATED
}

/// Who moved a record: a person, an approved automation, the transaction sync, or an import.
enum SalesChangeSource {
  MANUAL
  AUTOMATION
  TRANSACTION
  IMPORT
}

enum SalesFollowUpKind {
  FOLLOW_UP
  CALL
  DEMO
  CONSULTATION
  MEETING
}

enum SalesFollowUpStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

enum SalesActivityKind {
  CALL
  EMAIL
  SMS
  MEETING
  OTHER
}

enum SalesActivityDirection {
  OUTBOUND
  INBOUND
}

enum SalesActivityOutcome {
  CONNECTED
  NO_ANSWER
  LEFT_MESSAGE
  REPLIED
  NO_REPLY
  BOUNCED
  COMPLETED
}

/// A sales process. The migration ships Firmivra's default (system key "firmivra_default") with
/// the approved lifecycle; admins add more without code changes.
model SalesPipeline {
  id                      String   @id @default(uuid(7)) @db.Uuid
  name                    String   @unique
  description             String?
  /// Set only on pipelines the migration ships.
  systemKey               String?  @unique @map("system_key")
  isActive                Boolean  @default(true) @map("is_active")
  /// Where a terminated transaction returns a record (an active or converted stage of this pipeline).
  terminatedReturnStageId String?  @map("terminated_return_stage_id") @db.Uuid
  createdByUserId         String?  @map("created_by_user_id") @db.Uuid
  createdAt               DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt               DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  stages             SalesPipelineStage[] @relation("SalesPipelineStages")
  terminatedReturnTo SalesPipelineStage?  @relation("SalesPipelineTerminatedReturn", fields: [id, terminatedReturnStageId], references: [pipelineId, id], onDelete: Restrict)
  opportunities      SalesOpportunity[]

  @@map("sales_pipelines")
}

/// A pipeline's stage. A stage holding records can't be deleted (move them first) or change type;
/// an inactive stage takes no new records. History keeps the stage's name at the time, so a rename
/// or a reorder never rewrites it.
model SalesPipelineStage {
  id             String         @id @default(uuid(7)) @db.Uuid
  pipelineId     String         @map("pipeline_id") @db.Uuid
  name           String
  /// Set only on stages the migration ships (e.g. "new_lead", "unqualified_lost").
  systemKey      String?        @map("system_key")
  stageType      SalesStageType @map("stage_type")
  position       Int
  isActive       Boolean        @default(true) @map("is_active")
  /// What a record must carry to enter: "value", "assignee", "plan", "transaction", "lost_note".
  requiredFields String[]       @default([]) @map("required_fields")
  /// Approved automation keys the API runs on entry and exit.
  onEnterActions String[]       @default([]) @map("on_enter_actions")
  onExitActions  String[]       @default([]) @map("on_exit_actions")
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  pipeline          SalesPipeline       @relation("SalesPipelineStages", fields: [pipelineId], references: [id], onDelete: Cascade)
  terminatedReturns SalesPipeline[]     @relation("SalesPipelineTerminatedReturn")
  opportunities     SalesOpportunity[]  @relation("SalesOpportunityStage")
  historyFrom       SalesStageHistory[] @relation("SalesStageHistoryFrom")
  historyTo         SalesStageHistory[] @relation("SalesStageHistoryTo")

  @@unique([pipelineId, id])
  @@unique([pipelineId, name])
  @@unique([pipelineId, systemKey])
  @@index([pipelineId, position])
  @@map("sales_pipeline_stages")
}

/// The master person record for a prospect. Converting a lead never creates a second one.
model SalesContact {
  id              String   @id @default(uuid(7)) @db.Uuid
  name            String
  email           String?
  phone           String?
  /// Set by the database (lowercased email, phone digits) for the duplicate check and search.
  emailNormalized String?  @map("email_normalized")
  phoneNormalized String?  @map("phone_normalized")
  companyName     String?  @map("company_name")
  jobTitle        String?  @map("job_title")
  createdByUserId String?  @map("created_by_user_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  opportunities SalesOpportunity[]

  @@index([emailNormalized])
  @@index([phoneNormalized])
  @@index([companyName])
  @@map("sales_contacts")
}

/// One record behind the card, the row, the KPIs and the analytics. The database keeps the stage
/// rules (lost needs a reason, Under Contract needs its transaction, required fields), applies the
/// transaction sync, and writes the stage and assignment history itself.
model SalesOpportunity {
  id                  String                  @id @default(uuid(7)) @db.Uuid
  pipelineId          String                  @map("pipeline_id") @db.Uuid
  stageId             String                  @map("stage_id") @db.Uuid
  contactId           String                  @map("contact_id") @db.Uuid
  /// The firm or opportunity name shown on the card.
  title               String
  companyName         String?                 @map("company_name")
  source              SalesLeadSource         @default(MANUAL_ENTRY)
  /// The plan the prospect is interested in.
  planId              String?                 @map("plan_id") @db.Uuid
  /// Estimated value in cents; never invented (null when not given).
  valueCents          Int?                    @map("value_cents")
  assignedToUserId    String?                 @map("assigned_to_user_id") @db.Uuid
  /// Set while the record is in a lost stage, and only then.
  lostReason          SalesLostReason?        @map("lost_reason")
  lostNote            String?                 @map("lost_note")
  lostAt              DateTime?               @map("lost_at") @db.Timestamptz(3)
  /// First time it entered a converted stage (the conversion event).
  convertedAt         DateTime?               @map("converted_at") @db.Timestamptz(3)
  stageEnteredAt      DateTime                @default(now()) @map("stage_entered_at") @db.Timestamptz(3)
  /// The firm's application and the firm, once it applies and is provisioned.
  firmApplicationId   String?                 @map("firm_application_id") @db.Uuid
  linkedBusinessId    String?                 @map("linked_business_id") @db.Uuid
  /// The linked transaction (e.g. "platform_subscription" and its id) and its reported state.
  transactionKind     String?                 @map("transaction_kind")
  transactionId       String?                 @map("transaction_id") @db.Uuid
  transactionStatus   SalesTransactionStatus? @map("transaction_status")
  transactionSyncedAt DateTime?               @map("transaction_synced_at") @db.Timestamptz(3)
  createdByUserId     String?                 @map("created_by_user_id") @db.Uuid
  createdAt           DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime                @updatedAt @map("updated_at") @db.Timestamptz(3)

  pipeline          SalesPipeline            @relation(fields: [pipelineId], references: [id], onDelete: Restrict)
  stage             SalesPipelineStage       @relation("SalesOpportunityStage", fields: [pipelineId, stageId], references: [pipelineId, id], onDelete: Restrict)
  contact           SalesContact             @relation(fields: [contactId], references: [id], onDelete: Restrict)
  plan              PlatformPlan?            @relation(fields: [planId], references: [id], onDelete: Restrict)
  assignee          PlatformAdmin?           @relation("SalesOpportunityAssignee", fields: [assignedToUserId], references: [userId], onDelete: SetNull)
  firmApplication   FirmApplication?         @relation(fields: [firmApplicationId], references: [id], onDelete: SetNull)
  linkedBusiness    Business?                @relation(fields: [linkedBusinessId], references: [id], onDelete: SetNull)
  tags              SalesOpportunityTag[]
  stageHistory      SalesStageHistory[]
  assignmentHistory SalesAssignmentHistory[]
  activities        SalesActivity[]
  followUps         SalesFollowUp[]
  notes             SalesNote[]

  @@index([pipelineId, stageId])
  @@index([assignedToUserId])
  @@index([contactId])
  @@index([source])
  @@index([createdAt])
  @@index([transactionKind, transactionId])
  @@map("sales_opportunities")
}

/// Reusable tags (never a stand-in for the stage).
model SalesTag {
  id        String   @id @default(uuid(7)) @db.Uuid
  name      String   @unique
  /// A design-token name from packages/ui (e.g. "accent-blue"), never a raw colour.
  colorKey  String?  @map("color_key")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  opportunities SalesOpportunityTag[]

  @@map("sales_tags")
}

model SalesOpportunityTag {
  opportunityId String   @map("opportunity_id") @db.Uuid
  tagId         String   @map("tag_id") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  opportunity SalesOpportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  tag         SalesTag         @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([opportunityId, tagId])
  @@index([tagId])
  @@map("sales_opportunity_tags")
}

/// Every stage change, written by the database (the app only reads it). Names are kept as they
/// were, so renaming or deleting a stage never rewrites history.
model SalesStageHistory {
  id                String                  @id @default(uuid(7)) @db.Uuid
  opportunityId     String                  @map("opportunity_id") @db.Uuid
  /// Null for the creation row.
  fromStageId       String?                 @map("from_stage_id") @db.Uuid
  toStageId         String?                 @map("to_stage_id") @db.Uuid
  fromStageName     String?                 @map("from_stage_name")
  toStageName       String                  @map("to_stage_name")
  toStageType       SalesStageType          @map("to_stage_type")
  /// The team member who moved it; null for the platform (automation, sync, import).
  actorUserId       String?                 @map("actor_user_id") @db.Uuid
  source            SalesChangeSource
  lostReason        SalesLostReason?        @map("lost_reason")
  lostNote          String?                 @map("lost_note")
  transactionStatus SalesTransactionStatus? @map("transaction_status")
  createdAt         DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)

  opportunity SalesOpportunity    @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  fromStage   SalesPipelineStage? @relation("SalesStageHistoryFrom", fields: [fromStageId], references: [id], onDelete: SetNull)
  toStage     SalesPipelineStage? @relation("SalesStageHistoryTo", fields: [toStageId], references: [id], onDelete: SetNull)

  @@index([opportunityId, createdAt])
  @@index([toStageId, createdAt])
  @@index([createdAt])
  @@map("sales_stage_history")
}

/// Every owner change, written by the database (the app only reads it).
model SalesAssignmentHistory {
  id            String            @id @default(uuid(7)) @db.Uuid
  opportunityId String            @map("opportunity_id") @db.Uuid
  fromUserId    String?           @map("from_user_id") @db.Uuid
  toUserId      String?           @map("to_user_id") @db.Uuid
  actorUserId   String?           @map("actor_user_id") @db.Uuid
  source        SalesChangeSource
  createdAt     DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)

  opportunity SalesOpportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  @@index([opportunityId, createdAt])
  @@map("sales_assignment_history")
}

/// Outreach and conversations (calls, emails, texts, meetings), logged by the rep. Insert-only.
/// The attention rules (no contact yet, no response, no activity) read these.
model SalesActivity {
  id            String                 @id @default(uuid(7)) @db.Uuid
  opportunityId String                 @map("opportunity_id") @db.Uuid
  kind          SalesActivityKind
  direction     SalesActivityDirection
  outcome       SalesActivityOutcome?
  occurredAt    DateTime               @map("occurred_at") @db.Timestamptz(3)
  summary       String?
  /// Set by the database: the team member who logged it.
  actorUserId   String?                @map("actor_user_id") @db.Uuid
  followUpId    String?                @map("follow_up_id") @db.Uuid
  createdAt     DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)

  opportunity SalesOpportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  followUp    SalesFollowUp?   @relation(fields: [followUpId], references: [id], onDelete: SetNull)

  @@index([opportunityId, occurredAt])
  @@index([occurredAt])
  @@map("sales_activities")
}

/// Follow-ups and appointments (the Upcoming panel). Cancelled, never deleted.
model SalesFollowUp {
  id               String              @id @default(uuid(7)) @db.Uuid
  opportunityId    String              @map("opportunity_id") @db.Uuid
  kind             SalesFollowUpKind
  title            String
  dueAt            DateTime            @map("due_at") @db.Timestamptz(3)
  /// An appointment's end.
  endsAt           DateTime?           @map("ends_at") @db.Timestamptz(3)
  location         String?
  status           SalesFollowUpStatus @default(SCHEDULED)
  assignedToUserId String?             @map("assigned_to_user_id") @db.Uuid
  completedAt      DateTime?           @map("completed_at") @db.Timestamptz(3)
  cancelledAt      DateTime?           @map("cancelled_at") @db.Timestamptz(3)
  createdByUserId  String?             @map("created_by_user_id") @db.Uuid
  createdAt        DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)

  opportunity SalesOpportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  assignee    PlatformAdmin?   @relation("SalesFollowUpAssignee", fields: [assignedToUserId], references: [userId], onDelete: SetNull)
  activities  SalesActivity[]

  @@index([opportunityId, dueAt])
  @@index([status, dueAt])
  @@index([assignedToUserId, status, dueAt])
  @@map("sales_follow_ups")
}

/// A team member's note on an opportunity; only its author edits or deletes it.
model SalesNote {
  id            String   @id @default(uuid(7)) @db.Uuid
  opportunityId String   @map("opportunity_id") @db.Uuid
  authorUserId  String   @map("author_user_id") @db.Uuid
  body          String
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  opportunity SalesOpportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  @@index([opportunityId, createdAt])
  @@map("sales_notes")
}

/// One row (id 1): the attention rules behind the card badges and the Needs Attention KPI. The
/// migration inserts the defaults.
model SalesAttentionSettings {
  id                    Int      @id @default(1)
  /// A new lead with no outreach after this many hours shows "No contact yet".
  noContactHours        Int      @default(24) @map("no_contact_hours")
  /// A follow-up due within this many hours shows "Follow-up due".
  followUpDueHours      Int      @default(24) @map("follow_up_due_hours")
  /// This many outbound attempts with no reply shows "No response".
  noResponseAttempts    Int      @default(3) @map("no_response_attempts")
  /// No activity for this many days shows "No activity".
  noActivityDays        Int      @default(14) @map("no_activity_days")
  /// An unassigned record shows "Unassigned".
  ownerRequired         Boolean  @default(true) @map("owner_required")
  /// A lost reason of OTHER needs a note.
  lostOtherNoteRequired Boolean  @default(true) @map("lost_other_note_required")
  updatedByUserId       String?  @map("updated_by_user_id") @db.Uuid
  updatedAt             DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("sales_attention_settings")
}

// ---------- R0 stage B6: Super Admin Communications ----------
// Firmivra's own correspondence with firms' people, sales leads and the team (never a firm's
// clients): conversations and their messages with per-recipient delivery, templates and their
// categories, audience segments, broadcasts with per-channel content and per-recipient results,
// and the image and attachment library. Platform data: only the Super Admin team and the
// platform's jobs (dispatch, inbound mail and SMS, scanning) reach it. Contract note:
// docs/work/R0-stage-b6-communications.md.

enum CommChannel {
  EMAIL
  SMS
  INTERNAL
  IN_APP
}

/// Who the conversation is with: a firm's member, a sales lead (B5 contact), or a team member.
enum CommContactType {
  FIRM
  LEAD
  TEAM
}

enum CommConversationStatus {
  OPEN
  CLOSED
}

enum CommDirection {
  OUTBOUND
  INBOUND
  /// A team-only note in the thread (channel INTERNAL).
  INTERNAL
}

/// DRAFT -> SCHEDULED -> SENDING -> SENT, PARTIALLY_SENT or FAILED; SCHEDULED -> CANCELLED.
/// Inbound messages and internal notes are stored as RECEIVED and SENT.
enum CommMessageStatus {
  DRAFT
  SCHEDULED
  SENDING
  SENT
  PARTIALLY_SENT
  FAILED
  CANCELLED
  RECEIVED
}

enum CommRecipientKind {
  TO
  CC
  BCC
}

enum CommDeliveryStatus {
  PENDING
  SENT
  DELIVERED
  BOUNCED
  FAILED
  SKIPPED
}

enum CommTemplateStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum CommMediaKind {
  INLINE_IMAGE
  ATTACHMENT
}

/// DRAFT -> SCHEDULED -> SENDING -> SENT, PARTIALLY_SENT or FAILED; SCHEDULED -> CANCELLED;
/// FAILED -> SENDING (a retry; the first attempt's results stay).
enum CommBroadcastStatus {
  DRAFT
  SCHEDULED
  SENDING
  SENT
  PARTIALLY_SENT
  FAILED
  CANCELLED
}

/// A thread with one contact. The contact's name and destinations are kept as they were, so the
/// thread still reads correctly after the firm, lead or user changes or is deleted.
model CommConversation {
  id               String                 @id @default(uuid(7)) @db.Uuid
  contactType      CommContactType        @map("contact_type")
  /// The firm (FIRM), cleared if the firm is deleted.
  linkedBusinessId String?                @map("linked_business_id") @db.Uuid
  /// The firm member or team member. No foreign key: the history outlives the login.
  contactUserId    String?                @map("contact_user_id") @db.Uuid
  /// The sales lead (LEAD): a B5 sales_contacts id. No foreign key, so this stage does not
  /// depend on B5's merge order; the history outlives the lead.
  salesContactId   String?                @map("sales_contact_id") @db.Uuid
  contactName      String                 @map("contact_name")
  contactEmail     String?                @map("contact_email")
  contactPhone     String?                @map("contact_phone")
  subject          String?
  status           CommConversationStatus @default(OPEN)
  assignedToUserId String?                @map("assigned_to_user_id") @db.Uuid
  tags             String[]               @default([])
  /// Set by the database from the thread's messages.
  lastMessageAt    DateTime?              @map("last_message_at") @db.Timestamptz(3)
  createdByUserId  String?                @map("created_by_user_id") @db.Uuid
  createdAt        DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime               @updatedAt @map("updated_at") @db.Timestamptz(3)

  linkedBusiness Business?              @relation(fields: [linkedBusinessId], references: [id], onDelete: SetNull)
  assignee       PlatformAdmin?         @relation("CommConversationAssignee", fields: [assignedToUserId], references: [userId], onDelete: SetNull)
  messages       CommMessage[]
  reads          CommConversationRead[]

  @@index([lastMessageAt])
  @@index([assignedToUserId, status])
  @@index([linkedBusinessId])
  @@index([salesContactId])
  @@index([contactUserId])
  @@map("comm_conversations")
}

/// One message in a thread (or a broadcast's copy in a recipient's thread). Content is editable
/// while DRAFT or SCHEDULED; once dispatch begins it never changes. Only drafts are deleted.
model CommMessage {
  id                String            @id @default(uuid(7)) @db.Uuid
  conversationId    String            @map("conversation_id") @db.Uuid
  channel           CommChannel
  direction         CommDirection
  status            CommMessageStatus @default(DRAFT)
  /// Email only.
  subject           String?
  /// HTML for email (inline images by media id), plain text for SMS and internal notes.
  body              String
  templateId        String?           @map("template_id") @db.Uuid
  broadcastId       String?           @map("broadcast_id") @db.Uuid
  /// The failed message this one retries (the failed attempt stays in history).
  retryOfMessageId  String?           @map("retry_of_message_id") @db.Uuid
  /// Protects against a double submission of the same send.
  idempotencyKey    String?           @unique @map("idempotency_key")
  scheduledAt       DateTime?         @map("scheduled_at") @db.Timestamptz(3)
  scheduledTimeZone String?           @map("scheduled_time_zone")
  /// Set by the database: the team member who wrote it (null for inbound and the platform).
  senderUserId      String?           @map("sender_user_id") @db.Uuid
  /// Inbound: who it came from, as received.
  fromAddress       String?           @map("from_address")
  sentAt            DateTime?         @map("sent_at") @db.Timestamptz(3)
  failedAt          DateTime?         @map("failed_at") @db.Timestamptz(3)
  errorCode         String?           @map("error_code")
  errorMessage      String?           @map("error_message")
  createdAt         DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  conversation CommConversation       @relation(fields: [conversationId], references: [id], onDelete: Restrict)
  template     CommTemplate?          @relation(fields: [templateId], references: [id], onDelete: SetNull)
  broadcast    CommBroadcast?         @relation(fields: [broadcastId], references: [id], onDelete: SetNull)
  retryOf      CommMessage?           @relation("CommMessageRetry", fields: [retryOfMessageId], references: [id], onDelete: SetNull)
  retries      CommMessage[]          @relation("CommMessageRetry")
  recipients   CommMessageRecipient[]
  mentions     CommMessageMention[]
  media        CommMediaLink[]

  @@index([conversationId, createdAt])
  @@index([status, scheduledAt])
  @@index([broadcastId])
  @@map("comm_messages")
}

/// A message's recipient and its own delivery result (partial delivery, retry failed only).
model CommMessageRecipient {
  id                String             @id @default(uuid(7)) @db.Uuid
  messageId         String             @map("message_id") @db.Uuid
  kind              CommRecipientKind  @default(TO)
  contactType       CommContactType    @map("contact_type")
  linkedBusinessId  String?            @map("linked_business_id") @db.Uuid
  contactUserId     String?            @map("contact_user_id") @db.Uuid
  salesContactId    String?            @map("sales_contact_id") @db.Uuid
  name              String
  /// The email address or phone number used for this channel.
  address           String
  status            CommDeliveryStatus @default(PENDING)
  providerMessageId String?            @map("provider_message_id")
  errorCode         String?            @map("error_code")
  sentAt            DateTime?          @map("sent_at") @db.Timestamptz(3)
  deliveredAt       DateTime?          @map("delivered_at") @db.Timestamptz(3)
  failedAt          DateTime?          @map("failed_at") @db.Timestamptz(3)
  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)

  message        CommMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  linkedBusiness Business?   @relation("CommMessageRecipientBusiness", fields: [linkedBusinessId], references: [id], onDelete: SetNull)

  @@unique([messageId, kind, address])
  @@index([status])
  @@index([providerMessageId])
  @@map("comm_message_recipients")
}

/// A team member mentioned in an internal note (the Mentions tab).
model CommMessageMention {
  messageId String   @map("message_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  message CommMessage   @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    PlatformAdmin @relation("CommMessageMentioned", fields: [userId], references: [userId], onDelete: Cascade)

  @@id([messageId, userId])
  @@index([userId, createdAt])
  @@map("comm_message_mentions")
}

/// Each team member's read state per conversation (Unread counts).
model CommConversationRead {
  conversationId String   @map("conversation_id") @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  lastReadAt     DateTime @map("last_read_at") @db.Timestamptz(3)

  conversation CommConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         PlatformAdmin    @relation("CommConversationReader", fields: [userId], references: [userId], onDelete: Cascade)

  @@id([conversationId, userId])
  @@index([userId])
  @@map("comm_conversation_reads")
}

/// Template categories (tabs). The migration ships the spec's six; deactivated, never deleted.
model CommTemplateCategory {
  id        String   @id @default(uuid(7)) @db.Uuid
  name      String   @unique
  systemKey String?  @unique @map("system_key")
  position  Int
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  templates CommTemplate[]

  @@map("comm_template_categories")
}

/// An email or SMS template. Archived, never deleted. Merge fields are tokens like
/// {{firm.name}} from the API's central list.
model CommTemplate {
  id              String             @id @default(uuid(7)) @db.Uuid
  categoryId      String             @map("category_id") @db.Uuid
  name            String             @unique
  channel         CommChannel
  status          CommTemplateStatus @default(ACTIVE)
  /// Email only, and required for email.
  subject         String?
  body            String
  mergeFields     String[]           @default([]) @map("merge_fields")
  createdByUserId String?            @map("created_by_user_id") @db.Uuid
  updatedByUserId String?            @map("updated_by_user_id") @db.Uuid
  createdAt       DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  category CommTemplateCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  messages CommMessage[]
  media    CommMediaLink[]

  @@index([categoryId, status])
  @@map("comm_templates")
}

/// The image and attachment library (uploads go to S3 under platform/communications/<id>/).
/// Scanned once by the platform; only CLEAN files are sent.
model CommMedia {
  id               String        @id @default(uuid(7)) @db.Uuid
  kind             CommMediaKind
  fileName         String        @map("file_name")
  contentType      String        @map("content_type")
  sizeBytes        Int           @map("size_bytes")
  sha256           String
  s3Key            String        @unique @map("s3_key")
  scanStatus       ScanStatus    @default(PENDING) @map("scan_status")
  scannedAt        DateTime?     @map("scanned_at") @db.Timestamptz(3)
  uploadedByUserId String?       @map("uploaded_by_user_id") @db.Uuid
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)

  links CommMediaLink[]

  @@index([kind, createdAt])
  @@map("comm_media")
}

/// Where a library file is used: in a template, a message or a broadcast channel's content, as an
/// inline image or an attachment. Exactly one owner.
model CommMediaLink {
  id                 String        @id @default(uuid(7)) @db.Uuid
  mediaId            String        @map("media_id") @db.Uuid
  usage              CommMediaKind
  templateId         String?       @map("template_id") @db.Uuid
  messageId          String?       @map("message_id") @db.Uuid
  broadcastChannelId String?       @map("broadcast_channel_id") @db.Uuid
  createdAt          DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)

  media            CommMedia             @relation(fields: [mediaId], references: [id], onDelete: Restrict)
  template         CommTemplate?         @relation(fields: [templateId], references: [id], onDelete: Cascade)
  message          CommMessage?          @relation(fields: [messageId], references: [id], onDelete: Cascade)
  broadcastChannel CommBroadcastChannel? @relation(fields: [broadcastChannelId], references: [id], onDelete: Cascade)

  @@index([mediaId])
  @@index([templateId])
  @@index([messageId])
  @@index([broadcastChannelId])
  @@map("comm_media_links")
}

/// An audience. `definition` holds the API's filter rules (contact types, plans, firm statuses,
/// lead stages, tags); the API resolves it at send time and caches the last count.
model CommSegment {
  id              String    @id @default(uuid(7)) @db.Uuid
  name            String    @unique
  description     String?
  definition      Json
  lastCount       Int?      @map("last_count")
  lastCountedAt   DateTime? @map("last_counted_at") @db.Timestamptz(3)
  archivedAt      DateTime? @map("archived_at") @db.Timestamptz(3)
  createdByUserId String?   @map("created_by_user_id") @db.Uuid
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  broadcasts CommBroadcast[]

  @@map("comm_segments")
}

/// A broadcast to a segment over one or more channels (content per channel). Editable while
/// DRAFT or SCHEDULED; sent broadcasts are never edited or deleted (archive instead).
model CommBroadcast {
  id                String              @id @default(uuid(7)) @db.Uuid
  name              String
  status            CommBroadcastStatus @default(DRAFT)
  segmentId         String?             @map("segment_id") @db.Uuid
  scheduledAt       DateTime?           @map("scheduled_at") @db.Timestamptz(3)
  scheduledTimeZone String?             @map("scheduled_time_zone")
  /// Resolved at send; a send needs at least one.
  recipientCount    Int?                @map("recipient_count")
  idempotencyKey    String?             @unique @map("idempotency_key")
  duplicatedFromId  String?             @map("duplicated_from_id") @db.Uuid
  sendStartedAt     DateTime?           @map("send_started_at") @db.Timestamptz(3)
  finishedAt        DateTime?           @map("finished_at") @db.Timestamptz(3)
  errorMessage      String?             @map("error_message")
  archivedAt        DateTime?           @map("archived_at") @db.Timestamptz(3)
  createdByUserId   String?             @map("created_by_user_id") @db.Uuid
  updatedByUserId   String?             @map("updated_by_user_id") @db.Uuid
  createdAt         DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)

  segment        CommSegment?             @relation(fields: [segmentId], references: [id], onDelete: Restrict)
  duplicatedFrom CommBroadcast?           @relation("CommBroadcastDuplicate", fields: [duplicatedFromId], references: [id], onDelete: SetNull)
  duplicates     CommBroadcast[]          @relation("CommBroadcastDuplicate")
  channels       CommBroadcastChannel[]
  recipients     CommBroadcastRecipient[]
  messages       CommMessage[]

  @@index([status, scheduledAt])
  @@index([createdAt])
  @@map("comm_broadcasts")
}

/// A broadcast's content and result for one channel (a multi-channel send keeps each channel's
/// result; one failed channel never marks the whole broadcast sent).
model CommBroadcastChannel {
  id          String              @id @default(uuid(7)) @db.Uuid
  broadcastId String              @map("broadcast_id") @db.Uuid
  channel     CommChannel
  /// Email only, and required for email.
  subject     String?
  body        String
  status      CommBroadcastStatus @default(DRAFT)
  sentCount   Int                 @default(0) @map("sent_count")
  failedCount Int                 @default(0) @map("failed_count")
  createdAt   DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)

  broadcast CommBroadcast   @relation(fields: [broadcastId], references: [id], onDelete: Cascade)
  media     CommMediaLink[]

  @@unique([broadcastId, channel])
  @@map("comm_broadcast_channels")
}

/// A broadcast's recipient on one channel, with its own result.
model CommBroadcastRecipient {
  id                String             @id @default(uuid(7)) @db.Uuid
  broadcastId       String             @map("broadcast_id") @db.Uuid
  channel           CommChannel
  contactType       CommContactType    @map("contact_type")
  linkedBusinessId  String?            @map("linked_business_id") @db.Uuid
  contactUserId     String?            @map("contact_user_id") @db.Uuid
  salesContactId    String?            @map("sales_contact_id") @db.Uuid
  name              String
  address           String
  status            CommDeliveryStatus @default(PENDING)
  providerMessageId String?            @map("provider_message_id")
  errorCode         String?            @map("error_code")
  /// The copy written to the recipient's conversation history, when one is kept.
  messageId         String?            @map("message_id") @db.Uuid
  sentAt            DateTime?          @map("sent_at") @db.Timestamptz(3)
  deliveredAt       DateTime?          @map("delivered_at") @db.Timestamptz(3)
  failedAt          DateTime?          @map("failed_at") @db.Timestamptz(3)
  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)

  broadcast      CommBroadcast @relation(fields: [broadcastId], references: [id], onDelete: Cascade)
  linkedBusiness Business?     @relation("CommBroadcastRecipientBusiness", fields: [linkedBusinessId], references: [id], onDelete: SetNull)

  @@unique([broadcastId, channel, address])
  @@index([broadcastId, status])
  @@index([providerMessageId])
  @@map("comm_broadcast_recipients")
}

// ---------- R0 stage B7: Super Admin System Settings ----------
// Firmivra's platform configuration: typed settings sections, secret references (never secret
// values), versioned brand assets, feature flags with per-firm overrides, retention policies with
// floors, legal holds and retention runs, maintenance windows, background job controls, and
// versioned default sets for new firms and users. Platform data: only the Super Admin team and the
// platform's own services reach it. Contract note: docs/work/R0-stage-b7-system-settings.md.

enum PlatformBrandAssetKind {
  LOGO
  LOGO_DARK
  FAVICON
  APP_ICON
  LOGIN_BACKGROUND
}

enum PlatformFeatureState {
  ON
  OFF
}

enum PlatformRetentionDisposition {
  DELETE
  ANONYMIZE
  ARCHIVE
}

enum PlatformRunStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

enum PlatformMaintenanceStatus {
  SCHEDULED
  ACTIVE
  COMPLETED
  CANCELLED
}

enum PlatformDefaultSetKind {
  FIRM
  USER
}

/// A settings section (General, Branding & Appearance, Email & Notifications): one row per section
/// key, a typed JSON object whose shape the contract note fixes. Every save adds 1 to `version` (the
/// database does it); save with the version read, so two admins never silently overwrite each other.
model PlatformSetting {
  key             String   @id
  value           Json
  version         Int      @default(1)
  updatedByUserId String?  @map("updated_by_user_id") @db.Uuid
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("platform_settings")
}

/// Where a secret lives (an AWS Secrets Manager ARN, or a local reference in development), never
/// the secret itself. The API shows only "configured" and the hint.
model PlatformSecretRef {
  key             String    @id
  /// arn:aws:secretsmanager:... or local:<name>.
  reference       String
  /// A safe hint for the screen, e.g. the last 4 characters of a key id; never the secret.
  hint            String?
  rotatedAt       DateTime? @map("rotated_at") @db.Timestamptz(3)
  updatedByUserId String?   @map("updated_by_user_id") @db.Uuid
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("platform_secret_refs")
}

/// Every uploaded version of a brand asset (S3 under platform/branding/<id>/), scanned once by the
/// platform. Never changed or deleted; the current one per kind is in platform_brand_current.
model PlatformBrandAsset {
  id               String                 @id @default(uuid(7)) @db.Uuid
  kind             PlatformBrandAssetKind
  fileName         String                 @map("file_name")
  contentType      String                 @map("content_type")
  sizeBytes        Int                    @map("size_bytes")
  width            Int?
  height           Int?
  sha256           String
  s3Key            String                 @unique @map("s3_key")
  scanStatus       ScanStatus             @default(PENDING) @map("scan_status")
  scannedAt        DateTime?              @map("scanned_at") @db.Timestamptz(3)
  uploadedByUserId String?                @map("uploaded_by_user_id") @db.Uuid
  createdAt        DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)

  currentFor PlatformBrandCurrent[]

  @@index([kind, createdAt])
  @@map("platform_brand_assets")
}

/// The asset in use per kind (a clean asset of that kind). Removing a row resets the kind to the
/// built-in default.
model PlatformBrandCurrent {
  kind            PlatformBrandAssetKind @id
  assetId         String                 @map("asset_id") @db.Uuid
  updatedByUserId String?                @map("updated_by_user_id") @db.Uuid
  updatedAt       DateTime               @updatedAt @map("updated_at") @db.Timestamptz(3)

  asset PlatformBrandAsset @relation(fields: [assetId], references: [id], onDelete: Restrict)

  @@map("platform_brand_current")
}

/// A feature flag with a stable key. Effective state for a firm: emergency off wins, then a
/// required feature that is off, then the firm's override, then the default.
model PlatformFeature {
  key               String               @id
  name              String
  description       String?
  defaultState      PlatformFeatureState @default(OFF) @map("default_state")
  emergencyDisabled Boolean              @default(false) @map("emergency_disabled")
  /// Feature keys this one needs on.
  dependsOn         String[]             @default([]) @map("depends_on")
  updatedByUserId   String?              @map("updated_by_user_id") @db.Uuid
  createdAt         DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)

  overrides PlatformFeatureOverride[]

  @@map("platform_features")
}

/// A firm's explicit state for a feature (goes with the firm's data).
model PlatformFeatureOverride {
  featureKey      String               @map("feature_key")
  businessId      String               @map("business_id") @db.Uuid
  state           PlatformFeatureState
  reason          String?
  updatedByUserId String?              @map("updated_by_user_id") @db.Uuid
  createdAt       DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)

  feature  PlatformFeature @relation(fields: [featureKey], references: [key], onDelete: Cascade)
  business Business        @relation(fields: [businessId], references: [id], onDelete: Restrict)

  @@id([featureKey, businessId])
  @@index([businessId])
  @@map("platform_feature_overrides")
}

/// How long one category of data is kept and what happens after. The migration ships the
/// categories and their floors; the app never goes below the floor. Audit retention is the security
/// policy's (B4), not a row here.
model PlatformRetentionPolicy {
  category         String                       @id
  retentionDays    Int                          @map("retention_days")
  disposition      PlatformRetentionDisposition
  archiveAfterDays Int?                         @map("archive_after_days")
  /// Set by the migration (legal or product minimum); the app cannot change it.
  minimumDays      Int                          @map("minimum_days")
  effectiveFrom    DateTime                     @default(now()) @map("effective_from") @db.Timestamptz(3)
  version          Int                          @default(1)
  updatedByUserId  String?                      @map("updated_by_user_id") @db.Uuid
  updatedAt        DateTime                     @updatedAt @map("updated_at") @db.Timestamptz(3)

  runs PlatformRetentionRun[]

  @@map("platform_retention_policies")
}

/// A legal hold. An active hold on a firm blocks the firm's deletion; holding a category or a
/// record stops the retention jobs from disposing of it. Released once, never deleted (a released
/// hold stays on record after its firm is deleted, with the firm link cleared).
model PlatformLegalHold {
  id               String    @id @default(uuid(7)) @db.Uuid
  name             String
  reason           String
  category         String?
  heldBusinessId   String?   @map("held_business_id") @db.Uuid
  recordType       String?   @map("record_type")
  recordId         String?   @map("record_id")
  createdByUserId  String?   @map("created_by_user_id") @db.Uuid
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  releasedAt       DateTime? @map("released_at") @db.Timestamptz(3)
  releasedByUserId String?   @map("released_by_user_id") @db.Uuid
  releaseReason    String?   @map("release_reason")

  heldBusiness Business? @relation("PlatformLegalHoldBusiness", fields: [heldBusinessId], references: [id], onDelete: SetNull)

  @@index([heldBusinessId])
  @@index([category])
  @@map("platform_legal_holds")
}

/// A retention job's run (or dry run) for one category: asked for by a team member or the
/// scheduler, moved only by the worker (platform scope). Counts only, never the records.
model PlatformRetentionRun {
  id                String            @id @default(uuid(7)) @db.Uuid
  category          String
  dryRun            Boolean           @default(true) @map("dry_run")
  status            PlatformRunStatus @default(QUEUED)
  policyVersion     Int               @map("policy_version")
  eligibleCount     Int?              @map("eligible_count")
  affectedCount     Int?              @map("affected_count")
  heldCount         Int?              @map("held_count")
  errorCode         String?           @map("error_code")
  requestedByUserId String?           @map("requested_by_user_id") @db.Uuid
  createdAt         DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  startedAt         DateTime?         @map("started_at") @db.Timestamptz(3)
  finishedAt        DateTime?         @map("finished_at") @db.Timestamptz(3)

  policy PlatformRetentionPolicy @relation(fields: [category], references: [category], onDelete: Restrict)

  @@index([category, createdAt])
  @@index([status])
  @@map("platform_retention_runs")
}

/// A planned maintenance window and its notice. SCHEDULED -> ACTIVE -> COMPLETED, or CANCELLED
/// before it starts; the database stamps the actual start and end.
model PlatformMaintenanceWindow {
  id              String                    @id @default(uuid(7)) @db.Uuid
  title           String
  /// The notice users see (plain text).
  message         String
  startsAt        DateTime                  @map("starts_at") @db.Timestamptz(3)
  endsAt          DateTime                  @map("ends_at") @db.Timestamptz(3)
  status          PlatformMaintenanceStatus @default(SCHEDULED)
  /// Super Admins can still sign in during the window.
  adminBypass     Boolean                   @default(true) @map("admin_bypass")
  startedAt       DateTime?                 @map("started_at") @db.Timestamptz(3)
  endedAt         DateTime?                 @map("ended_at") @db.Timestamptz(3)
  createdByUserId String?                   @map("created_by_user_id") @db.Uuid
  updatedByUserId String?                   @map("updated_by_user_id") @db.Uuid
  createdAt       DateTime                  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime                  @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([status, startsAt])
  @@map("platform_maintenance_windows")
}

/// A background job the platform registers (platform scope) and the team may pause or resume.
/// Only allowlisted jobs appear; nothing here runs commands.
model PlatformJobControl {
  jobKey          String             @id @map("job_key")
  name            String
  enabled         Boolean            @default(true)
  pausedReason    String?            @map("paused_reason")
  lastRunAt       DateTime?          @map("last_run_at") @db.Timestamptz(3)
  lastStatus      PlatformRunStatus? @map("last_status")
  lastError       String?            @map("last_error")
  updatedByUserId String?            @map("updated_by_user_id") @db.Uuid
  createdAt       DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("platform_job_controls")
}

/// A version of the defaults for new firms or new users. Each save is a new version (the database
/// numbers it per kind); the newest is in use; versions never change, so a firm's provisioning
/// record names the exact defaults it got.
model PlatformDefaultSet {
  id              String                 @id @default(uuid(7)) @db.Uuid
  kind            PlatformDefaultSetKind
  version         Int
  values          Json
  note            String?
  createdByUserId String?                @map("created_by_user_id") @db.Uuid
  createdAt       DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)

  applications PlatformDefaultSetApplication[]

  @@unique([kind, version])
  @@map("platform_default_sets")
}

/// Which firm defaults a firm was provisioned with (goes with the firm's data).
model PlatformDefaultSetApplication {
  businessId   String   @id @map("business_id") @db.Uuid
  defaultSetId String   @map("default_set_id") @db.Uuid
  appliedAt    DateTime @default(now()) @map("applied_at") @db.Timestamptz(3)

  business   Business           @relation("PlatformDefaultSetApplied", fields: [businessId], references: [id], onDelete: Restrict)
  defaultSet PlatformDefaultSet @relation(fields: [defaultSetId], references: [id], onDelete: Restrict)

  @@index([defaultSetId])
  @@map("platform_default_set_applications")
}

// ---------- R0 stage B8: Super Admin Integrations ----------
// Firmivra's own service connections (billing, SMS, email, storage, AI, e-signature...) with their
// sync runs, the central integration log, the catalog firms see (plan and firm access; provider
// definitions stay in code and the catalog's provider key matches integration_connections.provider),
// Firmivra-issued API keys (hash only), webhook endpoints and deliveries, and a daily usage and
// adoption rollup. Platform data: only the Super Admin team and the platform's services reach it.
// Contract note: docs/work/R0-stage-b8-integrations.md.

enum PlatformIntegrationCategory {
  PAYMENTS_BILLING
  COMMUNICATION
  EMAIL
  CLOUD_STORAGE
  AI_AUTOMATION
  MLS_DATA
  ESIGN
  SECURITY_INFRASTRUCTURE
  OTHER
}

/// DRAFT until activated (after a passing test); then ACTIVE, INACTIVE, NEEDS_ATTENTION or ERROR as
/// health and admins decide; DISABLED by an admin; REMOVED is the tombstone.
enum PlatformIntegrationStatus {
  DRAFT
  ACTIVE
  INACTIVE
  NEEDS_ATTENTION
  ERROR
  DISABLED
  REMOVED
}

enum PlatformIntegrationRunKind {
  SYNC
  TEST
}

enum PlatformIntegrationLogSource {
  PLATFORM_INTEGRATION
  FIRM_CONNECTION
  API
  WEBHOOK
}

enum PlatformIntegrationLogSeverity {
  INFO
  WARNING
  ERROR
  CRITICAL
}

/// ENABLED: visible and connectable; COMING_SOON: visible, not connectable; DISABLED: hidden.
enum PlatformCatalogStatus {
  ENABLED
  COMING_SOON
  DISABLED
}

enum PlatformCatalogPlanAccess {
  ALL_PLANS
  SELECTED_PLANS
}

enum PlatformCatalogFirmAccess {
  ALLOW
  DENY
}

enum PlatformWebhookDirection {
  OUTBOUND
  INBOUND
}

enum PlatformWebhookStatus {
  ACTIVE
  DISABLED
}

enum PlatformDeliveryStatus {
  PENDING
  SUCCEEDED
  FAILED
}

enum PlatformUsageScope {
  PLATFORM_INTEGRATION
  CATALOG
  API
}

/// A Firmivra-owned service connection. Credentials live in the secret store: `secretRef` only
/// names where. Removed is a tombstone (kept for the record). At most one connection per provider
/// and environment that is not removed.
model PlatformIntegration {
  id                   String                      @id @default(uuid(7)) @db.Uuid
  /// The provider's key in the code catalog, e.g. "stripe", "twilio", "aws_s3".
  provider             String
  name                 String
  category             PlatformIntegrationCategory
  description          String?
  websiteUrl           String?                     @map("website_url")
  docsUrl              String?                     @map("docs_url")
  environment          IntegrationEnvironment      @default(TEST)
  status               PlatformIntegrationStatus   @default(DRAFT)
  /// Why it needs attention or failed, as a short code.
  statusReason         String?                     @map("status_reason")
  secretRef            String?                     @map("secret_ref")
  secretRotatedAt      DateTime?                   @map("secret_rotated_at") @db.Timestamptz(3)
  /// Non-secret options: scopes, sync schedule, enabled features, retry behaviour.
  settings             Json                        @default("{}")
  lastCheckAt          DateTime?                   @map("last_check_at") @db.Timestamptz(3)
  lastCheckOk          Boolean?                    @map("last_check_ok")
  lastSyncAt           DateTime?                   @map("last_sync_at") @db.Timestamptz(3)
  /// Activated without a passing test (the provider has no test endpoint), as the admin confirmed.
  activatedWithoutTest Boolean                     @default(false) @map("activated_without_test")
  activatedAt          DateTime?                   @map("activated_at") @db.Timestamptz(3)
  disabledAt           DateTime?                   @map("disabled_at") @db.Timestamptz(3)
  removedAt            DateTime?                   @map("removed_at") @db.Timestamptz(3)
  version              Int                         @default(1)
  createdByUserId      String?                     @map("created_by_user_id") @db.Uuid
  updatedByUserId      String?                     @map("updated_by_user_id") @db.Uuid
  createdAt            DateTime                    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime                    @updatedAt @map("updated_at") @db.Timestamptz(3)

  runs           PlatformIntegrationRun[]
  logs           PlatformIntegrationLog[]
  catalogEntries PlatformIntegrationCatalog[]

  @@index([provider, environment])
  @@index([status])
  @@map("platform_integrations")
}

/// A sync or a connection test of a platform integration. Asked for by the team or the scheduler;
/// moved only by the worker (platform scope). Counts only, never records or tokens.
model PlatformIntegrationRun {
  id                String                     @id @default(uuid(7)) @db.Uuid
  integrationId     String                     @map("integration_id") @db.Uuid
  kind              PlatformIntegrationRunKind
  status            IntegrationSyncRunStatus   @default(QUEUED)
  objectCount       Int                        @default(0) @map("object_count")
  failedCount       Int                        @default(0) @map("failed_count")
  retries           Int                        @default(0)
  errorCode         String?                    @map("error_code")
  errorMessage      String?                    @map("error_message")
  correlationId     String?                    @map("correlation_id")
  requestedByUserId String?                    @map("requested_by_user_id") @db.Uuid
  createdAt         DateTime                   @default(now()) @map("created_at") @db.Timestamptz(3)
  startedAt         DateTime?                  @map("started_at") @db.Timestamptz(3)
  finishedAt        DateTime?                  @map("finished_at") @db.Timestamptz(3)

  integration PlatformIntegration @relation(fields: [integrationId], references: [id], onDelete: Restrict)

  @@index([integrationId, createdAt])
  @@index([status])
  @@map("platform_integration_runs")
}

/// The central integration log: one structured, redacted event. Insert-only. A firm connection's
/// event names its firm in `subjectBusinessId` (no foreign key: the log outlives the firm).
model PlatformIntegrationLog {
  id                String                         @id @default(uuid(7)) @db.Uuid
  source            PlatformIntegrationLogSource
  integrationId     String?                        @map("integration_id") @db.Uuid
  provider          String?
  environment       IntegrationEnvironment?
  severity          PlatformIntegrationLogSeverity
  eventType         String                         @map("event_type")
  action            String?
  succeeded         Boolean
  errorCode         String?                        @map("error_code")
  message           String
  /// Redacted details: never secrets, tokens or record content.
  details           Json?
  requestId         String?                        @map("request_id")
  correlationId     String?                        @map("correlation_id")
  subjectBusinessId String?                        @map("subject_business_id") @db.Uuid
  actorUserId       String?                        @map("actor_user_id") @db.Uuid
  createdAt         DateTime                       @default(now()) @map("created_at") @db.Timestamptz(3)

  integration PlatformIntegration? @relation(fields: [integrationId], references: [id], onDelete: Restrict)

  @@index([createdAt])
  @@index([integrationId, createdAt])
  @@index([severity, createdAt])
  @@index([provider, createdAt])
  @@index([correlationId])
  @@index([requestId])
  @@map("platform_integration_logs")
}

/// What firms see in their integration catalog for one provider (its key matches
/// integration_connections.provider). Status, plan access and firm rules decide who can see and
/// connect it: DISABLED hides it from everyone; a firm's DENY hides it; a firm's ALLOW shows it
/// whatever the plan; otherwise the plan access decides.
model PlatformIntegrationCatalog {
  id                    String                      @id @default(uuid(7)) @db.Uuid
  provider              String                      @unique
  name                  String
  category              PlatformIntegrationCategory
  shortDescription      String                      @map("short_description")
  description           String?
  /// S3 under platform/integrations/<entry id>/, a raster logo.
  logoS3Key             String?                     @map("logo_s3_key")
  websiteUrl            String?                     @map("website_url")
  helpUrl               String?                     @map("help_url")
  status                PlatformCatalogStatus       @default(DISABLED)
  planAccess            PlatformCatalogPlanAccess   @default(ALL_PLANS) @map("plan_access")
  /// The customer setup experience: instructions, required fields, auth type (the API's schema).
  setup                 Json                        @default("{}")
  badges                String[]                    @default([])
  sortOrder             Int                         @default(0) @map("sort_order")
  /// Beta label, deprecation notice, rollout percentage, version requirement (the API's schema).
  advanced              Json                        @default("{}")
  /// The Firmivra service this entry relies on, if any (e.g. Firmivra's own Stripe account).
  platformIntegrationId String?                     @map("platform_integration_id") @db.Uuid
  version               Int                         @default(1)
  createdByUserId       String?                     @map("created_by_user_id") @db.Uuid
  updatedByUserId       String?                     @map("updated_by_user_id") @db.Uuid
  createdAt             DateTime                    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime                    @updatedAt @map("updated_at") @db.Timestamptz(3)

  platformIntegration PlatformIntegration?             @relation(fields: [platformIntegrationId], references: [id], onDelete: SetNull)
  plans               PlatformIntegrationCatalogPlan[]
  firmRules           PlatformIntegrationCatalogFirm[]

  @@index([status, sortOrder])
  @@map("platform_integration_catalog")
}

/// The plans a SELECTED_PLANS catalog entry is available on.
model PlatformIntegrationCatalogPlan {
  catalogId String   @map("catalog_id") @db.Uuid
  planId    String   @map("plan_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  catalog PlatformIntegrationCatalog @relation(fields: [catalogId], references: [id], onDelete: Cascade)
  plan    PlatformPlan               @relation(fields: [planId], references: [id], onDelete: Restrict)

  @@id([catalogId, planId])
  @@index([planId])
  @@map("platform_integration_catalog_plans")
}

/// A firm-specific allow or deny for a catalog entry (goes with the firm's data).
model PlatformIntegrationCatalogFirm {
  catalogId       String                    @map("catalog_id") @db.Uuid
  businessId      String                    @map("business_id") @db.Uuid
  access          PlatformCatalogFirmAccess
  reason          String?
  updatedByUserId String?                   @map("updated_by_user_id") @db.Uuid
  createdAt       DateTime                  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime                  @updatedAt @map("updated_at") @db.Timestamptz(3)

  catalog  PlatformIntegrationCatalog @relation(fields: [catalogId], references: [id], onDelete: Cascade)
  business Business                   @relation("PlatformCatalogFirmRule", fields: [businessId], references: [id], onDelete: Restrict)

  @@id([catalogId, businessId])
  @@index([businessId])
  @@map("platform_integration_catalog_firms")
}

/// A Firmivra-issued API key. Only its SHA-256 hash is stored (the key is shown once, at creation),
/// with a prefix and last four for display. Revoked once; a rotation is a new key naming the old.
model PlatformApiKey {
  id                 String                 @id @default(uuid(7)) @db.Uuid
  name               String
  /// e.g. "fv_live_8k2q": shown in lists.
  prefix             String
  lastFour           String                 @map("last_four")
  keyHash            String                 @unique @map("key_hash")
  scopes             String[]               @default([])
  environment        IntegrationEnvironment @default(TEST)
  rateLimitPerMinute Int?                   @map("rate_limit_per_minute")
  expiresAt          DateTime?              @map("expires_at") @db.Timestamptz(3)
  lastUsedAt         DateTime?              @map("last_used_at") @db.Timestamptz(3)
  rotatedFromId      String?                @unique @map("rotated_from_id") @db.Uuid
  revokedAt          DateTime?              @map("revoked_at") @db.Timestamptz(3)
  revokedByUserId    String?                @map("revoked_by_user_id") @db.Uuid
  createdByUserId    String?                @map("created_by_user_id") @db.Uuid
  createdAt          DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)

  rotatedFrom PlatformApiKey? @relation("PlatformApiKeyRotation", fields: [rotatedFromId], references: [id], onDelete: Restrict)
  rotatedTo   PlatformApiKey? @relation("PlatformApiKeyRotation")

  @@index([revokedAt])
  @@map("platform_api_keys")
}

/// A webhook endpoint: outbound (Firmivra calls it) or inbound (a provider calls Firmivra). The
/// signing secret lives in the secret store; `signingSecretRef` only names where.
model PlatformWebhookEndpoint {
  id               String                   @id @default(uuid(7)) @db.Uuid
  direction        PlatformWebhookDirection
  url              String
  description      String?
  events           String[]                 @default([])
  signingSecretRef String?                  @map("signing_secret_ref")
  secretRotatedAt  DateTime?                @map("secret_rotated_at") @db.Timestamptz(3)
  status           PlatformWebhookStatus    @default(ACTIVE)
  maxRetries       Int                      @default(5) @map("max_retries")
  createdByUserId  String?                  @map("created_by_user_id") @db.Uuid
  updatedByUserId  String?                  @map("updated_by_user_id") @db.Uuid
  createdAt        DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(3)

  deliveries PlatformWebhookDelivery[]

  @@index([direction, status])
  @@map("platform_webhook_endpoints")
}

/// One delivery attempt of one event to one endpoint. Recorded by the platform; its result is
/// written once. A redelivery is a new attempt naming the original.
model PlatformWebhookDelivery {
  id                 String                 @id @default(uuid(7)) @db.Uuid
  endpointId         String                 @map("endpoint_id") @db.Uuid
  eventType          String                 @map("event_type")
  eventId            String                 @map("event_id")
  attempt            Int                    @default(1)
  redeliveryOfId     String?                @map("redelivery_of_id") @db.Uuid
  status             PlatformDeliveryStatus @default(PENDING)
  responseStatusCode Int?                   @map("response_status_code")
  durationMs         Int?                   @map("duration_ms")
  requestId          String?                @map("request_id")
  errorCode          String?                @map("error_code")
  requestedByUserId  String?                @map("requested_by_user_id") @db.Uuid
  createdAt          DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  finishedAt         DateTime?              @map("finished_at") @db.Timestamptz(3)

  endpoint     PlatformWebhookEndpoint   @relation(fields: [endpointId], references: [id], onDelete: Restrict)
  redeliveryOf PlatformWebhookDelivery?  @relation("PlatformWebhookRedelivery", fields: [redeliveryOfId], references: [id], onDelete: Restrict)
  redeliveries PlatformWebhookDelivery[] @relation("PlatformWebhookRedelivery")

  @@unique([endpointId, eventId, attempt])
  @@index([endpointId, createdAt])
  @@index([status])
  @@map("platform_webhook_deliveries")
}

/// A day's rollup for one subject (a platform integration's id, a catalog provider key, or an API
/// key's id), written by the platform's daily job. Cross-firm adoption comes from here, never from
/// reading firms' connections in admin scope.
model PlatformIntegrationUsageDaily {
  day            DateTime           @db.Date
  scope          PlatformUsageScope
  subjectKey     String             @map("subject_key")
  requests       Int                @default(0)
  successes      Int                @default(0)
  failures       Int                @default(0)
  avgLatencyMs   Int?               @map("avg_latency_ms")
  volume         BigInt?
  costCents      Int?               @map("cost_cents")
  connectedFirms Int?               @map("connected_firms")
  activeFirms    Int?               @map("active_firms")
  connects       Int?
  disconnects    Int?
  computedAt     DateTime           @default(now()) @map("computed_at") @db.Timestamptz(3)

  @@id([day, scope, subjectKey])
  @@index([scope, subjectKey, day])
  @@map("platform_integration_usage_daily")
}
