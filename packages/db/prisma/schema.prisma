enum TaxPlanStatus {
  DRAFT
  SCHEDULED
  IN_PROGRESS
  AWAITING_CLIENT
  READY_FOR_REVIEW
  IMPLEMENTED
  CLOSED
}

enum PlanningGoal {
  REDUCE_TAXABLE_INCOME
  INCREASE_RETIREMENT_SAVINGS
  PURCHASE_HOME
  START_BUSINESS
  BUY_EQUIPMENT_VEHICLE
  MINIMIZE_SELF_EMPLOYMENT_TAX
  PLAN_EDUCATION_EXPENSES
  BUILD_LONG_TERM_WEALTH
  PREPARE_LIFE_CHANGES
  OTHER
}

enum TaxFilingStatus {
  SINGLE
  MARRIED_FILING_JOINTLY
  MARRIED_FILING_SEPARATELY
  HEAD_OF_HOUSEHOLD
  QUALIFYING_SURVIVING_SPOUSE
}

enum StrategyCategory {
  RETIREMENT
  DEDUCTIONS
  BUSINESS
  CREDITS
  ENTITY
  TIMING
  INVESTMENT
  ESTATE_OTHER
}

/// A strategy in a plan: proposed, accepted by the client, being carried out, done, or declined.
enum PlanStrategyStatus {
  PROPOSED
  ACCEPTED
  IN_PROGRESS
  IMPLEMENTED
  DECLINED
}

/// What a planning input is: a prior year's figure, a projection for the plan year, or a manual
