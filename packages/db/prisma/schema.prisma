// Firmivra database schema. Owner: Rasel. Developers request changes with a `schema` issue.
// Row-level security, the app role and the email checks live in the SQL migrations (see README).
// Tenant tables carry business_id; the app can only see rows of the business set by forBusiness().

generator client {
  provider               = "prisma-client"
  output                 = "../src/generated/prisma"
  runtime                = "nodejs"
  moduleFormat           = "esm"
  generatedFileExtension = "ts"
  importFileExtension    = "js"
}

datasource db {
  provider = "postgresql"
}

enum BusinessStatus {
  PENDING_SETUP
  ACTIVE
  SUSPENDED
  CLOSED
}

/// Which Cognito user pool the identity belongs to (docs/AUTH-DESIGN.md).
enum IdentityPool {
  STAFF
  CLIENT
  ADMIN
}

/// The firm's eight staff roles (R35). What each may do is in packages/types (team/roles.ts).
enum MembershipRole {
  OWNER
  ADMIN
  MANAGER
  STAFF
  BOOKKEEPER
  TAX_PREPARER
  CLIENT_SUPPORT
  READ_ONLY
}

/// LOCKED (R35): blocked for now and kept as a member; only ACTIVE members get into the firm.
enum MembershipStatus {
  INVITED
  ACTIVE
  LOCKED
  DEACTIVATED
}

enum ClientAccountStatus {
  /// The firm invited the client; the portal login is not set up yet.
  INVITED
  PENDING_APPROVAL
  ACTIVE
  DECLINED
  DISABLED
}

enum ClientAccountType {
  INDIVIDUAL
  BUSINESS
}

/// Whose portal login this is on the client's record (docs/SYSTEM-DESIGN.md, Data model: members).
enum ClientPortalRole {
  PRIMARY
  SPOUSE
  AUTHORIZED
}

enum PlatformRole {
  SUPER_ADMIN
  /// A platform team member below the CEO (R0 stage A): no admin-scope rights yet.
  /// app_is_admin() checks role = SUPER_ADMIN on purpose; TEAM_MEMBER must stay excluded.
  TEAM_MEMBER
}

/// docs/SYSTEM-DESIGN.md, Modules & packs. Only the tax and accounting pack exists now.
enum IndustryPack {
  TAX_ACCOUNTING
}

enum FirmApplicationStatus {
  PENDING_REVIEW
  INFO_REQUESTED
  APPROVED
  DECLINED
}

/// Begin Online's six services, plus OTHER (docs/SYSTEM-DESIGN.md, Sign-up flows).
enum ServiceKind {
  ANNUAL_TAX
  QUARTERLY_TAX
  BOOKKEEPING
  PAYROLL
  TAX_PLANNING
  BUSINESS_DEVELOPMENT
  OTHER
}

/// ONE_TIME, or recurring.
enum BillingInterval {
  ONE_TIME
  MONTHLY
  QUARTERLY
  YEARLY
}

enum EngagementStatus {
  /// From Begin Online, waiting for staff review.
  PENDING
  ACTIVE
  COMPLETED
  CANCELLED
}

/// GENERAL, or a client's "Request Name Change" from the portal (at most one open per client).
enum TaskKind {
  GENERAL
  NAME_CHANGE
}

enum TaskStatus {
  OPEN
  DONE
  CANCELLED
}

/// Where an OPEN task stands (the Tasks screens' Not Started, Pending, In Progress, Waiting,
/// Blocked). status stays the lifecycle: DONE shows as Completed, and overdue is never stored but
/// derived from an incomplete task past its due date (R38).
enum TaskProgress {
  NOT_STARTED
  PENDING
  IN_PROGRESS
  /// Waiting on the client.
  WAITING
  BLOCKED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
}

/// What a compliance deadline is for (the Deadline Types chart and filter).
enum DeadlineType {
  TAX_FILING
  ESTIMATED_TAX
  ELECTION
  BOOKKEEPING
  PAYROLL
  SALES_TAX
  STATE_FILING
  ANNUAL_REPORT
  LICENSE_PERMIT
  ADVISORY
  OTHER
}

enum DeadlineSource {
  GOVERNMENT
  FIRM
  CLIENT_SPECIFIC
  IMPORTED
}

/// Due Soon and Overdue are never stored: they are derived from the due date, the firm's Due Soon
/// threshold and the status (an incomplete deadline past its due date is overdue).
enum DeadlineStatus {
  UPCOMING
  IN_PROGRESS
  WAITING_ON_CLIENT
  COMPLETED
  NOT_APPLICABLE
  CANCELLED
}

enum JurisdictionLevel {
  FEDERAL
  STATE
  LOCAL
  INTERNAL
}

/// A family of official calendars (a firm keeps its own library of them).
enum CalendarFamily {
  IRS_GENERAL
  IRS_EMPLOYER
  STATE_INCOME_FRANCHISE
  SECRETARY_OF_STATE
  SALES_USE_TAX
  PAYROLL_WITHHOLDING
  LOCAL_BUSINESS_LICENSE
  PROFESSIONAL_LICENSE
  FIRM_INTERNAL
}

/// DRAFT (imported), VERIFIED (checked against the source), PUBLISHED (in use: at most one per
/// family, authority and year), SUPERSEDED (a later version replaced it; kept for rollback and
/// comparison), ARCHIVED.
enum CalendarStatus {
  DRAFT
  VERIFIED
  PUBLISHED
  SUPERSEDED
  ARCHIVED
}

/// How a calendar entry gives its date. NEEDS_VERIFICATION has no date: a date is never invented.
enum CalendarRuleKind {
  FIXED_DATE
  FORMULA
  NEEDS_VERIFICATION
}

/// How often a recurring deadline repeats; AUTHORITY_DEFINED follows the authority's own calendar.
enum DeadlineFrequency {
  MONTHLY
  QUARTERLY
  ANNUAL
  CUSTOM
  AUTHORITY_DEFINED
}

/// What a matching applicability rule does: APPLY makes the deadline, SUGGEST only suggests it
/// until staff confirm it (imported government dates are never assigned to everyone).
enum ApplicabilityOutcome {
  APPLY
  SUGGEST
}

enum ApplicabilityDecision {
  SUGGESTED
  NEEDS_REVIEW
  CONFIRMED
  DISMISSED
}

/// What a compliance log row records.
enum ComplianceLogKind {
  IMPORT
  VERIFY
  PUBLISH
  ROLLBACK
  GENERATE
  OVERRIDE
  ERROR
}

enum LogOutcome {
  SUCCESS
  FAILED
  SKIPPED
}

/// The modules automations start from and act on (a rule's trigger category and rule category).
enum AutomationModule {
  CLIENTS
  LEADS
  APPOINTMENTS
  INTAKE_FORMS
  DOCUMENTS
  TAX_RETURNS
  BOOKKEEPING
  PAYROLL
  TAX_PLANNING
  BUSINESS_ADVISORY
  INVOICES_PAYMENTS
  COMMUNICATIONS
  TASKS
  COMPLIANCE_DEADLINES
  STAFF_MANAGEMENT
  INTEGRATIONS
  CUSTOM
}

/// DRAFT is saved but never runs; ACTIVE runs; PAUSED stops new runs; ARCHIVED is kept for its history.
enum AutomationStatus {
  DRAFT
  ACTIVE
  PAUSED
  ARCHIVED
}

enum AutomationTiming {
  IMMEDIATE
  BEFORE
  AFTER
  SCHEDULED
}

enum OffsetUnit {
  MINUTE
  HOUR
  DAY
}

enum MatchMode {
  ALL
  ANY
}

/// PENDING waits to start (or for a scheduled action), RUNNING is in progress; the rest end the
/// run: PARTIAL_SUCCESS means some actions worked and others failed.
enum AutomationRunStatus {
  PENDING
  RUNNING
  SUCCESS
  PARTIAL_SUCCESS
  FAILED
  SKIPPED
}

enum ActionExecutionStatus {
  PENDING
  RUNNING
  SUCCESS
  FAILED
  SKIPPED
}

/// A bookkeeping client's workflow status (the Bookkeeping status tabs). Set by staff (MANUAL) or
/// by the firm's status rules from due dates, missing documents and sync problems (AUTOMATIC).
enum BookkeepingStatus {
  ON_TRACK
  NEEDS_ATTENTION
  MISSING_DOCUMENTS
  OVERDUE
  NOT_STARTED
}

enum StatusSource {
  MANUAL
  AUTOMATIC
}

enum ReportCadence {
  MONTHLY
  QUARTERLY
  ANNUAL
  CUSTOM
}

enum BookkeepingActivityKind {
  STATUS_CHANGE
  ASSIGNMENT
  PLAN_CHANGE
  PAUSE
  RESUME
  ARCHIVE
  SYNC
  DOCUMENT_REQUEST
  REPORT
  CLOSE
  RECONCILIATION
  CONTACT
  NOTE
  OTHER
}

enum ConnectionStatus {
  CONNECTED
  /// The provider's authorization ran out: reconnect.
  EXPIRED
  ERROR
  DISCONNECTED
}

enum SyncTrigger {
  INITIAL
  MANUAL
  SCHEDULED
}

enum SyncOutcome {
  RUNNING
  SUCCESS
  PARTIAL
  FAILED
}

enum BookkeepingAccountType {
  BANK
  CREDIT_CARD
  LOAN
  OTHER
}

enum BookkeepingPeriodKind {
  MONTH
  QUARTER
  YEAR
  CUSTOM
}

/// A period's close: work in progress, then review, approval and close (which locks it). Reports
